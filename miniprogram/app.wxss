/* ===== 校聚一城 · 全局样式（马卡龙清新可爱风） ===== */
/* 配色变量 —— 所有页面和组件复用此系统 */
/* 适配基础库: 2.11.0+ (CSS 变量支持) */

/* 新版设计令牌（单一来源）。@import 必须写在所有规则之前。 */
@import "./styles/tokens.wxss";
/* 统一图标系统（SVG mask + currentColor）。必须紧跟 tokens 之后。 */
@import "./styles/icons.wxss";

page {
  /* 品牌粉 shim（批次 1 过渡期保留，逐页迁移后删除） */
  --brand-primary: #FF8FA8;          /* 旧主色（CTA→绿、点赞→粉，逐处判断） */
  --brand-secondary: #FFB5C5;        /* 旧次主色 / 渐变亮端 */

  /* ========== 全局基础样式（变量由 styles/tokens.wxss 提供） ========== */
  /* 渐变背景改由下方 page::after 视口固定层承载。
     ⚠️ 不要把渐变换回这里：background-size:100% 100vh 会让它随内容滚动、
        滚过一屏就只剩白色底 —— 这正是「上下滑动背景变色」的根因。 */
  /* 白色底：半透明渐变叠在它上面才呈现「浅绿→白」；不要用 var(--grad-to)（它是全透明） */
  background-color: #FFFFFF;
  color: var(--text-1, #0F1A16);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 让所有页面的根容器透出 page 渐变画布（仅去掉根容器自身的不透明底，
   页面内部的卡片/列表仍用自己的底色，不会被误伤）。 */
page > .page {
  background: transparent;
}

/* ===== 视口固定的页面渐变背景层 =====
   状态栏浅绿（半透明）→ 底部转白。
   · position:fixed 固定在视口，不随页面滚动，滚动时颜色恒定。
   · z-index:-1 让它画在 page 自身背景之上、页面内容之下；
     内容区的透明间隙（卡片间距、hero 区）自然透出渐变，白色卡片照常盖在上面。
   · pointer-events:none 避免拦截点击。
   · 半透明色叠在 page 的白色底上；顶端等效实色 #C0D2E7 ＝ app.json 的导航栏背景色，无缝衔接。 */
page::after {
  content: '';
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 停靠点拉长到 72%，让浅绿贯穿「顶部→中部」再收到白色底部。
     之前只到 42%，加上各页不透明白容器，下半屏看着就是纯白（用户反馈的症结）。 */
  background: linear-gradient(180deg,
    var(--grad-from, rgba(30, 95, 168, 0.28)) 0%,
    var(--grad-mid, rgba(30, 95, 168, 0.10)) 30%,
    var(--grad-to, rgba(30, 95, 168, 0)) 72%);
  z-index: -1;
  pointer-events: none;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.container {
  padding: 24rpx 24rpx 40rpx;
}

/* 布局 */
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.center { display: flex; align-items: center; justify-content: center; }
.col { display: flex; flex-direction: column; }
.flex1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }
.gap24 { gap: 24rpx; }
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }

/* 卡片 */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg, 24rpx);
  padding: 28rpx;
  box-shadow: var(--shadow-1);
}
.card + .card { margin-top: 20rpx; }
.card-flat {
  background: var(--surface);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
}

/* 文字 */
.h1 { font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; color: var(--text-1); }
.h2 { font-size: 32rpx; font-weight: 700; color: var(--text-1); }
.sub { font-size: 26rpx; color: var(--text-2); }
.muted { font-size: 24rpx; color: var(--text-3); }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clamp1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.clamp3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 价格 */
.price { color: var(--price); font-weight: 700; }
.price-symbol { font-size: 24rpx; margin-right: 2rpx; }

/* 按钮 */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0 40rpx;
  transition: transform 200ms, box-shadow 200ms;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--brand-500, #1E5FA8);
  color: var(--text-inverse, #fff);
  box-shadow: var(--shadow-2);
}
.btn-primary:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-1);
}
.btn-ghost {
  background: var(--surface);
  color: var(--brand-500, #1E5FA8);
  border: 2rpx solid var(--border-strong);
}
.btn-plain {
  background: var(--surface-2);
  color: var(--text-1);
}
.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: var(--surface-2);
  color: var(--text-2);
}
.tag-brand {
  background: var(--brand-50);
  color: var(--brand-500, #1E5FA8);
}
.tag-mint {
  background: var(--success-50);
  color: var(--success-500);
}
.tag-warn {
  background: var(--warning-50);
  color: var(--warning-500, #D97706);
}

/* 头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex-shrink: 0;
}
.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

/* 默认头像 */
.avatar-default {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, var(--brand-50) 0%, var(--brand-100) 100%);
}
.ad-head {
  position: absolute;
  left: 50%;
  top: 19%;
  width: 34%;
  height: 34%;
  margin-left: -17%;
  border-radius: 50%;
  background: #ffffff;
}
.ad-body {
  position: absolute;
  left: 50%;
  bottom: -12%;
  width: 68%;
  height: 44%;
  margin-left: -34%;
  border-radius: 50% 50% 0 0;
  background: #ffffff;
}

/* 商品无图占位 */
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, var(--surface-2) 0%, var(--surface-3) 100%);
}
.ce-icon {
  position: relative;
  width: 72rpx;
  height: 58rpx;
  border: 4rpx solid var(--surface-3);
  border-radius: 10rpx;
  overflow: hidden;
}
.ce-sun {
  position: absolute;
  left: 12rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--surface-3);
}
.ce-hill {
  position: absolute;
  left: 8rpx;
  bottom: -14rpx;
  width: 58rpx;
  height: 32rpx;
  background: var(--surface-3);
  border-radius: 6rpx;
  transform: rotate(45deg);
}
.ce-text {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 匿名头像色块 —— 马卡龙色系 */
.anon-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.anon-1 { background: var(--like-50); }
.anon-2 { background: var(--info-50); }
.anon-3 { background: var(--brand-50); }
.anon-4 { background: var(--warning-50); }
.anon-5 { background: var(--success-50); }
.anon-6 { background: var(--like-100); }
.anon-7 { background: var(--brand-100); }
.anon-8 { background: var(--info-500); }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* 空态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.55;
}

/* 悬浮按钮 FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--brand-500);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-3);
  z-index: 20;
  transition: transform 200ms;
}
.fab:active { transform: scale(0.93); }

/* 表单 */
.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field:last-child { border-bottom: none; }
.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  width: 160rpx;
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  color: var(--text-1);
}
.textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-1);
}
.placeholder { color: var(--text-3); }

/* 底部安全区 */
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

/* ===== 信息流样式 ===== */
.feed {
  background: var(--bg-page);
}
.feed-item {
  background: var(--surface);
  padding: 24rpx 28rpx 20rpx;
}
.feed-item + .feed-item {
  border-top: 1rpx solid var(--border);
}
/* 作者行 */
.feed-user {
  display: flex;
  align-items: center;
}
.feed-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.feed-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}
.feed-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.feed-device {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--surface-2);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
/* 正文 */
.feed-text {
  font-size: 29rpx;
  line-height: 1.65;
  color: var(--text-1);
  margin-top: 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.feed-more {
  color: var(--brand-500, #1E5FA8);
  font-size: 27rpx;
}
/* 图片九宫格 */
.feed-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
.feed-img-wrap {
  width: calc((100% - 16rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--surface-2);
}
.feed-img-wrap.single {
  width: 70%;
  height: 320rpx;
}
.feed-img-wrap.double {
  width: calc((100% - 8rpx) / 2);
  height: 240rpx;
}
.feed-img {
  width: 100%;
  height: 100%;
  display: block;
}
/* 热评 */
.hot-comment {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: var(--surface-2);
  border-radius: 16rpx;
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.5;
}
.hot-comment .hc-name {
  color: var(--brand-500, #1E5FA8);
  flex-shrink: 0;
}
/* 操作栏 */
.feed-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: var(--text-3);
  font-size: 24rpx;
}
.feed-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  color: var(--text-2);
}
.feed-action.liked {
  color: var(--like-500, #FF4D7D);
}
.feed-action-icon {
  font-size: 28rpx;
  line-height: 1;
}
