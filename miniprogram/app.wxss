/* ===== 校园趣事 · 全局样式（马卡龙清新可爱风） ===== */
/* 配色变量 —— 所有页面和组件复用此系统 */
/* 适配基础库: 2.11.0+ (CSS 变量支持) */

page {
  /* ========== 马卡龙色系主题变量（可全局换肤） ========== */
  --brand-primary: #FF8FA8;          /* 主按钮 / 主题强调色  —— 樱花粉深 */
  --brand-secondary: #FFB5C5;        /* 次主色 / 渐变亮端    —— 樱花粉 */
  --brand-accent: #E8925E;           /* 深强调色 / 认证色    —— 珊瑚橙 */
  --brand-gradient: linear-gradient(135deg, #FF8FA8 0%, #FFB5C5 100%);
  --brand-gradient-accent: linear-gradient(135deg, #D4B5FF 0%, #FFB5C5 50%, #FFC4B5 100%);

  /* 背景 */
  --bg-page: #FFF8F5;                /* 页面奶油粉背景 */
  --bg-card: #FFFFFF;
  --bg-soft: #FFF0F3;                /* 柔和粉背景 */
  --bg-muted: #FFE4EC;               /* 浅粉灰 */
  --bg-deep: #F5E8EC;                /* 深一点的粉灰 */

  /* 文字 */
  --text-primary: #2D2D2D;
  --text-secondary: #6b6b73;
  --text-hint: #9b9ba3;
  --text-inverse: #FFFFFF;

  /* 语义色 */
  --price: #E8925E;                  /* 价格用珊瑚橙 */
  --success: #95C4A0;                /* 薄荷绿保留成功语义 */
  --warn: #D97706;
  --danger: #F472B6;

  /* 分割线 */
  --divider: #F5E8EC;

  /* 阴影 */
  --shadow-card: 0 4rpx 16rpx rgba(255, 143, 168, 0.08);
  --shadow-float: 0 8rpx 32rpx rgba(255, 143, 168, 0.18);

  /* ========== 全局基础样式 ========== */
  background: var(--bg-page);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.container {
  padding: 24rpx 24rpx 40rpx;
}

/* 布局 */
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.center { display: flex; align-items: center; justify-content: center; }
.col { display: flex; flex-direction: column; }
.flex1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }
.gap24 { gap: 24rpx; }
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.card + .card { margin-top: 20rpx; }
.card-flat {
  background: var(--bg-card);
  border-radius: 32rpx;
  overflow: hidden;
}

/* 文字 */
.h1 { font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; color: var(--text-primary); }
.h2 { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.sub { font-size: 26rpx; color: var(--text-secondary); }
.muted { font-size: 24rpx; color: var(--text-hint); }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.clamp3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 价格 */
.price { color: var(--price); font-weight: 700; }
.price-symbol { font-size: 24rpx; margin-right: 2rpx; }

/* 按钮 */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0 40rpx;
  transition: transform 200ms, box-shadow 200ms;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 168, 0.3);
}
.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(255, 143, 168, 0.2);
}
.btn-ghost {
  background: var(--bg-card);
  color: var(--brand-primary);
  border: 2rpx solid rgba(255, 143, 168, 0.4);
}
.btn-plain {
  background: var(--bg-soft);
  color: var(--text-primary);
}
.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: var(--bg-soft);
  color: var(--text-secondary);
}
.tag-brand {
  background: rgba(255, 143, 168, 0.15);
  color: var(--brand-primary);
}
.tag-mint {
  background: rgba(255, 143, 168, 0.15);
  color: var(--brand-primary);
}
.tag-warn {
  background: rgba(232, 146, 94, 0.15);
  color: var(--brand-accent);
}

/* 头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  flex-shrink: 0;
}
.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

/* 默认头像 */
.avatar-default {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, #FFE4EC 0%, #EFE4FF 100%);
}
.ad-head {
  position: absolute;
  left: 50%;
  top: 19%;
  width: 34%;
  height: 34%;
  margin-left: -17%;
  border-radius: 50%;
  background: #ffffff;
}
.ad-body {
  position: absolute;
  left: 50%;
  bottom: -12%;
  width: 68%;
  height: 44%;
  margin-left: -34%;
  border-radius: 50% 50% 0 0;
  background: #ffffff;
}

/* 商品无图占位 */
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFF0F3 0%, #EFE4FF 100%);
}
.ce-icon {
  position: relative;
  width: 72rpx;
  height: 58rpx;
  border: 4rpx solid var(--bg-deep);
  border-radius: 10rpx;
  overflow: hidden;
}
.ce-sun {
  position: absolute;
  left: 12rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--bg-deep);
}
.ce-hill {
  position: absolute;
  left: 8rpx;
  bottom: -14rpx;
  width: 58rpx;
  height: 32rpx;
  background: var(--bg-deep);
  border-radius: 6rpx;
  transform: rotate(45deg);
}
.ce-text {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 匿名头像色块 —— 马卡龙色系 */
.anon-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.anon-1 { background: #FFE4EC; }
.anon-2 { background: #E4F0FF; }
.anon-3 { background: #EFE4FF; }
.anon-4 { background: #FFF5E4; }
.anon-5 { background: #E4F7EA; }
.anon-6 { background: #FFE8E4; }
.anon-7 { background: #FFEAD5; }
.anon-8 { background: #F0E4FF; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--divider);
  margin: 20rpx 0;
}

/* 空态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.55;
}

/* 悬浮按钮 FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 168, 0.35);
  z-index: 20;
  transition: transform 200ms;
}
.fab:active { transform: scale(0.93); }

/* 表单 */
.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.field:last-child { border-bottom: none; }
.field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 160rpx;
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  color: var(--text-primary);
}
.textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-primary);
}
.placeholder { color: var(--text-hint); }

/* 底部安全区 */
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

/* ===== 信息流样式 ===== */
.feed {
  background: var(--bg-page);
}
.feed-item {
  background: var(--bg-card);
  padding: 24rpx 28rpx 20rpx;
}
.feed-item + .feed-item {
  border-top: 1rpx solid var(--divider);
}
/* 作者行 */
.feed-user {
  display: flex;
  align-items: center;
}
.feed-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.feed-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.feed-meta {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}
.feed-device {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-soft);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
/* 正文 */
.feed-text {
  font-size: 29rpx;
  line-height: 1.65;
  color: var(--text-primary);
  margin-top: 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.feed-more {
  color: var(--brand-primary);
  font-size: 27rpx;
}
/* 图片九宫格 */
.feed-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
.feed-img-wrap {
  width: calc((100% - 16rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--bg-soft);
}
.feed-img-wrap.single {
  width: 70%;
  height: 320rpx;
}
.feed-img-wrap.double {
  width: calc((100% - 8rpx) / 2);
  height: 240rpx;
}
.feed-img {
  width: 100%;
  height: 100%;
  display: block;
}
/* 热评 */
.hot-comment {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: var(--bg-soft);
  border-radius: 16rpx;
  font-size: 25rpx;
  color: var(--text-primary);
  line-height: 1.5;
}
.hot-comment .hc-name {
  color: var(--brand-primary);
  flex-shrink: 0;
}
/* 操作栏 */
.feed-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: var(--text-hint);
  font-size: 24rpx;
}
.feed-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  color: var(--text-secondary);
}
.feed-action.liked {
  color: var(--brand-primary);
}
.feed-action-icon {
  font-size: 28rpx;
  line-height: 1;
}
