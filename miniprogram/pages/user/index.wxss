.page {
  /* 给自定义 tabBar 留出空间；头部渐变通栏铺满 */
  padding: 0 0 calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f6f8;
}

/* 用户卡片 */
.profile {
  margin: 0;
  padding: 40rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #17c07c 0%, #11a86b 55%, #0e9a60 100%);
}
.avatar-xl {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
  overflow: hidden;
}

/* 头像授权按钮：开放能力 getUserInfo */
.avatar-btn {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: visible;
}
.avatar-btn::after {
  border: none;
}
.avatar-cam {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #17c07c;
  font-weight: 600;
}
.ml24 {
  margin-left: 24rpx;
}
.p-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}
.p-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 8rpx;
}
.verify-badge {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.verify-badge.ok {
  background: #ffffff;
  color: #0e9a60;
  font-weight: 600;
}
.verify-badge.todo {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}
.id-row {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
}
.id-item {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
}
.id-row.warn {
  color: #fff3cd;
  font-size: 23rpx;
}
.login-btn {
  margin-top: 32rpx;
}

/* 数据 */
.stats {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
}
.stat-label {
  font-size: 23rpx;
  color: #8b8f99;
  margin-top: 6rpx;
}
.stat-line {
  width: 1rpx;
  height: 48rpx;
  background: #f0f1f5;
}

/* 菜单 */
.menu {
  margin: 20rpx 24rpx 0;
  padding: 8rpx 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  font-size: 30rpx;
  width: 40rpx;
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #2b303b;
}
.menu-tip {
  font-size: 21rpx;
  color: #0e9a60;
  background: rgba(17, 168, 107, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.menu-arrow {
  font-size: 32rpx;
  color: #c8ccd4;
}

.logout {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  padding: 24rpx;
}
.footer-tip {
  text-align: center;
  font-size: 21rpx;
  color: #c8ccd4;
  margin-top: 16rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 76vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
}
.seg {
  display: flex;
  background: #f4f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 12rpx;
}
.seg-item.active {
  background: #ffffff;
  color: #1f2329;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.08);
}
.order-scroll {
  flex: 1;
  margin-top: 16rpx;
  max-height: 46vh;
}
.order-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.order-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.order-contact {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0e9a60;
}
.order-msg {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f7f8fc;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}
