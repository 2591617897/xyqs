/* ===== 我的页面 · 马卡龙清新可爱风 ===== */
/* 适配基础库: 2.11.0+ (CSS 变量支持) */

page {
  /* 马卡龙变量 → design tokens（批次 1：保留旧名、换值，逐页迁移用）
     中性变量（--bg-page / --text-* / --divider / --shadow-*）交给 tokens.wxss 兼容层，此处不再重定义 */
  --mac-pink: var(--like-500);            /* 情感子色：点赞/收藏/表白场景 */
  --mac-pink-deep: var(--like-600);
  --mac-pink-soft: var(--like-50);
  --mac-blue: var(--info-500);
  --mac-blue-soft: var(--info-50);
  --mac-mint: var(--success-500);
  --mac-mint-soft: var(--success-50);
  --mac-purple: var(--brand-200);
  --mac-purple-soft: var(--brand-50);
  --mac-yellow: #FFE5B5;                 /* 暖黄无对应 token，保留原值（低风险） */
  --mac-yellow-soft: #FFF5E4;
  --mac-coral: var(--warning-500);
  --mac-coral-soft: var(--warning-50);
  --mac-cream: var(--surface-2);         /* 原 --mac-cream 未定义，此处补上（历史灰块 bug） */
  --shadow-card-hover: var(--shadow-2);

  /* ========== 全局基础样式（变量由 styles/tokens.wxss 提供） ========== */
  background: var(--bg-page, #F5F7F6);
  color: var(--text-1, #0F1A16);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 页面容器 ---------- */
.page {
  padding: 0 0 calc(180rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 渐变头部区 ---------- */
.hero {
  padding: 16rpx 24rpx 0;
  position: relative;
  /* 品牌清新渐变背景（森林绿系） */
  background: linear-gradient(160deg, var(--brand-50) 0%, var(--brand-100) 55%, var(--info-50) 100%);
  margin: 0 -24rpx 16rpx;
  padding: 32rpx 24rpx 40rpx;
  border-radius: 0 0 48rpx 48rpx;
  transition: transform 100ms linear;
}

/* ---------- 可点击元素统一缩放反馈 ---------- */
/* 使用 hover-class 触发，兼容所有小程序基础库 */
.tap-scale {
  transition: transform 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.tap-scale:hover {
  /* hover 在小程序真机无效，但保留供开发者工具预览 */
  transform: scale(0.96);
}
.tap-scale.scale-down {
  transform: scale(0.96);
}

/* ---------- 入场动画 ---------- */
@keyframes fadeBounceIn {
  0% {
    opacity: 0;
    transform: translateY(40rpx) scale(0.96);
  }
  65% {
    opacity: 1;
    transform: translateY(-10rpx) scale(1.015);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.fade-bounce-in {
  opacity: 0; /* 初始隐藏，动画完成后保持可见 */
}
.fade-bounce-in.animate-in {
  animation: fadeBounceIn 350ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

/* 各模块入场动画延迟 —— 形成波浪式入场 */
.delay-1 { animation-delay: 50ms; }
.delay-2 { animation-delay: 120ms; }
.delay-3 { animation-delay: 180ms; }
.delay-4 { animation-delay: 240ms; }
.delay-5 { animation-delay: 300ms; }
.delay-6 { animation-delay: 360ms; }

/* ---------- 用户卡片 ---------- */
.user-card {
  background: var(--bg-card);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}
.user-card::before {
  /* 装饰性背景圆点 */
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--mac-pink-soft) 0%, transparent 70%);
  pointer-events: none;
}
.card-hover {
  transform: scale(0.985);
  transition: transform 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 200ms ease;
  box-shadow: var(--shadow-card-hover);
}
.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}
.user-avatar {
  position: relative;
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--mac-pink-soft);
  overflow: hidden;
  border: 6rpx solid var(--bg-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 108, 73, 0.16);
  box-sizing: border-box;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--mac-pink-soft), var(--mac-purple-soft));
}
.ad-head {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--mac-pink);
  margin-bottom: 4rpx;
}
.ad-body {
  width: 64rpx;
  height: 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--mac-purple);
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: nowrap;
}
.user-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 1rpx;
}
.verify-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  white-space: nowrap;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--mac-purple-soft);
  color: var(--brand-700, #00452F);
  font-size: 20rpx;
  font-weight: 600;
}
.verify-pill.ok {
  background: var(--mac-mint-soft);
  color: var(--success-500, #059669);
}
.verify-pill .vp-check {
  font-size: 18rpx;
}
.user-school {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-school-act {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--mac-pink-deep);
  font-weight: 500;
}
.user-verified-line {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--success-500, #059669);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-verified-line.warn {
  color: var(--warning-500, #D97706);
}
.user-chev {
  flex-shrink: 0;
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-hint);
}

/* 登录按钮 */
.login-btn {
  margin-top: 28rpx;
  background: var(--brand-gradient, linear-gradient(135deg, #006C49 0%, #5FB894 100%));
  color: var(--text-inverse, #ffffff);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  box-shadow: var(--shadow-2);
  transition: transform 200ms, box-shadow 200ms;
}
.login-btn:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-1);
}

/* ---------- 统计条 ---------- */
.stat-bar {
  display: flex;
  margin-top: 20rpx;
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 28rpx 0;
  box-shadow: var(--shadow-card);
  position: relative;
  z-index: 1;
}
.stat {
  flex: 1;
  text-align: center;
  transition: transform 200ms;
}
.stat:active {
  transform: scale(0.93);
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ---------- 信用分卡（粉紫渐变） ---------- */
.credit-card {
  position: relative;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 36rpx;
  /* 品牌绿渐变（信用分卡） */
  background: linear-gradient(135deg, var(--brand-500) 0%, var(--brand-300) 100%);
  overflow: hidden;
  box-shadow: var(--shadow-float);
  color: var(--text-inverse);
  transition: transform 200ms, box-shadow 200ms;
}
.credit-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-2);
}
.credit-card::before {
  /* 光晕装饰 */
  content: '';
  position: absolute;
  top: -60rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}
.credit-card::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  right: -40rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.credit-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.credit-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.credit-shield {
  font-size: 34rpx;
}
.credit-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-inverse);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}
.credit-pill {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  color: var(--text-inverse);
  font-size: 20rpx;
  font-weight: 600;
  backdrop-filter: blur(4rpx);
}
.credit-arrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}
.credit-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}
.credit-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
}
.credit-star {
  position: absolute;
  right: 20rpx;
  bottom: -20rpx;
  font-size: 120rpx;
  opacity: 0.2;
  transform: rotate(-12deg);
}

/* ---------- 通用区块 ---------- */
.section {
  margin: 24rpx 24rpx 0;
  background: var(--bg-card);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.section-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--mac-pink);
}
.section-bar.pink {
  background: var(--mac-purple);
}
.section-bar.dark {
  background: var(--mac-blue);
}
.section-bar.green {
  background: var(--mac-mint);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}
.section-more {
  font-size: 24rpx;
  color: var(--text-secondary);
  transition: color 200ms;
}
.section-more:active {
  color: var(--mac-pink-deep);
}

/* ---------- 4 宫格（闲置） ---------- */
.grid4 {
  display: flex;
}
.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.grid-item:active {
  transform: scale(0.92);
}
.grid-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: transform 200ms;
}
/* 马卡龙色图标背景 */
.gi-orange { background: var(--mac-coral-soft); }
.gi-green { background: var(--mac-mint-soft); }
.gi-gray { background: var(--mac-yellow-soft); }
.gi-blue { background: var(--mac-blue-soft); }
.gi-pink { background: var(--mac-pink-soft); }
.gi-teal { background: var(--mac-mint-soft); }
.gi-amber { background: var(--mac-yellow-soft); }
.gi-slate { background: var(--mac-purple-soft); }

.grid-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--mac-pink-deep);
  color: var(--text-inverse);
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--bg-card);
  box-sizing: border-box;
}
.grid-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.grid-sub {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* ---------- 2x2 宫格（社交互动） ---------- */
.grid2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.g2-item {
  width: calc((100% - 20rpx) / 2);
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--mac-cream);
  box-sizing: border-box;
  transition: transform 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
              background 200ms;
  border: 2rpx solid transparent;
}
.g2-item:active {
  transform: scale(0.96);
  background: var(--mac-pink-soft);
  border-color: var(--mac-pink);
}
.g2-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.g2-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.g2-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* ---------- 菜单列表 ---------- */
.menu-list {
  display: flex;
  flex-direction: column;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--divider);
  transition: background 200ms, transform 200ms;
  border-radius: 16rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  margin-left: -12rpx;
  margin-right: -12rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: var(--mac-pink-soft);
  transform: scale(0.98);
}
.mi-icon {
  font-size: 36rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--mac-pink-soft);
  flex-shrink: 0;
}
.mi-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}
.mi-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.mi-tip.warn {
  color: var(--warning-500, #D97706);
}
.mi-tip.orange {
  color: var(--mac-pink-deep);
}
.mi-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

/* ---------- 退出登录 ---------- */
.logout {
  margin: 32rpx 24rpx 0;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  color: var(--mac-pink-deep);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
  transition: transform 200ms, background 200ms;
}
.logout:active {
  transform: scale(0.97);
  background: var(--mac-pink-soft);
}
.footer-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  padding-bottom: 20rpx;
}

/* ---------- 弹层（意向单） ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(61, 61, 61, 0.45);
  backdrop-filter: blur(8rpx);
  z-index: 60;
  display: flex;
  align-items: flex-end;
  animation: maskFadeIn 250ms ease;
}
@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: sheetSlideUp 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
@keyframes sheetSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-close {
  font-size: 32rpx;
  color: var(--text-secondary);
  padding: 8rpx;
}
.seg {
  display: flex;
  background: var(--bg-page);
  border-radius: 999rpx;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 200ms;
}
.seg-item.active {
  background: var(--brand-gradient, linear-gradient(135deg, #006C49 0%, #5FB894 100%));
  color: var(--text-inverse);
  font-weight: 600;
  box-shadow: var(--shadow-2);
}
.order-scroll {
  max-height: 56vh;
  margin-top: 8rpx;
}
.order-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--bg-page);
  margin-top: 20rpx;
  border: 2rpx solid var(--divider);
  transition: border-color 200ms;
}
.order-item:active {
  border-color: var(--mac-pink);
}
.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.order-msg {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
.order-contact {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mac-pink-deep);
  font-weight: 500;
}

/* ---------- 通用工具类 ---------- */
.flex1 { flex: 1; }
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.muted { color: var(--text-secondary); }
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.h2 {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: var(--mac-pink-soft);
  color: var(--mac-pink-deep);
  font-weight: 500;
}
.tag-mint {
  background: var(--mac-mint-soft);
  color: var(--success-500, #059669);
}
.empty {
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
}
