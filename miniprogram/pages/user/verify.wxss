.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 已认证 */
.done-wrap {
  padding: 140rpx 40rpx 0;
  text-align: center;
}
.done-icon {
  font-size: 120rpx;
}
.done-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 24rpx;
}
.done-sub {
  font-size: 26rpx;
  color: #8b8f99;
  margin-top: 12rpx;
}
.done-btn {
  margin-top: 56rpx;
}

/* 说明 */
.intro {
  background: #f0faf8;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.intro-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0e9a60;
  margin-bottom: 10rpx;
}
.intro-item {
  font-size: 23rpx;
  color: #4f8f88;
  line-height: 1.9;
}

.school-value {
  font-size: 30rpx;
  text-align: right;
  color: #1f2329;
}
.arrow {
  font-size: 32rpx;
  color: #c8ccd4;
  margin-left: 8rpx;
}

/* 上传 */
.upload-area {
  display: flex;
}
.upload-btn {
  width: 240rpx;
  height: 170rpx;
  border-radius: 18rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.upload-plus {
  font-size: 44rpx;
  color: #b6bbc6;
  line-height: 1;
}
.upload-text {
  font-size: 22rpx;
  color: #b6bbc6;
  margin-top: 8rpx;
}
.upload-preview {
  width: 100%;
}
.upload-img {
  width: 320rpx;
  height: 210rpx;
  border-radius: 16rpx;
  background: #f4f5f9;
}
.upload-del {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #0e9a60;
}

.submit {
  margin-top: 36rpx;
}
.agree {
  text-align: center;
  font-size: 21rpx;
  color: #b6bbc6;
  margin-top: 20rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  height: 76vh;
  /* height 要把 padding 算进去，否则 76vh + 32rpx 上下内边距会超出屏幕，列表底部被顶出去 */
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
}
.search {
  height: 80rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  margin: 24rpx 0 12rpx;
}
.school-scroll {
  flex: 1;
  /* 关键：flex 子项默认 min-height:auto，会被内容撑到全高，
     scroll-view 拿不到受限高度就不会滚动（表现为「列表滑不动」） */
  min-height: 0;
  overflow: hidden;
}
.school-item {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f6f7fb;
}

/* 分组标题：IP 定位到的同城推荐 / 全部学校 */
.school-group {
  padding: 18rpx 4rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #94a3b8;
}
.school-group.near {
  color: #0e9a60;
}
.school-name {
  font-size: 28rpx;
  color: #1f2329;
}
.school-check {
  color: #0e9a60;
  font-size: 30rpx;
  font-weight: 700;
}
