.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 已认证 */
.done-wrap {
  padding: 140rpx 40rpx 0;
  text-align: center;
}
.done-icon {
  font-size: 120rpx;
}
.done-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 24rpx;
}
.done-sub {
  font-size: 26rpx;
  color: #8b8f99;
  margin-top: 12rpx;
}
.done-btn {
  margin-top: 56rpx;
}

/* 已认证卡片里的「认证学校 / 认证方式」 */
.done-info {
  margin: 40rpx auto 0;
  padding: 20rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
  background: #F7F8FA;
  border-radius: 18rpx;
}
.di-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 25rpx;
}
.di-row + .di-row {
  border-top: 1rpx solid #EFF1F5;
}
.di-k {
  color: #8A8F99;
}
.di-v {
  color: #2D2D2D;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 「毕业/换校了？重新认证」——做成文字链，不抢主按钮的视线 */
.done-relink {
  margin-top: 36rpx;
  font-size: 25rpx;
  color: #E8925E;
}

/* 驳回原因 / 重认证提示条 */
.hint {
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}
.hint-warn {
  background: #FFF6F0;
  border: 1rpx solid #FBE0CF;
}
.hint-info {
  background: #F2F7FF;
  border: 1rpx solid #D8E5F8;
}
.hint-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.hint-warn .hint-title {
  color: #C2571B;
}
.hint-info .hint-title {
  color: #2A5D9F;
}
.hint-text {
  font-size: 23rpx;
  line-height: 1.7;
  color: #6B7280;
}
.hint-link {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #2A5D9F;
}

/* 说明 */
.intro {
  background: #f0faf8;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.intro-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #E8925E;
  margin-bottom: 10rpx;
}
.intro-item {
  font-size: 23rpx;
  color: #4f8f88;
  line-height: 1.9;
}

.school-value {
  font-size: 30rpx;
  text-align: right;
  color: #2D2D2D;
}
.arrow {
  font-size: 32rpx;
  color: #c8ccd4;
  margin-left: 8rpx;
}

/* 上传 */
.upload-area {
  display: flex;
}
.upload-btn {
  width: 240rpx;
  height: 170rpx;
  border-radius: 18rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.upload-plus {
  font-size: 44rpx;
  color: #b6bbc6;
  line-height: 1;
}
.upload-text {
  font-size: 22rpx;
  color: #b6bbc6;
  margin-top: 8rpx;
}
.upload-preview {
  width: 100%;
}
.upload-img {
  width: 320rpx;
  height: 210rpx;
  border-radius: 16rpx;
  background: #f4f5f9;
}
.upload-del {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #E8925E;
}

.submit {
  margin-top: 36rpx;
}
.agree {
  text-align: center;
  font-size: 21rpx;
  color: #b6bbc6;
  margin-top: 20rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  height: 76vh;
  /* height 要把 padding 算进去，否则 76vh + 32rpx 上下内边距会超出屏幕，列表底部被顶出去 */
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
}
.search {
  height: 80rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  margin: 24rpx 0 12rpx;
}
.school-scroll {
  flex: 1;
  /* 关键：flex 子项默认 min-height:auto，会被内容撑到全高，
     scroll-view 拿不到受限高度就不会滚动（表现为「列表滑不动」） */
  min-height: 0;
  overflow: hidden;
}
.school-item {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f6f7fb;
}

/* 分组标题：IP 定位到的同城推荐 / 全部学校 */
.school-group {
  padding: 18rpx 4rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #94a3b8;
}
.school-group.near {
  color: #E8925E;
}
.school-name {
  font-size: 28rpx;
  color: #2D2D2D;
}
.school-check {
  color: #E8925E;
  font-size: 30rpx;
  font-weight: 700;
}

/* ==================== 认证方式切换 ==================== */
.mode-tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #F2F4F7;
}
.mode-tab {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #6B7280;
}
.mode-tab.on {
  background: #FFFFFF;
  color: #15803D;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.08);
}
.mode-badge {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #E7F6EC;
  color: #15803D;
  font-size: 20rpx;
  font-weight: 500;
}

/* 学校提示（微信通道不返回学校，要说明为什么还得选） */
.school-tip {
  padding: 16rpx 0 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A8F99;
  border-top: 1rpx solid #F1F3F6;
  margin-top: 4rpx;
}

/* ==================== 微信学生认证卡片 ==================== */
.wx-card {
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: #F4FBF6;
  border: 1rpx solid #D5EFDD;
}
.wx-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.wx-logo {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 22rpx;
  background: #FFFFFF;
  font-size: 40rpx;
  line-height: 76rpx;
  text-align: center;
}
.wx-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #14532D;
}
.wx-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #5B7A66;
}
.wx-line {
  font-size: 23rpx;
  line-height: 1.8;
  color: #456B54;
}
.wx-btn {
  margin-top: 24rpx;
}
.wx-note {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8A9A90;
  text-align: center;
}
.fallback {
  margin-top: 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: #0E9A60;
}

/* 注销入口：弱化成文字链，不与「提交认证 / 开始逛逛」抢视线，也降低误触 */
.danger-zone {
  margin-top: 64rpx;
  text-align: center;
}
.dz-link {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #A9AEB6;
}
.dz-note {
  margin-top: 4rpx;
  padding: 0 48rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #C4C8CF;
}
