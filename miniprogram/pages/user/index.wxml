<view class="page">
  <!-- ===== 用户信息卡（绿色渐变头部） ===== -->
  <view class="hero">
    <!-- 顶部学校定位 pills 已隐藏 -->

    <!-- 用户卡：精简为基本信息，点击进「个人信息」页查看/修改 -->
    <view class="user-card" hover-class="card-hover" bindtap="goProfile">
      <view class="user-row">
        <view class="user-avatar">
          <image wx:if="{{user && user.avatar}}" src="{{user.avatar}}" mode="aspectFill" class="avatar-img" />
          <view wx:else class="avatar-default">
            <view class="ad-head"></view>
            <view class="ad-body"></view>
          </view>
        </view>

        <view class="user-info">
          <view class="user-name-row">
            <text class="user-name">{{user ? user.nickname : '还没有登录'}}</text>
            <view class="verify-pill {{user && user.verifyStatus === 2 ? 'ok' : ''}}" catchtap="goVerify">
              <text class="vp-check">✓</text>
              <text>{{user && user.verifyStatus === 2 ? '已认证' : '去认证'}}</text>
            </view>
          </view>
          <view class="user-school" wx:if="{{user}}">🎓 {{user.schoolName || '已绑定学校'}}</view>
          <view class="user-school" wx:else>点击登录，同步你的校园身份</view>
          <view class="user-verified-line" wx:if="{{user && user.verifyStatus === 2}}">🛡️ 学籍认证已通过</view>
          <view class="user-verified-line warn" wx:if="{{user && user.verifyStatus === 3}}">⚠️ 认证被驳回，请重新提交</view>
        </view>

        <view class="user-chev">›</view>
      </view>
      <button class="btn btn-white login-btn" wx:if="{{!logged}}" catchtap="login">一键登录</button>
    </view>

    <!-- 统计条 -->
    <view class="stat-bar">
      <view class="stat" bindtap="goMyGoods">
        <view class="stat-num">{{user.goodsCount || 0}}</view>
        <view class="stat-label">我发布的</view>
      </view>
      <view class="stat" bindtap="demoEntry" data-name="已卖出">
        <view class="stat-num">{{user.soldCount || 0}}</view>
        <view class="stat-label">已卖出</view>
      </view>
      <view class="stat" bindtap="demoEntry" data-name="我的动态">
        <view class="stat-num">{{user.postCount || 0}}</view>
        <view class="stat-label">我的动态</view>
      </view>
      <view class="stat" bindtap="goFavorites">
        <view class="stat-num">{{user.favoriteCount || 0}}</view>
        <view class="stat-label">赞与收藏</view>
      </view>
    </view>
  </view>

  <!-- ===== 校园信用分 ===== -->
  <view class="credit-card" bindtap="demoEntry" data-name="信用特权">
    <view class="credit-top">
      <view class="credit-title-row">
        <text class="credit-shield">🛡️</text>
        <text class="credit-title">校园信用分 {{user.creditScore || 0}}</text>
        <view class="credit-pill">{{creditLevel || '一般'}}</view>
      </view>
      <text class="credit-arrow">信用特权 ›</text>
    </view>
    <view class="credit-tags">
      <text class="credit-tag">✓ 免押金租借</text>
      <text class="credit-tag">✓ 优先首页推荐</text>
      <text class="credit-tag">✓ 官方实名担保</text>
    </view>
    <view class="credit-star">⭐</view>
  </view>

  <!-- ===== 我的交易 ===== -->
  <view class="section">
    <view class="section-head">
      <view class="section-bar"></view>
      <text class="section-title">我的交易</text>
      <view class="flex1"></view>
      <text class="section-more" bindtap="openOrders">全部订单 ›</text>
    </view>
    <view class="grid4">
      <view class="grid-item" bindtap="openOrders">
        <view class="grid-icon gi-orange">🛍️</view>
        <view class="grid-label">我买到的</view>
        <view class="grid-sub">{{user.buyOrderCount || 0}} 件</view>
      </view>
      <view class="grid-item" bindtap="demoEntry" data-name="我卖出的">
        <view class="grid-icon gi-green">🏷️</view>
        <view class="grid-label">我卖出的</view>
        <view class="grid-sub">{{user.sellOrderCount || 0}} 单</view>
      </view>
      <view class="grid-item" bindtap="goMyGoods">
        <view class="grid-icon gi-gray">📦</view>
        <view class="grid-label">在售闲置</view>
        <view class="grid-sub">{{user.activeCount || 0}} 件</view>
      </view>
      <view class="grid-item" bindtap="openOrders">
        <view class="grid-icon gi-blue">✉️</view>
        <view class="grid-label">意向单</view>
        <view class="grid-sub">{{user.intentCount || 0}} 单</view>
      </view>
    </view>
  </view>

  <!-- ===== 社交互动 ===== -->
  <view class="section">
    <view class="section-head">
      <view class="section-bar pink"></view>
      <text class="section-title">社交互动</text>
      <view class="flex1"></view>
      <text class="section-more" bindtap="goMessages">校园回声 ›</text>
    </view>
    <view class="grid2">
      <view class="g2-item" bindtap="goMessages">
        <view class="g2-icon gi-pink">💗</view>
        <view class="g2-main">
          <view class="g2-title">发起的表白</view>
          <view class="g2-sub">{{user.confessionCount || 0}} 条表白</view>
        </view>
      </view>
      <view class="g2-item" bindtap="goMessages">
        <view class="g2-icon gi-teal">💬</view>
        <view class="g2-main">
          <view class="g2-title">树洞秘语</view>
          <view class="g2-sub">匿名保护中（{{user.treeholeCount || 0}}条）</view>
        </view>
      </view>
      <view class="g2-item" bindtap="goFavorites">
        <view class="g2-icon gi-amber">🔖</view>
        <view class="g2-main">
          <view class="g2-title">收藏与赞</view>
          <view class="g2-sub">{{user.favoriteCount || 0}} 个收藏</view>
        </view>
      </view>
      <view class="g2-item" bindtap="goMyFollows">
        <view class="g2-icon gi-pink">👥</view>
        <view class="g2-main">
          <view class="g2-title">我的关注</view>
          <view class="g2-sub">{{followCount}} 关注 · {{fansCount}} 粉丝</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 校园便民 ===== -->
  <view class="section">
    <view class="section-head">
      <view class="section-bar"></view>
      <text class="section-title">校园便民</text>
      <view class="flex1"></view>
      <text class="section-more" bindtap="demoEntry" data-name="校内直通">校内直通 ›</text>
    </view>
    <view class="grid4">
      <view class="grid-item" bindtap="demoEntry" data-name="跑腿互助">
        <view class="grid-icon gi-green">🏃</view>
        <view class="grid-label">跑腿互助</view>
      </view>
      <view class="grid-item" bindtap="demoEntry" data-name="自取柜租借">
        <view class="grid-icon gi-gray">🪳</view>
        <view class="grid-label">自取柜租借</view>
      </view>
      <view class="grid-item" bindtap="demoEntry" data-name="校历备忘">
        <view class="grid-icon gi-gray">📅</view>
        <view class="grid-label">校历备忘</view>
      </view>
      <view class="grid-item" bindtap="demoEntry" data-name="集市入场券">
        <view class="grid-icon gi-orange">🎟️</view>
        <view class="grid-label">集市入场券</view>
      </view>
    </view>
  </view>

  <!-- ===== 账户与服务 ===== -->
  <view class="section">
    <view class="section-head">
      <view class="section-bar dark"></view>
      <text class="section-title">账户与服务</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goVerify">
        <text class="mi-icon">🎓</text>
        <text class="mi-text">实名学籍认证中心</text>
        <text class="mi-tip" wx:if="{{user && user.verifyStatus === 2}}">认证有效（至 2026）</text>
        <text class="mi-tip warn" wx:else>未认证</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMessages">
        <text class="mi-icon">🔔</text>
        <text class="mi-text">消息通知与隐私权限</text>
        <text class="mi-tip orange">· 即时推送</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="demoEntry" data-name="在线客服与反馈">
        <text class="mi-icon">💬</text>
        <text class="mi-text">在线客服与反馈</text>
        <text class="mi-tip">校内值班中</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="about">
        <text class="mi-icon">ℹ️</text>
        <text class="mi-text">关于校园趣事平台</text>
        <text class="mi-tip">v2.4.1</text>
        <text class="mi-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="logout" wx:if="{{logged}}" bindtap="logout">⇄ 切换账号 / 退出登录</view>
  <view class="footer-tip" bindlongpress="resetMock">
    校园趣事 v2.4.1 · {{mockMode ? '模拟数据模式（长按可重置）' : '同校可信社区'}}
  </view>

  <!-- 意向单弹层 -->
  <view class="mask" wx:if="{{showOrders}}" bindtap="closeOrders">
    <view class="sheet" catchtap="stop">
      <view class="between">
        <text class="h2">购买意向</text>
        <text class="sheet-close" bindtap="closeOrders">✕</text>
      </view>

      <view class="seg mt16">
        <view class="seg-item {{orderRole === 'buyer' ? 'active' : ''}}" bindtap="switchOrderRole" data-role="buyer">我要求购的</view>
        <view class="seg-item {{orderRole === 'seller' ? 'active' : ''}}" bindtap="switchOrderRole" data-role="seller">别人想买我的</view>
      </view>

      <scroll-view class="order-scroll" scroll-y="true">
        <block wx:if="{{orderRole === 'buyer'}}">
          <view class="order-item" wx:for="{{buyerOrders}}" wx:key="id">
            <view class="between">
              <text class="order-title ellipsis flex1">{{item.goodsTitle || '商品'}}</text>
              <text class="tag">{{item.statusText}}</text>
            </view>
            <view class="muted mt8">{{item.timeText}} · 联系方式 {{item.contact}}</view>
            <view class="order-msg" wx:if="{{item.message}}">“{{item.message}}”</view>
          </view>
          <view class="empty" wx:if="{{!buyerOrders.length}}" style="padding: 60rpx 0;">
            <text>还没有求购记录</text>
          </view>
        </block>
        <block wx:else>
          <view class="order-item" wx:for="{{sellerOrders}}" wx:key="id">
            <view class="between">
              <text class="order-title ellipsis flex1">{{item.goodsTitle || '商品'}}</text>
              <text class="tag tag-mint">{{item.statusText}}</text>
            </view>
            <view class="muted mt8">{{item.timeText}} · {{item.buyerName}}</view>
            <view class="order-contact">联系他：{{item.contact}}</view>
            <view class="order-msg" wx:if="{{item.message}}">“{{item.message}}”</view>
          </view>
          <view class="empty" wx:if="{{!sellerOrders.length}}" style="padding: 60rpx 0;">
            <text>还没有人联系你</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- 浏览范围切换：本校 / 本市（+ 定位城市），与首页共用 -->
  <scope-sheet
    show="{{scopeShow}}"
    school-name="{{user.schoolName}}"
    school-city="{{schoolCity}}"
    geo-city="{{geoCity}}"
    current="{{scopeMode}}"
    current-city="{{scopeCity}}"
    bind:close="closeScope"
    bind:select="onScopeSelect"
    bind:verify="onScopeVerify"
  />
</view>

