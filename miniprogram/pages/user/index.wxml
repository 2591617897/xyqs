<view class="page">
  <!-- ===== 用户信息卡（马卡龙粉紫渐变头部） ===== -->
  <view class="hero hero-parallax" id="heroSection" style="transform: translateY(-{{heroOffset}}px)">
    <!-- 用户卡：点击进「个人信息」页 -->
    <view class="user-card fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-1" hover-class="card-hover" bindtap="goProfile">
      <view class="user-row">
        <view class="user-avatar">
          <image wx:if="{{user && user.avatar}}" src="{{user.avatar}}" mode="aspectFill" class="avatar-img" />
          <view wx:else class="avatar-default">
            <view class="ad-head"></view>
            <view class="ad-body"></view>
          </view>
        </view>

        <view class="user-info">
          <view class="user-name-row">
            <text class="user-name">{{user ? user.nickname : '还没有登录'}}</text>
            <view class="verify-pill {{user && user.verifyStatus === 2 ? 'ok' : ''}}" hover-class="scale-down" catchtap="goVerify">
              <block wx:if="{{user && user.verifyStatus === 2}}">
                <text class="vp-check">✓</text>
                <text>已认证</text>
              </block>
              <text wx:elif="{{user && user.verifyStatus === 1}}">审核中</text>
              <text wx:elif="{{user && user.verifyStatus === 3}}">已驳回</text>
              <text wx:else>去认证</text>
            </view>
          </view>
          <view class="user-school" wx:if="{{user}}" catchtap="goPickSchool">
            <block wx:if="{{user.schoolId}}">🎓 {{user.schoolName || '已选择学校'}}</block>
            <block wx:else>🎓 未绑定学校<text class="user-school-act">去选择 ›</text></block>
          </view>
          <view class="user-school" wx:else>点击登录，同步你的校园身份</view>
          <view class="user-verified-line" wx:if="{{user && user.verifyStatus === 2}}">🛡️ 学籍认证已通过</view>
          <view class="user-verified-line warn" wx:if="{{user && user.verifyStatus === 3}}">⚠️ 认证被驳回，请重新提交</view>
        </view>

        <view class="user-chev">›</view>
      </view>
      <button class="login-btn" wx:if="{{!logged}}" catchtap="login">一键登录</button>
    </view>

    <!-- 统计条：四个按钮全部指向分包 subpackages/me 下的独立子页面
         （我发布的 / 已卖出 / 我的动态 / 赞与收藏），页面内容多了也压不垮主包 -->
    <view class="stat-bar fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-2">
      <view class="stat" hover-class="tap-scale" bindtap="goMyGoods">
        <view class="stat-num">{{user.goodsCount || 0}}</view>
        <view class="stat-label">我发布的</view>
      </view>
      <view class="stat" hover-class="tap-scale" bindtap="goSold">
        <view class="stat-num">{{user.soldCount || 0}}</view>
        <view class="stat-label">已卖出</view>
      </view>
      <view class="stat" hover-class="tap-scale" bindtap="goMyDynamic">
        <view class="stat-num">{{user.dynamicCount || 0}}</view>
        <view class="stat-label">我的动态</view>
      </view>
      <view class="stat" hover-class="tap-scale" bindtap="goFavorites">
        <view class="stat-num">{{user.favoriteCount || 0}}</view>
        <view class="stat-label">赞与收藏</view>
      </view>
    </view>
  </view>

  <!-- 运营投放位（后台广告位 code=mine_banner）：放在用户卡与信用分之间，
       未配置时不渲染，页面高度自然回收 -->
  <ad-banner code="mine_banner" />

  <!-- ===== 校园信用分（粉紫渐变卡） ===== -->
  <view class="credit-card fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-3" hover-class="tap-scale" bindtap="demoEntry" data-name="信用特权">
    <view class="credit-top">
      <view class="credit-title-row">
        <text class="credit-shield">🛡️</text>
        <text class="credit-title">校园信用分 {{user.creditScore || 0}}</text>
        <view class="credit-pill">{{creditLevel || '一般'}}</view>
      </view>
      <text class="credit-arrow">信用特权 ›</text>
    </view>
    <view class="credit-tags">
      <text class="credit-tag">✓ 免押金租借</text>
      <text class="credit-tag">✓ 优先首页推荐</text>
      <text class="credit-tag">✓ 官方实名担保</text>
    </view>
    <view class="credit-star">⭐</view>
  </view>

  <!-- ===== 我的交易（闲置） ===== -->
  <view class="section fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-4">
    <view class="section-head">
      <view class="section-bar"></view>
      <text class="section-title">闲置</text>
      <view class="flex1"></view>
      <text class="section-more" hover-class="scale-down" bindtap="openOrders">全部记录 ›</text>
    </view>
    <view class="grid4">
      <view class="grid-item" hover-class="tap-scale" bindtap="openOrders">
        <view class="grid-icon gi-orange">🛍️</view>
        <view class="grid-label">我买到的</view>
        <view class="grid-sub">{{user.buyOrderCount || 0}} 件</view>
      </view>
      <view class="grid-item" hover-class="tap-scale" bindtap="demoEntry" data-name="我卖出的">
        <view class="grid-icon gi-green">🏷️</view>
        <view class="grid-label">我卖出的</view>
        <view class="grid-sub">{{user.sellOrderCount || 0}} 单</view>
      </view>
      <view class="grid-item" hover-class="tap-scale" bindtap="goMyGoods">
        <view class="grid-icon gi-gray">📦</view>
        <view class="grid-label">我的闲置</view>
        <view class="grid-sub">{{user.activeCount || 0}} 件</view>
      </view>
      <view class="grid-item" hover-class="tap-scale" bindtap="openOrders" data-role="seller">
        <view class="grid-icon gi-blue">✉️</view>
        <view class="grid-label">意向单</view>
        <view class="grid-sub">{{user.intentCount || 0}} 单</view>
      </view>
    </view>
  </view>

  <!-- ===== 需求广场：从「闲置」拆出独立分组 ===== -->
  <view class="section fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-5">
    <view class="section-head">
      <view class="section-bar green"></view>
      <text class="section-title">需求广场</text>
      <view class="flex1"></view>
      <text class="section-more" hover-class="scale-down" bindtap="goDemandSquare">逛逛 ›</text>
    </view>
    <view class="grid2">
      <view class="g2-item" hover-class="tap-scale" bindtap="goMyDemands">
        <view class="g2-icon gi-teal">🙋</view>
        <view class="g2-main">
          <view class="g2-title">我的需求</view>
          <view class="g2-sub">我发布的求物 / 求帮忙</view>
        </view>
      </view>
      <view class="g2-item" hover-class="tap-scale" bindtap="goDemandSquare">
        <view class="g2-icon gi-amber">🎁</view>
        <view class="g2-main">
          <view class="g2-title">需求广场</view>
          <view class="g2-sub">看看同学想要什么</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 社交互动 ===== -->
  <view class="section fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-6">
    <view class="section-head">
      <view class="section-bar pink"></view>
      <text class="section-title">社交互动</text>
      <view class="flex1"></view>
      <text class="section-more" hover-class="scale-down" bindtap="goSocial">校园回声 ›</text>
    </view>
    <view class="grid2">
      <view class="g2-item" hover-class="tap-scale" bindtap="goSocial" data-tab="wall" data-cat="love">
        <view class="g2-icon gi-pink">💗</view>
        <view class="g2-main">
          <view class="g2-title">发起的表白</view>
          <view class="g2-sub">{{user.confessionCount || 0}} 条表白</view>
        </view>
      </view>
      <view class="g2-item" hover-class="tap-scale" bindtap="goSocial" data-tab="wall" data-cat="tree">
        <view class="g2-icon gi-teal">💬</view>
        <view class="g2-main">
          <view class="g2-title">树洞秘语</view>
          <view class="g2-sub">匿名保护中（{{user.treeholeCount || 0}}条）</view>
        </view>
      </view>
      <view class="g2-item" hover-class="tap-scale" bindtap="goFavorites">
        <view class="g2-icon gi-amber">🔖</view>
        <view class="g2-main">
          <view class="g2-title">收藏与赞</view>
          <view class="g2-sub">{{user.favoriteCount || 0}} 个收藏</view>
        </view>
      </view>
      <view class="g2-item" hover-class="tap-scale" bindtap="goMyFollows">
        <view class="g2-icon gi-pink">👥</view>
        <view class="g2-main">
          <view class="g2-title">我的关注</view>
          <view class="g2-sub">{{followCount}} 关注 · {{fansCount}} 粉丝</view>
        </view>
      </view>
    </view>
  </view>


  <!-- ===== 账户与服务：整组下沉到子页面，主页面只留一个入口 ===== -->
  <view class="section fade-bounce-in {{pageReady ? 'animate-in' : ''}} delay-7" hover-class="tap-scale" bindtap="goAccount">
    <view class="account-entry">
      <view class="ae-left">
        <view class="ae-icon">⚙️</view>
        <view class="ae-main">
          <view class="ae-title">账号与服务</view>
          <view class="ae-sub">认证 · 范围 · 隐私 · 帮助</view>
        </view>
      </view>
      <text class="ae-arrow">›</text>
    </view>
  </view>

  <view class="logout fade-bounce-in {{pageReady ? 'animate-in' : ''}}" hover-class="tap-scale" wx:if="{{logged}}" bindtap="logout">⇄ 切换账号 / 退出登录</view>
  <view class="footer-tip" bindlongpress="resetMock">
    校聚一城 v2.4.1 · {{mockMode ? '模拟数据模式（长按可重置）' : '立足本校 · 同城相连'}}
  </view>

  <!-- 面交意向单弹层（无支付，仅约见记录） -->
  <view class="mask" wx:if="{{showOrders}}" bindtap="closeOrders">
    <view class="sheet" catchtap="stop">
      <view class="between">
        <text class="h2">面交意向</text>
        <text class="sheet-close" hover-class="scale-down" bindtap="closeOrders">✕</text>
      </view>

      <view class="seg mt16">
        <view class="seg-item {{orderRole === 'buyer' ? 'active' : ''}}" bindtap="switchOrderRole" data-role="buyer">我想约的</view>
        <view class="seg-item {{orderRole === 'seller' ? 'active' : ''}}" bindtap="switchOrderRole" data-role="seller">同学想约我的</view>
      </view>

      <scroll-view class="order-scroll" scroll-y="true">
        <block wx:if="{{orderRole === 'buyer'}}">
          <view class="order-item" wx:for="{{buyerOrders}}" wx:key="id">
            <view class="between">
              <text class="order-title ellipsis flex1">{{item.goodsTitle || '商品'}}</text>
              <text class="tag">{{item.statusText}}</text>
            </view>
            <view class="muted mt8">{{item.timeText}} · 联系方式 {{item.contact}}</view>
            <view class="order-msg" wx:if="{{item.message}}">"{{item.message}}"</view>
          </view>
          <view class="empty" wx:if="{{!buyerOrders.length}}" style="padding: 60rpx 0;">
            <text>还没有约见记录</text>
          </view>
        </block>
        <block wx:else>
          <view class="order-item" wx:for="{{sellerOrders}}" wx:key="id">
            <view class="between">
              <text class="order-title ellipsis flex1">{{item.goodsTitle || '商品'}}</text>
              <text class="tag tag-mint">{{item.statusText}}</text>
            </view>
            <view class="muted mt8">{{item.timeText}} · {{item.buyerName}}</view>
            <view class="order-contact">联系他：{{item.contact}}</view>
            <view class="order-msg" wx:if="{{item.message}}">"{{item.message}}"</view>
          </view>
          <view class="empty" wx:if="{{!sellerOrders.length}}" style="padding: 60rpx 0;">
            <text>还没有人联系你</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- 未绑定学校时的选择弹层 -->
  <school-onboard
    show="{{onboardShow}}"
    saving="{{onboardSaving}}"
    bind:select="onOnboardSelect"
    bind:close="onOnboardClose"
  />
</view>
