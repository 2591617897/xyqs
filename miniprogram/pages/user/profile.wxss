/* ===== 个人信息页 ===== */
.page {
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  background: #f7f9fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx -4rpx rgba(16, 185, 129, 0.05), 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.04);
}

/* ---------- 头像卡 ---------- */
.avatar-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.avatar-btn {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  flex-shrink: 0;
  line-height: 1;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(16, 185, 129, 0.18);
  box-sizing: border-box;
  background: #eef0f4;
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #94a3b8;
}
.avatar-side {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.avatar-tip {
  font-size: 28rpx;
  font-weight: 600;
  color: #191c1e;
}
.avatar-album {
  font-size: 24rpx;
  color: #10b981;
}

/* ---------- 卡片头 ---------- */
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.card-bar {
  width: 6rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #10b981;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #191c1e;
}
.flex1 {
  flex: 1;
}
.card-more {
  font-size: 24rpx;
  color: #10b981;
}

/* ---------- 可编辑字段 ---------- */
.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.field:last-child {
  border-bottom: none;
}
.field-area {
  align-items: flex-start;
}
.field-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #94a3b8;
}
.field-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #191c1e;
}
.field-picker {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #191c1e;
}
.picker-arrow {
  font-size: 32rpx;
  color: #c2c8d0;
}
.field-textarea {
  flex: 1;
  min-width: 0;
  min-height: 100rpx;
  font-size: 28rpx;
  color: #191c1e;
  line-height: 1.6;
}
.ph {
  color: #c2c8d0;
}
.bio-count {
  align-self: flex-end;
  font-size: 20rpx;
  color: #c2c8d0;
}

/* ---------- 只读学籍 ---------- */
.ro-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.ro-row:last-of-type {
  border-bottom: none;
}
.ro-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #94a3b8;
}
.ro-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #191c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ro-value.ok {
  color: #006c49;
  font-weight: 600;
}
.ro-value.bad {
  color: #f97316;
}
.ro-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* ---------- 保存按钮 ---------- */
.save-btn {
  margin-top: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #10b981;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx -6rpx rgba(16, 185, 129, 0.5);
}
.save-btn.disabled {
  opacity: 0.6;
}
.save-btn::after {
  border: none;
}

/* ---------- 未登录 ---------- */
.login-card {
  margin-top: 30vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.login-emoji {
  font-size: 80rpx;
}
.login-text {
  font-size: 26rpx;
  color: #94a3b8;
}
.login-btn {
  margin-top: 12rpx;
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #10b981;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.login-btn::after {
  border: none;
}
