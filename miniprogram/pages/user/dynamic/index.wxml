<view class="page">
  <!-- 统计条 -->
  <view class="stat-bar">
    <view class="stat-item">
      <view class="stat-num">{{totalCount}}</view>
      <view class="stat-label">全部动态</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{postCount}}</view>
      <view class="stat-label">发帖</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{wallCount}}</view>
      <view class="stat-label">表白</view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{!loading && items.length === 0}}">
    <view class="empty-icon">📝</view>
    <view class="empty-title">还没有任何动态</view>
    <view class="empty-desc">去首页发一条帖子，或者在表白墙匿名说句心里话～</view>
  </view>

  <!-- 时间线 -->
  <view class="timeline" wx:else>
    <view
      class="t-card {{item._type}}"
      wx:for="{{items}}"
      wx:key="_key"
      bindtap="goDetail"
      data-type="{{item._type}}"
      data-id="{{item.id}}"
    >
      <!-- === 帖子卡片 === -->
      <block wx:if="{{item._type === 'post'}}">
        <view class="tc-head">
          <view class="tc-type-badge post">📱 帖子</view>
          <view class="tc-channel">{{item.channelName || '综合'}}</view>
          <view class="tc-time">{{item.timeText}}</view>
        </view>
        <view class="tc-title" wx:if="{{item.title}}">{{item.title}}</view>
        <view class="tc-content">{{item.content}}</view>
        <view class="tc-images" wx:if="{{item.imageList && item.imageList.length}}">
          <image
            wx:for="{{item.imageList}}"
            wx:for-item="img"
            wx:key="*this"
            class="tc-img"
            src="{{img}}"
            mode="aspectFill"
          />
        </view>
        <view class="tc-foot">
          <view class="tc-foot-item">👍 {{item.likeCount || 0}}</view>
          <view class="tc-foot-item">💬 {{item.commentCount || 0}}</view>
          <view class="tc-foot-right" wx:if="{{item.status != null && item.status === 0}}">
            <text class="tc-off-shelf">已下架</text>
          </view>
        </view>
      </block>

      <!-- === 表白墙卡片 === -->
      <block wx:else>
        <view class="tc-head">
          <view class="tc-type-badge wall">{{item.flair}}</view>
          <view class="tc-wall-label">我发的表白</view>
          <view class="tc-time">{{item.timeText}}</view>
        </view>
        <view class="tc-content">{{item.content}}</view>
        <view class="tc-images" wx:if="{{item.imageList && item.imageList.length}}">
          <image
            wx:for="{{item.imageList}}"
            wx:for-item="img"
            wx:key="*this"
            class="tc-img"
            src="{{img}}"
            mode="aspectFill"
          />
        </view>
        <view class="tc-foot">
          <view class="tc-foot-item">👍 {{item.likeCount || 0}}</view>
          <view class="tc-foot-item">💬 {{item.commentCount || 0}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
