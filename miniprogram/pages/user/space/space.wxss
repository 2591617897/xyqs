/* ============ 个人主页（pages/user/space） ============ */

.page {
  min-height: 100vh;
  background: #f5f6f8;
}

/* ---------- 头部卡（绿色渐变，同「我的」页 hero） ---------- */
.hero {
  padding: 24rpx 24rpx 0;
  background: linear-gradient(180deg, #e8f7ef 0%, #f5f6f8 100%);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  position: relative;
  flex-shrink: 0;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #eef0f4;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-default {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #e2e8f0;
}

.ad-head {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #94a3b8;
}

.ad-body {
  margin-top: 8rpx;
  width: 88rpx;
  height: 44rpx;
  border-radius: 44rpx 44rpx 0 0;
  background: #94a3b8;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: nowrap;
}

.user-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: #191c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.verify-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  white-space: nowrap;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 600;
}

.verify-pill.ok {
  background: rgba(16, 185, 129, 0.12);
  color: #006c49;
}

.user-school {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-bio {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

/* 关注主按钮：未关注实心主色 / 已关注幽灵 / 本人「编辑资料」 */
.follow-btn {
  flex-shrink: 0;
  min-width: 148rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #11a86b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.follow-btn.on {
  background: #f1f5f9;
  color: #64748b;
}

.follow-btn.ghost {
  background: #ffffff;
  color: #11a86b;
  border: 1rpx solid rgba(17, 168, 107, 0.4);
}

/* 统计条：关注 / 粉丝 */
.stat-bar {
  display: flex;
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 0;
  box-shadow: 0 8rpx 32rpx -4rpx rgba(16, 185, 129, 0.05), 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.04);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #191c1e;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

/* ---------- Tab ---------- */
.tabs {
  display: flex;
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.tab.active {
  background: #11a86b;
  color: #ffffff;
}

/* ---------- 帖子列表（复用信息流卡样式） ---------- */
.feed {
  padding: 24rpx 24rpx 0;
}

.feed-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.feed-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feed-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
}

.feed-avatar-img {
  width: 100%;
  height: 100%;
}

.feed-user-info {
  flex: 1;
  min-width: 0;
}

.feed-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #191c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.feed-chip {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.chip-amber {
  background: #fef3c7;
  color: #b45309;
}

.chip-green {
  background: #d1fae5;
  color: #047857;
}

.feed-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.feed-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #191c1e;
  line-height: 1.5;
}

.clamp2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.feed-imgs {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.feed-img-wrap {
  position: relative;
  flex: 1;
}

.feed-img {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.img-more {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.6);
  color: #ffffff;
  font-size: 18rpx;
}

.feed-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.feed-view,
.feed-act {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.fa-icon {
  font-size: 24rpx;
}

/* ---------- 闲置列表 ---------- */
.goods-list {
  padding: 24rpx 24rpx 0;
}

.goods-item {
  display: flex;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.gi-cover {
  position: relative;
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
}

.gi-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f1f5f9;
}

.gi-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.gi-status {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #ffffff;
}

.gi-status.sale {
  background: #11a86b;
}

.gi-status.sold {
  background: #f59e0b;
}

.gi-status.off {
  background: #94a3b8;
}

.gi-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.gi-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #191c1e;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.gi-price {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  color: #ff4d4f;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.gi-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 空态 / 加载 / 底部 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.list-end {
  text-align: center;
  padding: 24rpx 0 48rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}

.loading-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-block {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
  margin-bottom: 16rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #94a3b8;
}
