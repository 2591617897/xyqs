<view class="page">
  <!-- 未登录提示 -->
  <view class="login-card" wx:if="{{!logged}}">
    <view class="login-emoji">🔐</view>
    <view class="login-text">登录后才能查看和编辑个人信息</view>
    <button class="login-btn" bindtap="login">一键登录</button>
  </view>

  <block wx:else>
    <!-- ===== 头像卡 ===== -->
    <view class="card">
      <view class="avatar-row">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-empty">👤</view>
        </button>
        <view class="avatar-side">
          <view class="avatar-tip">点击头像更换</view>
          <view class="avatar-album" bindtap="chooseFromAlbum">从相册选择 ›</view>
        </view>
      </view>
    </view>

    <!-- ===== 基本资料（可编辑） ===== -->
    <view class="card">
      <view class="card-head">
        <view class="card-bar"></view>
        <text class="card-title">基本资料</text>
      </view>

      <view class="field">
        <text class="field-label">昵称</text>
        <input
          class="field-input"
          type="nickname"
          value="{{nickname}}"
          placeholder="填写你的昵称"
          placeholder-class="ph"
          maxlength="20"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="field">
        <text class="field-label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="field-picker">
            <text class="picker-value">{{genderOptions[genderIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">手机号</text>
        <input
          class="field-input"
          type="number"
          value="{{phone}}"
          placeholder="方便交易时联系（选填）"
          placeholder-class="ph"
          maxlength="11"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="field field-area">
        <text class="field-label">简介</text>
        <textarea
          class="field-textarea"
          value="{{bio}}"
          placeholder="介绍一下自己吧，让同校同学更信任你"
          placeholder-class="ph"
          maxlength="100"
          auto-height
          bindinput="onBioInput"
        />
        <text class="bio-count">{{bioCount}}/100</text>
      </view>
    </view>

    <!-- ===== 学籍信息（只读，去认证页修改） ===== -->
    <view class="card">
      <view class="card-head">
        <view class="card-bar"></view>
        <text class="card-title">学籍信息</text>
        <view class="flex1"></view>
        <text class="card-more" bindtap="goVerify">去认证 ›</text>
      </view>

      <view class="ro-row">
        <text class="ro-label">学校</text>
        <text class="ro-value">{{user.schoolName || '未绑定'}}</text>
      </view>
      <view class="ro-row">
        <text class="ro-label">学号</text>
        <text class="ro-value">{{user.studentNo || '未认证'}}</text>
      </view>
      <view class="ro-row">
        <text class="ro-label">姓名</text>
        <text class="ro-value">{{user.realName || '未认证'}}</text>
      </view>
      <view class="ro-row">
        <text class="ro-label">认证状态</text>
        <text class="ro-value {{user.verifyStatus === 2 ? 'ok' : (user.verifyStatus === 3 ? 'bad' : '')}}">
          {{user.verifyStatus === 2 ? '🛡️ 已通过' : (user.verifyStatus === 3 ? '⚠️ 已驳回' : '未认证')}}
        </text>
      </view>
      <view class="ro-tip" wx:if="{{user.verifyStatus === 3}}">驳回原因：{{user.verifyRemark || '资料不清晰，请重新提交'}}</view>
      <view class="ro-tip">学籍信息涉及校园身份，需在「实名学籍认证」中提交材料修改</view>
    </view>

    <!-- 保存 -->
    <button class="save-btn {{saving ? 'disabled' : ''}}" bindtap="save" disabled="{{saving}}">保存修改</button>
  </block>
</view>
