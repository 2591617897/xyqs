/* ===== 功能区（tab 页）：功能入口网格 ===== */
.page {
  min-height: 100vh;
  background: #F5F7F6;
  /* 底部留出自定义 tabBar 高度 + 安全区，否则最后一行会被底栏压住 */
  padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  padding: 8rpx 8rpx 20rpx;
}
.head-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F1A16;
  letter-spacing: 0.5rpx;
}
.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7A74;
}

/* 入口卡片容器：白底大圆角，一行 4 个 */
.card {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx 8rpx 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 26, 22, 0.06);
}

.entry {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
}
.entry-hover {
  opacity: 0.65;
}
.entry-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}
.entry-text {
  font-size: 22rpx;
  color: #4B4B52;
  max-width: 92%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 图标底色（与首页原先的金刚区一致，token 全部带 fallback） */
.tone-brand { background: var(--brand-50, #E8F0FA); }
.tone-like { background: var(--like-50, #FFF0F4); }
.tone-info { background: var(--info-50, #EFF6FF); }
.tone-warn { background: var(--warning-50, #FFFBEB); }
.tone-violet { background: #F3EEFF; }

/* 加载 / 兜底态 */
.state {
  margin-top: 12rpx;
  padding: 100rpx 40rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.state-emoji { font-size: 64rpx; line-height: 1; }
.state-text { font-size: 26rpx; color: #6B7A74; }
.state-btn {
  margin-top: 8rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #1E5FA8;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.foot {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9AA5A0;
}
.foot.warn { color: #C98A2E; }
