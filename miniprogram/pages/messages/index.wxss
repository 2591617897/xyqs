/* ===== 消息中心 · 对齐设计稿 ===== */
.page {
  min-height: 100vh;
  background: #f7f9fb;
  /* 底部留出自定义 tabBar 的高度（约 110rpx）+ 安全区，否则最后一条会话被底栏压住 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* ===== 未登录引导 ===== */
.login-box {
  margin: 40rpx 24rpx 0;
  padding: 56rpx 32rpx 48rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 26, 22, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.lb-icon { font-size: 76rpx; line-height: 1; }
.lb-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f1a16;
}
.lb-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7a74;
}
.lb-btn {
  margin-top: 32rpx;
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  background: #006C49;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

/* ---------- 顶栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 顶部留白由内联 statusBarHeight 控制（自绘顶栏避开状态栏） */
  padding: 0 24rpx 20rpx;
}
.tb-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tb-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}
.tb-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #191c1e;
}
.tb-right {
  display: flex;
  gap: 12rpx;
}
.tb-act {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

/* 图标统一走全局 styles/icons.wxss（mask + currentColor），
   页内只负责尺寸与颜色，不再自定义 .ico 基类——
   否则会和全局基类的 background-color:currentColor 叠出实心色块 */
.tb-back {
  color: #191c1e;
}
.tb-back .ico {
  width: 48rpx;
  height: 48rpx;
}
.tb-act {
  color: #475569;
}
.tb-act .ico {
  width: 44rpx;
  height: 44rpx;
}
.search-box .ico {
  width: 36rpx;
  height: 36rpx;
  color: #94a3b8;
  flex-shrink: 0;
}
.tip-close {
  color: #94a3b8;
}
.tip-close .ico {
  width: 32rpx;
  height: 32rpx;
}
.op-btn .ico {
  width: 40rpx;
  height: 40rpx;
}

/* ---------- 搜索 ---------- */
.search-wrap {
  padding: 8rpx 24rpx 8rpx;
}
.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: #eceef0;
  padding: 0 28rpx;
  gap: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #191c1e;
}
.ph {
  color: #94a3b8;
}

/* ---------- 快捷入口 ---------- */
.quick {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx -4rpx rgba(0, 108, 73, 0.05), 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.04);
}
.quick-icon {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}
.qi-pink { background: linear-gradient(135deg, #ffd9e4, #ffb0cd); }
.qi-green { background: linear-gradient(135deg, #d9fbec, #a7f3d0); }
.qi-blue { background: #e0f2fe; }
.qi-amber { background: #fef3c7; }
.q-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
  box-sizing: border-box;
}
.q-badge.pink { background: #ec4899; }
.q-badge.green { background: var(--brand-500, #006C49); }
.q-badge.orange { background: #fd761a; }
.q-badge.solid {
  background: #fd761a;
  right: -22rpx;
  font-size: 16rpx;
}
.quick-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #191c1e;
}

/* ---------- 防骗提示 ---------- */
.tip {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 24rpx 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(0, 108, 73, 0.1);
}
.tip-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 108, 73, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.tip-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #006c49;
}
.tip-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #3c4a42;
}
.tip-close {
  flex-shrink: 0;
  padding: 8rpx;
  height: fit-content;
}

/* ---------- 筛选 ---------- */
.filter-scroll {
  width: 100%;
  white-space: nowrap;
}
.filter-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 8rpx 24rpx 16rpx;
}
.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #eceef0;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}
.filter-pill.active {
  background: var(--brand-500, #006C49);
  color: #ffffff;
}
.fp-count {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ---------- 会话列表 ---------- */
.convos {
  padding: 8rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 左滑容器：圆角与投影放在外层，避免被组件的 overflow:hidden 裁掉 */
.convo-swipe {
  display: block;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx -4rpx rgba(0, 108, 73, 0.05), 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.04);
}

/* 左滑操作区按钮 */
.op-btn {
  width: 88px;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.op-btn-danger {
  background: #ef4444;
  color: #ffffff;
}
.op-btn-text {
  font-size: 24rpx;
  font-weight: 600;
}

.convo {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}
.convo-hover {
  background: #f2f4f6;
}
.c-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.c-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e6e8ea;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.c-avatar.anon {
  background: #ffd9e4;
}
.c-avatar.official {
  background: var(--brand-500, #006C49);
  color: #ffffff;
}
.c-official-check {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-500, #006C49);
  color: #ffffff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
}
.c-online {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--brand-500, #006C49);
  border: 4rpx solid #ffffff;
  box-sizing: content-box;
}
/* 未读角标：贴在头像右上角 */
.c-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
  box-sizing: border-box;
}
.c-main {
  flex: 1;
  min-width: 0;
}

/* 第一行：昵称 + 标签 / 时间 */
.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.c-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex-wrap: wrap;
}
.c-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #191c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}
.c-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.c-tag.mint { background: rgba(0, 108, 73, 0.14); color: #005236; }
.c-tag.pink { background: rgba(236, 72, 153, 0.12); color: #8c0053; }
.c-tag.orange { background: #ffdbca; color: #783200; }
.c-tag.plain { background: var(--surface-2, #F0F3F2); color: #64748b; }
.c-tag.green { background: rgba(0, 108, 73, 0.18); color: #006c49; }
.c-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 第二行：最新消息摘要 */
.c-preview {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 10rpx;
}
.c-prefix {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #94a3b8;
}
.c-last {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-last.strong {
  color: #191c1e;
  font-weight: 600;
}

/* 第三行：关联宝贝（轻量标签条） */
.c-goods {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: #f5f7f8;
  min-width: 0;
}
.cg-emoji {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
}
.cg-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cg-price {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: #f97316;
}
.cg-symbol {
  font-size: 20rpx;
  font-weight: 700;
}
.cg-num {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.1;
}
.cg-status {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #e6e8ea;
  color: #475569;
}

/* 空态 / 底部 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}
.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.55;
}
.end {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}
.end-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eceef0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
}
.end-title {
  font-size: 24rpx;
  color: #94a3b8;
}
.end-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b6bdc8;
}

/* ===== 我的校友群卡片 ===== */
.group-card {
  display: flex;
  gap: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  background: linear-gradient(135deg, #eaf5f0 0%, #ffffff 62%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 26, 22, 0.06);
  border: 2rpx solid #dcece4;
}
.group-card-hover {
  background: #f2f8f5;
}
.gc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #006c49;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  flex-shrink: 0;
}
.gc-main {
  flex: 1;
  min-width: 0;
}
.gc-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.gc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f1a16;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.gc-at {
  min-width: 40rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #c2410c;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  flex-shrink: 0;
}
.gc-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  flex-shrink: 0;
}
.gc-join {
  font-size: 21rpx;
  color: #006c49;
  background: #e8f3ee;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.gc-mid {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}
.gc-count {
  font-size: 21rpx;
  color: #7b8a84;
  flex-shrink: 0;
}
.gc-dot {
  font-size: 20rpx;
  color: #cfd9d5;
}
.gc-last {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #7b8a84;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.gc-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}
.gc-tag {
  font-size: 18rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
}
.tag-night {
  color: #1d4ed8;
  background: #eef2ff;
}
.tag-mute {
  color: #b91c1c;
  background: #fee2e2;
}
.tag-new {
  color: #a8730f;
  background: #fff7e6;
}
.gc-time {
  margin-left: auto;
  font-size: 19rpx;
  color: #b9c4bf;
}

/* ===== 群引导（未登录 / 未绑学校） ===== */
.group-empty {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx dashed #dcece4;
}
.ge-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #f2f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.ge-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.ge-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #0f1a16;
}
.ge-sub {
  font-size: 21rpx;
  color: #7b8a84;
}
.ge-act {
  font-size: 24rpx;
  color: #006c49;
  font-weight: 600;
  flex-shrink: 0;
}
/* 接口失败态：换成实线+警示色，和「正常引导」视觉上区分开，别让人以为要选学校 */
.ge-error {
  border-style: solid;
  border-color: #f3d9d3;
  background: #fffaf8;
}
.ge-error .ge-act {
  color: #c2452d;
}
