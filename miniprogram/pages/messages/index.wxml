<view class="page">
  <!-- 顶栏（自绘单层，navigationStyle:custom，不再叠原生导航栏；右侧预留胶囊宽度） -->
  <view class="topbar" style="padding-top: {{statusBarHeight + 8}}px; padding-right: {{capsuleGap}}px">
    <view class="tb-left">
      <!-- 本页已是底部「私信」tab 页：没有上一级可返回，不显示返回箭头 -->
      <text class="tb-title">私信与消息中心</text>
    </view>
    <view class="tb-right">
      <view class="tb-act" bindtap="markAllRead"><view class="ico ico-done-all"></view></view>
      <view class="tb-act" bindtap="onSettings"><view class="ico ico-tune"></view></view>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-wrap">
    <view class="search-box">
      <view class="ico ico-search"></view>
      <input class="search-input" placeholder="搜索校友昵称、聊天记录或宝贝..." placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>
  </view>

  <!-- 四大快捷入口 -->
  <view class="quick">
    <view class="quick-item" bindtap="onQuick" data-name="赞与收藏">
      <view class="quick-icon qi-pink">
        <text>💗</text>
        <view class="q-badge pink" wx:if="{{summary.likes}}">{{summary.likes}}</view>
      </view>
      <text class="quick-label">赞与收藏</text>
    </view>
    <view class="quick-item" bindtap="onQuick" data-name="新增粉丝">
      <view class="quick-icon qi-green">
        <text>👤</text>
        <view class="q-badge green" wx:if="{{summary.followers}}">{{summary.followers}}</view>
      </view>
      <text class="quick-label">新增粉丝</text>
    </view>
    <view class="quick-item" bindtap="onQuick" data-name="评论与@">
      <view class="quick-icon qi-blue">
        <text>💬</text>
        <view class="q-badge orange" wx:if="{{summary.mentions}}">{{summary.mentions}}</view>
      </view>
      <text class="quick-label">评论与@</text>
    </view>
    <view class="quick-item" bindtap="onQuick" data-name="官方通知">
      <view class="quick-icon qi-amber">
        <text>📣</text>
        <view class="q-badge solid" wx:if="{{summary.notice}}">{{summary.notice}}</view>
      </view>
      <text class="quick-label">官方通知</text>
    </view>
  </view>

  <!-- 防骗提示 -->
  <view class="tip" wx:if="{{showTip}}">
    <view class="tip-icon">🛡️</view>
    <view class="tip-body">
      <view class="tip-title">校园面交防骗小贴士</view>
      <view class="tip-text">面交请优先选择宿舍大厅、主楼或食堂等明亮公共区域，认准实名校友，谨防脱离平台私下转账。</view>
    </view>
    <view class="tip-close" bindtap="closeTip"><view class="ico ico-close"></view></view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="filter-scroll" scroll-x="true" show-scrollbar="false">
    <view class="filter-row">
      <view
        class="filter-pill {{filter === item.key ? 'active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        bindtap="switchFilter"
        data-key="{{item.key}}"
      >
        <text>{{item.name}}</text>
        <text class="fp-count" wx:if="{{item.key === 'all'}}">{{allConvos.length}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 会话列表：左滑露出「删除」操作 -->
  <view class="convos">
    <swipe-cell
      wx:for="{{convos}}"
      wx:key="id"
      class="convo-swipe"
      open="{{openSwipeId === item.id}}"
      bind:openchange="onSwipeChange"
      bind:action="onSwipeAction"
      data-id="{{item.id}}"
    >
      <view slot="action">
        <view class="op-btn op-btn-danger" catchtap="onSwipeAction" data-id="{{item.id}}">
          <view class="ico ico-delete"></view>
          <text class="op-btn-text">删除</text>
        </view>
      </view>

      <view
        class="convo"
        hover-class="convo-hover"
        bindtap="goChat"
        data-id="{{item.id}}"
        data-name="{{item.peerName}}"
      >
        <!-- 头像 -->
        <view class="c-avatar-wrap">
          <image wx:if="{{item.peerAvatar}}" class="c-avatar" src="{{item.peerAvatar}}" mode="aspectFill" />
          <view wx:elif="{{item.official}}" class="c-avatar official">🏫<view class="c-official-check">✓</view></view>
          <view wx:elif="{{item.anon}}" class="c-avatar anon">✉️</view>
          <view wx:else class="c-avatar">
            <view class="avatar-default">
              <view class="ad-head"></view>
              <view class="ad-body"></view>
            </view>
          </view>
          <view class="c-online" wx:if="{{item.peerOnline}}"></view>
          <!-- 未读红点：贴在头像右上角，符合 IM 习惯 -->
          <view class="c-badge" wx:if="{{item.unread > 0}}">{{item.unread > 99 ? '99+' : item.unread}}</view>
        </view>

        <view class="c-main">
          <!-- 第一行：昵称 + 身份标签 ... 时间 -->
          <view class="c-head">
            <view class="c-name-row">
              <text class="c-name">{{item.peerName}}</text>
              <text class="c-tag {{tag.cls}}" wx:for="{{item.peerTags}}" wx:for-item="tag" wx:key="text">{{tag.text}}</text>
            </view>
            <text class="c-time">{{item.timeText}}</text>
          </view>

          <!-- 第二行：最新消息摘要（这是会话列表的主角） -->
          <view class="c-preview">
            <text class="c-prefix" wx:if="{{item.lastFrom === 'me'}}">我：</text>
            <text class="c-last {{item.unread ? 'strong' : ''}}">{{item.lastText || '暂无消息'}}</text>
          </view>

          <!-- 第三行：关联宝贝（轻量标签条，不再是大卡片） -->
          <view class="c-goods" wx:if="{{item.goodsCard}}" catchtap="goChat" data-id="{{item.id}}" data-name="{{item.peerName}}">
            <text class="cg-emoji">{{item.goodsCard.emoji}}</text>
            <text class="cg-title">{{item.goodsCard.title}}</text>
            <view class="cg-price"><text class="cg-symbol">¥</text><text class="cg-num">{{item.goodsCard.price}}</text></view>
            <text class="cg-status">{{item.goodsCard.statusText}}</text>
          </view>
        </view>
      </view>
    </swipe-cell>
  </view>

  <view class="empty" wx:if="{{!loading && !needLogin && !convos.length}}">
    <text class="empty-icon">📭</text>
    <text>没有符合条件的会话</text>
  </view>

  <!-- 未登录引导：私信必须有身份，游客点进来给一个明确入口，不打 401 -->
  <view class="login-box" wx:if="{{needLogin}}">
    <view class="lb-icon">💬</view>
    <view class="lb-title">登录后查看私信</view>
    <view class="lb-sub">和校友聊闲置、约面交时间，消息只在你们两人之间可见。</view>
    <view class="lb-btn" bindtap="goLogin">微信一键登录</view>
  </view>

  <!-- 底部状态 -->
  <view class="end" wx:if="{{convos.length}}">
    <view class="end-icon">💬</view>
    <text class="end-title">已加载全部私信对话</text>
    <text class="end-sub">友善交流，共筑可信温暖的校园圈子 🌱</text>
  </view>

  <!-- ========== 通知抽屉 bottom-sheet ========== -->
  <view class="mask" wx:if="{{notifyDrawerOpen}}" catchtap="closeNotifyDrawer"></view>
  <view class="notify-drawer {{notifyDrawerOpen ? 'on' : ''}}">
    <view class="nd-head">
      <text class="nd-title">{{notifyDrawerTitle}}</text>
      <view class="nd-actions">
        <text class="nd-mark" bindtap="onMarkCurrentRead" wx:if="{{notifyDrawerItems.length}}">全部标为已读</text>
        <text class="nd-close" bindtap="closeNotifyDrawer">✕</text>
      </view>
    </view>

    <view class="nd-list" wx:if="{{!notifyDrawerLoading}}">
      <view
        class="nd-item {{item.unread ? 'unread' : ''}}"
        wx:for="{{notifyDrawerItems}}"
        wx:key="id"
        bindtap="goNotifyDetail"
        data-index="{{index}}"
      >
        <!-- 头像 -->
        <view class="ndi-avatar-wrap">
          <image wx:if="{{item.actorAvatar}}" class="ndi-avatar" src="{{item.actorAvatar}}" mode="aspectFill" />
          <view wx:else class="ndi-avatar default">
            <text wx:if="{{item.type === 'SYSTEM'}}">🏫</text>
            <text wx:else>👤</text>
          </view>
          <view class="ndi-dot" wx:if="{{item.unread}}"></view>
        </view>

        <view class="ndi-main">
          <view class="ndi-top">
            <text class="ndi-name">{{item.actorName || '校园趣事'}}</text>
            <text class="ndi-action">
              <text wx:if="{{item.type === 'LIKE_GOODS' || item.type === 'LIKE_POST' || item.type === 'LIKE_WALL'}}">给你点了个赞</text>
              <text wx:elif="{{item.type === 'NEW_FOLLOWER'}}">关注了你</text>
              <text wx:elif="{{item.type === 'COMMENT_GOODS' || item.type === 'COMMENT_POST' || item.type === 'COMMENT_WALL'}}">评论了你</text>
              <text wx:elif="{{item.type === 'MENTION'}}">@了你</text>
              <text wx:elif="{{item.type === 'SYSTEM'}}">发来一条消息</text>
              <text wx:else>发来通知</text>
            </text>
          </view>
          <view class="ndi-snippet" wx:if="{{item.contentSnapshot}}">{{item.contentSnapshot}}</view>
          <view class="ndi-bottom">
            <text class="ndi-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>

      <view class="nd-empty" wx:if="{{!notifyDrawerItems.length}}">
        <text class="nde-icon">✨</text>
        <text>暂时没有{{notifyDrawerTitle}}</text>
      </view>
    </view>

    <view class="nd-loading" wx:if="{{notifyDrawerLoading}}">加载中...</view>
  </view>
</view>
