<view class="page" wx:if="{{post}}">
  <!-- 正文 -->
  <view class="article">
    <view class="between">
      <view class="row gap12">
        <view class="anon-avatar {{post.avatarClass}}">{{post.avatarEmoji}}</view>
        <view>
          <view class="anon-name">{{post.anonName}}</view>
          <view class="muted">{{post.timeText}}</view>
        </view>
      </view>
      <view class="row gap12">
        <view class="wall-promote" wx:if="{{post.mine}}" hover-class="wall-promote-hover" hover-stay-time="80" catchtap="openPromote">推广</view>
        <view
          class="more-btn"
          wx:if="{{post.mine}}"
          hover-class="more-btn-hover"
          hover-stay-time="80"
          catchtap="openMore"
          aria-role="button"
          aria-label="更多操作"
        >
          <view class="ico ico-more"></view>
        </view>
      </view>
    </view>

    <view class="content">{{post.content}}</view>

    <view class="imgs" wx:if="{{post.imageList.length}}">
      <image
        wx:for="{{post.imageList}}"
        wx:key="*this"
        class="img"
        src="{{item}}"
        mode="widthFix"
        bindtap="preview"
        data-url="{{item}}"
      />
    </view>

    <view class="meta">
      <text class="tag" wx:if="{{post.mine}}">我发布的</text>
      <text class="muted">{{post.sameSchool ? '仅同校可见 · 匿名展示' : '同城可见 · 匿名展示'}}</text>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comment-section">
    <view class="section-head">
      <text class="section-title">全部评论</text>
      <text class="section-count">{{comments.length}}</text>
    </view>

    <view class="comment-item" wx:for="{{comments}}" wx:key="id" wx:for-index="pindex">
      <view class="c-avatar {{item.avatarClass}}">💬</view>
      <view class="flex1">
        <view class="c-head">
          <text class="c-name">{{item.anonName}}</text>
          <view class="row gap12">
            <text class="muted">{{item.timeText}}</text>
            <text class="c-reply-btn" catchtap="replyComment" data-id="{{item.id}}" data-name="{{item.anonName}}">回复</text>
            <text class="c-del" wx:if="{{item.mine}}" catchtap="deleteComment" data-id="{{item.id}}">删除</text>
          </view>
        </view>

        <view class="c-text" wx:if="{{item.content}}">{{item.content}}</view>

        <view class="c-imgs" wx:if="{{item.imageList.length}}">
          <image
            wx:for="{{item.imageList}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="*this"
            class="c-img"
            src="{{img}}"
            mode="aspectFill"
            catchtap="previewComment"
            data-pindex="{{pindex}}"
            data-url="{{img}}"
          />
        </view>

        <!-- 楼中楼回复 -->
        <view class="c-replies" wx:if="{{item.replies && item.replies.length}}">
          <view class="reply-item" wx:for="{{item.repliesShown}}" wx:for-item="rp" wx:for-index="rindex" wx:key="id">
          
            <view class="flex1">
              <view class="c-head">
                <text class="c-name">{{rp.anonName}}</text>
                <view class="row gap12">
                  <text class="muted">{{rp.timeText}}</text>
                  <text class="c-reply-btn" catchtap="replyComment" data-id="{{rp.id}}" data-name="{{rp.anonName}}">回复</text>
                  <text class="c-del" wx:if="{{rp.mine}}" catchtap="deleteReply" data-id="{{rp.id}}">删除</text>
                </view>
              </view>
              <view class="c-text">
                <text wx:if="{{rp.replyToName}}" class="reply-to">回复 {{rp.replyToName}}：</text>{{rp.content}}
              </view>
              <view class="c-imgs" wx:if="{{rp.imageList.length}}">
                <image
                  wx:for="{{rp.imageList}}"
                  wx:for-item="img"
                  wx:for-index="imgIndex"
                  wx:key="*this"
                  class="c-img"
                  src="{{img}}"
                  mode="aspectFill"
                  catchtap="previewComment"
                  data-pindex="{{pindex}}"
                  data-url="{{img}}"
                />
              </view>
            </view>
          </view>
          <view class="reply-more" wx:if="{{item.replyCount > 5 && !item.expanded}}" catchtap="toggleReplies" data-index="{{pindex}}">
            查看全部 {{item.replyCount}} 条回复 ›
          </view>
        </view>
      </view>
    </view>

    <view class="comment-empty" wx:if="{{!comments.length}}">
      <text class="empty-icon">💬</text>
      <text>还没有评论，做第一个温柔的人</text>
    </view>
  </view>

  <view class="bottom-space"></view>

  <!-- 底部悬停操作栏：写评论 + 点赞 / 评论 / 分享 / 举报 -->
  <view class="bottom-bar">
    <view class="bar-input" hover-class="bar-input-hover" hover-stay-time="80" bindtap="openCommentSheet">
      <view class="ico ico-edit bar-input-icon"></view>
      <text class="bar-input-hint">写评论…</text>
    </view>
    <view class="bar-acts">
      <view
        class="bar-act {{post.liked ? 'on' : ''}}"
        hover-class="bar-act-hover"
        hover-stay-time="80"
        catchtap="toggleLike"
        aria-role="button"
        aria-label="{{post.liked ? '取消点赞' : '点赞'}}"
      >
        <view class="ico bar-ico {{post.liked ? 'ico-like' : 'ico-like-o'}}"></view>
        <text class="bar-num">{{post.likeCount || 0}}</text>
      </view>
      <view
        class="bar-act"
        hover-class="bar-act-hover"
        hover-stay-time="80"
        catchtap="openCommentSheet"
        aria-role="button"
        aria-label="评论"
      >
        <view class="ico ico-comment bar-ico"></view>
        <text class="bar-num">{{post.commentCount || 0}}</text>
      </view>
      <!-- 转发：<button> 自带描边在部分基础库清不掉，改为 view 出图 + 透明 button 占位承接点击 -->
      <view class="bar-act bar-share" hover-class="bar-act-hover" hover-stay-time="80" aria-role="button" aria-label="分享">
        <view class="ico ico-share bar-ico"></view>
        <button class="bar-share-hit" open-type="share" plain></button>
      </view>
      <view class="bar-act" hover-class="bar-act-hover" hover-stay-time="80" catchtap="goReport" aria-role="button" aria-label="举报">
        <view class="ico ico-flag bar-ico"></view>
      </view>
    </view>
  </view>

  <!-- 评论抽屉：底部半屏弹起（点「评论」或「回复」弹出） -->
  <view class="mask pc-comment-mask" wx:if="{{showCommentSheet}}" catchtap="closeCommentSheet"></view>
  <view class="pc-comment-sheet {{showCommentSheet ? 'on' : ''}}" style="bottom: {{keyboardHeight}}px" catchtap="stop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-head-title">{{replyTo ? '回复 @' + replyTo.name : '匿名评论'}}</text>
      <text class="sheet-head-close" catchtap="closeCommentSheet">✕</text>
    </view>

    <!-- 待发送配图 -->
    <view class="pending-imgs" wx:if="{{commentImages.length}}">
      <view class="p-item" wx:for="{{commentImages}}" wx:key="*this">
        <image class="p-thumb" src="{{item}}" mode="aspectFill" />
        <view class="p-del" catchtap="removeCommentImage" data-index="{{index}}">✕</view>
      </view>
      <text class="p-tip">最多 3 张</text>
    </view>

    <!-- 主输入 -->
    <view class="sheet-input-area">
      <textarea
        class="sheet-textarea"
        placeholder="{{replyTo ? '回复 @' + replyTo.name + '，温柔一点…' : '匿名评论，温柔一点…'}}"
        placeholder-class="placeholder"
        value="{{commentInput}}"
        auto-height
        maxlength="500"
        focus="{{commentSheetFocus}}"
        confirm-type="send"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeight"
        bindinput="onCommentInput"
        bindconfirm="sendComment"
      />
      <view class="sheet-count">{{commentInput.length || 0}}/500</view>
    </view>

    <!-- 工具行 + 发布 -->
    <view class="sheet-toolbar">
      <view class="sheet-tools">
        <view class="sheet-tool {{showEmoji ? 'on' : ''}}" hover-class="sheet-tool-hover" hover-stay-time="80" catchtap="toggleEmoji" aria-role="button" aria-label="表情">
          <view class="ico ico-emoji"></view>
        </view>
        <view class="sheet-tool" hover-class="sheet-tool-hover" hover-stay-time="80" catchtap="chooseCommentImage" aria-role="button" aria-label="图片">
          <view class="ico ico-image"></view>
        </view>
        <view class="sheet-tool" hover-class="sheet-tool-hover" hover-stay-time="80" catchtap="openMentionPicker" aria-role="button" aria-label="提醒好友">
          <view class="ico ico-at"></view>
        </view>
      </view>
      <view class="sheet-send {{commentInput || commentImages.length ? 'on' : ''}}" bindtap="sendComment">发布</view>
    </view>

    <!-- 已 @ 人员标签 -->
    <view class="mention-tags" wx:if="{{mentionUserIds.length}}">
      <view class="mention-tag">已 @ {{mentionUserIds.length}} 人</view>
    </view>

    <!-- 表情面板 -->
    <view class="emoji-panel" wx:if="{{showEmoji}}">
      <view class="emoji-grid">
        <view
          class="emoji-item"
          wx:for="{{emojiList}}"
          wx:key="*this"
          catchtap="addEmoji"
          data-emoji="{{item}}"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <!-- @ 好友选择 bottom-sheet -->
  <view class="mask" wx:if="{{showMentionPicker}}" catchtap="closeMentionPicker"></view>
  <view class="mention-picker {{showMentionPicker ? 'on' : ''}}">
    <view class="sheet-head">
      <text class="sheet-head-title">选择要 @ 的好友</text>
      <text class="sheet-head-close" catchtap="closeMentionPicker">✕</text>
    </view>
    <view class="mention-list">
      <view class="mention-item" wx:for="{{mentionPickerList}}" wx:key="id" catchtap="confirmMention" data-index="{{index}}">
        <image wx:if="{{item.avatar}}" class="mi-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="mi-avatar default"></view>
        <view class="mi-info">
          <text class="mi-name">{{item.nickname || item.name}}</text>
          <text class="mi-sub">{{item.school || '同学'}}</text>
        </view>
        <view class="mi-add">+ @</view>
      </view>
      <view class="mention-empty" wx:if="{{!mentionPickerList.length}}">没有更多好友可 @ 了</view>
    </view>
  </view>

  <!-- 编辑弹层 -->
  <view class="mask" wx:if="{{showEdit}}" bindtap="closeEdit">
    <view class="sheet" catchtap="stop">
      <view class="between">
        <text class="h2">编辑这条心事</text>
        <text class="sheet-close" bindtap="closeEdit">✕</text>
      </view>

      <textarea
        class="edit-textarea"
        placeholder="想说的话，改一改也可以"
        placeholder-class="placeholder"
        maxlength="1000"
        value="{{editContent}}"
        bindinput="onEditContent"
        auto-height
      />

      <view class="row between mt16">
        <view class="row gap12">
          <view class="img-add" wx:if="{{editImages.length < 3}}" bindtap="chooseEditImage">＋</view>
          <view class="img-item" wx:for="{{editImages}}" wx:key="*this">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" />
            <view class="img-del" catchtap="removeEditImage" data-index="{{index}}">✕</view>
          </view>
        </view>
        <text class="muted">{{editContent.length}}/1000</text>
      </view>

      <button class="btn btn-primary mt24" loading="{{saving}}" bindtap="saveEdit">保存修改</button>
      <view class="sheet-note">发布时间与匿名昵称不会变化</view>
    </view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">
  <text class="empty-icon">{{loadError ? '📡' : '💌'}}</text>
  <text>{{loadError ? '加载失败，请检查网络或后端服务' : '这条表白不见了'}}</text>
  <view class="btn btn-ghost btn-sm back-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  <view class="btn btn-plain btn-sm back-btn" wx:else bindtap="goBack">回到表白墙</view>
</view>

<promote-sheet
  visible="{{showPromote}}"
  target-type="WALL"
  target-id="{{post.id}}"
  target-name="心事"
  title="推广这条心事"
  bind:close="closePromote"
  bind:done="onPromoteDone"
/>
