.page {
  padding-bottom: 40rpx;
}

/* 正文 */
.article {
  background: #ffffff;
  padding: 32rpx 32rpx 12rpx;
}
.anon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3f4653;
}
/* ---------- 头部操作：推广 / 更多（统一图标 + 胶囊） ---------- */
.more-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-3, #6B7A74);
  background: var(--surface-2, #F0F3F2);
  border-radius: var(--radius-pill, 999rpx);
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease);
}
.more-btn-hover {
  background: var(--surface-3, #E8ECEA);
}
/* 推广入口：品牌实心胶囊，与普通「更多」区分视觉权重 */
.wall-promote {
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--brand-500, #006C49);
  color: var(--text-inverse, #FFFFFF);
  font-size: var(--fs-3, 24rpx);
  font-weight: var(--fw-bold, 600);
  box-shadow: var(--shadow-1, 0 2rpx 8rpx rgba(15, 26, 22, 0.04));
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease);
}
.wall-promote-hover {
  background: var(--brand-600, #005A3D);
}
.content {
  font-size: 33rpx;
  line-height: 1.85;
  color: #2b303b;
  margin-top: 26rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.imgs {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.img {
  width: 100%;
  border-radius: 16rpx;
  background: #f4f5f9;
}
.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

/* 评论 */
.comment-section {
  background: #ffffff;
  margin-top: 20rpx;
  padding: 28rpx 32rpx 12rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
}
.section-count {
  font-size: 23rpx;
  color: #b6bbc6;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.c-name {
  font-size: 25rpx;
  color: #8b8f99;
}
.c-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
  margin-top: 8rpx;
  word-break: break-all;
}
.comment-empty {
  padding: 70rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
}

.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.c-del {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-imgs {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}
.c-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f4f5f9;
}

/* ---------- 底部悬停操作栏 ---------- */
.bottom-space {
  height: 200rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--surface, #FFFFFF);
  border-top: 1rpx solid var(--border, #E3E8E6);
  box-shadow: 0 -8rpx 32rpx rgba(15, 26, 22, 0.06);
  z-index: 30;
}

/* 写评论：胶囊输入框 */
.bar-input {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 26rpx;
  background: var(--surface-2, #F0F3F2);
  border-radius: var(--radius-pill, 999rpx);
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease);
}
.bar-input-hover {
  background: var(--surface-3, #E8ECEA);
}
.bar-input-icon {
  font-size: 30rpx;
  color: var(--text-3, #6B7A74);
  flex-shrink: 0;
}
.bar-input-hint {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-4, 26rpx);
  color: var(--text-3, #6B7A74);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 操作组：图标 + 计数，单行胶囊 */
.bar-acts {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.bar-act {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 76rpx;
  min-width: 64rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: transparent;
  color: var(--text-2, #4B5A54);
  box-sizing: border-box;
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease),
              transform var(--dur-fast, 120ms) var(--ease-out, ease);
}
.bar-act-hover {
  background: var(--surface-2, #F0F3F2);
  transform: scale(0.94);
}
.bar-ico {
  font-size: 36rpx;
  flex-shrink: 0;
}
.bar-num {
  font-size: var(--fs-2, 22rpx);
  font-weight: var(--fw-medium, 500);
  color: var(--text-3, #6B7A74);
  line-height: 1;
}
/* 点赞激活：马卡龙浅粉底 + 樱花粉 */
.bar-act.on {
  background: var(--like-50, #FFF0F4);
  color: var(--like-500, #FF4D7D);
}
.bar-act.on .bar-num {
  color: var(--like-500, #FF4D7D);
}
.bar-act.on.bar-act-hover {
  background: var(--like-100, #FFD9E3);
}
/* 分享（button 组件）样式复位 */
.bar-share {
  margin: 0;
  padding: 0 16rpx;
  line-height: 1;
  font-size: inherit;
  background: transparent;
  border-radius: var(--radius-pill, 999rpx);
}
.bar-share::after {
  border: none;
}

/* 待发送图片 */
.pending-imgs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 14rpx;
}
.p-item {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.p-thumb {
  width: 100%;
  height: 100%;
}
.p-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #ffffff;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 10rpx;
}
.p-tip {
  font-size: 20rpx;
  color: #c2c6cf;
}

/* 表情面板 */
.emoji-panel {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f4f5f9;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
}
.emoji-item {
  width: 12.5%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

/* ---------- @ 好友选择器 ---------- */
.mention-picker {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform .25s ease;
  z-index: 120;
  display: flex; flex-direction: column;
}
.mention-picker.on { transform: translateY(0); }
.mention-list {
  flex: 1; overflow-y: auto;
  padding: 0 24rpx 40rpx;
}
.mention-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--surface-2, #F0F3F2);
}
.mi-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg,#a855f7,#ec4899);
}
.mi-avatar.default { background: #e2e8f0; }
.mi-info { flex: 1; min-width: 0; }
.mi-name { font-size: 28rpx; font-weight: 500; color: #1e293b; display: block; }
.mi-sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; display: block; }
.mi-add {
  font-size: 26rpx; color: #ffffff;
  background: linear-gradient(135deg,#6366f1,#a855f7);
  padding: 6rpx 20rpx; border-radius: 30rpx;
}
.mention-empty { text-align: center; padding: 60rpx 0; color: #94a3b8; font-size: 26rpx; }
.mention-tags {
  padding: 0 24rpx; margin-top: 10rpx;
}
.mention-tag {
  display: inline-block;
  font-size: 22rpx; color: #6366f1;
  background: #eef2ff; padding: 4rpx 16rpx; border-radius: 20rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 0 8rpx;
}
.sheet-note {
  text-align: center;
  font-size: 22rpx;
  color: #b6bbc6;
  margin-top: 16rpx;
}
.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 420rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f8fc;
  border-radius: 20rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #2D2D2D;
}
.img-add {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #b6bbc6;
}
.img-item {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.back-btn {
  margin-top: 32rpx;
  display: inline-block;
}

/* ---------- 楼中楼回复 ---------- */
.c-reply-btn {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-replies {
  margin-top: 16rpx;
  background: #f6f8fb;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}
.reply-item {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
}
.reply-item + .reply-item {
  border-top: 1rpx solid #eceff5;
}
.reply-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
}
.reply-to {
  color: var(--like-500, #FF4D7D);
  font-weight: 600;
}
.reply-more {
  padding: 14rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--like-500, #FF4D7D);
}

/* ---------- 评论抽屉 ---------- */
.pc-comment-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.48);
  z-index: 90;
}
.pc-comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 78vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.pc-comment-sheet.on {
  transform: translateY(0);
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 6rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx 10rpx;
}
.sheet-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
.sheet-head-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #94a3b8;
  border-radius: 50%;
  background: var(--surface-2, #F0F3F2);
}
.sheet-input-area {
  position: relative;
  margin: 6rpx 24rpx 0;
  padding: 20rpx 24rpx 40rpx;
  background: #f8fafc;
  border-radius: 20rpx;
}
.sheet-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 360rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #0f172a;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.sheet-count {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}
.sheet-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}
.sheet-tools {
  display: flex;
  gap: 20rpx;
}
.sheet-tool {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--surface-2, #F0F3F2);
  color: var(--text-3, #6B7A74);
  transition: background 0.15s, color 0.15s;
}
.sheet-tool-hover {
  background: var(--surface-3, #E8ECEA);
}
.sheet-tool.on {
  background: var(--brand-50, #E8F5EF);
  color: var(--brand-500, #006C49);
}
.sheet-send {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
  transition: background 0.15s, color 0.15s;
}
.sheet-send.on {
  background: var(--brand-gradient, linear-gradient(135deg, #006C49 0%, #5FB894 100%));
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 108, 73, 0.18);
}
