.page {
  padding-bottom: 40rpx;
}

/* 正文 */
.article {
  background: #ffffff;
  padding: 32rpx 32rpx 12rpx;
}
.anon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3f4653;
}
.more-btn {
  font-size: 34rpx;
  color: #9ca3af;
  letter-spacing: 2rpx;
  padding: 0 12rpx;
  line-height: 1;
}
.content {
  font-size: 33rpx;
  line-height: 1.85;
  color: #2b303b;
  margin-top: 26rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.imgs {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.img {
  width: 100%;
  border-radius: 16rpx;
  background: #f4f5f9;
}
.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 56rpx;
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #f4f5f9;
}
.action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #8b8f99;
}
.action.liked {
  color: #ff4d4f;
}
.act-icon {
  font-size: 34rpx;
  line-height: 1;
}

/* 评论 */
.comment-section {
  background: #ffffff;
  margin-top: 20rpx;
  padding: 28rpx 32rpx 12rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
}
.section-count {
  font-size: 23rpx;
  color: #b6bbc6;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.c-name {
  font-size: 25rpx;
  color: #8b8f99;
}
.c-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
  margin-top: 8rpx;
  word-break: break-all;
}
.comment-empty {
  padding: 70rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
}

.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.c-del {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-imgs {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}
.c-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f4f5f9;
}

.bottom-space {
  height: 160rpx;
}
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.06);
  z-index: 30;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tool {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.tool.on {
  background: #f4f5f9;
}
.comment-input {
  flex: 1;
  height: 76rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  min-width: 0;
}
.send-btn {
  font-size: 27rpx;
  color: #c2c6cf;
  font-weight: 600;
  padding: 0 8rpx;
  flex-shrink: 0;
}
.send-btn.active {
  color: #0e9a60;
}

/* 待发送图片 */
.pending-imgs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 14rpx;
}
.p-item {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.p-thumb {
  width: 100%;
  height: 100%;
}
.p-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #ffffff;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 10rpx;
}
.p-tip {
  font-size: 20rpx;
  color: #c2c6cf;
}

/* 表情面板 */
.emoji-panel {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f4f5f9;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
}
.emoji-item {
  width: 12.5%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 0 8rpx;
}
.sheet-note {
  text-align: center;
  font-size: 22rpx;
  color: #b6bbc6;
  margin-top: 16rpx;
}
.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 420rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f8fc;
  border-radius: 20rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #1f2329;
}
.img-add {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #b6bbc6;
}
.img-item {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.back-btn {
  margin-top: 32rpx;
  display: inline-block;
}
