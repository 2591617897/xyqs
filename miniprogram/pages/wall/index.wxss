.page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

/* 顶部栏 */
.topbar {
  background: #ffffff;
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f1f3;
}
.topbar-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
}
.topbar-sub {
  font-size: 23rpx;
  color: #9b9ba3;
  margin-top: 6rpx;
}
.compose-entry {
  margin-top: 18rpx;
  height: 76rpx;
  background: #f4f5f7;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 28rpx;
}
.compose-ph {
  flex: 1;
  font-size: 26rpx;
  color: #a8adb6;
}
.compose-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  background: #11a86b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 排序条 */
.sort-bar {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 18rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f1f3;
}
.sort-item {
  font-size: 27rpx;
  color: #8c8c93;
  position: relative;
  padding: 4rpx 0;
}
.sort-item.active {
  color: #1a1a1a;
  font-weight: 700;
}
.sort-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 36rpx;
  height: 6rpx;
  margin-left: -18rpx;
  border-radius: 3rpx;
  background: #11a86b;
}
.sort-count {
  font-size: 23rpx;
  color: #9b9ba3;
}

/* 信息流 */
.feed {
  background: #ffffff;
}
.feed-item {
  padding: 24rpx 28rpx 20rpx;
  background: #ffffff;
}
.feed-item + .feed-item {
  border-top: 1rpx solid #f0f1f3;
}
.feed-hover {
  background: #fafbfc;
}
.feed-user-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.feed-del {
  font-size: 23rpx;
  color: #b6bbc6;
  padding: 0 6rpx;
}
.feed-avatar.anon-avatar {
  font-size: 30rpx;
}
.ml40 {
  margin-left: 48rpx;
}
.list-end {
  text-align: center;
  font-size: 23rpx;
  color: #b6bbc6;
  padding: 32rpx 0;
  background: #f5f6f8;
}
.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 0 8rpx;
}
.sheet-note {
  text-align: center;
  font-size: 22rpx;
  color: #b6bbc6;
  margin-top: 16rpx;
}

/* 发布 */
.compose-textarea {
  width: 100%;
  min-height: 220rpx;
  max-height: 400rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #1a1a1a;
}
.img-add {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #b6bbc6;
}
.img-item {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #ffffff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}
