.page {
  /* 给自定义 tabBar 留出空间 */
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

/* 头部 */
.wall-hero {
  padding: 40rpx 32rpx 64rpx;
  background: linear-gradient(160deg, #ffe9ef 0%, #fdf3f6 55%, #f6f7fb 100%);
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: #a08a94;
  margin-top: 10rpx;
}
.compose-entry {
  margin-top: 28rpx;
  height: 92rpx;
  background: #ffffff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 120, 150, 0.12);
}
.compose-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.compose-ph {
  flex: 1;
  font-size: 26rpx;
  color: #b6bbc6;
}
.compose-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ff5a76 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 卡片列表 */
.wall-list {
  margin-top: -36rpx;
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.wall-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 22rpx rgba(31, 35, 41, 0.05);
  transition: transform 0.12s ease, background 0.12s ease;
}
.anon-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #3f4653;
}
.del-btn {
  font-size: 23rpx;
  color: #b6bbc6;
}
.wall-content {
  font-size: 30rpx;
  line-height: 1.75;
  color: #2b303b;
  margin-top: 20rpx;
  word-break: break-all;
  white-space: pre-wrap;
}
.wall-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.wall-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  background: #f4f5f9;
}
.wall-actions {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f4f5f9;
}
.action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8b8f99;
}
.act-icon {
  font-size: 32rpx;
  line-height: 1;
}
.act-icon.liked,
.action.liked {
  color: #ff4d4f;
}
.detail-hint {
  font-size: 22rpx;
  color: #c8ccd4;
}
.card-hover {
  background: #fbfcfe;
  transform: scale(0.995);
}
.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}

.list-tip {
  text-align: center;
  font-size: 23rpx;
  color: #b6bbc6;
  padding: 32rpx 0;
}

/* 弹层通用 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-tall {
  height: 70vh;
  display: flex;
  flex-direction: column;
}
.sheet-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 0 8rpx;
}
.sheet-note {
  text-align: center;
  font-size: 22rpx;
  color: #b6bbc6;
  margin-top: 16rpx;
}

/* 发布 */
.compose-textarea {
  width: 100%;
  min-height: 220rpx;
  max-height: 400rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f8fc;
  border-radius: 20rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #1f2329;
}
.img-add {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #b6bbc6;
}
.img-item {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

/* 评论 */
.comment-scroll {
  flex: 1;
  margin-top: 20rpx;
}
.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #f4f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.comment-name {
  font-size: 24rpx;
  color: #8b8f99;
}
.comment-text {
  font-size: 27rpx;
  line-height: 1.6;
  color: #2b303b;
  margin-top: 6rpx;
}
.comment-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f5;
}
.comment-input {
  flex: 1;
  height: 80rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
}
.comment-send {
  font-size: 27rpx;
  color: #ff5a76;
  font-weight: 600;
  padding: 0 12rpx;
}
