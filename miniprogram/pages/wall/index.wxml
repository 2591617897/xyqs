<view class="page">
  <!-- 顶部栏（酷安式） -->
  <view class="topbar">
    <view class="topbar-title">表白墙</view>
    <view class="topbar-sub">匿名 · 仅同校可见</view>
    <view class="compose-entry" bindtap="openCompose">
      <text class="compose-ph">写下今天想说的话…</text>
      <text class="compose-btn">发布</text>
    </view>
  </view>

  <!-- 排序 -->
  <view class="sort-bar">
    <view
      class="sort-item {{sort === 'new' ? 'active' : ''}}"
      bindtap="switchSort"
      data-key="new"
    >最新</view>
    <view
      class="sort-item {{sort === 'hot' ? 'active' : ''}}"
      bindtap="switchSort"
      data-key="hot"
    >最热</view>
    <view class="flex1"></view>
    <text class="sort-count">共 {{total}} 条心事</text>
  </view>

  <!-- 信息流 -->
  <view class="feed">
    <view
      class="feed-item"
      wx:for="{{posts}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
      hover-class="feed-hover"
      hover-stay-time="60"
    >
      <view class="feed-user">
        <view class="feed-avatar anon-avatar {{item.avatarClass}}">{{item.avatarEmoji}}</view>
        <view class="feed-user-info">
          <view class="feed-name">{{item.anonName}}</view>
          <view class="feed-meta">
            <text>{{item.timeText}}</text>
            <text class="feed-device">匿名发布</text>
          </view>
        </view>
        <text class="feed-del" wx:if="{{item.mine}}" catchtap="deletePost" data-index="{{index}}">删除</text>
      </view>

      <view class="feed-text clamp3">{{item.content}}</view>

      <view class="feed-imgs" wx:if="{{item.imageList.length}}">
        <view
          class="feed-img-wrap {{item.imageList.length === 1 ? 'single' : (item.imageList.length === 2 ? 'double' : '')}}"
          wx:for="{{item.imageList}}"
          wx:for-item="img"
          wx:for-index="ii"
          wx:key="*this"
        >
          <image
            class="feed-img"
            src="{{img}}"
            mode="aspectFill"
            catchtap="preview"
            data-index="{{index}}"
            data-url="{{img}}"
          />
        </view>
      </view>

      <view class="feed-actions">
        <view class="feed-action {{item.liked ? 'liked' : ''}}" catchtap="toggleLike" data-index="{{index}}">
          <text class="feed-action-icon">👍</text>
          <text>{{item.likeCount ? item.likeCount : '点赞'}}</text>
        </view>
        <view class="feed-action ml40" catchtap="goDetail" data-id="{{item.id}}">
          <text class="feed-action-icon">💬</text>
          <text>{{item.commentCount ? item.commentCount : '评论'}}</text>
        </view>
        <view class="flex1"></view>
        <text class="feed-more" catchtap="goDetail" data-id="{{item.id}}">详情 ›</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !posts.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '💌'}}</text>
    <text>{{loadError ? '加载失败，请检查网络或后端服务' : '还没有人写心事，第一个就是你'}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <view class="list-end" wx:if="{{posts.length}}">
    {{loading ? '加载中…' : (hasMore ? '上拉看更多心事' : '— 已经到底了 —')}}
  </view>

  <!-- 发布弹层 -->
  <view class="mask" wx:if="{{showCompose}}" bindtap="closeCompose">
    <view class="sheet" catchtap="stop">
      <view class="between">
        <text class="h2">写一条匿名心事</text>
        <text class="sheet-close" bindtap="closeCompose">✕</text>
      </view>
      <textarea
        class="compose-textarea"
        placeholder="匿名发布，不会展示你的昵称和头像"
        placeholder-class="placeholder"
        maxlength="1000"
        value="{{content}}"
        bindinput="onContent"
        auto-height
        focus
      />
      <view class="row between mt16">
        <view class="row gap12">
          <view class="img-add" wx:if="{{images.length < 3}}" bindtap="chooseImage">＋</view>
          <view class="img-item" wx:for="{{images}}" wx:key="*this">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" />
            <view class="img-del" catchtap="removeImage" data-index="{{index}}">✕</view>
          </view>
        </view>
        <text class="muted">{{content.length}}/1000</text>
      </view>
      <button class="btn btn-primary mt24" loading="{{submitting}}" bindtap="submitPost">匿名发布</button>
      <view class="sheet-note">发布后仍可编辑或删除</view>
    </view>
  </view>
</view>
