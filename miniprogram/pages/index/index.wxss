.page {
  /* 给自定义 tabBar 留出空间 */
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部搜索栏 ===== */
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 28rpx;
  background: #ffffff;
}
.topbar-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}
.topbar-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.search-box {
  flex: 1;
  height: 68rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 10rpx;
}
.search-icon {
  font-size: 26rpx;
  opacity: 0.55;
}
.search-placeholder {
  font-size: 26rpx;
  color: #b3b3b8;
}
.msg-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e8e9ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

/* ===== 频道导航 ===== */
.nav-scroll {
  background: #ffffff;
  white-space: nowrap;
}
.nav-row {
  display: inline-flex;
  align-items: center;
  gap: 44rpx;
  padding: 8rpx 28rpx 0;
}
.nav-item {
  position: relative;
  padding: 14rpx 0 18rpx;
  font-size: 28rpx;
  color: #6b6b73;
}
.nav-item.active {
  color: #1a1a1a;
  font-weight: 700;
}
.nav-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 32rpx;
  height: 6rpx;
  margin-left: -16rpx;
  border-radius: 999rpx;
  background: #11a86b;
}

/* ===== 分类横滑 ===== */
.cat-scroll {
  background: #ffffff;
  white-space: nowrap;
  padding: 16rpx 0 18rpx;
  border-bottom: 1rpx solid #f0f1f3;
}
.cat-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 28rpx;
}
.cat-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  font-size: 24rpx;
  color: #6b6b73;
}
.cat-pill.active {
  background: rgba(17, 168, 107, 0.1);
  color: #11a86b;
  font-weight: 600;
}

/* ===== 信息流 ===== */
.feed {
  background: #ffffff;
}
.feed-item {
  position: relative;
}
.feed-hover {
  background: #fafafa;
}
.feed-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.feed-user-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.feed-meta .feed-device {
  margin-left: 12rpx;
}
.feed-type {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #11a86b;
  background: rgba(17, 168, 107, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.feed-title {
  font-weight: 700;
  margin-right: 8rpx;
}

.feed-price {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ff4d4f;
}
.feed-loc {
  font-size: 22rpx;
  font-weight: 400;
  color: #9b9ba3;
  margin-left: 14rpx;
}

.ml40 {
  margin-left: 48rpx;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}
.list-end {
  text-align: center;
  font-size: 22rpx;
  color: #c2c2c8;
  padding: 36rpx 0 20rpx;
  background: #f5f6f8;
}
