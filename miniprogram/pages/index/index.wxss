.page {
  /* 给自定义 tabBar 留出空间 */
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部：学校胶囊 + 搜索 + 通知 ===== */
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
}
.school-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 64rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 1rpx solid #F5E8EC;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 20, 26, 0.04);
  flex-shrink: 0;
  max-width: 260rpx;
}
.school-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.school-arrow {
  font-size: 20rpx;
  color: #9b9ba3;
}
.search-box {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  gap: 10rpx;
}
.search-icon {
  font-size: 24rpx;
  opacity: 0.55;
}
.search-placeholder {
  font-size: 25rpx;
  color: #b3b3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bell-btn {
  position: relative;
  width: 56rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bell-icon {
  font-size: 34rpx;
}
.bell-dot {
  position: absolute;
  right: 8rpx;
  top: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  border: 3rpx solid #ffffff;
  box-sizing: content-box;
}

/* ===== 功能入口区（金刚区）=====
   一屏看清所有功能；后台给 t_channel 加一行，这里自动多一个图标。
   固定入口在前（我想说 / 校园闲置 / 校园频道），频道入口在后。 */
.entries {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 12rpx 20rpx;
  background: #ffffff;
}
.entry {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
}
.entry-hover {
  opacity: 0.7;
}
.entry-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}
.tone-brand { background: var(--brand-50, #E8F5EF); }
.tone-like { background: var(--like-50, #FFF0F4); }
.tone-info { background: var(--info-50, #EFF6FF); }
.tone-warn { background: var(--warning-50, #FFFBEB); }
.tone-violet { background: #F3EEFF; }
.entry-text {
  font-size: 22rpx;
  color: #4b4b52;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 运营公告位：绿色横幅 ===== */
.announce {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(100deg, #1cb877 0%, #0f9f5f 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 108, 73, 0.18);
}
.announce-hover {
  transform: scale(0.99);
  opacity: 0.94;
}
.announce-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.announce-main {
  flex: 1;
  min-width: 0;
}
.announce-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.announce-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
}
.announce-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.announce-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.announce-btn {
  flex-shrink: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f9f5f;
  font-size: 24rpx;
  font-weight: 700;
}

/* ===== 内容功能区 ===== */
.zones {
  padding-bottom: 8rpx;
}
.zone {
  margin-top: 24rpx;
}
/* 模块标题行 */
.zone-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}
.zone-icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}
.zone-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.zone-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex-shrink: 0;
}
.zone-desc {
  font-size: 21rpx;
  color: #9b9ba3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.zone-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand-500, #006C49);
  font-weight: 600;
}

/* 横向滚动容器 */
.zone-scroll {
  white-space: nowrap;
  width: 100%;
}
.zone-row {
  display: inline-flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 0 24rpx 4rpx;
}

/* 通用卡片 */
.zcard {
  display: inline-block;
  vertical-align: top;
  white-space: normal;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(17, 20, 26, 0.06);
  overflow: hidden;
  box-sizing: border-box;
}
.zcard-hover {
  background: #fcfcfd;
}
.zcard-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.zcard-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #d97706;
  background: rgba(245, 165, 36, 0.16);
}
.zcard-time {
  font-size: 20rpx;
  color: #9b9ba3;
}
.zcard-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
}
.zcard-excerpt {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b6b73;
}
.zcard-foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}
.zcard-act {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  color: #6b6b73;
}
.zcard-act-icon {
  font-size: 24rpx;
  line-height: 1;
}
.zcard-act-icon.is-liked {
  color: var(--like-500, #FF4D7D);
}

/* 帖子卡片 */
.zcard-post {
  width: 400rpx;
  padding: 20rpx;
}

/* 我想说（表白墙）卡片 */
.zcard-wall {
  width: 340rpx;
  padding: 20rpx;
}
.zcard-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.zcard-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.zcard-user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.zcard-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.zcard-meta {
  font-size: 20rpx;
  color: #9b9ba3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.zcard-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--like-500, #FF4D7D);
  background: var(--like-50, #FFF0F4);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 校园闲置卡片 */
.zcard-goods {
  width: 240rpx;
}
.zcard-goods-img {
  width: 240rpx;
  height: 200rpx;
  display: block;
  background: #f2f3f5;
}
.zcard-goods-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.zcard-goods-body {
  padding: 16rpx 18rpx 18rpx;
}
.zcard-goods-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  min-height: 70rpx;
}
.zcard-goods-price {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}
.zcard-price-symbol {
  font-size: 22rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-right: 2rpx;
}
.zcard-price-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
}
.zcard-goods-loc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9b9ba3;
}

/* 校园闲置区的分类子筛选 */
.zone-sub {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 14rpx;
}
.zone-sub-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}
.zone-sub-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 22rpx;
  color: #4b4b52;
  box-sizing: border-box;
}
.zone-sub-icon {
  font-size: 22rpx;
}

/* ===== 今日最热帖子卡 ===== */
.hot-card {
  margin: 0 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7fbf9 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx -6rpx rgba(0, 108, 73, 0.12);
  border: 1rpx solid rgba(0, 108, 73, 0.14);
}
.hot-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.hot-flame {
  font-size: 30rpx;
}
.hot-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #191c1e;
}
.hot-hint {
  font-size: 20rpx;
  color: var(--brand-500, #006C49);
  background: rgba(0, 108, 73, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.hot-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.hot-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}
.hot-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #191c1e;
  margin-right: 12rpx;
}
.hot-meta {
  font-size: 20rpx;
  color: #9b9ba3;
}
.hot-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
}
.hot-comment {
  position: relative;
  margin-top: 14rpx;
  background: var(--bg-page, #F5F7F6);
  border-radius: 16rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
}
.hot-like-badge {
  position: absolute;
  top: -14rpx;
  left: 20rpx;
  background: var(--like-500, #FF4D7D);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx 999rpx 999rpx 0;
  box-shadow: 0 4rpx 12rpx -2rpx rgba(255, 77, 125, 0.4);
}
.hot-comment-body {
  font-size: 25rpx;
  line-height: 1.6;
  color: #5b6472;
}
.hot-comment-name {
  color: var(--like-500, #FF4D7D);
  font-weight: 600;
}
.hot-comment-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* #话题 标签（热评卡内复用） */
.feed-topic {
  color: var(--brand-500, #006C49);
  font-weight: 600;
}
.feed-hover {
  background: #fcfcfd;
}

/* ===== 底部操作：胶囊图标 + 计数 ===== */
.feed-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #9b9ba3;
  font-size: 23rpx;
}
.feed-view {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: #8a8f99;
  font-size: 22rpx;
}
.feed-view .fa-icon {
  font-size: 24rpx;
  opacity: 0.8;
}
.fa-icon {
  font-size: 28rpx;
  line-height: 1;
}
.feed-act {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #6b6b73;
  font-size: 22rpx;
  transition: background 0.15s ease, color 0.15s ease;
}
.feed-act:active {
  background: #f4f5f7;
}
.feed-act.liked {
  color: var(--like-500, #FF4D7D);
  background: rgba(255, 77, 125, 0.1);
}
.feed-share {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: 0;
  padding: 8rpx 18rpx;
  background: transparent;
  border: none;
  border-radius: 999rpx;
  line-height: 1;
  font-size: 22rpx;
  color: #6b6b73;
}
.feed-share:active {
  background: #f4f5f7;
}
.feed-share::after {
  border: none;
}
.share-hover {
  opacity: 0.6;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}
