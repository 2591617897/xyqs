.page {
  /* 给自定义 tabBar 留出空间 */
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部「浏览范围」行（默认不渲染，见 index.wxml 注释） =====
   必须落在首页既有的卡片语言里：白底 + 24rpx 圆角 + shadow-1 + 品牌浅底图标块 + 品牌绿 CTA。
   ⚠️ 不要退化成裸文字行（无承载块 + 裸 emoji）—— 那样看着像漏写样式，也会和下面的绿 banner 打架。
   高度约 72rpx（旧版 sticky 白栏是 96rpx），且不再 sticky，滚一下就没了。
   旧版 .topbar / .school-pill / .school-name / .school-arrow 已随之移除。 */
.scope-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 14rpx 20rpx;
  background: var(--surface, #FFFFFF);
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: var(--shadow-1, 0 2rpx 8rpx rgba(15, 26, 22, 0.04));
}
.scope-hover {
  background: var(--surface-2, #F0F3F2);
}
/* 图标块：与 .announce-icon 同思路（有底才不像裸 emoji），尺寸按行高收到 44rpx */
.scope-ico {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--brand-50, #E8F5EF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}
.scope-main {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-1, #0F1A16);
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scope-sub {
  flex-shrink: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--text-3, #6B7A74);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 右侧 CTA：品牌绿文字 + 箭头，不做填充按钮（下方绿 banner 已有一个白色填充按钮，会抢焦点） */
.scope-cta {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brand-500, #006C49);
}
.scope-arrow {
  font-size: 24rpx;
  line-height: 1;
}

/* ===== 功能入口区（金刚区）已移到 pages/zone/index =====
   样式随页面一起搬走，首页不再有 .entries / .entry / .tone-* 定义。 */

/* ===== 运营 Banner（后台广告位 code=home_banner） ===== */
/* 与首页其他区块对齐：左右各 24rpx（= .announce / .zone-head / .hot-card 的外边距），
   圆角 24rpx 与 .announce、.hot-card 保持一致。
   ⚠️ width 必须是 auto 而不是 100%：swiper 默认宽度就是满屏，
   再叠上左右 24rpx margin 会撑出 48rpx，整页可横向滚动。 */
.banner {
  width: auto;
  height: 300rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 300rpx;
  display: block;
  border-radius: 24rpx;
}

/* ===== 运营公告位：绿色横幅 ===== */
.announce {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(100deg, #1cb877 0%, #0f9f5f 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 108, 73, 0.18);
}
.announce-hover {
  transform: scale(0.99);
  opacity: 0.94;
}
.announce-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.announce-main {
  flex: 1;
  min-width: 0;
}
.announce-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.announce-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
}
.announce-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.announce-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.announce-btn {
  flex-shrink: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f9f5f;
  font-size: 24rpx;
  font-weight: 700;
}

/* ===== 内容功能区 ===== */
.zones {
  padding-bottom: 8rpx;
}
.zone {
  margin-top: 24rpx;
}
/* 模块标题行 */
.zone-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}
.zone-icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}
.zone-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.zone-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex-shrink: 0;
}
.zone-desc {
  font-size: 21rpx;
  color: #9b9ba3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.zone-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand-500, #006C49);
  font-weight: 600;
}

/* 单列全宽列表：每张卡片横向铺满一屏（不分栏、不横向滚动） */
.zone-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx 4rpx;
}

/* 通用卡片 */
.zcard {
  display: block;
  width: 100%;
  white-space: normal;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(17, 20, 26, 0.06);
  overflow: hidden;
  box-sizing: border-box;
}
.zcard-hover {
  background: #fcfcfd;
}
.zcard-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.zcard-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #d97706;
  background: rgba(245, 165, 36, 0.16);
}
.zcard-time {
  font-size: 20rpx;
  color: #9b9ba3;
}
.zcard-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
}
.zcard-excerpt {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b6b73;
}
.zcard-foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}
.zcard-act {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  color: #6b6b73;
}
.zcard-act-icon {
  font-size: 24rpx;
  line-height: 1;
}
.zcard-act-icon.is-liked {
  color: var(--like-500, #FF4D7D);
}

/* 帖子卡片 */
.zcard-post {
  padding: 24rpx;
}

/* 树洞（表白墙）卡片：单列全宽，排版与上方「今日最热 / 帖子」一致 */
.zcard-wall {
  display: block;
  padding: 24rpx;
}
/* 底部操作条：仅点赞，右对齐（与上方帖子卡 feed-actions 一致） */
.wall-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
/* 复用 .zcard-act 的点赞图标样式；这里仅占位说明，实际样式在下方补充时不冲突 */
.zcard-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
/* 昵称 + 徽标同一行 */
.zcard-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.zcard-flair {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  background: rgba(236, 72, 153, 0.1);
  color: #ec4899;
}
.zcard-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.zcard-user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.zcard-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.zcard-meta {
  font-size: 20rpx;
  color: #9b9ba3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.zcard-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.zcard-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--like-500, #FF4D7D);
  background: var(--like-50, #FFF0F4);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
/* 树洞正文：浅底色块，内容只有一行时也有视觉重量，不显得空 */
.zcard-wall .zcard-excerpt {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  color: #3a3f47;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}
/* 树洞配图：九宫格，无图不渲染（WXML 已 wx:if 控制）。
   圆角只落在整块外缘（outer-corner-only，仿帖子九宫格观感），
   内部图片不单独圆角，靠容器 overflow:hidden 统一裁切。 */
.wall-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.wall-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 0;
  background: #f2f3f5;
  display: block;
}
/* 1 张：放大，限制宽度避免被拉成正方形 */
.wall-imgs.cols-1 .wall-img {
  width: 420rpx;
  height: 320rpx;
}
/* 2 / 4 张：两列（4 张即 2×2） */
.wall-imgs.cols-2 .wall-img {
  width: calc((100% - 10rpx) / 2);
  height: 220rpx;
}
/* 3 张及以上：三列 */
.wall-imgs.cols-3 .wall-img {
  width: calc((100% - 20rpx) / 3);
  height: 210rpx;
}

/* 校园闲置卡片：左图右文的整行卡片 */
.zcard-goods {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 16rpx;
}
/* 图片容器：定宽、高度由 flex stretch 决定，图片绝对定位铺满 */
.zcard-goods-thumb {
  width: 200rpx;
  min-height: 200rpx;
  flex-shrink: 0;
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f2f3f5;
}
.zcard-goods-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  background: #f2f3f5;
}
.zcard-goods-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.zcard-goods-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 4rpx 4rpx 4rpx 0;
}
.zcard-goods-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}
/* 描述摘要：标题只有一行时接在下面，把卡片下半部分填起来 */
.zcard-goods-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--text-3);
}
.zcard-goods-price {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.zcard-price-symbol {
  font-size: 22rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-right: 2rpx;
}
.zcard-price-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a1a;
}
/* 划线原价：仅当确实高于现价时才有意义 */
.zcard-price-origin {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: var(--text-4);
  text-decoration: line-through;
}
/* 分类 / 成色标签 */
.zcard-goods-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}
.zcard-goods-tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  background: var(--surface-2);
  color: var(--text-2);
}
.zcard-goods-tag.mint {
  background: var(--success-50);
  color: var(--success-500);
}
/* 底部信息行：地址 / 浏览 / 想要 */
.zcard-goods-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* 吸底：多张卡片的分隔线与统计数字对齐，视觉更齐 */
  margin-top: auto;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
  font-size: 20rpx;
  line-height: 1;
  color: var(--text-4);
}
.zcard-goods-loc {
  min-width: 0;
  max-width: 220rpx;
}
.zcard-goods-stat {
  flex-shrink: 0;
}

/* 校园闲置区的分类子筛选 */
.zone-sub {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 14rpx;
}
.zone-sub-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}
.zone-sub-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 22rpx;
  color: #4b4b52;
  box-sizing: border-box;
}
.zone-sub-icon {
  font-size: 22rpx;
}

/* ===== 今日最热帖子卡 ===== */
.hot-card {
  margin: 0 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7fbf9 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx -6rpx rgba(0, 108, 73, 0.12);
  border: 1rpx solid rgba(0, 108, 73, 0.14);
}
.hot-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.hot-flame {
  font-size: 30rpx;
}
.hot-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #191c1e;
}
.hot-hint {
  font-size: 20rpx;
  color: var(--brand-500, #006C49);
  background: rgba(0, 108, 73, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.hot-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.hot-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}
.hot-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #191c1e;
  margin-right: 12rpx;
}
.hot-meta {
  font-size: 20rpx;
  color: #9b9ba3;
}
.hot-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
}
.hot-comment {
  position: relative;
  margin-top: 14rpx;
  background: var(--bg-page, #F5F7F6);
  border-radius: 16rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
}
.hot-like-badge {
  position: absolute;
  top: -14rpx;
  left: 20rpx;
  background: var(--like-500, #FF4D7D);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx 999rpx 999rpx 0;
  box-shadow: 0 4rpx 12rpx -2rpx rgba(255, 77, 125, 0.4);
}
.hot-comment-body {
  font-size: 25rpx;
  line-height: 1.6;
  color: #5b6472;
}
.hot-comment-name {
  color: var(--like-500, #FF4D7D);
  font-weight: 600;
}
.hot-comment-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* #话题 标签（热评卡内复用） */
.feed-topic {
  color: var(--brand-500, #006C49);
  font-weight: 600;
}
.feed-hover {
  background: #fcfcfd;
}

/* ===== 底部操作：胶囊图标 + 计数 ===== */
.feed-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #9b9ba3;
  font-size: 23rpx;
}
.feed-view {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: #8a8f99;
  font-size: 22rpx;
}
.feed-view .fa-icon {
  font-size: 24rpx;
  opacity: 0.8;
}
.fa-icon {
  font-size: 28rpx;
  line-height: 1;
}
.feed-act {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #6b6b73;
  font-size: 22rpx;
  transition: background 0.15s ease, color 0.15s ease;
}
.feed-act:active {
  background: #f4f5f7;
}
.feed-act.liked {
  color: var(--like-500, #FF4D7D);
  background: rgba(255, 77, 125, 0.1);
}
.feed-share {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: 0;
  padding: 8rpx 18rpx;
  background: transparent;
  border: none;
  border-radius: 999rpx;
  line-height: 1;
  font-size: 22rpx;
  color: #6b6b73;
}
.feed-share:active {
  background: #f4f5f7;
}
.feed-share::after {
  border: none;
}
.share-hover {
  opacity: 0.6;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}
