<view class="page">
  <!-- 顶部「浏览范围」行（默认整块不渲染）
       旧版是一整条 sticky 白栏 + 一枚胶囊：96rpx 独占一行、右侧全空、滚动时一直悬在顶上，
       但它对大多数用户没有决策价值（已绑学校 + 本校模式时就是个装饰）。
       现在只在这两种情况出现，跟随页面滚走：
         - onboard：还没绑学校 → 引导去选学校（本校筛选此时是退化的，必须提示）
         - city：已切到「本市」→ 显示城市，右侧给一键切回本校
       视觉沿用首页卡片语言：白底 + 24rpx 圆角 + shadow-1 + 品牌浅底图标块 + 品牌绿 CTA，
       不要做成裸文字行（没有承载块会显得像漏样式）。
       常驻入口搬到「我的 → 账户与服务 → 浏览范围」，功能不会丢。
       搜索框 / 铃铛同理：入口在闲置页与底栏 tab，需要恢复时把结构与 wxss 一并加回。 -->
  <view
    wx:if="{{scopeKind}}"
    class="scope-bar"
    bindtap="openScope"
    hover-class="scope-hover"
    hover-stay-time="60"
  >
    <view class="scope-ico">{{scopeKind === 'city' ? '🏙' : '🎓'}}</view>
    <text class="scope-main">{{scopeKind === 'onboard' ? '选择学校' : scopeLabel}}</text>
    <text class="scope-sub" wx:if="{{scopeKind === 'onboard'}}">只看本校内容</text>
    <view class="flex1"></view>
    <view class="scope-cta" wx:if="{{scopeKind === 'city'}}" catchtap="switchToSchool">切回本校</view>
    <view class="scope-cta" wx:else>
      <text>去选择</text>
      <text class="scope-arrow">›</text>
    </view>
  </view>

  <!-- 功能入口区已独立成页（底部「功能区」tab），首页不再放金刚区 -->

  <!--
    运营公告位：优先展示后台发布的公告（tap 进详情）；
    后台没发公告时退回原来的「跳蚤集市」默认卡，保证首屏不空缺。
  -->
  <view
    wx:if="{{notices.length}}"
    class="announce"
    bindtap="onNoticeTap"
    data-notice="{{notices[0]}}"
    hover-class="announce-hover"
    hover-stay-time="60"
  >
    <view class="announce-icon">{{notices[0].level === 3 ? '⚠️' : '📢'}}</view>
    <view class="announce-main">
      <view class="announce-title-row">
        <text class="announce-tag" wx:if="{{notices[0].level === 3}}">紧急</text>
        <text class="announce-tag" wx:elif="{{notices[0].level === 2}}">重要</text>
        <text class="announce-title">{{notices[0].title}}</text>
      </view>
      <!-- summary 在 JS 里截好：正文可能有几百字，直接塞进来会把首屏卡片撑高 -->
      <view class="announce-sub">{{notices[0].summary}}</view>
    </view>
    <!-- 公告只有详情页、没有列表页，所以这里固定是「详情」；
         以前按 notices.length > 1 显示「全部 ›」，点了却还是进第一条，属于误导 -->
    <view class="announce-btn">详情 ›</view>
  </view>

  <!-- 后台暂无公告时的默认运营位：闲置交换 -->
  <view wx:else class="announce" bindtap="onAnnounce" hover-class="announce-hover" hover-stay-time="60">
    <view class="announce-icon">♻️</view>
    <view class="announce-main">
      <view class="announce-title-row">
        <text class="announce-tag">毕业季</text>
        <text class="announce-title">闲置交换开放中</text>
      </view>
      <view class="announce-sub">仅做信息展示 · 校内当面看货、当面结清</view>
    </view>
    <view class="announce-btn">去逛逛 ›</view>
  </view>

  
  <!-- 运营 Banner：运营在后台「广告位管理」配置（code=home_banner），
       过审 + 上架 + 投放期内 + 定向命中才会返回；空数据整块不渲染，不留占位空白。 -->
       <swiper
    wx:if="{{banners.length}}"
    class="banner"
    style="height: {{bannerHeight}}rpx;"
    indicator-dots="{{banners.length > 1}}"
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
    autoplay="{{banners.length > 1}}"
    circular
    interval="5000"
    duration="400"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <!-- 宽度由 .banner-img（100%）统一控制，不要在行内写死 rpx -->
      <image
        class="banner-img"
        style="height: {{bannerHeight}}rpx;"
        src="{{item.image}}"
        mode="aspectFill"
        lazy-load
        data-ad="{{item}}"
        bindtap="onAdTap"
        binderror="onBannerError"
        data-index="{{index}}"
      />
    </swiper-item>
  </swiper>


  <!-- 内容功能区：每个模块一段单列全宽卡片（不分栏、不横向滚动），配置见 utils/zones.js -->
  <view class="zones">
    <view class="zone" wx:for="{{zones}}" wx:for-item="zone" wx:for-index="zi" wx:key="key">

      <!-- 模块标题 -->
      <view class="zone-head">
        <text class="zone-icon">{{zone.icon}}</text>
        <view class="zone-head-main">
          <text class="zone-title">{{zone.title}}</text>
          <text class="zone-desc">{{zone.desc}}</text>
        </view>
        <view class="zone-more" wx:if="{{zone.more}}" bindtap="goZoneMore" data-url="{{zone.more}}">更多 ›</view>
      </view>

      <!-- 今日最热：大卡（置顶视觉锚点） -->
      <block wx:if="{{zone.type === 'hot'}}">
        <view
          class="hot-card"
          wx:for="{{zone.items}}"
          wx:for-item="it"
          wx:for-index="ii"
          wx:key="key"
          bindtap="goZoneDetail"
          data-kind="{{it.kind}}"
          data-id="{{it.id}}"
          hover-class="feed-hover"
          hover-stay-time="60"
        >
          <view class="hot-head">
            <text class="hot-flame">🔥</text>
            <text class="hot-title">今日最热帖子</text>
            <view class="flex1"></view>
            <text class="hot-hint">点赞榜第一</text>
          </view>

          <view class="hot-user">
            <view class="hot-avatar" catchtap="goUserSpace" data-id="{{it.authorId}}">
              <image wx:if="{{it.avatar}}" class="hot-avatar-img" src="{{it.avatar}}" mode="aspectFill" />
              <view wx:else class="avatar-default">
                <view class="ad-head"></view>
                <view class="ad-body"></view>
              </view>
            </view>
            <view class="flex1" catchtap="goUserSpace" data-id="{{it.authorId}}">
              <text class="hot-name">{{it.authorName}}</text>
              <text class="hot-meta">{{it.badge}} · {{it.timeText}}</text>
            </view>
          </view>

          <view class="hot-text clamp3">
            <text class="feed-topic">#{{it.badge}}</text>
            <text wx:if="{{it.title}}"> {{it.title}} </text>
            <text>{{it.excerpt}}</text>
          </view>

          <!-- 图片网格：有照片才渲染，1 张放大 / 2、4 张两列 / 3 张及以上三列 -->
          <view
            class="wall-imgs {{it.imgGrid}}"
            wx:if="{{it.imageList.length}}"
          >
            <image
              class="wall-img"
              wx:for="{{it.imageList}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="{{it.imgMode}}"
              lazy-load
              catchtap="previewZoneImage"
              data-zi="{{zi}}"
              data-ii="{{ii}}"
              data-url="{{img}}"
            />
          </view>

          <!-- 热评预览 -->
          <view class="hot-comment" wx:if="{{it.hotComment}}">
            <view class="hot-like-badge">{{it.likeCount}}赞</view>
            <view class="hot-comment-body">
              <text class="hot-comment-name">{{it.hotComment.userName}}：</text>
              <text class="hot-comment-text">{{it.hotComment.content}}</text>
            </view>
          </view>

          <!-- 互动栏：一排完成（对齐 QQ 群的帖子底栏）——左「浏览 N」，右侧
               【点赞 / 评论 / 分享】三个线性图标靠右。点赞不再单独做胶囊：
               独立成行会让互动区分裂成两排，而它是卡片上唯一的点赞入口，
               必须和评论、分享同排才好点。 -->
          <view class="zfoot">
            <!-- 左槽位必须始终存在：它用 flex:1 吃掉剩余空间，右侧图标才能稳定贴右。
                 只靠 space-between + auto margin 时，一旦左侧不渲染（帖子没有浏览量），
                 图标会失准卡在中间 —— 这是实测撞出来的。 -->
            <view class="zfoot-left">
              <!-- 浏览数始终显示：四项（浏览 / 点赞 / 评论 / 分享）要齐全，
                   缺一项用户会以为信息没加载出来 -->
              <text class="zfoot-views">浏览 {{it.viewText}}</text>
            </view>
            <view class="zfoot-acts">
              <!-- 点赞：♡ / ♥ 文字符号（不用 emoji —— 颜色写死在字形里，没法按状态变色） -->
              <view class="zfoot-btn {{it.liked ? 'is-liked' : ''}}" catchtap="toggleZoneLike" data-zi="{{zi}}" data-ii="{{ii}}">
                <text class="zfoot-like">{{it.liked ? '♥' : '♡'}}</text>
                <text class="zfoot-num" wx:if="{{it.liked || it.likeCount > 0}}">{{it.likeText}}</text>
              </view>
              <!-- 评论：方泡内嵌数字（QQ 的那种「▢ 19」）。0 条时留空泡，与 QQ 一致 -->
              <view class="zfoot-btn" catchtap="goZoneDetail" data-kind="{{it.kind}}" data-id="{{it.id}}">
                <view class="zfoot-bubble">
                  <text>{{it.commentText}}</text>
                </view>
              </view>
              <!-- 分享：图标放外层、button 只做透明点击层。
                   原因：button 内置 width:184px 压得过页面 class，只要图标在 button 里，
                   它就会在这 184px 里居中 → 看起来永远贴不到右边缘。隔离后图标位置
                   由 wrap 决定，button 再怎么顽固都影响不到。 -->
              <view class="zfoot-share-wrap" hover-class="share-hover">
                <view class="zfoot-ico-share"></view>
                <button class="zfoot-share-hit" open-type="share" catchtap="noop" hover-class="none" data-id="{{it.id}}" data-kind="{{it.kind}}"></button>
              </view>
            </view>
          </view>
        </view>
      </block>

    </view>
  </view>

  <!--
    校园广场：一条混合时间流 + 顶部分类 tab。
    「全部」里混排帖子 / 树洞 / 闲置 / 需求，按发布时间倒序，推广帖单独置顶。
    固定 tab 对应四大内容模块，后面跟着后端在线频道（后台加频道这里自动多一个）。
  -->
  <view class="zone plaza">
    <view class="zone-head">
      <text class="zone-icon">🧭</text>
      <view class="zone-head-main">
        <text class="zone-title">校园广场</text>
        <text class="zone-desc">最新发布在前</text>
      </view>
      <view class="zone-more" bindtap="goPlazaMore">更多 ›</view>
    </view>

    <!-- 分类 tab：横向滚动，选中态用品牌色 + 下划线（不是胶囊，胶囊一屏只能放 3 个） -->
    <scroll-view class="ptabs" scroll-x="true" show-scrollbar="false" enhanced="{{true}}">
      <view class="ptabs-row">
        <view
          class="ptab {{plazaTab === t.key ? 'is-on' : ''}}"
          wx:for="{{plaza.tabs}}"
          wx:for-item="t"
          wx:key="key"
          bindtap="switchPlazaTab"
          data-key="{{t.key}}"
        >{{t.name}}</view>
      </view>
    </scroll-view>

    <!-- 频道 tab 的数据要单独拉，只给一条细提示，别用整页骨架闪一下 -->
    <view class="plaza-tip" wx:if="{{plazaLoading}}">加载中…</view>

    <view class="zone-list" wx:else>
      <view
        class="zcard {{it.kind === 'wall' ? 'zcard-wall' : (it.kind === 'goods' ? 'zcard-goods-wrap' : (it.kind === 'demand' ? 'zcard-demand' : 'zcard-post'))}}"
        wx:for="{{plaza.items}}"
        wx:for-item="it"
        wx:for-index="ii"
        wx:key="key"
        bindtap="goPlazaDetail"
        data-kind="{{it.kind}}"
        data-id="{{it.id}}"
        hover-class="zcard-hover"
        hover-stay-time="60"
      >
        <!-- 推广标：只有推广帖才出现，用户能一眼看出为什么它排在最前 -->
        <block wx:if="{{it.kind === 'post' && it.promoted}}">
          <view class="zcard-promote">推广</view>
        </block>

        <!-- ===== 树洞：匿名身份行 ===== -->
        <block wx:if="{{it.kind === 'wall'}}">
          <view class="zcard-user">
            <view class="zcard-avatar {{it.avatarClass}}">{{it.avatarEmoji}}</view>
            <view class="zcard-user-info">
              <view class="zcard-name-row">
                <text class="zcard-name">{{it.anonName}}</text>
                <text class="zcard-flair" wx:if="{{it.flair}}">{{it.flair}}</text>
              </view>
              <text class="zcard-meta">{{it.timeText}} · 匿名保护中</text>
            </view>
          </view>

          <view class="zcard-tags" wx:if="{{it.tags.length}}">
            <text class="zcard-tag" wx:for="{{it.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
          </view>

          <view class="zcard-excerpt clamp3">{{it.content}}</view>

          <view class="wall-imgs {{it.imgGrid}}" wx:if="{{it.imageList.length}}">
            <image
              class="wall-img"
              wx:for="{{it.imageList}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="{{it.imgMode}}"
              lazy-load
              catchtap="previewPlazaImage"
              data-idx="{{ii}}"
              data-url="{{img}}"
            />
          </view>
        </block>

        <!-- ===== 帖子 ===== -->
        <block wx:elif="{{it.kind === 'post'}}">
          <view class="zcard-top">
            <text class="zcard-badge">{{it.badge}}</text>
            <text class="zcard-time">{{it.timeText}}</text>
          </view>
          <view class="zcard-title clamp2">{{it.title}}</view>
          <view class="zcard-excerpt clamp2">{{it.excerpt}}</view>
          <view class="wall-imgs {{it.imgGrid}}" wx:if="{{it.imageList.length}}">
            <image
              class="wall-img"
              wx:for="{{it.imageList}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="{{it.imgMode}}"
              lazy-load
              catchtap="previewPlazaImage"
              data-idx="{{ii}}"
              data-url="{{img}}"
            />
          </view>
        </block>

        <!-- ===== 闲置 ===== -->
        <block wx:elif="{{it.kind === 'goods'}}">
          <!-- 结构改成「上横排（图 + 信息） + 下整行互动栏」：
               卡根原来是 flex row，底栏塞不进去（会被挤到图片右边的窄列里放不下四项），
               所以把横排收进 .zcard-goods，卡根改成 block 后底栏才能占满整行 -->
          <view class="zcard-goods">
            <view class="zcard-goods-thumb">
              <image wx:if="{{it.imageList.length}}" class="zcard-goods-img" src="{{it.imageList[0]}}" mode="aspectFill" />
              <view wx:else class="zcard-goods-img zcard-goods-blank">🛍️</view>
            </view>
            <view class="zcard-goods-body">
            <view class="zcard-goods-title clamp2">{{it.title}}</view>
            <view class="zcard-goods-desc clamp1" wx:if="{{it.excerpt}}">{{it.excerpt}}</view>
            <view class="zcard-goods-sell" wx:if="{{it.sellParts.length}}">
              <text
                class="zcard-goods-sell-t {{sp.cls}}"
                wx:for="{{it.sellParts}}"
                wx:for-item="sp"
                wx:key="k"
              >{{sp.v}}</text>
            </view>
            <view class="zcard-goods-feature">
              <text class="zcard-goods-feature-main">{{it.featureMain}}</text>
              <text class="zcard-goods-feature-sub">{{it.featureSub}}</text>
            </view>
            <view class="zcard-goods-price">
              <text class="zcard-price-symbol">¥</text>
              <text class="zcard-price-num">{{it.priceText}}</text>
              <text class="zcard-price-origin" wx:if="{{it.showOrigin}}">原价 ¥{{it.originalPriceText}}</text>
              <view class="flex1"></view>
              <view class="zcard-goods-cta">看详情</view>
            </view>
          </view>
        </view>
        </block>

        <!-- ===== 需求（求物 / 求帮忙）===== -->
        <block wx:else>
          <view class="zcard-top">
            <text class="zcard-badge zcard-badge-demand">{{it.typeIcon}} {{it.typeLabel}}</text>
            <text class="zcard-time">{{it.timeText}}</text>
          </view>
          <!-- 标题行：标题占满剩余宽度，预算贴右。
               预算放右侧而不是单起一行 —— 单独一行会让需求卡比帖子卡高出一大截，
               在混合时间流里显得突兀，也让「多少钱」这个最该被扫到的信息远离标题 -->
          <view class="zd-row">
            <view class="zcard-title clamp2 zd-main">{{it.title}}</view>
            <text class="zd-budget" wx:if="{{it.budgetText}}">{{it.budgetText}}</text>
          </view>
          <view class="zd-row">
            <view class="zcard-excerpt clamp2 zd-main">{{it.excerpt}}</view>
            <text class="zd-chip zd-inline" wx:if="{{it.expectTime}}">⏰ {{it.expectTime}}</text>
          </view>
          <!-- 只剩地点：分类已经显示在顶部徽标旁，不重复占位 -->
          <view class="zcard-demand-meta" wx:if="{{it.location}}">
            <text class="zd-chip">📍 {{it.location}}</text>
          </view>
          <view class="wall-imgs {{it.imgGrid}}" wx:if="{{it.imageList.length}}">
            <image
              class="wall-img"
              wx:for="{{it.imageList}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="{{it.imgMode}}"
              lazy-load
              catchtap="previewPlazaImage"
              data-idx="{{ii}}"
              data-url="{{img}}"
            />
          </view>
        </block>

        <!-- 互动栏：与上方「今日最热」完全同一套（左浏览 / 右三个线性图标）。
             闲置卡也要有 —— 它内嵌的「35 浏览」已移到这一排，不再重复显示。 -->
        <block>
          <view class="zfoot">
            <!-- 左槽位始终存在（理由见上方今日最热卡同处注释） -->
            <view class="zfoot-left">
              <text class="zfoot-views">浏览 {{it.viewText}}</text>
            </view>
            <view class="zfoot-acts">
              <!-- 需求也能点赞（和帖子/树洞同一套），只有回应数是需求专属 -->
              <view
                class="zfoot-btn {{it.liked ? 'is-liked' : ''}}"
                catchtap="togglePlazaLike"
                data-idx="{{ii}}"
              >
                <text class="zfoot-like">{{it.liked ? '♥' : '♡'}}</text>
                <text class="zfoot-num" wx:if="{{it.liked || it.likeCount > 0}}">{{it.likeText}}</text>
              </view>
              <!-- 评论数：四类卡片统一取 commentText（需求也有评论了） -->
              <view class="zfoot-btn" catchtap="goPlazaDetail" data-kind="{{it.kind}}" data-id="{{it.id}}">
                <view class="zfoot-bubble">
                  <text>{{it.commentText}}</text>
                </view>
              </view>
              <!-- 分享：图标在外层、button 只做透明点击层（理由见上方今日最热卡同处注释） -->
              <view class="zfoot-share-wrap" hover-class="share-hover">
                <view class="zfoot-ico-share"></view>
                <button class="zfoot-share-hit" open-type="share" catchtap="noop" hover-class="none" data-id="{{it.id}}" data-kind="{{it.kind}}"></button>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="plaza-tip" wx:if="{{!plazaLoading && plaza.empty}}">这个分类还没有内容，换个看看 ›</view>
  </view>

  <view class="empty" wx:if="{{!loading && !zones.length && !plaza.items.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '📭'}}</text>
    <text>{{loadError ? (errorMsg || '加载失败，请检查后端服务') : '暂时还没有内容'}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <!-- 浏览范围切换：本校 / 本市（+ 定位城市） -->
  <scope-sheet
    show="{{scopeShow}}"
    school-name="{{(user && user.schoolName) || ''}}"
    school-city="{{schoolCity || ''}}"
    geo-city="{{geoCity}}"
    current="{{scopeMode}}"
    current-city="{{scopeCity || ''}}"
    bind:close="closeScope"
    bind:select="onScopeSelect"
    bind:verify="onScopeVerify"
  />

  <!-- 新用户引导：还没落学校时首次进入先选学校（不要求学籍认证） -->
  <school-onboard
    show="{{onboardShow}}"
    saving="{{onboardSaving}}"
    bind:select="onOnboardSelect"
    bind:close="onOnboardClose"
  />

  <!-- 后台公告弹窗：频次（每次进入 / 每天一次 / 确认后不再显示）由 admin 选择，
       该不该弹在 utils/notice.js 里判定，这里只管显示 -->
  <notice-popup
    visible="{{popupVisible}}"
    notice="{{popup}}"
    bind:close="closePopup"
    bind:confirm="onPopupConfirm"
  />
</view>
