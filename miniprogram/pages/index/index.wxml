<view class="page">
  <!-- 顶部「浏览范围」行（默认整块不渲染）
       旧版是一整条 sticky 白栏 + 一枚胶囊：96rpx 独占一行、右侧全空、滚动时一直悬在顶上，
       但它对大多数用户没有决策价值（已绑学校 + 本校模式时就是个装饰）。
       现在只在这两种情况出现，跟随页面滚走：
         - onboard：还没绑学校 → 引导去选学校（本校筛选此时是退化的，必须提示）
         - city：已切到「本市」→ 显示城市，右侧给一键切回本校
       视觉沿用首页卡片语言：白底 + 24rpx 圆角 + shadow-1 + 品牌浅底图标块 + 品牌绿 CTA，
       不要做成裸文字行（没有承载块会显得像漏样式）。
       常驻入口搬到「我的 → 账户与服务 → 浏览范围」，功能不会丢。
       搜索框 / 铃铛同理：入口在闲置页与底栏 tab，需要恢复时把结构与 wxss 一并加回。 -->
  <view
    wx:if="{{scopeKind}}"
    class="scope-bar"
    bindtap="openScope"
    hover-class="scope-hover"
    hover-stay-time="60"
  >
    <view class="scope-ico">{{scopeKind === 'city' ? '🏙' : '🎓'}}</view>
    <text class="scope-main">{{scopeKind === 'onboard' ? '选择学校' : scopeLabel}}</text>
    <text class="scope-sub" wx:if="{{scopeKind === 'onboard'}}">只看本校内容</text>
    <view class="flex1"></view>
    <view class="scope-cta" wx:if="{{scopeKind === 'city'}}" catchtap="switchToSchool">切回本校</view>
    <view class="scope-cta" wx:else>
      <text>去选择</text>
      <text class="scope-arrow">›</text>
    </view>
  </view>

  <!-- 功能入口区已独立成页（底部「功能区」tab），首页不再放金刚区 -->

  <!--
    运营公告位：优先展示后台发布的公告（tap 进详情）；
    后台没发公告时退回原来的「跳蚤集市」默认卡，保证首屏不空缺。
  -->
  <view
    wx:if="{{notices.length}}"
    class="announce"
    bindtap="onNoticeTap"
    data-notice="{{notices[0]}}"
    hover-class="announce-hover"
    hover-stay-time="60"
  >
    <view class="announce-icon">{{notices[0].level === 3 ? '⚠️' : '📢'}}</view>
    <view class="announce-main">
      <view class="announce-title-row">
        <text class="announce-tag" wx:if="{{notices[0].level === 3}}">紧急</text>
        <text class="announce-tag" wx:elif="{{notices[0].level === 2}}">重要</text>
        <text class="announce-title">{{notices[0].title}}</text>
      </view>
      <!-- summary 在 JS 里截好：正文可能有几百字，直接塞进来会把首屏卡片撑高 -->
      <view class="announce-sub">{{notices[0].summary}}</view>
    </view>
    <!-- 公告只有详情页、没有列表页，所以这里固定是「详情」；
         以前按 notices.length > 1 显示「全部 ›」，点了却还是进第一条，属于误导 -->
    <view class="announce-btn">详情 ›</view>
  </view>

  <!-- 后台暂无公告时的默认运营位：闲置交换 -->
  <view wx:else class="announce" bindtap="onAnnounce" hover-class="announce-hover" hover-stay-time="60">
    <view class="announce-icon">♻️</view>
    <view class="announce-main">
      <view class="announce-title-row">
        <text class="announce-tag">毕业季</text>
        <text class="announce-title">闲置交换开放中</text>
      </view>
      <view class="announce-sub">仅做信息展示 · 校内当面看货、当面结清</view>
    </view>
    <view class="announce-btn">去逛逛 ›</view>
  </view>

  
  <!-- 运营 Banner：运营在后台「广告位管理」配置（code=home_banner），
       过审 + 上架 + 投放期内 + 定向命中才会返回；空数据整块不渲染，不留占位空白。 -->
       <swiper
    wx:if="{{banners.length}}"
    class="banner"
    indicator-dots="{{banners.length > 1}}"
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
    autoplay="{{banners.length > 1}}"
    circular
    interval="5000"
    duration="400"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <!-- 宽度由 .banner-img（100%）统一控制，不要在行内写死 rpx -->
      <image
        class="banner-img"
        src="{{item.image}}"
        mode="aspectFill"
        lazy-load
        data-ad="{{item}}"
        bindtap="onAdTap"
        binderror="onBannerError"
        data-index="{{index}}"
      />
    </swiper-item>
  </swiper>


  <!-- 内容功能区：每个模块一段单列全宽卡片（不分栏、不横向滚动），配置见 utils/zones.js -->
  <view class="zones">
    <view class="zone" wx:for="{{zones}}" wx:for-item="zone" wx:for-index="zi" wx:key="key">

      <!-- 模块标题 -->
      <view class="zone-head">
        <text class="zone-icon">{{zone.icon}}</text>
        <view class="zone-head-main">
          <text class="zone-title">{{zone.title}}</text>
          <text class="zone-desc">{{zone.desc}}</text>
        </view>
        <view class="zone-more" wx:if="{{zone.more}}" bindtap="goZoneMore" data-url="{{zone.more}}">更多 ›</view>
      </view>

      <!-- 今日最热：大卡（置顶视觉锚点） -->
      <block wx:if="{{zone.type === 'hot'}}">
        <view
          class="hot-card"
          wx:for="{{zone.items}}"
          wx:for-item="it"
          wx:for-index="ii"
          wx:key="key"
          bindtap="goZoneDetail"
          data-kind="{{it.kind}}"
          data-id="{{it.id}}"
          hover-class="feed-hover"
          hover-stay-time="60"
        >
          <view class="hot-head">
            <text class="hot-flame">🔥</text>
            <text class="hot-title">今日最热帖子</text>
            <view class="flex1"></view>
            <text class="hot-hint">点赞榜第一</text>
          </view>

          <view class="hot-user">
            <view class="hot-avatar" catchtap="goUserSpace" data-id="{{it.authorId}}">
              <image wx:if="{{it.avatar}}" class="hot-avatar-img" src="{{it.avatar}}" mode="aspectFill" />
              <view wx:else class="avatar-default">
                <view class="ad-head"></view>
                <view class="ad-body"></view>
              </view>
            </view>
            <view class="flex1" catchtap="goUserSpace" data-id="{{it.authorId}}">
              <text class="hot-name">{{it.authorName}}</text>
              <text class="hot-meta">{{it.badge}} · {{it.timeText}}</text>
            </view>
          </view>

          <view class="hot-text clamp3">
            <text class="feed-topic">#{{it.badge}}</text>
            <text wx:if="{{it.title}}"> {{it.title}} </text>
            <text>{{it.excerpt}}</text>
          </view>

          <!-- 热评预览 -->
          <view class="hot-comment" wx:if="{{it.hotComment}}">
            <view class="hot-like-badge">{{it.likeCount}}赞</view>
            <view class="hot-comment-body">
              <text class="hot-comment-name">{{it.hotComment.userName}}：</text>
              <text class="hot-comment-text">{{it.hotComment.content}}</text>
            </view>
          </view>

          <view class="feed-actions">
            <!-- 后端 Post 没有 view_count 字段，没有浏览数时整块不显示（避免出现「👁 0」） -->
            <view class="feed-view" wx:if="{{it.viewCount}}">
              <text class="fa-icon">👁</text>
              <text>{{it.viewText}}</text>
            </view>
            <view class="flex1"></view>
            <view class="feed-act {{it.liked ? 'liked' : ''}}" catchtap="toggleZoneLike" data-zi="{{zi}}" data-ii="{{ii}}">
              <text class="fa-icon">{{it.liked ? '💚' : '👍'}}</text>
              <text>{{it.likeText}}</text>
            </view>
            <view class="feed-act" catchtap="goZoneDetail" data-kind="{{it.kind}}" data-id="{{it.id}}">
              <text class="fa-icon">💬</text>
              <text>{{it.commentText}}</text>
            </view>
            <button class="feed-share" open-type="share" catchtap="noop" hover-class="share-hover" style="width: 58rpx; display: flex; box-sizing: border-box; left: 0rpx; top: 0rpx">
              <text class="fa-icon">↗</text>
            </button>
          </view>
        </view>
      </block>

      <!-- 帖子型（校园公告 / 校园生活） -->
      <block wx:if="{{zone.type === 'post'}}">
        <view class="zone-list">
          <view
            class="zcard zcard-post"
            wx:for="{{zone.items}}"
            wx:for-item="it"
            wx:for-index="ii"
            wx:key="key"
            bindtap="goZoneDetail"
            data-kind="{{it.kind}}"
            data-id="{{it.id}}"
            hover-class="zcard-hover"
            hover-stay-time="60"
          >
            <view class="zcard-top">
              <text class="zcard-badge">{{it.badge}}</text>
              <text class="zcard-time">{{it.timeText}}</text>
            </view>
            <view class="zcard-title clamp2">{{it.title}}</view>
            <view class="zcard-excerpt clamp2">{{it.excerpt}}</view>
            <view class="zcard-foot">
              <view class="zcard-act" catchtap="toggleZoneLike" data-zi="{{zi}}" data-ii="{{ii}}">
                <text class="zcard-act-icon {{it.liked ? 'is-liked' : ''}}">{{it.liked ? '💚' : '👍'}}</text>
                <text>{{it.likeText}}</text>
              </view>
              <view class="zcard-act" catchtap="goZoneDetail" data-kind="{{it.kind}}" data-id="{{it.id}}">
                <text class="zcard-act-icon">💬</text>
                <text>{{it.commentText}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 树洞闲谈：匿名心事卡片（排版与上方「今日最热 / 帖子」一致：头像行 + 正文 + 配图 + 底部操作条） -->
      <block wx:if="{{zone.type === 'wall'}}">
        <view class="zone-list">
          <view
            class="zcard zcard-wall"
            wx:for="{{zone.items}}"
            wx:for-item="it"
            wx:for-index="ii"
            wx:key="key"
            bindtap="goZoneDetail"
            data-kind="{{it.kind}}"
            data-id="{{it.id}}"
            hover-class="zcard-hover"
            hover-stay-time="60"
          >
            <!-- 顶部：匿名身份行（头像 emoji / 昵称 / 徽标 / 时间） -->
            <view class="zcard-user">
              <view class="zcard-avatar {{it.avatarClass}}">{{it.avatarEmoji}}</view>
              <view class="zcard-user-info">
                <view class="zcard-name-row">
                  <text class="zcard-name">{{it.anonName}}</text>
                  <text class="zcard-flair" wx:if="{{it.flair}}">{{it.flair}}</text>
                </view>
                <text class="zcard-meta">{{it.timeText}} · 匿名保护中</text>
              </view>
            </view>

            <!-- 话题标签 -->
            <view class="zcard-tags" wx:if="{{it.tags.length}}">
              <text class="zcard-tag" wx:for="{{it.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
            </view>

            <!-- 正文：浅底色块，即使只有一行也有视觉重量，不会显得空 -->
            <view class="zcard-excerpt clamp3">{{it.content}}</view>

            <!-- 配图：九宫格，无图不渲染；1 张放大、2/4 张两列、其余三列 -->
            <view
              class="wall-imgs {{it.imageList.length === 1 ? 'cols-1' : (it.imageList.length === 2 || it.imageList.length === 4 ? 'cols-2' : 'cols-3')}}"
              wx:if="{{it.imageList.length}}"
            >
              <image
                class="wall-img"
                wx:for="{{it.imageList}}"
                wx:for-item="img"
                wx:key="*this"
                src="{{img}}"
                mode="aspectFill"
                lazy-load
              />
            </view>

            <!-- 底部操作条：仅保留点赞（左对齐，与帖子卡一致：扁平图标 + 计数，无分隔线） -->
            <view class="wall-foot">
              <view class="zcard-act" catchtap="toggleZoneLike" data-zi="{{zi}}" data-ii="{{ii}}">
                <text class="zcard-act-icon {{it.liked ? 'is-liked' : ''}}">{{it.liked ? '💚' : '👍'}}</text>
                <text>{{it.likeText}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 校园闲置：带分类子筛选 -->
      <block wx:if="{{zone.type === 'goods'}}">
        <scroll-view class="zone-sub" scroll-x="true" show-scrollbar="false">
          <view class="zone-sub-row">
            <view class="zone-sub-pill" bindtap="goCategory" data-id="">🔥 全部</view>
            <view
              class="zone-sub-pill"
              wx:for="{{categories}}"
              wx:key="id"
              bindtap="goCategory"
              data-id="{{item.id}}"
            >
              <text class="zone-sub-icon">{{item.icon}}</text>
              <text>{{item.name}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="zone-list">
          <view
            class="zcard zcard-goods"
            wx:for="{{zone.items}}"
            wx:for-item="it"
            wx:for-index="ii"
            wx:key="key"
            bindtap="goZoneDetail"
            data-kind="{{it.kind}}"
            data-id="{{it.id}}"
            hover-class="zcard-hover"
            hover-stay-time="60"
          >
            <!-- 图片容器：定宽不写死高，随右侧文字区一起拉高，图下方不留白边 -->
            <view class="zcard-goods-thumb">
              <image wx:if="{{it.imageList.length}}" class="zcard-goods-img" src="{{it.imageList[0]}}" mode="aspectFill" />
              <view wx:else class="zcard-goods-img zcard-goods-blank">🛍️</view>
            </view>
            <view class="zcard-goods-body">
              <view class="zcard-goods-title clamp2">{{it.title}}</view>
              <!-- 描述摘要：标题短时把卡片撑起来，长描述只留一行 -->
              <view class="zcard-goods-desc clamp1" wx:if="{{it.excerpt}}">{{it.excerpt}}</view>
              <!-- 价格紧跟描述：价格是这张卡的核心信息，不能被推到最底下 -->
              <view class="zcard-goods-price">
                <text class="zcard-price-symbol">¥</text>
                <text class="zcard-price-num">{{it.priceText}}</text>
                <!-- 划线原价：只有确实比现价高才显示，否则「原价 = 现价」是噪音 -->
                <text class="zcard-price-origin" wx:if="{{it.showOrigin}}">原价 ¥{{it.originalPriceText}}</text>
              </view>
              <!-- 标签行：分类 + 成色 -->
              <view class="zcard-goods-tags">
                <text class="zcard-goods-tag" wx:if="{{it.categoryName}}">{{it.categoryName}}</text>
                <text class="zcard-goods-tag mint" wx:if="{{it.conditionText}}">{{it.conditionText}}</text>
              </view>
              <!-- 底部信息行：地址 / 浏览 / 想要（吸底对齐，两张卡视觉齐平） -->
              <view class="zcard-goods-foot">
                <text class="zcard-goods-loc ellipsis">📍 {{it.location || '校内自提'}}</text>
                <view class="flex1"></view>
                <text class="zcard-goods-stat">👁 {{it.viewText}}</text>
                <text class="zcard-goods-stat">💗 {{it.likeText}}想要</text>
              </view>
            </view>
          </view>
        </view>
      </block>

    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !zones.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '📭'}}</text>
    <text>{{loadError ? (errorMsg || '加载失败，请检查后端服务') : '暂时还没有内容'}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <!-- 浏览范围切换：本校 / 本市（+ 定位城市） -->
  <scope-sheet
    show="{{scopeShow}}"
    school-name="{{(user && user.schoolName) || ''}}"
    school-city="{{schoolCity || ''}}"
    geo-city="{{geoCity}}"
    current="{{scopeMode}}"
    current-city="{{scopeCity || ''}}"
    bind:close="closeScope"
    bind:select="onScopeSelect"
    bind:verify="onScopeVerify"
  />

  <!-- 新用户引导：还没落学校时首次进入先选学校（不要求学籍认证） -->
  <school-onboard
    show="{{onboardShow}}"
    saving="{{onboardSaving}}"
    bind:select="onOnboardSelect"
    bind:close="onOnboardClose"
  />

  <!-- 后台公告弹窗：频次（每次进入 / 每天一次 / 确认后不再显示）由 admin 选择，
       该不该弹在 utils/notice.js 里判定，这里只管显示 -->
  <notice-popup
    visible="{{popupVisible}}"
    notice="{{popup}}"
    bind:close="closePopup"
    bind:confirm="onPopupConfirm"
  />
</view>
