<view class="page">
  <!-- 顶部：范围胶囊（本校/本市） + 搜索 + 通知 -->
  <view class="topbar">
    <view class="school-pill" bindtap="openScope">
      <text class="school-name">{{scopeLabel}}</text>
      <text class="school-arrow">▾</text>
    </view>
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜帖子、闲置好物...</text>
    </view>
    <view class="bell-btn" bindtap="goMessages">
      <text class="bell-icon">🔔</text>
      <view class="bell-dot" wx:if="{{unread > 0}}"></view>
    </view>
  </view>

  <!-- 频道导航 -->
  <scroll-view class="nav-scroll" scroll-x="true" show-scrollbar="false">
    <view class="nav-row">
      <view class="nav-item {{!channelId ? 'active' : ''}}" bindtap="switchChannel" data-id="">全部</view>
      <view
        class="nav-item {{channelId === item.id ? 'active' : ''}}"
        wx:for="{{channels}}"
        wx:key="id"
        bindtap="switchChannel"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 分类横滑 -->
  <scroll-view class="cat-scroll" scroll-x="true" show-scrollbar="false">
    <view class="cat-row">
      <view class="cat-pill active" bindtap="goCategory" data-id="">🔥 今日热门</view>
      <view class="cat-pill" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
        <text class="cat-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 运营公告位：跳蚤集市 -->
  <view class="announce" bindtap="onAnnounce" hover-class="announce-hover" hover-stay-time="60">
    <view class="announce-icon">🛍️</view>
    <view class="announce-main">
      <view class="announce-title-row">
        <text class="announce-tag">毕业季</text>
        <text class="announce-title">跳蚤集市已开启</text>
      </view>
      <view class="announce-sub">校园闲置交易平台 低价买卖与无忧保障</view>
    </view>
    <view class="announce-btn">去逛逛 ›</view>
  </view>

  <!-- 最热帖子：全站点赞第一（点赞 > 10 才展示） -->
  <view class="hot-card" wx:if="{{hotPost}}" bindtap="goDetail" data-type="post" data-id="{{hotPost.id}}" hover-class="feed-hover" hover-stay-time="60">
    <view class="hot-head">
      <text class="hot-flame">🔥</text>
      <text class="hot-title">今日最热帖子</text>
      <view class="flex1"></view>
      <text class="hot-hint">点赞榜第一</text>
    </view>

    <view class="hot-user">
      <view class="hot-avatar" catchtap="goUserSpace" data-id="{{hotPost.authorId}}">
        <image wx:if="{{hotPost.avatar}}" class="hot-avatar-img" src="{{hotPost.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-default">
          <view class="ad-head"></view>
          <view class="ad-body"></view>
        </view>
      </view>
      <view class="flex1" catchtap="goUserSpace" data-id="{{hotPost.authorId}}">
        <text class="hot-name">{{hotPost.authorName}}</text>
        <text class="hot-meta">{{hotPost.badge}} · {{hotPost.timeText}}</text>
      </view>
    </view>

    <view class="hot-text clamp3">
      <text class="feed-topic">#{{hotPost.badge}}</text>
      <text wx:if="{{hotPost.title}}"> {{hotPost.title}} </text>
      <text>{{hotPost.excerpt}}</text>
    </view>

    <!-- 热评预览 -->
    <view class="hot-comment" wx:if="{{hotComment}}">
      <view class="hot-like-badge">{{hotPost.likeCount}}赞</view>
      <view class="hot-comment-body">
        <text class="hot-comment-name">{{hotComment.userName}}：</text>
        <text class="hot-comment-text">{{hotComment.content}}</text>
      </view>
    </view>

    <view class="feed-actions">
      <view class="feed-view">
        <text class="fa-icon">👁</text>
        <text>{{hotPost.viewText}}</text>
      </view>
      <view class="flex1"></view>
      <view class="feed-act {{hotPost.liked ? 'liked' : ''}}" catchtap="likeHot">
        <text class="fa-icon">{{hotPost.liked ? '💚' : '👍'}}</text>
        <text>{{hotPost.likeText}}</text>
      </view>
      <view class="feed-act" catchtap="goDetail" data-type="post" data-id="{{hotPost.id}}">
        <text class="fa-icon">💬</text>
        <text>{{hotPost.commentText}}</text>
      </view>
      <button class="feed-share" open-type="share" catchtap="noop" hover-class="share-hover" style="width: 77rpx; display: flex; box-sizing: border-box; left: 0rpx; top: 0rpx">
        <text class="fa-icon">↗</text>
      </button>
    </view>
  </view>

  <!-- 信息流 -->
  <view class="feed">
    <view
      class="feed-item"
      wx:for="{{feed}}"
      wx:key="key"
      bindtap="goDetail"
      data-type="{{item.type}}"
      data-id="{{item.id}}"
      hover-class="feed-hover"
      hover-stay-time="60"
    >
      <!-- 作者行：头像 + 昵称 + 标签/关注（头像与昵称区 catchtap 阻止冒泡到卡片详情跳转） -->
      <view class="feed-user">
        <view class="feed-avatar" catchtap="goUserSpace" data-id="{{item.authorId}}">
          <image wx:if="{{item.avatar}}" class="feed-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar-default">
            <view class="ad-head"></view>
            <view class="ad-body"></view>
          </view>
        </view>
        <view class="feed-user-info" catchtap="goUserSpace" data-id="{{item.authorId}}">
          <view class="feed-name-row">
            <text class="feed-name">{{item.authorName}}</text>
            <text wx:if="{{item.scopeBadge}}" class="scope-badge {{item.scopeBadge === '同校' ? 'scope-school' : 'scope-city'}}">{{item.scopeBadge}}</text>
          </view>
          <view class="feed-meta">
            <text class="feed-chip {{item.type === 'post' ? 'chip-amber' : 'chip-green'}}">{{item.badge}}</text>
            <text class="feed-time">{{item.timeText}}</text>
          </view>
        </view>
        <text class="feed-status" wx:if="{{item.type === 'goods'}}">闲置中</text>
        <view class="follow-btn" wx:else catchtap="onFollow" data-id="{{item.authorId}}">
          {{followedAuthors[item.authorId].following ? '已关注' : '+ 关注'}}
        </view>
      </view>

      <!-- 正文主体：单图时右侧缩略图 -->
      <view class="feed-body {{item.imageList.length === 1 ? 'with-thumb' : ''}}">
        <view class="feed-body-main">
          <view class="feed-text clamp3">
            <text class="feed-topic">#{{item.topic}}</text>
            <text wx:if="{{item.title}}"> {{item.title}} </text>
            <text>{{item.excerpt}}</text>
          </view>
          <view class="feed-price" wx:if="{{item.type === 'goods'}}">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{item.priceText}}</text>
            <text class="price-origin" wx:if="{{item.originalPriceText}}">¥{{item.originalPriceText}}</text>
            <text class="feed-loc" wx:if="{{item.location}}">📍 {{item.location}}</text>
          </view>
        </view>
        <image
          wx:if="{{item.imageList.length === 1}}"
          class="feed-thumb"
          src="{{item.imageList[0]}}"
          mode="aspectFill"
          catchtap="previewFeed"
          data-fi="{{index}}"
          data-url="{{item.imageList[0]}}"
        />
      </view>

      <!-- 多图：三列横排，超出显示 +N -->
      <view class="feed-imgs" wx:if="{{item.imageList.length > 1}}">
        <view
          class="feed-img-wrap"
          wx:for="{{item.imageList}}"
          wx:for-item="img"
          wx:for-index="ii"
          wx:key="*this"
        >
          <image
            class="feed-img"
            src="{{img}}"
            mode="aspectFill"
            catchtap="previewFeed"
            data-fi="{{index}}"
            data-url="{{img}}"
          />
          <view class="img-more" wx:if="{{ii === 2 && item.imageList.length > 3}}">+{{item.imageList.length - 3}}</view>
        </view>
      </view>

      <!-- 附件卡片（如学习资料） -->
      <view class="attach-card" wx:if="{{item.attachment}}" catchtap="onAttachment">
        <view class="attach-icon">📄</view>
        <view class="attach-info">
          <text class="attach-name ellipsis">{{item.attachment.name}}</text>
          <text class="attach-meta">{{item.attachment.size}} · 已下载 {{item.attachment.downloads}} 次</text>
        </view>
        <text class="attach-down">⬇</text>
      </view>

      <!-- 底部：浏览 / 赞 / 评 / 分享 -->
      <view class="feed-actions">
        <view class="feed-view" wx:if="{{item.viewCount}}">
          <text class="fa-icon">👁</text>
          <text>{{item.viewText}}</text>
        </view>
        <view class="flex1"></view>
        <view class="feed-act {{item.liked ? 'liked' : ''}}" catchtap="toggleLike" data-index="{{index}}">
          <text class="fa-icon">{{item.liked ? '💚' : '👍'}}</text>
          <text>{{item.likeText}}</text>
        </view>
        <view class="feed-act" catchtap="goComments" data-type="{{item.type}}" data-id="{{item.id}}">
          <text class="fa-icon">💬</text>
          <text>{{item.commentText}}</text>
        </view>
        <button class="feed-share" open-type="share" catchtap="noop" hover-class="share-hover" style="width: 58rpx; display: flex; box-sizing: border-box; left: 0rpx; top: 0rpx">
          <text class="fa-icon">↗</text>
        </button>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !feed.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '📭'}}</text>
    <text>{{loadError ? (errorMsg || '加载失败，请检查后端服务') : '这个频道还没有内容，去发第一条吧'}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <view class="list-end" wx:if="{{feed.length && !loading}}">已经到底啦，点击右下方「＋」发布你的新动态吧</view>

  <!-- 浏览范围切换：本校 / 本市（+ 定位城市） -->
  <scope-sheet
    show="{{scopeShow}}"
    school-name="{{user.schoolName}}"
    school-city="{{schoolCity}}"
    geo-city="{{geoCity}}"
    current="{{scopeMode}}"
    current-city="{{scopeCity}}"
    bind:close="closeScope"
    bind:select="onScopeSelect"
    bind:verify="onScopeVerify"
  />
</view>
