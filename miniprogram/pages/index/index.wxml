<view class="page">
  <!-- 顶部搜索栏 -->
  <view class="topbar">
    <view class="topbar-avatar" bindtap="goStatus">
      <image wx:if="{{user && user.avatar}}" class="topbar-avatar-img" src="{{user.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar-default">
        <view class="ad-head"></view>
        <view class="ad-body"></view>
      </view>
    </view>
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜闲置、帖子、同学</text>
    </view>
    <view class="msg-btn" bindtap="goMessages">✉️</view>
  </view>

  <!-- 频道导航 -->
  <scroll-view class="nav-scroll" scroll-x="true" show-scrollbar="false">
    <view class="nav-row">
      <view class="nav-item {{!channelId ? 'active' : ''}}" bindtap="switchChannel" data-id="">推荐</view>
      <view
        class="nav-item {{channelId === item.id ? 'active' : ''}}"
        wx:for="{{channels}}"
        wx:key="id"
        bindtap="switchChannel"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 分类横滑 -->
  <scroll-view class="cat-scroll" scroll-x="true" show-scrollbar="false">
    <view class="cat-row">
      <view class="cat-pill active" bindtap="goCategory" data-id="">今日热门</view>
      <view class="cat-pill" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
        <text>{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 信息流 -->
  <view class="feed">
    <view
      class="feed-item"
      wx:for="{{feed}}"
      wx:key="key"
      bindtap="goDetail"
      data-type="{{item.type}}"
      data-id="{{item.id}}"
      hover-class="feed-hover"
      hover-stay-time="60"
    >
      <view class="feed-user">
        <view class="feed-avatar">
          <image wx:if="{{item.avatar}}" class="feed-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar-default">
            <view class="ad-head"></view>
            <view class="ad-body"></view>
          </view>
        </view>
        <view class="feed-user-info">
          <view class="feed-name">{{item.authorName}}</view>
          <view class="feed-meta">
            <text>{{item.timeText}}</text>
            <text class="feed-device">{{item.badgeIcon}} {{item.badge}}</text>
          </view>
        </view>
        <text class="feed-type" wx:if="{{item.type === 'goods'}}">闲置</text>
      </view>

      <view class="feed-text clamp3">
        <text class="feed-title" wx:if="{{item.title}}">{{item.title}}</text>
        <text>{{item.excerpt}}</text>
      </view>

      <view class="feed-price" wx:if="{{item.type === 'goods'}}">
        <text class="price-symbol">¥</text>{{item.priceText}}
        <text class="feed-loc" wx:if="{{item.location}}">{{item.location}}</text>
      </view>

      <view class="feed-imgs" wx:if="{{item.imageList.length}}">
        <view
          class="feed-img-wrap {{item.imageList.length === 1 ? 'single' : (item.imageList.length === 2 ? 'double' : '')}}"
          wx:for="{{item.imageList}}"
          wx:for-item="img"
          wx:for-index="ii"
          wx:key="*this"
        >
          <image
            class="feed-img"
            src="{{img}}"
            mode="aspectFill"
            catchtap="previewFeed"
            data-fi="{{index}}"
            data-url="{{img}}"
          />
        </view>
      </view>

      <view class="feed-actions">
        <view class="feed-action {{item.liked ? 'liked' : ''}}" catchtap="toggleLike" data-index="{{index}}">
          <text class="feed-action-icon">👍</text>
          <text>{{item.likeCount ? item.likeCount : '点赞'}}</text>
        </view>
        <view class="feed-action ml40" catchtap="goComments" data-type="{{item.type}}" data-id="{{item.id}}">
          <text class="feed-action-icon">💬</text>
          <text>{{item.commentCount ? item.commentCount : '评论'}}</text>
        </view>
        <view class="flex1"></view>
        <text class="feed-more" catchtap="goDetail" data-type="{{item.type}}" data-id="{{item.id}}">详情 ›</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !feed.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '📭'}}</text>
    <text>{{loadError ? (errorMsg || '加载失败，请检查后端服务') : '这个频道还没有内容，去发第一条吧'}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <view class="list-end" wx:if="{{feed.length && !loading}}">— 已经到底了 —</view>
</view>
