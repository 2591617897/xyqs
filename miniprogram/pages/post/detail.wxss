.page {
  padding-bottom: 40rpx;
}

/* ===== 作者栏 ===== */
.author-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
}
.ab-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}
.ab-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ab-info {
  flex: 1;
  min-width: 0;
}
.ab-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.ab-meta {
  font-size: 22rpx;
  color: #9b9ba3;
  margin-top: 4rpx;
}
.ab-btn {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FF8FA8;
  color: #FF8FA8;
  font-size: 24rpx;
  font-weight: 600;
}
.ab-btn.ghost {
  border-color: #F5E8EC;
  color: #9b9ba3;
  font-weight: 400;
}

/* ===== 正文 ===== */
.article {
  background: #ffffff;
  padding: 8rpx 28rpx 28rpx;
}
.article-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #1a1a1a;
  margin-bottom: 14rpx;
}
.article-content {
  font-size: 30rpx;
  line-height: 1.75;
  color: #2b2b30;
  white-space: pre-wrap;
  word-break: break-all;
}
.article-imgs {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.article-img {
  width: 100%;
  border-radius: 12rpx;
  background: #f2f3f5;
}

/* ===== 评论区（与表白墙详情一致） ===== */
.comment-section {
  background: #ffffff;
  margin-top: 20rpx;
  padding: 28rpx 32rpx 12rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.section-count {
  font-size: 23rpx;
  color: #b6bbc6;
}
.ch-sorts {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.ch-sort {
  font-size: 25rpx;
  color: #9b9ba3;
}
.ch-sort.on {
  color: #FF8FA8;
  font-weight: 600;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  background: #eef0f4;
}
.c-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.c-name {
  font-size: 25rpx;
  color: #8b8f99;
}
.c-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
  margin-top: 8rpx;
  word-break: break-all;
}
.c-del {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-imgs {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}
.c-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f4f5f9;
}
.comment-empty {
  padding: 70rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
}

/* ===== 底部悬停操作栏（与表白墙详情一致） ===== */
.bottom-space {
  height: 200rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.06);
  z-index: 30;
}
.bar-input {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 84rpx;
  padding: 0 28rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
}
.bar-input-icon {
  font-size: 30rpx;
  line-height: 1;
}
.bar-input-hint {
  font-size: 27rpx;
  color: #9ca3af;
}
.bar-acts {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.bar-act {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  border-radius: 50%;
  box-sizing: border-box;
}
.bar-act.on {
  border-color: #ffd7da;
  background: #fff5f6;
}
.bar-icon {
  font-size: 32rpx;
  line-height: 1;
}
.bar-num {
  font-size: 20rpx;
  color: #8b8f99;
  line-height: 1.2;
}
.bar-act.on .bar-num {
  color: #ff4d4f;
}
.bar-share {
  margin: 0;
  padding: 0;
  line-height: inherit;
}
.bar-share::after {
  border: none;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}

/* 评论配图 + 表情面板 */
.pending-imgs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 4rpx 12rpx;
}
.p-item {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.p-thumb {
  width: 100%;
  height: 100%;
}
.p-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #ffffff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 10rpx;
}
.p-tip {
  font-size: 21rpx;
  color: #b3b3b8;
  margin-left: 8rpx;
}
.emoji-panel {
  margin-top: 10rpx;
  padding: 12rpx 4rpx 0;
  border-top: 1rpx solid #f0f1f3;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  max-height: 320rpx;
  overflow-y: auto;
}
.emoji-item {
  width: 12.5%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

/* ---------- 遮罩 ---------- */
/* 注意：本页此前只引用了 .pc-comment-mask，普通 .mask 未定义 → @ 好友弹层没有遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 110;
  display: flex;
  align-items: flex-end;
}
.comment-mask {
  z-index: 110;
}

/* ---------- @ 好友选择器 ---------- */
.mention-picker {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform .25s ease;
  z-index: 120;
  display: flex; flex-direction: column;
}
.mention-picker.on { transform: translateY(0); }
.mention-list {
  flex: 1; overflow-y: auto;
  padding: 0 24rpx 40rpx;
}
.mention-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #FFE4EC;
}
.mi-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg,#a855f7,#ec4899);
}
.mi-avatar.default { background: #e2e8f0; }
.mi-info { flex: 1; min-width: 0; }
.mi-name { font-size: 28rpx; font-weight: 500; color: #1e293b; display: block; }
.mi-sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; display: block; }
.mi-add {
  font-size: 26rpx; color: #ffffff;
  background: linear-gradient(135deg,#6366f1,#a855f7);
  padding: 6rpx 20rpx; border-radius: 30rpx;
}
.mention-empty { text-align: center; padding: 60rpx 0; color: #94a3b8; font-size: 26rpx; }
.mention-tags {
  padding: 0 24rpx; margin-top: 10rpx;
}
.mention-tag {
  display: inline-block;
  font-size: 22rpx; color: #6366f1;
  background: #eef2ff; padding: 4rpx 16rpx; border-radius: 20rpx;
}

/* ---------- 楼中楼回复 ---------- */
.c-reply-btn {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-replies {
  margin-top: 16rpx;
  background: #f6f8fb;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}
.reply-item {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
}
.reply-item + .reply-item {
  border-top: 1rpx solid #eceff5;
}
.reply-to {
  color: #FF8FA8;
  font-weight: 600;
}
.reply-more {
  padding: 14rpx 0 8rpx;
  font-size: 24rpx;
  color: #FF8FA8;
}
.reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: #eef2f7;
  border-radius: 12rpx 12rpx 0 0;
  font-size: 22rpx;
  color: #5b6472;
}
.reply-bar-cancel {
  padding: 4rpx 10rpx;
  color: #b6bbc6;
  font-size: 24rpx;
}

/* ---------- 评论入口胶囊 ---------- */
.pc-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 28rpx;
  background: #f5f7f9;
  border-radius: 999rpx;
}
.pc-entry-hint {
  font-size: 26rpx;
  color: #94a3b8;
}
.pc-entry-tools {
  display: flex;
  gap: 14rpx;
}
.pc-entry-icon {
  font-size: 26rpx;
  line-height: 1;
}

/* ---------- 评论抽屉 ---------- */
.pc-comment-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.48);
  z-index: 90;
}
.pc-comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.pc-comment-sheet.on {
  transform: translateY(0);
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 6rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx 10rpx;
}
.sheet-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
.sheet-head-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #94a3b8;
  border-radius: 50%;
  background: #FFE4EC;
}
.sheet-input-area {
  position: relative;
  margin: 6rpx 24rpx 0;
  padding: 20rpx 24rpx 40rpx;
  background: #f8fafc;
  border-radius: 20rpx;
}
.sheet-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 360rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #0f172a;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.sheet-count {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}
.sheet-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}
.sheet-tools {
  display: flex;
  gap: 20rpx;
}
.sheet-tool {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 50%;
  background: #FFE4EC;
  color: #64748b;
  transition: background 0.15s, color 0.15s;
}
.sheet-tool.on {
  background: #edf9f3;
  color: #E8625A;
}
.sheet-send {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
  transition: background 0.15s, color 0.15s;
}
.sheet-send.on {
  background: linear-gradient(135deg, #FFB5C5, #E8625A);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 181, 197, 0.3);
}
