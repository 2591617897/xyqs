.page {
  padding-bottom: 40rpx;
}

.article {
  background: #ffffff;
  padding: 32rpx 32rpx 40rpx;
}
.channel-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}
.channel-name {
  color: #14a89b;
  font-weight: 600;
}
.del-btn {
  font-size: 23rpx;
  color: #b6bbc6;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-top: 20rpx;
  letter-spacing: -0.5rpx;
}
.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f4f5f9;
}
.author-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #eef0f5;
}
.author-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #8b8f99;
}
.author-name {
  font-size: 27rpx;
  font-weight: 600;
}
.content {
  font-size: 31rpx;
  line-height: 1.85;
  color: #2b303b;
  margin-top: 26rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.imgs {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.img {
  width: 100%;
  border-radius: 16rpx;
  background: #f4f5f9;
}
.like-row {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}
.like-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: #f7f8fc;
  font-size: 26rpx;
  color: #6b7280;
}
.like-btn.liked {
  background: rgba(255, 77, 79, 0.08);
  color: #ff4d4f;
}
.heart {
  font-size: 32rpx;
}

.comment-card {
  background: #ffffff;
  margin-top: 20rpx;
  padding: 32rpx;
}
.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eef0f5;
  flex-shrink: 0;
}
.c-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8b8f99;
}
.c-name {
  font-size: 25rpx;
  color: #5b6170;
  font-weight: 600;
}
.c-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
  margin-top: 8rpx;
}

.bottom-space {
  height: 140rpx;
}
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.06);
}
.comment-input {
  flex: 1;
  height: 80rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
}
.send-btn {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff5a76;
  padding: 0 12rpx;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}
