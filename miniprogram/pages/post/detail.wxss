.page {
  padding-bottom: 40rpx;
}

/* ===== 作者栏 ===== */
.author-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
}
.ab-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}
.ab-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ab-info {
  flex: 1;
  min-width: 0;
}
.ab-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.ab-meta {
  font-size: 22rpx;
  color: #9b9ba3;
  margin-top: 4rpx;
}
.ab-btn {
  flex-shrink: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: var(--radius-pill, 999rpx);
  border: 2rpx solid var(--brand-200, #93D3B9);
  color: var(--brand-500, #006C49);
  font-size: var(--fs-3, 24rpx);
  font-weight: var(--fw-bold, 600);
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease),
              transform var(--dur-fast, 120ms) var(--ease-out, ease);
}
.ab-btn-hover {
  background: var(--brand-50, #E8F5EF);
  transform: scale(0.96);
}
.ab-btn.ghost {
  border-color: var(--border, #E3E8E6);
  color: var(--text-3, #6B7A74);
  font-weight: var(--fw-regular, 400);
}
.ab-btn.ghost.ab-btn-hover {
  background: var(--surface-2, #F0F3F2);
}
/* 推广入口：实心填充，和普通「管理」按钮区分开 */
.ab-btn.solid {
  background: var(--brand-500, #006C49);
  border-color: var(--brand-500, #006C49);
  color: var(--text-inverse, #FFFFFF);
  box-shadow: var(--shadow-1, 0 2rpx 8rpx rgba(15, 26, 22, 0.04));
}
.ab-btn-solid-hover {
  background: var(--brand-600, #005A3D);
  border-color: var(--brand-600, #005A3D);
  transform: scale(0.96);
}

/* ===== 正文 ===== */
.article {
  background: #ffffff;
  padding: 8rpx 28rpx 28rpx;
}
.article-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #1a1a1a;
  margin-bottom: 14rpx;
}
.article-content {
  font-size: 30rpx;
  line-height: 1.75;
  color: #2b2b30;
  white-space: pre-wrap;
  word-break: break-all;
}
.article-imgs {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.article-img {
  width: 100%;
  border-radius: 12rpx;
  background: #f2f3f5;
}

/* ===== 评论区（按参考图 1:1 还原） ===== */
.comment-section {
  background: #ffffff;
  margin-top: 20rpx;
  padding: 28rpx 32rpx 12rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.section-count {
  font-size: 23rpx;
  color: #b6bbc6;
}
.ch-sorts {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.ch-sort {
  font-size: 25rpx;
  color: #9b9ba3;
}
.ch-sort.on {
  color: var(--brand-500, #006C49);
  font-weight: 600;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  background: #eef0f4;
}
.c-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
/* 头部：左「昵称 + LV 徽章 + 省份」，右「时间」 */
.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.c-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}
.c-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.c-time {
  font-size: 22rpx;
  color: #b6bbc6;
  flex-shrink: 0;
}
/* LV 等级徽章：分 5 档配色，低调但可辨 */
.c-lv {
  flex-shrink: 0;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  background: #eef0f4;
  color: #8b8f99;
}
.c-lv.lv-1 { background: #F2F3F5; color: #9A9EA6; }
.c-lv.lv-2 { background: #E8F5EF; color: #1F9E6E; }
.c-lv.lv-3 { background: #E3F0FF; color: #2E7CD6; }
.c-lv.lv-4 { background: #F1ECFF; color: #7A5AF8; }
.c-lv.lv-5 { background: #FFF3E0; color: #E08A00; }
/* 省份标签 */
.c-province {
  flex-shrink: 0;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  background: #F4F6F8;
  color: #7A8089;
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.c-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
  margin-top: 8rpx;
  word-break: break-all;
}
.c-del {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-imgs {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}
.c-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f4f5f9;
}
/* 底部操作栏：点赞 / 回复 / 删除 */
.c-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 14rpx;
}
.c-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 8rpx;
  margin: -4rpx -8rpx;
  border-radius: 999rpx;
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease);
}
.c-action-hover {
  background: var(--surface-2, #F0F3F2);
}
.c-like-ico {
  font-size: 28rpx;
  color: #9ca3af;
  transition: color var(--dur-fast, 120ms) var(--ease-out, ease);
}
.c-action-num {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1;
}
/* 已点赞：心形与数字一起变粉 */
.c-liked {
  color: var(--like-500, #FF4D7D);
}
.comment-empty {
  padding: 70rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
}

/* ===== 底部悬停操作栏（与表白墙详情完全一致） ===== */
.bottom-space {
  height: 200rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--surface, #FFFFFF);
  border-top: 1rpx solid var(--border, #E3E8E6);
  box-shadow: 0 -8rpx 32rpx rgba(15, 26, 22, 0.06);
  z-index: 30;
}
/* 写评论：胶囊输入框 */
.bar-input {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 26rpx;
  background: var(--surface-2, #F0F3F2);
  border-radius: var(--radius-pill, 999rpx);
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease);
}
.bar-input-hover {
  background: var(--surface-3, #E8ECEA);
}
.bar-input-icon {
  font-size: 30rpx;
  color: var(--text-3, #6B7A74);
  flex-shrink: 0;
}
.bar-input-hint {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-4, 26rpx);
  color: var(--text-3, #6B7A74);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 操作组：图标 + 计数，单行胶囊 */
.bar-acts {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.bar-act {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 76rpx;
  min-width: 64rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: transparent;
  color: var(--text-2, #4B5A54);
  box-sizing: border-box;
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease),
              transform var(--dur-fast, 120ms) var(--ease-out, ease);
}
.bar-act-hover {
  background: var(--surface-2, #F0F3F2);
  transform: scale(0.94);
}
.bar-ico {
  font-size: 36rpx;
  flex-shrink: 0;
}
.bar-num {
  font-size: var(--fs-2, 22rpx);
  font-weight: var(--fw-medium, 500);
  color: var(--text-3, #6B7A74);
  line-height: 1;
}
/* 点赞激活：马卡龙浅粉底 + 樱花粉 */
.bar-act.on {
  background: var(--like-50, #FFF0F4);
  color: var(--like-500, #FF4D7D);
}
.bar-act.on .bar-num {
  color: var(--like-500, #FF4D7D);
}
.bar-act.on.bar-act-hover {
  background: var(--like-100, #FFD9E3);
}
/* 转发位沿用 .bar-act 外观，额外提供定位上下文给覆盖层 */
.bar-share {
  position: relative;
}
/* 透明热区：<button> 只负责触发转发，视觉与描边全部由外层 view 承担。
   用 opacity:0 而不是 display:none，保证点击依然命中 open-type="share" */
.bar-share-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-color: transparent;
  opacity: 0;
}
.bar-share-hit::after {
  border: none;
  box-shadow: none;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}

/* 评论配图 + 表情面板 */
.pending-imgs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 4rpx 12rpx;
}
.p-item {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.p-thumb {
  width: 100%;
  height: 100%;
}
.p-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #ffffff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 10rpx;
}
.p-tip {
  font-size: 21rpx;
  color: #b3b3b8;
  margin-left: 8rpx;
}
.emoji-panel {
  margin-top: 10rpx;
  padding: 12rpx 4rpx 0;
  border-top: 1rpx solid #f0f1f3;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  max-height: 320rpx;
  overflow-y: auto;
}
.emoji-item {
  width: 12.5%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

/* ---------- 遮罩 ---------- */
/* 注意：本页此前只引用了 .pc-comment-mask，普通 .mask 未定义 → @ 好友弹层没有遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 20, 26, 0.45);
  z-index: 110;
  display: flex;
  align-items: flex-end;
}
.comment-mask {
  z-index: 110;
}

/* ---------- @ 好友选择器 ---------- */
.mention-picker {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform .25s ease;
  z-index: 120;
  display: flex; flex-direction: column;
}
.mention-picker.on { transform: translateY(0); }
.mention-list {
  flex: 1; overflow-y: auto;
  padding: 0 24rpx 40rpx;
}
.mention-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--surface-2, #F0F3F2);
}
.mi-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg,#a855f7,#ec4899);
}
.mi-avatar.default { background: #e2e8f0; }
.mi-info { flex: 1; min-width: 0; }
.mi-name { font-size: 28rpx; font-weight: 500; color: #1e293b; display: block; }
.mi-sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; display: block; }
.mi-add {
  font-size: 26rpx; color: #ffffff;
  background: linear-gradient(135deg,#6366f1,#a855f7);
  padding: 6rpx 20rpx; border-radius: 30rpx;
}
.mention-empty { text-align: center; padding: 60rpx 0; color: #94a3b8; font-size: 26rpx; }
.mention-tags {
  padding: 0 24rpx; margin-top: 10rpx;
}
.mention-tag {
  display: inline-block;
  font-size: 22rpx; color: #6366f1;
  background: #eef2ff; padding: 4rpx 16rpx; border-radius: 20rpx;
}

/* ---------- 楼中楼回复 ---------- */
.c-replies {
  margin-top: 16rpx;
  background: #f6f8fb;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
}
.reply-item {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
}
.reply-item + .reply-item {
  border-top: 1rpx solid #eceff5;
}
/* 楼中楼回复者头像：比主评论头像小一号，视觉上分出层级 */
.r-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #eef0f4;
  margin-top: 2rpx;
}
.r-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.reply-to {
  color: var(--like-500, #FF4D7D);
  font-weight: 600;
}
.reply-more {
  padding: 12rpx 0 4rpx;
  font-size: 24rpx;
  color: var(--like-500, #FF4D7D);
}
/* 楼中楼里的昵称比主评论略小、字重略轻，视觉上分出层级 */
.c-replies .c-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #4b5563;
}
.c-replies .c-text {
  font-size: 26rpx;
}
.c-replies .c-actions {
  margin-top: 10rpx;
}
.reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: #eef2f7;
  border-radius: 12rpx 12rpx 0 0;
  font-size: 22rpx;
  color: #5b6472;
}
.reply-bar-cancel {
  padding: 4rpx 10rpx;
  color: #b6bbc6;
  font-size: 24rpx;
}

/* ---------- 评论入口胶囊 ---------- */
.pc-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 28rpx;
  background: #f5f7f9;
  border-radius: 999rpx;
}
.pc-entry-hint {
  font-size: 26rpx;
  color: #94a3b8;
}
.pc-entry-tools {
  display: flex;
  gap: 14rpx;
}
.pc-entry-icon {
  font-size: 26rpx;
  line-height: 1;
}

/* ---------- 评论抽屉 ---------- */
.pc-comment-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.48);
  z-index: 90;
}
.pc-comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.pc-comment-sheet.on {
  transform: translateY(0);
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 6rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx 10rpx;
}
.sheet-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
.sheet-head-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #94a3b8;
  border-radius: 50%;
  background: var(--surface-2, #F0F3F2);
}
.sheet-input-area {
  position: relative;
  margin: 6rpx 24rpx 0;
  padding: 20rpx 24rpx 40rpx;
  background: #f8fafc;
  border-radius: 20rpx;
}
.sheet-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 360rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #0f172a;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.sheet-count {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}
.sheet-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}
.sheet-tools {
  display: flex;
  gap: 20rpx;
}
.sheet-tool {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--surface-2, #F0F3F2);
  color: var(--text-3, #6B7A74);
  transition: background 0.15s, color 0.15s;
}
.sheet-tool-hover {
  background: var(--surface-3, #E8ECEA);
}
.sheet-tool.on {
  background: var(--brand-50, #E8F5EF);
  color: var(--brand-500, #006C49);
}
.sheet-send {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
  transition: background 0.15s, color 0.15s;
}
.sheet-send.on {
  background: var(--brand-gradient, linear-gradient(135deg, #006C49 0%, #5FB894 100%));
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 108, 73, 0.18);
}
