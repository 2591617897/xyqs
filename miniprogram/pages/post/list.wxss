.page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* 顶部栏 */
.topbar {
  background: #ffffff;
  padding: 24rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #f0f1f3;
}
.topbar-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.topbar-sub {
  font-size: 23rpx;
  color: #9b9ba3;
  margin-top: 6rpx;
}

/* 频道导航（酷安式下划线指示） */
.nav-scroll {
  background: #ffffff;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f1f3;
}
.nav-row {
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
}
.nav-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 80rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #8c8c93;
  position: relative;
}
.nav-item.active {
  color: #1a1a1a;
  font-weight: 700;
}
.nav-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: #11a86b;
}

/* 信息流 */
.feed {
  background: #ffffff;
}
.feed-item {
  padding: 24rpx 28rpx 20rpx;
  background: #ffffff;
}
.feed-item + .feed-item {
  border-top: 1rpx solid #f0f1f3;
}
.feed-hover {
  background: #fafbfc;
}
.feed-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.feed-user-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}
.feed-title {
  font-weight: 600;
  margin-right: 8rpx;
}
.ml40 {
  margin-left: 48rpx;
}
.list-end {
  text-align: center;
  font-size: 23rpx;
  color: #b6bbc6;
  padding: 32rpx 0;
  background: #f5f6f8;
}
.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}
