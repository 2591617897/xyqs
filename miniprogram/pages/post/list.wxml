<view class="page">
  <!-- 顶部栏 -->
  <view class="topbar">
    <view class="topbar-title">校园频道</view>
    <view class="topbar-sub">同校同学都在聊什么</view>
  </view>

  <!-- 频道导航 -->
  <scroll-view class="nav-scroll" scroll-x="true" show-scrollbar="false">
    <view class="nav-row">
      <view class="nav-item {{!channelId ? 'active' : ''}}" bindtap="switchChannel" data-id="">
        <text>🌟</text>
        <text>全部</text>
      </view>
      <view
        class="nav-item {{channelId === item.id ? 'active' : ''}}"
        wx:for="{{channels}}"
        wx:key="id"
        bindtap="switchChannel"
        data-id="{{item.id}}"
      >
        <text>{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 信息流 -->
  <view class="feed">
    <view
      class="feed-item"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
      hover-class="feed-hover"
      hover-stay-time="60"
    >
      <view class="feed-user">
        <view class="feed-avatar">
          <image wx:if="{{item.authorAvatar}}" class="feed-avatar-img" src="{{item.authorAvatar}}" mode="aspectFill" />
          <view wx:else class="avatar-default">
            <view class="ad-head"></view>
            <view class="ad-body"></view>
          </view>
        </view>
        <view class="feed-user-info">
          <view class="feed-name">{{item.authorName}}</view>
          <view class="feed-meta">
            <text>{{item.timeText}}</text>
            <text class="feed-device">{{item.channelIcon}} {{item.channelName}}</text>
          </view>
        </view>
      </view>

      <view class="feed-text clamp3">
        <text class="feed-title">{{item.title}}</text>
        <text wx:if="{{item.excerpt}}">{{item.excerpt}}</text>
      </view>

      <view class="feed-imgs" wx:if="{{item.imageList.length}}">
        <view
          class="feed-img-wrap {{item.imageList.length === 1 ? 'single' : (item.imageList.length === 2 ? 'double' : '')}}"
          wx:for="{{item.imageList}}"
          wx:for-item="img"
          wx:for-index="ii"
          wx:key="*this"
        >
          <image class="feed-img" src="{{img}}" mode="aspectFill" />
        </view>
      </view>

      <view class="feed-actions">
        <view class="feed-action {{item.liked ? 'liked' : ''}}" catchtap="toggleLike" data-index="{{index}}">
          <text class="feed-action-icon">👍</text>
          <text>{{item.likeCount ? item.likeCount : '点赞'}}</text>
        </view>
        <view class="feed-action ml40" catchtap="goDetail" data-id="{{item.id}}">
          <text class="feed-action-icon">💬</text>
          <text>{{item.commentCount ? item.commentCount : '评论'}}</text>
        </view>
        <view class="flex1"></view>
        <text class="feed-more" catchtap="goDetail" data-id="{{item.id}}">详情 ›</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '💬'}}</text>
    <text>{{loadError ? '加载失败，请检查网络或后端服务' : '这个频道还没有帖子，来发第一帖'}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <view class="list-end" wx:if="{{list.length}}">
    {{loading ? '加载中…' : (hasMore ? '上拉加载更多' : '— 已经到底了 —')}}
  </view>

  <view class="fab" bindtap="goPublish">＋</view>
</view>
