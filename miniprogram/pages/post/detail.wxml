<view class="page" wx:if="{{post}}">
  <!-- 帖子主卡：作者栏 + 正文 + 配图合成一张圆角卡片，浮在页面渐变上
       （原来是两块白底直接拼接，渐变全被盖住，层次感弱） -->
  <view class="post-card">
    <!-- 作者栏：头像 + 昵称点击进个人主页（catchtap 阻止冒泡；右上「同校」保持静态标签） -->
    <view class="author-bar">
      <view class="ab-avatar" catchtap="goUserSpace">
        <image wx:if="{{post.authorAvatar}}" class="ab-avatar-img" src="{{post.authorAvatar}}" mode="aspectFill" />
        <view wx:else class="avatar-default">
          <view class="ad-head"></view>
          <view class="ad-body"></view>
        </view>
      </view>
      <view class="ab-info" catchtap="goUserSpace">
        <view class="ab-name">{{post.authorName}}</view>
        <view class="ab-meta">{{post.timeText}} · {{post.channelIcon}} {{post.channelName}}</view>
      </view>
      <view class="ab-btn solid" wx:if="{{post.mine}}" hover-class="ab-btn-solid-hover" hover-stay-time="80" catchtap="openPromote">推广</view>
      <view class="ab-btn" wx:if="{{post.mine}}" hover-class="ab-btn-hover" hover-stay-time="80" catchtap="openMore">管理</view>
      <!-- 同校 / 同市 由 schoolId 对比得出（全市范围下作者可能是外校同学） -->
      <view class="ab-btn ghost" wx:elif="{{post.schoolBadge}}">{{post.schoolBadge}}</view>
    </view>

    <!-- 正文 -->
    <view class="article">
      <view class="article-title" wx:if="{{post.title}}">{{post.title}}</view>
      <view class="article-content">{{post.content}}</view>

      <!-- 图片网格（参考今日头条详情页）：
           1 张 → 单列大图；2 / 4 张 → 两列；3 张及以上 → 三列九宫格 -->
      <view class="article-imgs {{post.imgGrid}}" wx:if="{{post.imageList.length}}">
        <image
          wx:for="{{post.imageList}}"
          wx:key="*this"
          class="article-img"
          src="{{item}}"
          mode="{{post.imgMode}}"
          lazy-load
          binderror="onImageError"
          bindtap="previewImage"
          data-url="{{item}}"
        />
      </view>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comment-section">
    <view class="section-head">
      <view class="row gap12">
        <text class="section-title">全部评论</text>
        <text class="section-count">{{comments.length}}</text>
      </view>
      <view class="ch-sorts">
        <text class="ch-sort {{commentSort === 'default' ? 'on' : ''}}" bindtap="switchSort" data-sort="default">默认</text>
        <text class="ch-sort {{commentSort === 'newest' ? 'on' : ''}}" bindtap="switchSort" data-sort="newest">最新</text>
      </view>
    </view>

    <!-- 顶层评论 -->
    <view class="comment-item" wx:for="{{comments}}" wx:key="id" wx:for-index="pindex">
      <view class="c-avatar" catchtap="goUserSpaceById" data-id="{{item.userId}}">
        <image wx:if="{{item.userAvatar}}" class="c-avatar-img" src="{{item.userAvatar}}" mode="aspectFill" />
        <view wx:else class="avatar-default">
          <view class="ad-head"></view>
          <view class="ad-body"></view>
        </view>
      </view>
      <view class="flex1">
        <!-- 头部：昵称 + LV 徽章 + 省份 -->
        <view class="c-head">
          <view class="c-head-left">
            <text class="c-name" catchtap="goUserSpaceById" data-id="{{item.userId}}">{{item.userName || '校园用户'}}</text>
            <text class="c-lv lv-{{item.lvTier}}" wx:if="{{item.lvText}}">{{item.lvText}}</text>
            <text class="c-province" wx:if="{{item.userProvince}}">{{item.userProvince}}</text>
          </view>
          <text class="c-time">{{item.timeText}}</text>
        </view>

        <view class="c-text" wx:if="{{item.content}}">{{item.content}}</view>

        <view class="c-imgs" wx:if="{{item.imageList.length}}">
          <image
            wx:for="{{item.imageList}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="*this"
            class="c-img"
            src="{{img}}"
            mode="aspectFill"
            catchtap="previewComment"
            data-pindex="{{pindex}}"
            data-url="{{img}}"
          />
        </view>

        <!-- 底部操作栏：点赞 / 回复 / 删除 -->
        <view class="c-actions">
          <view class="c-action" hover-class="c-action-hover" hover-stay-time="80" catchtap="toggleCommentLike" data-id="{{item.id}}" data-index="{{pindex}}" aria-role="button" aria-label="点赞评论">
            <view class="ico ico-like-o c-like-ico {{item.liked ? 'ico-like c-liked' : ''}}"></view>
            <text class="c-action-num {{item.liked ? 'c-liked' : ''}}">{{item.likeCount || 0}}</text>
          </view>
          <view class="c-action" hover-class="c-action-hover" hover-stay-time="80" catchtap="replyComment" data-id="{{item.id}}" data-name="{{item.userName || '校园用户'}}" aria-role="button" aria-label="回复评论">
            <view class="ico ico-comment c-like-ico"></view>
            <text class="c-action-num">{{item.replyCount || 0}}</text>
          </view>
          <text class="c-del" wx:if="{{item.mine}}" catchtap="deleteComment" data-id="{{item.id}}">删除</text>
        </view>

        <!-- 楼中楼回复 -->
        <view class="c-replies" wx:if="{{item.replies && item.replies.length}}">
          <view class="reply-item" wx:for="{{item.repliesShown}}" wx:for-item="rp" wx:for-index="rindex" wx:key="id">
            <!-- 回复者头像：比主评论小一号，点进对方个人主页 -->
            <view class="r-avatar" catchtap="goUserSpaceById" data-id="{{rp.userId}}">
              <image wx:if="{{rp.userAvatar}}" class="r-avatar-img" src="{{rp.userAvatar}}" mode="aspectFill" />
              <view wx:else class="avatar-default">
                <view class="ad-head"></view>
                <view class="ad-body"></view>
              </view>
            </view>
            <view class="flex1">
              <view class="c-head">
                <view class="c-head-left">
                  <text class="c-name" catchtap="goUserSpaceById" data-id="{{rp.userId}}">{{rp.userName || '校园用户'}}</text>
                  <text class="c-lv lv-{{rp.lvTier}}" wx:if="{{rp.lvText}}">{{rp.lvText}}</text>
                  <text class="c-province" wx:if="{{rp.userProvince}}">{{rp.userProvince}}</text>
                </view>
                <text class="c-time">{{rp.timeText}}</text>
              </view>
              <view class="c-text">
                <text wx:if="{{rp.replyToName}}" class="reply-to">回复 {{rp.replyToName}}：</text>{{rp.content}}
              </view>
              <view class="c-imgs" wx:if="{{rp.imageList.length}}">
                <image
                  wx:for="{{rp.imageList}}"
                  wx:for-item="img"
                  wx:for-index="imgIndex"
                  wx:key="*this"
                  class="c-img"
                  src="{{img}}"
                  mode="aspectFill"
                  catchtap="previewComment"
                  data-pindex="{{pindex}}"
                  data-rindex="{{rindex}}"
                  data-url="{{img}}"
                />
              </view>
              <view class="c-actions">
                <view class="c-action" hover-class="c-action-hover" hover-stay-time="80" catchtap="toggleCommentLike" data-id="{{rp.id}}" data-index="{{pindex}}" data-rindex="{{rindex}}" aria-role="button" aria-label="点赞回复">
                  <view class="ico ico-like-o c-like-ico {{rp.liked ? 'ico-like c-liked' : ''}}"></view>
                  <text class="c-action-num {{rp.liked ? 'c-liked' : ''}}">{{rp.likeCount || 0}}</text>
                </view>
                <view class="c-action" hover-class="c-action-hover" hover-stay-time="80" catchtap="replyComment" data-id="{{rp.id}}" data-name="{{rp.userName || '校园用户'}}" aria-role="button" aria-label="回复">
                  <view class="ico ico-comment c-like-ico"></view>
                  <text class="c-action-num">回复</text>
                </view>
                <text class="c-del" wx:if="{{rp.mine}}" catchtap="deleteComment" data-id="{{rp.id}}">删除</text>
              </view>
            </view>
          </view>
          <view class="reply-more" wx:if="{{item.replyCount > 5 && !item.expanded}}" catchtap="toggleReplies" data-index="{{pindex}}">
            查看全部 {{item.replyCount}} 条回复 ›
          </view>
          <view class="reply-more" wx:if="{{item.expanded}}" catchtap="toggleReplies" data-index="{{pindex}}">
            收起回复 ‹
          </view>
        </view>
      </view>
    </view>

    <view class="comment-empty" wx:if="{{!comments.length}}">
      <text class="empty-icon">💬</text>
      <text>还没有评论，做第一个温柔的人</text>
    </view>

    <!-- 有评论时收尾，避免评论区下方突然一片空白 -->
    <view class="comment-end" wx:if="{{comments.length}}">
      <text class="ce-line"></text>
      <text class="ce-text">— 到底了 —</text>
      <text class="ce-line"></text>
    </view>
  </view>

  <view class="bottom-space"></view>

  <!-- 评论抽屉：底部半屏弹起 -->
  <view class="mask pc-comment-mask" wx:if="{{showCommentSheet}}" catchtap="closeCommentSheet"></view>
  <view class="pc-comment-sheet {{showCommentSheet ? 'on' : ''}}" style="bottom: {{keyboardHeight}}px" catchtap="stop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-head-title">{{replyTo ? '回复 @' + replyTo.name : '发表回复'}}</text>
      <text class="sheet-head-close" catchtap="closeCommentSheet">✕</text>
    </view>

    <!-- 待发送配图 -->
    <view class="pending-imgs" wx:if="{{commentImages.length}}">
      <view class="p-item" wx:for="{{commentImages}}" wx:key="*this">
        <image class="p-thumb" src="{{item}}" mode="aspectFill" />
        <view class="p-del" catchtap="removeCommentImage" data-index="{{index}}">✕</view>
      </view>
      <text class="p-tip">最多 3 张</text>
    </view>

    <!-- 主输入 -->
    <view class="sheet-input-area">
      <textarea
        class="sheet-textarea"
        placeholder="{{replyTo ? '回复 ' + replyTo.name + '，说点什么…' : '说点什么，或者配张图吧…'}}"
        placeholder-class="placeholder"
        value="{{commentInput}}"
        auto-height
        maxlength="500"
        focus="{{commentSheetFocus}}"
        confirm-type="send"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeight"
        bindinput="onCommentInput"
        bindconfirm="sendComment"
      />
      <view class="sheet-count">{{commentInput.length || 0}}/500</view>
    </view>

    <!-- 工具行 + 发送 -->
    <view class="sheet-toolbar">
      <view class="sheet-tools">
        <view class="sheet-tool {{showEmoji ? 'on' : ''}}" hover-class="sheet-tool-hover" hover-stay-time="80" catchtap="toggleEmoji" aria-role="button" aria-label="表情">
          <view class="ico ico-emoji"></view>
        </view>
        <view class="sheet-tool" hover-class="sheet-tool-hover" hover-stay-time="80" catchtap="chooseCommentImage" aria-role="button" aria-label="图片">
          <view class="ico ico-image"></view>
        </view>
        <view class="sheet-tool" hover-class="sheet-tool-hover" hover-stay-time="80" catchtap="openMentionPicker" aria-role="button" aria-label="提醒好友">
          <view class="ico ico-at"></view>
        </view>
      </view>
      <view class="sheet-send {{commentInput || commentImages.length ? 'on' : ''}}" bindtap="sendComment">发布</view>
    </view>

    <!-- 已 @ 人员标签 -->
    <view class="mention-tags" wx:if="{{mentionUserIds.length}}">
      <view class="mention-tag">已 @ {{mentionUserIds.length}} 人</view>
    </view>

    <!-- 表情面板 -->
    <view class="emoji-panel" wx:if="{{showEmoji}}">
      <view class="emoji-grid">
        <view
          class="emoji-item"
          wx:for="{{emojiList}}"
          wx:key="*this"
          catchtap="addEmoji"
          data-emoji="{{item}}"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <!-- @ 好友选择 bottom-sheet -->
  <view class="mask comment-mask" wx:if="{{showMentionPicker}}" catchtap="closeMentionPicker"></view>
  <view class="mention-picker {{showMentionPicker ? 'on' : ''}}">
    <view class="sheet-head">
      <text class="sheet-head-title">选择要 @ 的好友</text>
      <text class="sheet-head-close" catchtap="closeMentionPicker">✕</text>
    </view>
    <view class="mention-list">
      <view class="mention-item" wx:for="{{mentionPickerList}}" wx:key="id" catchtap="confirmMention" data-index="{{index}}">
        <image wx:if="{{item.avatar}}" class="mi-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="mi-avatar default"></view>
        <view class="mi-info">
          <text class="mi-name">{{item.nickname || item.name}}</text>
          <text class="mi-sub">{{item.school || '同学'}}</text>
        </view>
        <view class="mi-add">+ @</view>
      </view>
      <view class="mention-empty" wx:if="{{!mentionPickerList.length}}">没有更多好友可 @ 了</view>
    </view>
  </view>

  <!-- 底部悬停操作栏：写评论 + 点赞 / 评论 / 分享 / 举报 -->
  <view class="bottom-bar">
    <view class="bar-input" hover-class="bar-input-hover" hover-stay-time="80" bindtap="openCommentSheet">
      <view class="ico ico-edit bar-input-icon"></view>
      <text class="bar-input-hint">写评论…</text>
    </view>
    <view class="bar-acts">
      <view
        class="bar-act {{liked ? 'on' : ''}}"
        hover-class="bar-act-hover"
        hover-stay-time="80"
        catchtap="toggleLike"
        aria-role="button"
        aria-label="{{liked ? '取消点赞' : '点赞'}}"
      >
        <view class="ico bar-ico {{liked ? 'ico-like' : 'ico-like-o'}}"></view>
        <text class="bar-num">{{post.likeCount || 0}}</text>
      </view>
      <view
        class="bar-act"
        hover-class="bar-act-hover"
        hover-stay-time="80"
        catchtap="openCommentSheet"
        aria-role="button"
        aria-label="评论"
      >
        <view class="ico ico-comment bar-ico"></view>
        <text class="bar-num">{{post.commentCount || 0}}</text>
      </view>
      <!-- 转发：<button> 自带描边在部分基础库清不掉，改为 view 出图 + 透明 button 占位承接点击 -->
      <view class="bar-act bar-share" hover-class="bar-act-hover" hover-stay-time="80" aria-role="button" aria-label="分享">
        <view class="ico ico-share bar-ico"></view>
        <button class="bar-share-hit" open-type="share" plain></button>
      </view>
      <view class="bar-act" hover-class="bar-act-hover" hover-stay-time="80" catchtap="goReport" aria-role="button" aria-label="举报">
        <view class="ico ico-flag bar-ico"></view>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">
  <text class="empty-icon">{{loadError ? '📡' : '📄'}}</text>
  <text>{{loadError ? '加载失败，请检查网络或后端服务' : '帖子不存在或已删除'}}</text>
  <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
</view>

<promote-sheet
  visible="{{showPromote}}"
  target-type="POST"
  target-id="{{post.id}}"
  target-name="帖子"
  title="推广这条帖子"
  bind:close="closePromote"
  bind:done="onPromoteDone"
/>
