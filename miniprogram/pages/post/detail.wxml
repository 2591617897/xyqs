<view class="page" wx:if="{{post}}">
  <!-- 作者栏 -->
  <view class="author-bar">
    <view class="ab-avatar">
      <image wx:if="{{post.authorAvatar}}" class="ab-avatar-img" src="{{post.authorAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar-default">
        <view class="ad-head"></view>
        <view class="ad-body"></view>
      </view>
    </view>
    <view class="ab-info">
      <view class="ab-name">{{post.authorName}}</view>
      <view class="ab-meta">{{post.timeText}} · {{post.channelIcon}} {{post.channelName}}</view>
    </view>
    <view class="ab-btn" wx:if="{{post.mine}}" catchtap="openMore">管理</view>
    <view class="ab-btn ghost" wx:else>同校</view>
  </view>

  <!-- 正文 -->
  <view class="article">
    <view class="article-title" wx:if="{{post.title}}">{{post.title}}</view>
    <view class="article-content">{{post.content}}</view>

    <view class="article-imgs" wx:if="{{post.imageList.length}}">
      <image
        wx:for="{{post.imageList}}"
        wx:key="*this"
        class="article-img"
        src="{{item}}"
        mode="widthFix"
        bindtap="previewImage"
        data-url="{{item}}"
      />
    </view>
  </view>

  <!-- 评论头 -->
  <view class="comment-head">
    <text class="ch-count">共 {{comments.length}} 回复</text>
    <view class="ch-sorts">
      <text class="ch-sort {{commentSort === 'default' ? 'on' : ''}}" bindtap="switchSort" data-sort="default">默认</text>
      <text class="ch-sort {{commentSort === 'newest' ? 'on' : ''}}" bindtap="switchSort" data-sort="newest">最新</text>
    </view>
  </view>

  <!-- 评论列表 -->
  <view class="comment-list">
    <view class="comment-item" wx:for="{{comments}}" wx:key="id" wx:for-index="cindex">
      <view class="ci-avatar">
        <image wx:if="{{item.userAvatar}}" class="ci-avatar-img" src="{{item.userAvatar}}" mode="aspectFill" />
        <view wx:else class="avatar-default">
          <view class="ad-head"></view>
          <view class="ad-body"></view>
        </view>
      </view>
      <view class="ci-body">
        <view class="ci-name">{{item.userName || '校园用户'}}</view>
        <view class="ci-text" wx:if="{{item.content}}">{{item.content}}</view>

        <view class="ci-imgs" wx:if="{{item.imageList.length}}">
          <image
            wx:for="{{item.imageList}}"
            wx:for-item="img"
            wx:key="*this"
            class="ci-img"
            src="{{img}}"
            mode="aspectFill"
            catchtap="previewCommentImage"
            data-url="{{img}}"
          />
        </view>

        <view class="ci-foot">
          <text class="ci-time">{{item.timeText}}</text>
          <view class="flex1"></view>
          <text class="ci-reply-btn" catchtap="replyComment" data-id="{{item.id}}" data-name="{{item.userName || '校园用户'}}">回复</text>
          <text class="ci-del" wx:if="{{item.mine}}" catchtap="deleteComment" data-id="{{item.id}}">删除</text>
        </view>

        <!-- 楼中楼回复 -->
        <view class="ci-replies" wx:if="{{item.replies && item.replies.length}}">
          <view class="reply-item" wx:for="{{item.repliesShown}}" wx:for-item="rp" wx:key="id">
            <view class="ci-avatar">
              <image wx:if="{{rp.userAvatar}}" class="ci-avatar-img" src="{{rp.userAvatar}}" mode="aspectFill" />
              <view wx:else class="avatar-default">
                <view class="ad-head"></view>
                <view class="ad-body"></view>
              </view>
            </view>
            <view class="ci-body">
              <view class="ci-name">{{rp.userName || '校园用户'}}</view>
              <view class="ci-text">
                <text wx:if="{{rp.replyToName}}" class="reply-to">回复 {{rp.replyToName}}：</text>{{rp.content}}
              </view>
              <view class="ci-foot">
                <text class="ci-time">{{rp.timeText}}</text>
                <view class="flex1"></view>
                <text class="ci-reply-btn" catchtap="replyComment" data-id="{{rp.id}}" data-name="{{rp.userName || '校园用户'}}">回复</text>
                <text class="ci-del" wx:if="{{rp.mine}}" catchtap="deleteComment" data-id="{{rp.id}}">删除</text>
              </view>
            </view>
          </view>
          <view class="reply-more" wx:if="{{item.replyCount > 5 && !item.expanded}}" catchtap="toggleReplies" data-index="{{cindex}}">
            查看全部 {{item.replyCount}} 条回复 ›
          </view>
        </view>
      </view>
    </view>

    <view class="comment-empty" wx:if="{{!comments.length}}">
      <text class="empty-icon">💬</text>
      <text>还没有回复，来抢沙发</text>
    </view>

    <view class="list-end" wx:if="{{comments.length}}">— 已经到底了 —</view>
  </view>

  <view class="bottom-space"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <!-- 待发送配图 -->
    <view class="pending-imgs" wx:if="{{commentImages.length}}">
      <view class="p-item" wx:for="{{commentImages}}" wx:key="*this">
        <image class="p-thumb" src="{{item}}" mode="aspectFill" />
        <view class="p-del" catchtap="removeCommentImage" data-index="{{index}}">✕</view>
      </view>
      <text class="p-tip">最多 3 张</text>
    </view>

    <!-- 回复状态条 -->
    <view class="reply-bar" wx:if="{{replyTo}}">
      <text class="reply-bar-text">回复 @{{replyTo.name}}</text>
      <text class="reply-bar-cancel" catchtap="cancelReply">✕</text>
    </view>

    <view class="bb-row">
      <view class="bb-input-wrap">
        <input
          class="bb-input"
          placeholder="{{replyTo ? '回复 ' + replyTo.name : '写评论…'}}"
          placeholder-class="bb-placeholder"
          value="{{commentInput}}"
          focus="{{commentFocus}}"
          maxlength="500"
          confirm-type="send"
          bindinput="onCommentInput"
          bindconfirm="sendComment"
          bindfocus="focusInput"
          bindblur="onInputBlur"
        />
      </view>
      <view class="bb-tool {{showEmoji ? 'on' : ''}}" catchtap="toggleEmoji">😊</view>
      <view class="bb-tool" catchtap="chooseCommentImage">🖼</view>
      <view class="bb-send {{commentInput || commentImages.length ? 'on' : ''}}" bindtap="sendComment">发送</view>
      <view class="bb-action {{liked ? 'on' : ''}}" catchtap="toggleLike">
        <text class="bb-icon">👍</text>
        <text class="bb-num">{{post.likeCount || 0}}</text>
      </view>
      <view class="bb-action" catchtap="focusInput">
        <text class="bb-icon">💬</text>
        <text class="bb-num">{{post.commentCount || 0}}</text>
      </view>
    </view>

    <!-- 表情面板 -->
    <view class="emoji-panel" wx:if="{{showEmoji}}">
      <view class="emoji-grid">
        <view
          class="emoji-item"
          wx:for="{{emojiList}}"
          wx:key="*this"
          catchtap="addEmoji"
          data-emoji="{{item}}"
        >{{item}}</view>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">
  <text class="empty-icon">{{loadError ? '📡' : '📄'}}</text>
  <text>{{loadError ? '加载失败，请检查网络或后端服务' : '帖子不存在或已删除'}}</text>
  <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
</view>
