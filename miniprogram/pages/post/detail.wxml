<view class="page" wx:if="{{post}}">
  <view class="article">
    <view class="row between">
      <view class="channel-line">
        <text>{{post.channelIcon}}</text>
        <text class="channel-name">{{post.channelName}}</text>
      </view>
      <text class="del-btn" wx:if="{{post.mine}}" bindtap="deletePost">删除</text>
    </view>

    <view class="title">{{post.title}}</view>

    <view class="author-row">
      <image wx:if="{{post.authorAvatar}}" class="author-avatar" src="{{post.authorAvatar}}" mode="aspectFill" />
      <view wx:else class="author-avatar author-ph">{{post.avatarText}}</view>
      <view class="flex1">
        <view class="author-name">{{post.authorName}}</view>
        <view class="muted">{{post.timeText}}</view>
      </view>
      <text class="tag tag-mint">同校</text>
    </view>

    <view class="content">{{post.content}}</view>

    <view class="imgs" wx:if="{{post.imageList.length}}">
      <image
        wx:for="{{post.imageList}}"
        wx:key="*this"
        class="img"
        src="{{item}}"
        mode="widthFix"
        bindtap="previewImage"
        data-url="{{item}}"
      />
    </view>

    <view class="like-row">
      <view class="like-btn {{liked ? 'liked' : ''}}" bindtap="toggleLike">
        <text class="heart">{{liked ? '♥' : '♡'}}</text>
        <text>{{post.likeCount || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 评论 -->
  <view class="comment-card">
    <view class="h2">评论 {{comments.length}}</view>
    <view class="comment-item" wx:for="{{comments}}" wx:key="id">
      <image wx:if="{{item.userAvatar}}" class="c-avatar" src="{{item.userAvatar}}" mode="aspectFill" />
      <view wx:else class="c-avatar c-ph">{{item.avatarText}}</view>
      <view class="flex1">
        <view class="between">
          <text class="c-name">{{item.userName}}</text>
          <text class="muted">{{item.timeText}}</text>
        </view>
        <view class="c-text">{{item.content}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!comments.length}}" style="padding: 60rpx 0;">
      <text>还没有评论，来抢沙发</text>
    </view>
  </view>

  <view class="bottom-space"></view>

  <view class="comment-bar">
    <input
      class="comment-input"
      placeholder="友善发言，理性讨论"
      placeholder-class="placeholder"
      value="{{commentInput}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="sendComment"
    />
    <view class="send-btn" bindtap="sendComment">发送</view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">
  <text class="empty-icon">{{loadError ? '📡' : '📄'}}</text>
  <text>{{loadError ? '加载失败，请检查网络或后端服务' : '帖子不存在或已删除'}}</text>
  <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
</view>
