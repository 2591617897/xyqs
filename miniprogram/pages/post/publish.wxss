.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.channel-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.channel-pill {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f5f9;
  font-size: 25rpx;
  color: #5b6170;
}
.channel-pill.active {
  background: rgba(0, 108, 73, 0.12);
  color: #E8925E;
  font-weight: 600;
}

.title-input {
  font-size: 34rpx;
  font-weight: 700;
  padding: 8rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f1f5;
}
.content-input {
  margin-top: 20rpx;
  min-height: 360rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 16rpx;
}
.img-add {
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #b6bbc6;
}
.submit {
  margin-top: 36rpx;
}

/* ===== 发布规范提示 ===== */
.pub-rule {
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #F4F8FF;
  border: 1rpx solid #D8E4F8;
}
.pub-rule-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.pub-rule-icon {
  font-size: 28rpx;
  line-height: 1;
}
.pub-rule-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2C4A73;
}
.pub-rule-line {
  font-size: 23rpx;
  line-height: 1.7;
  color: #4E6484;
  margin-top: 6rpx;
}

/* ===== 规范与协议确认 ===== */
.promise {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.promise-box {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  margin-top: 2rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C6CDD4;
  background: #FFFFFF;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
.promise-box.on {
  background: #0E9A60;
  border-color: #0E9A60;
}
.promise-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5B6470;
}
.promise-link {
  color: #0E9A60;
  font-weight: 600;
}

/* 可见范围：两个选项卡片，选中的描边 + 浅绿底
   ⚠️ 别给 .vis-opt 写内联 style：WXML 内联样式会静默覆盖 wxss（2026-10-27 已踩过） */
.vis-opts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.vis-opt {
  border: 2rpx solid #ECEEF3;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  background: #FBFBFD;
}
.vis-opt.active {
  border-color: #006C49;
  background: rgba(0, 108, 73, 0.06);
}
/* 用透明度做按压反馈，避免 hover 背景把选中态的浅绿底盖掉 */
.vis-opt-hover {
  opacity: 0.85;
}
.vis-opt-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.vis-opt-icon {
  font-size: 28rpx;
}
.vis-opt-title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.vis-opt-check {
  font-size: 26rpx;
  font-weight: 700;
  color: #006C49;
}
.vis-opt-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8A8F99;
}
