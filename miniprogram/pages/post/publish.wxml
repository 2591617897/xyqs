<view class="page">
  <!-- 发布规范：UGC 平台必须在写内容前明确告知 -->
  <view class="pub-rule">
    <view class="pub-rule-head">
      <text class="pub-rule-icon">📋</text>
      <text class="pub-rule-title">发帖前请确认</text>
    </view>
    <view class="pub-rule-line">1. 内容真实、来源可靠，不造谣、不传谣、不发布未经核实的“爆料”。</view>
    <view class="pub-rule-line">2. 不辱骂攻击、不人身威胁、不曝光他人姓名 / 学号 / 手机号 / 宿舍号 / 照片。</view>
    <view class="pub-rule-line">3. 不发布色情低俗、赌博、贷款、代考代写、刷单、兼职拉人头等违法违规信息。</view>
    <view class="pub-rule-line">4. 本站不提供交易与支付功能，请勿发布买卖、代购、收款、引流到站外交易的内容。</view>
    <view class="pub-rule-line">5. 转载他人内容请注明来源；涉及个人信息的图片请先打码。</view>
  </view>

  <view class="card">
    <view class="h2">选择频道</view>
    <view class="channel-wrap mt16">
      <view
        class="channel-pill {{channelId === item.id ? 'active' : ''}}"
        wx:for="{{channels}}"
        wx:key="id"
        bindtap="chooseChannel"
        data-id="{{item.id}}"
      >{{item.icon}} {{item.name}}</view>
    </view>
  </view>

  <view class="card">
    <input style="height: 100rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx"
      class="title-input"
      placeholder="标题：紫金港食堂测评，这 5 个窗口闭眼入"
      placeholder-class="placeholder"
      maxlength="40"
      value="{{title}}"
      data-field="title"
      bindinput="onInput"
    />
    <textarea style="position: relative; left: 0rpx; top: 7rpx; height: 407rpx; display: block; box-sizing: border-box"
      class="textarea content-input"
      placeholder="分享你的校园见闻、攻略或吐槽…"
      placeholder-class="placeholder"
      maxlength="3000"
      value="{{content}}"
      data-field="content"
      bindinput="onInput"
    />
    <view class="muted mt8">{{content.length}}/3000</view>
  </view>

  <view class="card">
    <view class="h2">配图（选填）</view>
    <view class="img-grid mt16">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image class="img-thumb" src="{{item}}" mode="aspectFill" />
        <view class="img-del" catchtap="removeImage" data-index="{{index}}">✕</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">＋</view>
    </view>
  </view>

  <!-- 可见范围：默认仅本校，切到「同市可见」后同城高校的同学都能刷到 -->
  <view class="card">
    <view class="h2">可见范围</view>
    <view class="muted mt16">决定哪些同学能刷到这条帖子，发布后可以在编辑里改</view>
    <view class="vis-opts mt16">
      <view
        class="vis-opt {{visibility === item.value ? 'active' : ''}}"
        wx:for="{{visibilityOptions}}"
        wx:key="value"
        bindtap="chooseVisibility"
        data-value="{{item.value}}"
        hover-class="vis-opt-hover"
      >
        <view class="vis-opt-head">
          <text class="vis-opt-icon">{{item.icon}}</text>
          <text class="vis-opt-title">{{item.title}}</text>
          <text class="vis-opt-check" wx:if="{{visibility === item.value}}">✓</text>
        </view>
        <view class="vis-opt-sub">{{item.sub}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="promise" bindtap="toggleAgree">
      <view class="promise-box {{agreed ? 'on' : ''}}">{{agreed ? '✓' : ''}}</view>
      <view class="promise-text">
        我已阅读并同意<text class="promise-link" catchtap="goRule">《社区规范》</text>与<text class="promise-link" catchtap="goAgreement">《用户服务协议》</text>，承诺发布内容真实合法、不侵犯他人权益，并接受内容安全检测。
      </view>
    </view>
  </view>

  <button class="btn btn-primary submit" loading="{{submitting}}" bindtap="submit">{{isEdit ? '保存修改' : '发布'}}</button>
</view>
