.rp {
  padding: 24rpx 24rpx 60rpx;
  background: #F5F6F8;
  min-height: 100vh;
  box-sizing: border-box;
}

.rp-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.rp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rp-label {
  font-size: 28rpx;
  color: #64748B;
}

.rp-value {
  font-size: 30rpx;
  color: #191C1E;
  font-weight: 600;
}

.rp-tip {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 12rpx;
}

.rp-title {
  font-size: 28rpx;
  color: #191C1E;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.rp-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rp-chip {
  font-size: 26rpx;
  color: #475569;
  background: #F1F5F9;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
}

.rp-chip--on {
  color: #fff;
  background: #006C49;
}

.rp-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #191C1E;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.rp-submit {
  margin-top: 12rpx;
  background: #006C49;
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.rp-submit[disabled] {
  background: #9CA3AF;
}

.rp-foot {
  font-size: 22rpx;
  color: #94A3B8;
  text-align: center;
  margin-top: 20rpx;
}
