<view class="page">
  <!-- 顶栏 -->
  <view class="topbar">
    <view class="tb-left">
      <view class="tb-back" bindtap="goBack" wx:if="{{false}}"></view>
      <text class="tb-title">私信</text>
    </view>
  </view>

  <!-- 对方信息 -->
  <view class="peer">
    <view class="peer-avatar">
      <image wx:if="{{peerAvatar}}" class="peer-img" src="{{peerAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar-default">
        <view class="ad-head"></view>
        <view class="ad-body"></view>
      </view>
      <view class="peer-check" wx:if="{{peerVerified}}">✓</view>
    </view>
    <view class="peer-main">
      <view class="peer-name-row">
        <text class="peer-name">{{peerName}}</text>
        <text class="peer-tag {{tag.cls}}" wx:for="{{peerTags}}" wx:for-item="tag" wx:key="text">{{tag.text}}</text>
      </view>
      <view class="peer-school">{{anon ? '💌 匿名纸条 · 身份保密' : '🎓 同校同学'}}</view>
    </view>
    <view class="peer-acts">
      <view class="peer-act" bindtap="onSafety">⋯</view>
    </view>
  </view>

  <!-- 消息列表：长按自己发的消息可撤回（微信同款，2 分钟内） -->
  <scroll-view class="msgs" scroll-y="true" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="msg-day">{{dayText}}</view>
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-row" id="msg-{{item.id}}">
        <!-- 我发的：长按可撤回 -->
        <view wx:if="{{item.from === 'me'}}" class="msg mine" bindlongpress="onLongPress" data-id="{{item.id}}">
          <view class="msg-body">
            <!-- 图片消息 -->
            <image wx:if="{{item.type === 'image'}}" class="msg-image" src="{{item.content}}" mode="aspectFill" bindtap="previewMedia" data-url="{{item.content}}" />
            <!-- 视频消息：只渲染首帧当封面（关掉全部原生控件），点一下进全屏播放层 -->
            <view wx:elif="{{item.type === 'video'}}" class="msg-video">
              <video
                class="mv-body"
                id="v-{{item.id}}"
                src="{{item.content}}"
                object-fit="contain"
                controls="{{false}}"
                show-center-play-btn="{{false}}"
                show-play-btn="{{false}}"
                show-fullscreen-btn="{{false}}"
                show-progress="{{false}}"
                enable-progress-gesture="{{false}}"
                bindtap="onTapVideo"
                data-url="{{item.content}}"
                bindloadedmetadata="onVideoMeta"
                data-id="{{item.id}}"
              />
              <view class="mv-hit" catchtap="onTapVideo" data-url="{{item.content}}">
                <view class="mv-play"><view class="ico ico-play"></view></view>
              </view>
              <text class="mv-dur" wx:if="{{item.durationText}}" catchtap="onTapVideo" data-url="{{item.content}}">{{item.durationText}}</text>
            </view>
            <!-- 地址卡片消息 -->
            <view class="loc-card" wx:elif="{{item.type === 'location'}}">
              <view class="loc-pin">📍 {{item.content}}</view>
            </view>
            <!-- 普通文本 -->
            <view class="bubble" wx:else>{{item.content}}</view>
            <view class="msg-time">{{item.timeText}}</view>
          </view>
          <view class="msg-avatar">
            <image wx:if="{{myAvatar}}" class="msg-img" src="{{myAvatar}}" mode="aspectFill" />
            <view wx:else class="avatar-default">
              <view class="ad-head"></view>
              <view class="ad-body"></view>
            </view>
          </view>
        </view>

        <!-- 对方发的：不可撤回，直接渲染 -->
        <view wx:else class="msg">
          <view class="msg-avatar">
            <image wx:if="{{peerAvatar && !anon}}" class="msg-img" src="{{peerAvatar}}" mode="aspectFill" />
            <view wx:else class="avatar-default">
              <view class="ad-head"></view>
              <view class="ad-body"></view>
            </view>
          </view>
          <view class="msg-body">
            <!-- 图片消息 -->
            <image wx:if="{{item.type === 'image'}}" class="msg-image" src="{{item.content}}" mode="aspectFill" bindtap="previewMedia" data-url="{{item.content}}" />
            <!-- 视频消息：只渲染首帧当封面（关掉全部原生控件），点一下进全屏播放层 -->
            <view wx:elif="{{item.type === 'video'}}" class="msg-video">
              <video
                class="mv-body"
                id="v-{{item.id}}"
                src="{{item.content}}"
                object-fit="contain"
                controls="{{false}}"
                show-center-play-btn="{{false}}"
                show-play-btn="{{false}}"
                show-fullscreen-btn="{{false}}"
                show-progress="{{false}}"
                enable-progress-gesture="{{false}}"
                bindtap="onTapVideo"
                data-url="{{item.content}}"
                bindloadedmetadata="onVideoMeta"
                data-id="{{item.id}}"
              />
              <view class="mv-hit" catchtap="onTapVideo" data-url="{{item.content}}">
                <view class="mv-play"><view class="ico ico-play"></view></view>
              </view>
              <text class="mv-dur" wx:if="{{item.durationText}}" catchtap="onTapVideo" data-url="{{item.content}}">{{item.durationText}}</text>
            </view>
            <view class="loc-card" wx:elif="{{item.type === 'location'}}">
              <view class="loc-pin">📍 {{item.content}}</view>
            </view>
            <view class="bubble" wx:else>{{item.content}}</view>
            <view class="msg-time">{{item.timeText}}</view>
          </view>
        </view>
      </view>
    </block>
    <view class="msgs-pad"></view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input class="ib-input" placeholder="发消息给{{peerName}}..." placeholder-class="ph" value="{{draft}}" bindinput="onDraft" bindconfirm="onSend" confirm-type="send" />
    <view class="ib-icon" bindtap="onPlus">⊕</view>
    <view class="ib-send" bindtap="onSend">发送</view>
  </view>

  <!-- 视频全屏播放层：点消息里的视频卡进入，autoplay 直接开播（2026-10-28） -->
  <view class="vplayer" wx:if="{{vpShow}}" catchtouchmove="noop">
    <view class="vp-bar">
      <view class="vp-close" hover-class="vp-close-hover" bindtap="closeVideo">
        <view class="ico ico-close"></view>
      </view>
      <text class="vp-tip">全屏播放中</text>
    </view>
    <video
      class="vp-body"
      id="vp-video"
      src="{{vpUrl}}"
      autoplay="{{true}}"
      controls="{{true}}"
      object-fit="contain"
      show-center-play-btn="{{true}}"
      bindended="closeVideo"
    />
  </view>
</view>
