<view class="page" wx:if="{{goods}}">
  <!-- 图片 -->
  <swiper wx:if="{{goods.imageList.length}}" class="gallery" indicator-dots="true" circular="true" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{goods.imageList}}" wx:key="*this">
      <image class="gallery-img" src="{{item}}" mode="aspectFill" bindtap="preview" data-url="{{item}}" />
    </swiper-item>
  </swiper>
  <view wx:else class="gallery gallery-empty">{{goods.emoji}}</view>

  <!-- 主信息 -->
  <view class="main-card">
    <view class="price-row">
      <view class="price big"><text class="price-symbol">¥</text>{{goods.priceText}}</view>
      <text class="origin" wx:if="{{goods.originalPrice}}">原价 ¥{{goods.originalPrice}}</text>
      <view class="flex1"></view>
      <text class="muted">{{goods.viewCount}} 次浏览</text>
    </view>
    <view class="title">{{goods.title}}</view>
    <view class="row wrap gap12 mt16">
      <text class="tag tag-brand">{{goods.categoryName}}</text>
      <text class="tag">{{goods.tradeType === 1 ? '校内自提' : '支持邮寄'}}</text>
      <text class="tag" wx:if="{{goods.location}}">📍 {{goods.location}}</text>
      <text class="tag tag-warn" wx:if="{{goods.status === 2}}">已售出</text>
      <text class="tag" wx:if="{{goods.status === 0}}">已下架</text>
    </view>
  </view>

  <!-- 卖家 -->
  <view class="card seller">
    <image wx:if="{{goods.sellerAvatar}}" class="avatar-lg" src="{{goods.sellerAvatar}}" mode="aspectFill" />
    <view wx:else class="avatar-lg">
      <view class="avatar-default">
        <view class="ad-head"></view>
        <view class="ad-body"></view>
      </view>
    </view>
    <view class="flex1 ml20">
      <view class="h2">{{goods.sellerName}}</view>
      <view class="muted mt8">发布于 {{goods.timeText}} · 同校交易更安心</view>
    </view>
  </view>

  <!-- 描述 -->
  <view class="card">
    <view class="h2">宝贝描述</view>
    <view class="desc mt16">{{goods.description || '卖家很懒，什么都没写～'}}</view>
  </view>

  <view class="card tip-card">
    <view class="h2">交易提醒</view>
    <view class="tip-item">· 建议在校内公共区域当面交易，先验货再付款</view>
    <view class="tip-item">· 平台仅提供信息撮合，请勿提前转账</view>
    <view class="tip-item">· 遇到可疑情况可在「我的-帮助与反馈」举报</view>
  </view>

  <view class="bottom-space"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <block wx:if="{{isOwner}}">
      <view class="owner-tag">{{goods.status === 1 ? '在售中' : (goods.status === 2 ? '已售出' : '已下架')}}</view>
      <button class="btn btn-plain btn-sm" bindtap="goEdit">编辑</button>
      <button class="btn btn-plain btn-sm" bindtap="toggleStatus">{{goods.status === 1 ? '下架' : '上架'}}</button>
      <button class="btn btn-ghost btn-sm" bindtap="removeGoods">删除</button>
    </block>
    <block wx:else>
      <view class="like-btn" bindtap="toggleLike">
        <text class="like-icon {{liked ? 'liked' : ''}}">{{liked ? '♥' : '♡'}}</text>
        <text class="like-text">{{goods.likeCount || 0}}</text>
      </view>
      <button class="btn btn-primary flex1" bindtap="openOrder">
        {{goods.status === 1 ? '我想要 · 联系卖家' : (goods.status === 2 ? '该商品已售出' : '该商品已下架')}}
      </button>
    </block>
  </view>

  <!-- 购买意向弹层 -->
  <view class="mask" wx:if="{{showOrder}}" bindtap="closeOrder">
    <view class="sheet" catchtap="stop">
      <view class="sheet-head">
        <text class="h2">联系卖家</text>
        <text class="sheet-close" bindtap="closeOrder">✕</text>
      </view>
      <view class="sheet-goods">
        <view class="sheet-cover">{{goods.emoji}}</view>
        <view class="flex1">
          <view class="clamp2 sheet-title">{{goods.title}}</view>
          <view class="price mt8"><text class="price-symbol">¥</text>{{goods.priceText}}</view>
        </view>
      </view>
      <input class="sheet-input" placeholder="留个联系方式（QQ / 微信 / 手机号）" placeholder-class="placeholder" value="{{contact}}" bindinput="onContact" />
      <textarea class="sheet-textarea" placeholder="想对卖家说点什么（选填）" placeholder-class="placeholder" value="{{message}}" bindinput="onMessage" maxlength="200" />
      <button class="btn btn-primary mt24" loading="{{submitting}}" bindtap="submitOrder">发送购买意向</button>
      <view class="sheet-note">卖家确认后会主动联系你</view>
    </view>
  </view>
</view>

<view class="loading-hero" wx:if="{{loading && !goods}}">
  <view class="loading-block"></view>
  <text class="loading-text">加载中…</text>
</view>

<view class="empty" wx:elif="{{!goods}}">
  <text class="empty-icon">📦</text>
  <text>{{loadError ? '加载失败，请检查网络或后端服务' : '商品不存在或已下架'}}</text>
  <view class="btn btn-ghost btn-sm retry-btn" bindtap="retry" wx:if="{{loadError}}">重新加载</view>
</view>
