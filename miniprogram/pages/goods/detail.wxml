<view class="page" wx:if="{{goods}}">
  <!-- 图片轮播：顶部通栏 4:3 + 角标 + 计数胶囊 -->
  <view class="gallery-wrap">
    <swiper
      wx:if="{{goods.imageList.length}}"
      class="gallery"
      circular="true"
      bindchange="onGalleryChange"
    >
      <swiper-item wx:for="{{goods.imageList}}" wx:key="*this">
        <view wx:if="{{goods.imgFailed[index]}}" class="gallery-img gallery-img-failed">{{goods.emoji}}</view>
        <image wx:else class="gallery-img" src="{{item}}" mode="aspectFill" bindtap="preview" data-url="{{item}}" binderror="onImgError" data-index="{{index}}" />
      </swiper-item>
    </swiper>
    <view wx:else class="gallery gallery-empty">
      <text class="gallery-emoji">{{goods.emoji}}</text>
      <text class="gallery-empty-tip">卖家没有上传图片，可以私聊向 TA 看图</text>
    </view>

    <!-- 左上角标签浮层 -->
    <view class="gallery-tags" wx:if="{{goods.imageList.length}}">
      <view class="gallery-tag mint">
        <text class="gt-check">✓</text>
        <text>{{goods.categoryName || '闲置'}}</text>
      </view>
      <view class="gallery-tag ghost" wx:if="{{goods.supportTrial === 1}}">🏫 支持自提验机</view>
    </view>

    <!-- 右下角计数胶囊 -->
    <view class="gallery-counter" wx:if="{{goods.imageList.length}}">{{galleryIndex}}/{{goods.imageList.length}}</view>
  </view>

  <view class="body">
    <!-- 价格与标题卡（上浮压住轮播底边，形成层次） -->
    <view class="card price-card">
      <view class="price-row">
        <view class="price-main">
          <text class="price-symbol">¥</text>
          <text class="price-num">{{goods.priceText}}</text>
          <text class="price-origin" wx:if="{{goods.originalPrice}}">原价 ¥{{goods.originalPrice}}</text>
        </view>
        <view class="save-pill" wx:if="{{goods.saveText}}">{{goods.saveText}}</view>
      </view>
      <view class="g-title">{{goods.title}}</view>
      <view class="g-meta">
        <view class="g-loc">📍 {{goods.location || '校内交易'}}</view>
        <view class="g-stats">
          <text>浏览 {{goods.viewCount || 0}}</text>
          <text class="g-stat-gap">想要 {{goods.likeCount || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 卖家卡 -->
    <view class="card">
      <view class="seller-row">
        <view class="seller-avatar-wrap" catchtap="goUserSpace">
          <image wx:if="{{goods.sellerAvatar}}" class="seller-avatar" src="{{goods.sellerAvatar}}" mode="aspectFill" binderror="onAvatarError" />
          <view wx:else class="seller-avatar">
            <view class="avatar-default">
              <view class="ad-head"></view>
              <view class="ad-body"></view>
            </view>
          </view>
          <view class="seller-check">✓</view>
        </view>
        <view class="seller-info" catchtap="goUserSpace">
          <view class="seller-name-row">
            <text class="seller-name">{{goods.sellerName}}</text>
            <text class="seller-verified">已实名学生认证</text>
          </view>
          <view class="seller-school">🎓 {{goods.schoolName || '同校同学'}} · 发布于 {{goods.timeText}}</view>
        </view>
        <view class="follow-btn {{following ? 'on' : ''}}" wx:if="{{!isOwner}}" catchtap="onFollow">{{following ? '已关注' : '关注'}}</view>
      </view>
      <view class="seller-metrics">
        <view class="metric" wx:for="{{goods.sellerMeta}}" wx:key="top">
          <view class="metric-top {{item.brand ? 'brand' : ''}}">{{item.icon}} {{item.top}}</view>
          <view class="metric-sub">{{item.sub}}</view>
        </view>
      </view>
    </view>

    <!-- 规格与成色 -->
    <view class="card">
      <view class="card-head">
        <view class="head-bar"></view>
        <text class="head-title">规格与成色信息</text>
      </view>
      <view class="spec-list">
        <view class="spec-item" wx:for="{{goods.specs}}" wx:key="label">
          <view class="spec-label">{{item.icon}} {{item.label}}</view>
          <view class="spec-value {{item.warn ? 'warn' : ''}} {{item.brand ? 'brand' : ''}}">{{item.value}}</view>
        </view>
      </view>
    </view>

    <!-- 宝贝详细描述 -->
    <view class="card">
      <view class="card-head">
        <view class="head-bar"></view>
        <text class="head-title">宝贝详细描述</text>
      </view>
      <view class="desc">{{goods.description || '卖家很懒，什么都没写～'}}</view>
      <view class="desc-note" wx:if="{{goods.supportTrial === 1}}">支持校内任意地点当面验货！诚心想要的同校同学欢迎点击下方随时发起沟通～</view>
    </view>

    <!-- 安全提示 -->
    <view class="safety">
      <text class="safety-icon">🛡️</text>
      <view class="safety-body">
        <view class="safety-title">校园同校交易安全提示</view>
        <view class="safety-text">建议在食堂、宿舍楼前台大厅等人流密集处当面验货交易。警惕脱离平台私下微信转账、货到付款等风险行为。</view>
      </view>
    </view>

    <!-- 评论区（含楼中楼回复） -->
    <view class="card comment-card">
      <view class="card-head">
        <view class="head-bar"></view>
        <text class="head-title">全部评论</text>
        <text class="cc-count">{{goods.commentCount || 0}}</text>
      </view>

      <!-- 评论列表 -->
      <view class="cc-list" wx:if="{{comments.length}}">
        <view class="comment-item" wx:for="{{comments}}" wx:for-index="cindex" wx:key="id">
          <view class="ci-avatar">
            <image wx:if="{{item.userAvatar}}" class="ci-avatar-img" src="{{item.userAvatar}}" mode="aspectFill" />
            <view wx:else class="avatar-default">
              <view class="ad-head"></view>
              <view class="ad-body"></view>
            </view>
          </view>
          <view class="ci-body">
            <view class="ci-name">{{item.userName || '校园用户'}}</view>
            <view class="ci-text" wx:if="{{item.content}}">{{item.content}}</view>
            <view class="ci-imgs" wx:if="{{item.imageList.length}}">
              <image
                wx:for="{{item.imageList}}"
                wx:for-item="img"
                wx:key="*this"
                class="ci-img"
                src="{{img}}"
                mode="aspectFill"
                catchtap="previewCommentImage"
                data-url="{{img}}"
              />
            </view>
            <view class="ci-foot">
              <text class="ci-time">{{item.timeText}}</text>
              <view class="flex1"></view>
              <text class="ci-reply-btn" catchtap="replyComment" data-id="{{item.id}}" data-name="{{item.userName || '校园用户'}}">回复</text>
              <text class="ci-del" wx:if="{{item.mine}}" catchtap="deleteComment" data-id="{{item.id}}">删除</text>
            </view>

            <!-- 楼中楼回复 -->
            <view class="ci-replies" wx:if="{{item.replies && item.replies.length}}">
              <view class="reply-item" wx:for="{{item.repliesShown}}" wx:for-item="rp" wx:key="id">
                <view class="ci-avatar">
                  <image wx:if="{{rp.userAvatar}}" class="ci-avatar-img" src="{{rp.userAvatar}}" mode="aspectFill" />
                  <view wx:else class="avatar-default">
                    <view class="ad-head"></view>
                    <view class="ad-body"></view>
                  </view>
                </view>
                <view class="ci-body">
                  <view class="ci-name">{{rp.userName || '校园用户'}}</view>
                  <view class="ci-text">
                    <text wx:if="{{rp.replyToName}}" class="reply-to">回复 {{rp.replyToName}}：</text>{{rp.content}}
                  </view>
                  <view class="ci-foot">
                    <text class="ci-time">{{rp.timeText}}</text>
                    <view class="flex1"></view>
                    <text class="ci-reply-btn" catchtap="replyComment" data-id="{{rp.id}}" data-name="{{rp.userName || '校园用户'}}">回复</text>
                    <text class="ci-del" wx:if="{{rp.mine}}" catchtap="deleteComment" data-id="{{rp.id}}">删除</text>
                  </view>
                </view>
              </view>
              <view class="reply-more" wx:if="{{item.replyCount > 5 && !item.expanded}}" catchtap="toggleReplies" data-index="{{cindex}}">
                查看全部 {{item.replyCount}} 条回复 ›
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="comment-empty" wx:if="{{!comments.length}}">
        <text class="empty-icon">💬</text>
        <text>还没有评论，来抢沙发</text>
      </view>

      <!-- 入口：点击弹出评论抽屉 -->
      <view class="cc-entry" bindtap="openCommentSheet">
        <text class="cc-entry-hint">{{replyTo ? '回复 @' + replyTo.name : '写评论…'}}</text>
        <view class="cc-entry-tools">
          <text class="cc-entry-icon">😊</text>
          <text class="cc-entry-icon">🖼</text>
        </view>
      </view>
    </view>

    <!-- 校友问答（有真实提问数据时才展示） -->
    <view class="card qa-card" wx:if="{{goods.qaList.length}}">
      <view class="card-head between">
        <view class="row">
          <view class="head-bar"></view>
          <text class="head-title">校友问答</text>
          <text class="qa-count">（{{goods.qaList.length}}条提问）</text>
        </view>
        <view class="qa-ask" bindtap="goChat">✏️ 向TA提问</view>
      </view>
      <view class="qa-list">
        <view class="qa-item" wx:for="{{goods.qaList}}" wx:key="q">
          <view class="qa-row">
            <view class="qa-badge q">问</view>
            <view class="qa-text">{{item.q}}</view>
          </view>
          <view class="qa-row indent">
            <view class="qa-badge a">答</view>
            <view class="qa-text sub">{{item.a}}</view>
          </view>
          <view class="qa-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>

  <!-- 评论抽屉：底部半屏弹起 -->
  <view class="mask comment-mask" wx:if="{{showCommentSheet}}" catchtap="closeCommentSheet"></view>
  <view class="comment-sheet {{showCommentSheet ? 'on' : ''}}" catchtap="stop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-head-title">{{replyTo ? '回复 @' + replyTo.name : '发表评论'}}</text>
      <text class="sheet-head-close" catchtap="closeCommentSheet">✕</text>
    </view>

    <!-- 待发送配图 -->
    <view class="pending-imgs" wx:if="{{commentImages.length}}">
      <view class="p-item" wx:for="{{commentImages}}" wx:key="*this">
        <image class="p-thumb" src="{{item}}" mode="aspectFill" />
        <view class="p-del" catchtap="removeCommentImage" data-index="{{index}}">✕</view>
      </view>
      <text class="p-tip">最多 3 张</text>
    </view>

    <!-- 主输入 -->
    <view class="sheet-input-area">
      <textarea
        class="sheet-textarea"
        placeholder="{{replyTo ? '回复 ' + replyTo.name + '，说点什么…' : '说点什么，或者配张图吧…'}}"
        placeholder-class="placeholder"
        value="{{commentInput}}"
        auto-height
        maxlength="500"
        focus="{{commentSheetFocus}}"
        confirm-type="send"
        bindinput="onCommentInput"
        bindconfirm="sendComment"
      />
      <view class="sheet-count">{{commentInput.length || 0}}/500</view>
    </view>

    <!-- 工具行 + 发送 -->
    <view class="sheet-toolbar">
      <view class="sheet-tools">
        <view class="sheet-tool {{showEmoji ? 'on' : ''}}" catchtap="toggleEmoji">😊</view>
        <view class="sheet-tool" catchtap="chooseCommentImage">🖼</view>
        <view class="sheet-tool" catchtap="insertAt">@</view>
      </view>
      <view class="sheet-send {{commentInput || commentImages.length ? 'on' : ''}}" bindtap="sendComment">发布</view>
    </view>

    <!-- 表情面板 -->
    <view class="emoji-panel" wx:if="{{showEmoji}}">
      <view class="emoji-grid">
        <view
          class="emoji-item"
          wx:for="{{emojiList}}"
          wx:key="*this"
          catchtap="addEmoji"
          data-emoji="{{item}}"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏：左侧图标动作组 + 右侧主次双按钮 -->
  <view class="bottom-bar">
    <block wx:if="{{isOwner}}">
      <view class="owner-status {{goods.status === 1 ? 'on' : (goods.status === 2 ? 'sold' : 'off')}}">
        <view class="status-dot"></view>
        <text>{{goods.status === 1 ? '在售中' : (goods.status === 2 ? '已售出' : '已下架')}}</text>
      </view>
      <view class="owner-acts">
        <button class="act-btn act-edit" hover-class="act-btn-hover" bindtap="goEdit">编辑</button>
        <button class="act-btn" hover-class="act-btn-hover" bindtap="toggleStatus">{{goods.status === 1 ? '下架' : '上架'}}</button>
        <button class="act-btn act-danger" hover-class="act-btn-hover" bindtap="removeGoods">删除</button>
      </view>
    </block>
    <block wx:else>
      <view class="bar-acts">
        <view class="bar-act" hover-class="bar-act-hover" bindtap="toggleLike" aria-role="button" aria-label="{{liked ? '取消收藏' : '收藏'}}">
          <view class="bar-act-icon {{liked ? 'liked' : ''}}">{{liked ? '♥' : '♡'}}</view>
          <text class="bar-act-text">{{liked ? '已收藏' : '收藏'}}</text>
        </view>
        <button class="bar-act" open-type="share" hover-class="bar-act-hover" aria-label="分享">
          <view class="bar-act-icon">↗</view>
          <text class="bar-act-text">分享</text>
        </button>
      </view>
      <view class="bar-cta">
        <view class="cta-chat" hover-class="cta-chat-hover" bindtap="goChat" aria-role="button" aria-label="和卖家聊一聊">
          <text class="cta-chat-emoji">💬</text>
          <text class="cta-chat-text">聊一聊</text>
        </view>
        <view class="cta-buy {{goods.status === 1 ? '' : 'off'}}" hover-class="cta-buy-hover" bindtap="openOrder" aria-role="button" aria-label="申请自提">
          <text class="cta-buy-text">{{goods.status === 1 ? '申请自提' : (goods.status === 2 ? '已售出' : '已下架')}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 购买意向弹层 -->
  <view class="mask" wx:if="{{showOrder}}" bindtap="closeOrder">
    <view class="sheet" catchtap="stop">
      <view class="sheet-head">
        <text class="h2">申请自提 · 联系卖家</text>
        <text class="sheet-close" bindtap="closeOrder">✕</text>
      </view>
      <view class="sheet-goods">
        <view class="sheet-cover">{{goods.emoji}}</view>
        <view class="flex1">
          <view class="clamp2 sheet-title">{{goods.title}}</view>
          <view class="sheet-price"><text class="price-symbol">¥</text>{{goods.priceText}}</view>
        </view>
      </view>
      <input class="sheet-input" placeholder="留个联系方式（QQ / 微信 / 手机号）" placeholder-class="placeholder" value="{{contact}}" bindinput="onContact" />
      <textarea class="sheet-textarea" placeholder="想对卖家说点什么（选填）" placeholder-class="placeholder" value="{{message}}" bindinput="onMessage" maxlength="200" />
      <button class="btn btn-primary mt24" loading="{{submitting}}" bindtap="submitOrder">发送购买意向</button>
      <view class="sheet-note">卖家确认后会主动联系你</view>
    </view>
  </view>
</view>

<view class="loading-hero" wx:if="{{loading && !goods}}">
  <view class="loading-block"></view>
  <text class="loading-text">加载中…</text>
</view>

<view class="empty" wx:elif="{{!goods}}">
  <text class="empty-icon">📦</text>
  <text>{{loadError ? '加载失败，请检查网络' : '商品不存在或已下架'}}</text>
  <view class="btn btn-ghost btn-sm retry-btn" bindtap="retry" wx:if="{{loadError}}">重新加载</view>
</view>
