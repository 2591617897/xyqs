.page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
}
.s-wrap {
  flex: 1;
  height: 76rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.s-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}
.s-input {
  flex: 1;
  font-size: 27rpx;
  color: #2D2D2D;
}
.s-ph {
  color: #b6bbc6;
  font-size: 26rpx;
}
.s-clear {
  font-size: 24rpx;
  color: #b6bbc6;
  padding: 0 6rpx;
}
.s-btn {
  font-size: 27rpx;
  color: #E8925E;
  font-weight: 600;
}

/* 分类 */
.cat-scroll {
  background: #ffffff;
  white-space: nowrap;
  padding-bottom: 12rpx;
}
.cat-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 24rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f5f9;
  font-size: 25rpx;
  color: #5b6170;
}
.cat-chip.active {
  background: rgba(30, 95, 168, 0.12);
  color: #E8925E;
  font-weight: 600;
}
.cat-emoji {
  font-size: 24rpx;
}

/* 排序 */
.sort-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 22rpx 24rpx 18rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #8b8f99;
}
.sort-item.active {
  color: #2D2D2D;
  font-weight: 700;
}
.total-text {
  font-size: 23rpx;
  color: #b6bbc6;
}

/* 商品网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 24rpx;
}
.goods-card {
  width: calc((100% - 20rpx) / 2);
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  /* 竖向 flex：同一行的两张卡等高时，内部内容能撑满而不是顶部堆积 */
  display: flex;
  flex-direction: column;
}
.goods-cover {
  position: relative;
  height: 220rpx;
}
.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cover-tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(31, 35, 41, 0.55);
  color: #ffffff;
  font-size: 20rpx;
}
/* 推广标签放右上角，避开左下角的「自提 / 已售出」 */
.cover-promote {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(30, 95, 168, 0.85);
  color: #ffffff;
  font-size: 20rpx;
}
.cover-status {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 35, 41, 0.45);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.goods-body {
  padding: 18rpx 20rpx 20rpx;
  /* 撑满剩余高度，配合 .goods-stats 的 margin-top:auto 让统计行吸底 */
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.goods-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text-1);
}
/* 描述摘要：标题只有一行时，它接在下面把卡片下半部分填起来 */
.goods-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-3);
}
/* 地址 / 浏览 / 想要：详情页才看得到的数据，提前摊在卡片上 */
.goods-stats {
  margin-top: auto;
  padding-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 20rpx;
  line-height: 1;
  color: var(--text-4);
}
.gs-item {
  flex-shrink: 0;
}
.gs-loc {
  flex: 1;
  min-width: 0;
  flex-shrink: 1;
}
.list-tip {
  text-align: center;
  font-size: 23rpx;
  color: #b6bbc6;
  padding: 32rpx 0;
}
.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
}

/* 悬浮发布按钮上移，避开自定义 tabBar */
.fab {
  bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   搜索：输入即搜 + 历史/热词面板 + 命中高亮
   ============================================================ */

/* 外层撑起层叠上下文：面板、遮罩都要盖住下面的广告位/列表 */
.search-area {
  position: relative;
  z-index: 60;
}
/* 搜索栏本身要压在遮罩之上，否则点输入框会被遮罩吃掉 */
.search-bar {
  position: relative;
  z-index: 62;
}
.s-btn.busy {
  color: #c2c7d0;
}

/* 遮罩：点空白处收面板。不加深色背景，避免整页闪黑 */
.s-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 58;
  background: transparent;
}

/* 建议面板：贴在搜索栏正下方，圆角只做下方，视觉上是搜索栏的延伸 */
.s-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 60;
  background: #ffffff;
  padding: 4rpx 24rpx 26rpx;
  border-radius: 0 0 26rpx 26rpx;
  box-shadow: 0 16rpx 28rpx rgba(15, 23, 42, .07);
}

.sp-sec {
  padding-top: 18rpx;
}
.sp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 4rpx 14rpx;
}
.sp-title {
  font-size: 24rpx;
  color: #8b8f99;
}
.sp-act {
  font-size: 23rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.sp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sp-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  background: #f4f5f9;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #4b5058;
  max-width: 460rpx;
}
.sp-tag.hot {
  background: #fff5ec;
  color: #E8925E;
}
.sp-word {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-del {
  font-size: 20rpx;
  color: #c2c7d0;
  padding-left: 4rpx;
}

/* 搜索态提示条 */
.ss-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 6rpx;
  padding: 14rpx 20rpx;
  background: #fff5ec;
  border-radius: 16rpx;
}
.ss-kw {
  font-size: 25rpx;
  color: #E8925E;
  font-weight: 600;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ss-total {
  font-size: 23rpx;
  color: #b6bbc6;
}
.ss-clear {
  font-size: 23rpx;
  color: #E8925E;
  padding: 4rpx 8rpx;
}

/* 标题命中高亮 */
.kw-hit {
  color: #E8925E;
  font-weight: 600;
}

/* 空结果里的换词引导 */
.hs {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.hs-title {
  font-size: 24rpx;
  color: #8b8f99;
}
.hs-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  padding: 0 40rpx;
}
.hs-tag {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #eceef2;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4b5058;
}
.hs-clear {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #E8925E;
  padding: 8rpx 12rpx;
}

/* 搜索面板底部：多词搜索的规则说明。字号压到最小，不抢内容焦点 */
.sp-hint {
  margin-top: 18rpx;
  padding: 14rpx 4rpx 0;
  border-top: 1rpx solid #f2f3f7;
  font-size: 22rpx;
  line-height: 1.5;
  color: #b6bbc6;
}
