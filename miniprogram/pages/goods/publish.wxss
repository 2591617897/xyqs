.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #fff7f2;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.hint-icon {
  font-size: 28rpx;
}
.hint-text {
  font-size: 23rpx;
  color: #a8724f;
  line-height: 1.6;
  flex: 1;
}

.title-input {
  display: block;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding: 0;
  border-bottom: 1rpx solid #f0f1f5;
}
.desc-input {
  margin-top: 20rpx;
  min-height: 200rpx;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}
.symbol {
  font-size: 28rpx;
  color: #ff4d4f;
  margin-right: 6rpx;
}
.price-input {
  text-align: right;
  font-size: 34rpx;
  font-weight: 600;
  color: #ff4d4f;
  width: 280rpx;
}

.cat-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: flex-end;
}
.cat-pill {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f4f5f9;
  font-size: 24rpx;
  color: #5b6170;
}
.cat-pill.active {
  background: rgba(0, 108, 73, 0.12);
  color: #E8925E;
  font-weight: 600;
}

/* 规格与成色：picker 占位色与清除按钮 */
.field-ph {
  color: #9b9ba3;
}
.pick-clear {
  font-size: 24rpx;
  color: #9b9ba3;
  padding: 12rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 0 0 0 16rpx;
  background: rgba(17, 20, 26, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add {
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  border: 2rpx dashed #dfe3ec;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.img-add-icon {
  font-size: 44rpx;
  color: #b6bbc6;
  line-height: 1;
}
.img-add-text {
  font-size: 20rpx;
  color: #b6bbc6;
  margin-top: 6rpx;
}

.seg {
  display: flex;
  background: #f4f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 12rpx;
}
.seg-item.active {
  background: #ffffff;
  color: #2D2D2D;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.08);
}

.submit-wrap {
  margin-top: 36rpx;
}

/* ===== 合规提示：禁止线上交易 / 反诈 ===== */
.trade-warn {
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #FFF5F3;
  border: 1rpx solid #FFCFC4;
}
.trade-warn-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.trade-warn-icon {
  font-size: 30rpx;
  line-height: 1;
}
.trade-warn-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #B2311A;
}
.trade-warn-line {
  font-size: 24rpx;
  line-height: 1.72;
  color: #8A4A3A;
  margin-top: 6rpx;
}
.tw-strong {
  font-weight: 700;
  color: #B2311A;
}

/* ===== 发布承诺勾选 ===== */
.promise {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
}
.promise-box {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  margin-top: 2rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C6CDD4;
  background: #FFFFFF;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
.promise-box.on {
  background: #0E9A60;
  border-color: #0E9A60;
}
.promise-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5B6470;
}

/* 可见范围：两个选项卡片，选中的描边 + 浅绿底
   ⚠️ 别给 .vis-opt 写内联 style：WXML 内联样式会静默覆盖 wxss（2026-10-27 已踩过） */
.vis-opts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.vis-opt {
  border: 2rpx solid #ECEEF3;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  background: #FBFBFD;
}
.vis-opt.active {
  border-color: #006C49;
  background: rgba(0, 108, 73, 0.06);
}
/* 用透明度做按压反馈，避免 hover 背景把选中态的浅绿底盖掉 */
.vis-opt-hover {
  opacity: 0.85;
}
.vis-opt-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.vis-opt-icon {
  font-size: 28rpx;
}
.vis-opt-title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.vis-opt-check {
  font-size: 26rpx;
  font-weight: 700;
  color: #006C49;
}
.vis-opt-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8A8F99;
}
