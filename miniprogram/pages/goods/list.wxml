<view class="page">
  <!-- 搜索 -->
  <view class="search-bar">
    <view class="s-wrap">
      <text class="s-icon">🔍</text>
      <input
        class="s-input"
        value="{{keyword}}"
        placeholder="搜闲置：自行车 / 显示器 / 考研书"
        placeholder-class="s-ph"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{keyword}}" class="s-clear" bindtap="clearKeyword">✕</text>
    </view>
    <view class="s-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 运营投放位（后台广告位 code=goods_top）：只在浏览全部闲置时出现，
       「我的闲置 / 我的收藏」是个人列表，插广告既打扰也不符合投放口径 -->
  <ad-banner wx:if="{{!mineMode && !favMode}}" code="goods_top" height="{{240}}" />

  <block wx:if="{{!mineMode && !favMode}}">
    <!-- 分类 -->
    <scroll-view class="cat-scroll" scroll-x="true" show-scrollbar="false">
      <view class="cat-row">
        <view class="cat-chip {{categoryId === 0 ? 'active' : ''}}" bindtap="switchCategory" data-id="0">全部</view>
        <view
          class="cat-chip {{categoryId === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bindtap="switchCategory"
          data-id="{{item.id}}"
        >
          <text class="cat-emoji">{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 排序 -->
    <view class="sort-row">
      <view
        class="sort-item {{sort === item.key ? 'active' : ''}}"
        wx:for="{{sorts}}"
        wx:key="key"
        bindtap="switchSort"
        data-key="{{item.key}}"
      >{{item.label}}</view>
      <view class="flex1"></view>
      <text class="total-text">共 {{total}} 件</text>
    </view>
  </block>

  <!-- 列表 -->
  <view class="goods-grid">
    <view class="goods-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="goods-cover">
        <image
          wx:if="{{item.imageList.length && !item.imgFailed}}"
          class="cover-img"
          src="{{item.imageList[0]}}"
          mode="aspectFill"
          binderror="onImgError"
          data-index="{{index}}"
        />
        <view wx:else class="cover-empty">
          <view class="ce-icon">
            <view class="ce-sun"></view>
            <view class="ce-hill"></view>
          </view>
          <text class="ce-text">{{item.categoryName || '闲置'}}</text>
        </view>
        <view class="cover-status" wx:if="{{item.status !== 1}}">{{item.status === 2 ? '已售出' : '已下架'}}</view>
        <view class="cover-tag" wx:elif="{{item.tradeType === 1}}">自提</view>
        <!-- 推广中：作者看过广告，这条在同校列表里靠前展示 -->
        <view class="cover-promote" wx:if="{{item.promoteScore > 0}}">🚀 推广</view>
      </view>
      <view class="goods-body">
        <view class="goods-title clamp2">{{item.title}}</view>
        <view class="between mt8">
          <view class="price"><text class="price-symbol">¥</text>{{item.priceText}}</view>
          <text class="muted">{{item.timeText}}</text>
        </view>
        <view class="row gap8 mt8">
          <text class="tag">{{item.categoryName}}</text>
          <text class="muted ellipsis flex1">{{item.location || '校内交易'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text class="empty-icon">{{loadError ? '📡' : '🧺'}}</text>
    <text>{{loadError ? '加载失败，请检查网络或后端服务' : (mineMode ? '你还没有发布过闲置' : (favMode ? '还没有收藏的宝贝' : '没有找到相关闲置，换个关键词试试'))}}</text>
    <view class="btn btn-ghost btn-sm retry-btn" wx:if="{{loadError}}" bindtap="retry">重新加载</view>
  </view>

  <view class="list-tip" wx:if="{{list.length}}">
    {{loading ? '加载中…' : (mineMode || favMode ? '共 ' + list.length + ' 件' : (hasMore ? '上拉加载更多' : '没有更多啦'))}}
  </view>

  <view class="fab" wx:if="{{!mineMode && !favMode}}" bindtap="goPublish">＋</view>
</view>
