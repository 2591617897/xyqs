<view class="page">
  <view class="hint">
    <text class="hint-icon">💡</text>
    <text class="hint-text">发布需完成校园认证。同校交易，描述越真实越容易卖出。</text>
  </view>

  <view class="card">
    <input
      class="title-input"
      placeholder="标题：出个九成新的机械键盘"
      placeholder-class="placeholder"
      maxlength="40"
      value="{{title}}"
      data-field="title"
      bindinput="onInput"
    />
    <textarea
      class="textarea desc-input"
      placeholder="描述一下成色、入手时间、为什么出、有没有小瑕疵…"
      placeholder-class="placeholder"
      maxlength="1000"
      value="{{description}}"
      data-field="description"
      bindinput="onInput"
    />
    <view class="between mt16">
      <text class="muted">{{description.length}}/1000</text>
    </view>
  </view>

  <view class="card">
    <view class="field row">
      <text class="field-label">售价</text>
      <view class="price-input-wrap">
        <text class="symbol">¥</text>
        <input class="price-input" type="digit" placeholder="0.00" placeholder-class="placeholder" value="{{price}}" data-field="price" bindinput="onInput" />
      </view>
    </view>
    <view class="field row">
      <text class="field-label">原价</text>
      <view class="price-input-wrap">
        <text class="symbol">¥</text>
        <input class="price-input" type="digit" placeholder="选填，显示划线价" placeholder-class="placeholder" value="{{originalPrice}}" data-field="originalPrice" bindinput="onInput" />
      </view>
    </view>
    <view class="field row">
      <text class="field-label">分类</text>
      <view class="cat-wrap flex1">
        <view
          class="cat-pill {{categoryId === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bindtap="chooseCategory"
          data-id="{{item.id}}"
        >{{item.icon}} {{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="h2">规格与成色</view>
    <view class="muted mt16">选填，但填得越准，同校同学越敢下手</view>

    <view class="field row mt16">
      <text class="field-label">成色</text>
      <view class="cat-wrap flex1">
        <view
          class="cat-pill {{conditionLevel === item.id ? 'active' : ''}}"
          wx:for="{{conditionOptions}}"
          wx:key="id"
          bindtap="chooseCondition"
          data-id="{{item.id}}"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="field row">
      <text class="field-label">入手时间</text>
      <picker class="flex1 row" mode="date" fields="month" value="{{purchaseMonth}}" bindchange="onPurchaseChange">
        <text class="field-input {{purchaseTime ? '' : 'field-ph'}}">{{purchaseTime || '选填，如 2023年9月'}}</text>
        <text wx:if="{{purchaseTime}}" class="pick-clear" catchtap="clearPurchase">✕</text>
      </picker>
    </view>

    <view class="field row">
      <text class="field-label">使用频率</text>
      <view class="cat-wrap flex1">
        <view
          class="cat-pill {{usageFrequency === item ? 'active' : ''}}"
          wx:for="{{usageOptions}}"
          wx:key="*this"
          bindtap="chooseUsage"
          data-value="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <view class="field row">
      <text class="field-label">来源</text>
      <view class="cat-wrap flex1">
        <view
          class="cat-pill {{source === item ? 'active' : ''}}"
          wx:for="{{sourceOptions}}"
          wx:key="*this"
          bindtap="chooseSource"
          data-value="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <view class="field row">
      <text class="field-label">保修状态</text>
      <view class="cat-wrap flex1">
        <view
          class="cat-pill {{warranty === item ? 'active' : ''}}"
          wx:for="{{warrantyOptions}}"
          wx:key="*this"
          bindtap="chooseWarranty"
          data-value="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <view class="field row">
      <text class="field-label">面交试机</text>
      <text class="muted flex1">支持当面验货，满意再付</text>
      <switch checked="{{supportTrial === 1}}" bindchange="toggleTrial" color="#0e9a60" />
    </view>
  </view>

  <view class="card">
    <view class="h2">商品图片</view>
    <view class="img-grid mt16">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image class="img-thumb" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
        <view class="img-del" catchtap="removeImage" data-index="{{index}}">✕</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="img-add-icon">＋</text>
        <text class="img-add-text">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="h2">交易方式</view>
    <view class="seg mt16">
      <view class="seg-item {{tradeType === 1 ? 'active' : ''}}" bindtap="chooseTrade" data-type="1">校内自提</view>
      <view class="seg-item {{tradeType === 2 ? 'active' : ''}}" bindtap="chooseTrade" data-type="2">支持邮寄</view>
    </view>
    <view class="field row mt16">
      <text class="field-label">交易地点</text>
      <input class="field-input" placeholder="如：南苑食堂门口" placeholder-class="placeholder" maxlength="30" value="{{location}}" data-field="location" bindinput="onInput" />
    </view>
  </view>

  <view class="submit-wrap">
    <button class="btn btn-primary" loading="{{submitting}}" bindtap="submit">{{isEdit ? '保存修改' : '发布闲置'}}</button>
  </view>
</view>
