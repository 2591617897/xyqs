/* ===== 商品详情 · 对齐设计稿 Item Detail ===== */
.page {
  background: #f7f9fb;
  min-height: 100vh;
  padding-bottom: 1rpx;
}

/* ---------- 轮播 ---------- */
.gallery-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  background: #eceef0;
}
.gallery {
  width: 100%;
  height: 100%;
}
.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}
.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #f7f9fc 0%, #eaeef7 100%);
}
.gallery-emoji {
  font-size: 140rpx;
}
.gallery-img-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  background: linear-gradient(135deg, #f7f9fc 0%, #eaeef7 100%);
}
.gallery-empty-tip {
  font-size: 24rpx;
  color: #94a3b8;
}
.gallery-tags {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  display: flex;
  gap: 12rpx;
  z-index: 5;
}
.gallery-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.gallery-tag.mint {
  background: #10b981;
  color: #00422b;
}
.gallery-tag.mint .gt-check {
  font-size: 20rpx;
}
.gallery-tag.ghost {
  background: rgba(255, 255, 255, 0.92);
  color: #006c49;
  backdrop-filter: blur(8rpx);
}
.gallery-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(45, 49, 51, 0.66);
  color: #eff1f3;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  z-index: 5;
}

/* ---------- 主体卡片 ---------- */
.body {
  padding: 24rpx 24rpx 0;
}
.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx -4rpx rgba(16, 185, 129, 0.05), 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.04);
}

/* 价格与标题 */
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.price-main {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.price-symbol {
  color: #f97316;
  font-size: 26rpx;
  font-weight: 700;
}
.price-num {
  color: #f97316;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
}
.price-origin {
  margin-left: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
  text-decoration: line-through;
}
.save-pill {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #ffdbca;
  color: #5c2400;
  font-size: 22rpx;
  font-weight: 600;
}
.g-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #191c1e;
}
.g-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #475569;
}
.g-loc {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.g-stats {
  flex-shrink: 0;
  margin-left: 24rpx;
}
.g-stat-gap {
  margin-left: 24rpx;
}

/* 卖家卡 */
.seller-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.seller-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.seller-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e6e8ea;
  border: 4rpx solid rgba(16, 185, 129, 0.25);
}
.seller-check {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #10b981;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
}
.seller-info {
  flex: 1;
  min-width: 0;
}
.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.seller-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #191c1e;
}
.seller-verified {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 108, 73, 0.1);
  color: #006c49;
  font-size: 20rpx;
  font-weight: 600;
}
.seller-school {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.follow-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #11a86b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 已关注：幽灵样式，再次点击取消 */
.follow-btn.on {
  background: #f1f5f9;
  color: #64748b;
}
.seller-metrics {
  display: flex;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
}
.metric {
  flex: 1;
  text-align: center;
}
.metric-top {
  font-size: 24rpx;
  font-weight: 600;
  color: #191c1e;
}
.metric-top.brand {
  color: #006c49;
}
.metric-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #475569;
}

/* 卡片标题 */
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.card-head.between {
  justify-content: space-between;
}
.head-bar {
  width: 6rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #10b981;
}
.head-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #191c1e;
}

/* 规格 */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.spec-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
  font-size: 24rpx;
}
.spec-label {
  color: #475569;
  flex-shrink: 0;
}
.spec-value {
  color: #191c1e;
  font-weight: 600;
  text-align: right;
  margin-left: 24rpx;
}
.spec-value.warn {
  color: #f97316;
}
.spec-value.brand {
  color: #006c49;
}

/* 描述 */
.desc {
  font-size: 28rpx;
  line-height: 1.8;
  color: #191c1e;
  white-space: pre-wrap;
  word-break: break-all;
}
.desc-note {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

/* 安全提示 */
.safety {
  display: flex;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(0, 108, 73, 0.06);
  margin-bottom: 24rpx;
}
.safety-icon {
  font-size: 40rpx;
  line-height: 1.2;
  flex-shrink: 0;
}
.safety-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #006c49;
}
.safety-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

/* 校友问答 */
.qa-count {
  font-size: 24rpx;
  color: #475569;
}
.qa-ask {
  font-size: 24rpx;
  color: #006c49;
  font-weight: 600;
}
.qa-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.qa-item {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
}
.qa-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.qa-row.indent {
  margin-top: 16rpx;
  padding-left: 8rpx;
}
.qa-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.qa-badge.q {
  background: rgba(249, 115, 22, 0.15);
  color: #f97316;
}
.qa-badge.a {
  background: #10b981;
  color: #ffffff;
}
.qa-text {
  flex: 1;
  font-size: 26rpx;
  color: #191c1e;
  font-weight: 500;
  line-height: 1.6;
}
.qa-text.sub {
  color: #475569;
  font-weight: 400;
}
.qa-time {
  margin-top: 12rpx;
  text-align: right;
  font-size: 20rpx;
  color: #94a3b8;
}

/* ---------- 底部操作栏 ---------- */
.bottom-space {
  height: 180rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.06);
}
.bar-act {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  flex-shrink: 0;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: 1.2;
  border: none;
  font-size: inherit;
}
.bar-act::after {
  border: none;
}
.bar-act-icon {
  font-size: 40rpx;
  color: #475569;
  line-height: 1.1;
}
.bar-act-icon.liked {
  color: #ec4899;
}
.bar-act-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #475569;
  white-space: nowrap;
}
.bar-cta {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  gap: 14rpx;
}
.cta-chat {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  height: 88rpx;
  border-radius: 999rpx;
  background: rgba(0, 108, 73, 0.1);
  color: #006c49;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
}
.cta-badge {
  position: absolute;
  top: -10rpx;
  right: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fd761a;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}
.cta-buy {
  flex: 1 1 0;
  min-width: 0;
  height: 88rpx;
  border-radius: 999rpx;
  background: #006c49;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx -4rpx rgba(0, 108, 73, 0.4);
}
/* 卖家管理操作条：状态胶囊 + 右侧操作按钮 */
.owner-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  background: rgba(14, 154, 96, 0.1);
  color: #0e9a60;
}
.owner-status.sold {
  background: rgba(249, 115, 22, 0.1);
  color: #ea6a0a;
}
.owner-status.off {
  background: #eef1f5;
  color: #64748b;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}
.owner-acts {
  display: flex;
  gap: 14rpx;
  flex: 1;
  justify-content: flex-end;
  min-width: 0;
}
.act-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 0;
  padding: 0 26rpx;
  border: none;
  border-radius: 999rpx;
  background: #f2f4f6;
  color: #191c1e;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.act-btn::after {
  border: none;
}
.act-btn.act-danger {
  background: rgba(255, 77, 79, 0.08);
  color: #e23a3c;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 8rpx;
}
.sheet-goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
  margin-bottom: 24rpx;
}
.sheet-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}
.sheet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #191c1e;
}
.sheet-price {
  margin-top: 8rpx;
  color: #f97316;
  font-size: 32rpx;
  font-weight: 700;
}
.sheet-price .price-symbol {
  font-size: 22rpx;
  margin-right: 2rpx;
}
.sheet-input {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.sheet-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
  font-size: 28rpx;
  box-sizing: border-box;
}
.sheet-note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 加载 / 空态 */
.loading-hero {
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.loading-block {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #eceef0;
  animation: pulse 1.2s ease-in-out infinite;
}
.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
}
@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.retry-btn {
  margin-top: 24rpx;
}

/* ---------- 评论区（含楼中楼回复） ---------- */
.comment-card {
  margin-top: 20rpx;
}
.cc-count {
  font-size: 24rpx;
  color: #b6bbc6;
  margin-left: 4rpx;
}
.cc-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0 4rpx;
}
.cc-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1a1a1a;
}
.cc-tool {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.cc-tool.on {
  background: rgba(16, 185, 129, 0.12);
}
.cc-send {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #e6e8ec;
  color: #9ca3af;
  font-size: 26rpx;
  flex-shrink: 0;
}
.cc-send.on {
  background: #10b981;
  color: #ffffff;
  font-weight: 600;
}
.emoji-panel {
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 16rpx;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.emoji-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #ffffff;
  border-radius: 12rpx;
}
.pending-imgs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0 4rpx;
  flex-wrap: wrap;
}
.p-item {
  position: relative;
}
.p-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.p-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.7);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-tip {
  font-size: 20rpx;
  color: #b6bbc6;
}
.cc-list {
  margin-top: 8rpx;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.ci-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}
.ci-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-name {
  font-size: 25rpx;
  color: #8c8c93;
}
.ci-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #1a1a1a;
  margin-top: 8rpx;
  word-break: break-all;
}
.ci-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.ci-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.ci-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: #f2f3f5;
}
.ci-time {
  font-size: 22rpx;
  color: #b3b3b8;
}
.ci-del {
  font-size: 22rpx;
  color: #b3b3b8;
  padding-left: 16rpx;
}
.ci-reply-btn {
  font-size: 22rpx;
  color: #b3b3b8;
  padding-left: 16rpx;
}
.ci-replies {
  margin-top: 16rpx;
  background: #f6f8fb;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}
.reply-item {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
}
.reply-item + .reply-item {
  border-top: 1rpx solid #eceff5;
}
.reply-to {
  color: #10b981;
  font-weight: 600;
}
.reply-more {
  padding: 14rpx 0 8rpx;
  font-size: 24rpx;
  color: #10b981;
}
.reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: #eef2f7;
  border-radius: 12rpx 12rpx 0 0;
  font-size: 22rpx;
  color: #5b6472;
}
.reply-bar-cancel {
  padding: 4rpx 10rpx;
  color: #b6bbc6;
  font-size: 24rpx;
}
.comment-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9b9ba3;
  font-size: 25rpx;
}
