/* ===== 商品详情 · 统一视觉规范 =====
   主色 var(--brand-500, #1E5FA8) / var(--like-600, #E11D48) · 墨色 #0f172a · 次级 #64748b · 三级 #94a3b8
   圆角：卡片 28rpx / 内块 18rpx / 胶囊 999rpx
   阴影：1rpx 描边 + 大范围低透明度投影，避免灰块感
*/
.page {
  background: var(--bg-page, #F5F7F6);
  min-height: 100vh;
  padding-bottom: 1rpx;
}

/* ---------- 轮播 ---------- */
.gallery-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  background: var(--surface-2, #F0F3F2);
}
.gallery {
  width: 100%;
  height: 100%;
}
.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}
.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #f7f9fc 0%, #e8eef6 100%);
}
.gallery-emoji {
  font-size: 140rpx;
}
.gallery-img-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  background: linear-gradient(135deg, #f7f9fc 0%, #e8eef6 100%);
}
.gallery-empty-tip {
  font-size: 24rpx;
  color: #94a3b8;
}
.gallery-tags {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  display: flex;
  gap: 12rpx;
  z-index: 5;
}
.gallery-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.gallery-tag.mint {
  background: var(--brand-gradient, linear-gradient(135deg, #1E5FA8 0%, #5B97D1 100%));
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(255, 122, 149, 0.6);
}
.gallery-tag.mint .gt-check {
  font-size: 20rpx;
}
.gallery-tag.ghost {
  background: rgba(255, 255, 255, 0.86);
  color: var(--like-600, #E11D48);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 12rpx -6rpx rgba(15, 23, 42, 0.3);
}
.gallery-counter {
  position: absolute;
  right: 24rpx;
  bottom: 64rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.55);
  color: #f8fafc;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  z-index: 5;
  backdrop-filter: blur(8rpx);
}

/* ---------- 主体：首卡上浮压住轮播 ---------- */
.body {
  position: relative;
  z-index: 2;
  margin-top: -40rpx;
  padding: 0 24rpx;
}
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  box-shadow: 0 1rpx 2rpx rgba(15, 23, 42, 0.03), 0 16rpx 36rpx -22rpx rgba(15, 23, 42, 0.22);
}
.price-card {
  border-radius: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.04), 0 20rpx 44rpx -26rpx rgba(15, 23, 42, 0.28);
}

/* 价格与标题 */
.price-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.price-main {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  min-width: 0;
}
.price-symbol {
  color: #f97316;
  font-size: 28rpx;
  font-weight: 700;
}
.price-num {
  color: #f97316;
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}
.price-origin {
  margin-left: 14rpx;
  color: #94a3b8;
  font-size: 23rpx;
  text-decoration: line-through;
}
.save-pill {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1e6;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 600;
}
.g-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #0f172a;
  letter-spacing: 0.5rpx;
}
.g-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--surface-2, #F0F3F2);
  font-size: 23rpx;
  color: #64748b;
}
.g-loc {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.g-stats {
  flex-shrink: 0;
  margin-left: 24rpx;
  color: #94a3b8;
}
.g-stat-gap {
  margin-left: 20rpx;
}

/* 卖家卡 */
.seller-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.seller-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.seller-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef1f4;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx rgba(30, 95, 168, 0.2), 0 8rpx 20rpx -10rpx rgba(15, 23, 42, 0.3);
}
.seller-check {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-500, #1E5FA8);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
}
.seller-info {
  flex: 1;
  min-width: 0;
}
.seller-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.seller-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.seller-verified {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: var(--like-600, #E11D48);
  font-size: 19rpx;
  font-weight: 600;
}
.seller-school {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.follow-btn {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient, linear-gradient(135deg, #1E5FA8 0%, #5B97D1 100%));
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx -10rpx rgba(255, 122, 149, 0.7);
}

/* 已关注：幽灵样式，再次点击取消 */
.follow-btn.on {
  background: var(--surface-2, #F0F3F2);
  color: #64748b;
  box-shadow: none;
}
.seller-metrics {
  display: flex;
  margin-top: 26rpx;
  padding: 22rpx 8rpx;
  border-radius: 20rpx;
  background: #f7faf9;
  border: 1rpx solid #eef4f1;
}
.metric {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.metric + .metric {
  border-left: 1rpx solid #e6eeea;
}
.metric-top {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}
.metric-top.brand {
  color: var(--like-600, #E11D48);
}
.metric-sub {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #94a3b8;
}

/* 卡片标题 */
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.card-head.between {
  justify-content: space-between;
}
.head-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--like-50, #FFF0F4) 0%, var(--like-100, #FFD9E3) 100%);
}
.head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  letter-spacing: 0.5rpx;
}

/* 规格 */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.spec-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f8fafb;
  border: 1rpx solid var(--surface-2, #F0F3F2);
  font-size: 24rpx;
}
.spec-label {
  color: #64748b;
  flex-shrink: 0;
}
.spec-value {
  color: #0f172a;
  font-weight: 600;
  text-align: right;
  margin-left: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.spec-value.warn {
  color: #f97316;
}
.spec-value.brand {
  color: var(--like-600, #E11D48);
  font-weight: 700;
}

/* 描述 */
.desc {
  font-size: 28rpx;
  line-height: 1.85;
  color: #334155;
  white-space: pre-wrap;
  word-break: break-all;
}
.desc-note {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f4faf7;
  border-left: 4rpx solid rgba(30, 95, 168, 0.5);
  font-size: 23rpx;
  line-height: 1.75;
  color: #3f6b5b;
}

/* 安全提示 */
.safety {
  display: flex;
  gap: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #effaf3 0%, #f8fdfb 100%);
  border: 1rpx solid rgba(30, 95, 168, 0.14);
  margin-bottom: 20rpx;
}
.safety-icon {
  font-size: 36rpx;
  line-height: 1.2;
  flex-shrink: 0;
}
.safety-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--like-600, #E11D48);
  letter-spacing: 0.5rpx;
}
.safety-text {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #5b7a6d;
}

/* 校友问答 */
.qa-count {
  font-size: 23rpx;
  color: #94a3b8;
}
.qa-ask {
  font-size: 23rpx;
  color: var(--like-600, #E11D48);
  font-weight: 600;
}
.qa-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.qa-item {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f8fafb;
  border: 1rpx solid var(--surface-2, #F0F3F2);
}
.qa-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.qa-row.indent {
  margin-top: 16rpx;
  padding-left: 8rpx;
}
.qa-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.qa-badge.q {
  background: #fff1e6;
  color: #c2410c;
}
.qa-badge.a {
  background: var(--brand-500, #1E5FA8);
  color: #ffffff;
}
.qa-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 500;
  line-height: 1.6;
  word-break: break-all;
}
.qa-text.sub {
  color: #64748b;
  font-weight: 400;
}
.qa-time {
  margin-top: 12rpx;
  text-align: right;
  font-size: 20rpx;
  color: #b6c0cc;
}

/* ---------- 底部操作栏 ----------
   结构：图标动作组（固定 82rpx×2）+ 主按钮区（弹性）
   防溢出：所有子项显式 flex-basis + min-width:0，容器 overflow: hidden
*/
.bottom-space {
  height: 200rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 -14rpx 40rpx -20rpx rgba(15, 23, 42, 0.25);
}

/* 左侧：圆形图标动作组 */
.bar-acts {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  padding-right: 12rpx;
  margin-right: 12rpx;
  border-right: 1rpx solid #eef1f5;
}
.bar-act {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 82rpx;
  width: 82rpx;
  min-width: 82rpx;
  max-width: 82rpx;
  padding: 6rpx 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 20rpx;
  line-height: 1;
  font-size: inherit;
  box-sizing: border-box;
}
.bar-act::after {
  border: none;
}
.bar-act-hover {
  background: #f4f6f9;
}
.bar-act-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f4f6f9;
  color: #475569;
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, color 0.2s ease;
}
.bar-act-icon.liked {
  background: #fdf2f8;
  color: #ec4899;
}
.bar-act-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #64748b;
  white-space: nowrap;
}

/* 右侧：主次双按钮 */
.bar-cta {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
}
.cta-chat {
  flex: 0 1 180rpx;
  min-width: 0;
  max-width: 180rpx;
  height: 92rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #eaf7f1;
  border: 2rpx solid rgba(30, 95, 168, 0.22);
  color: var(--like-600, #E11D48);
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  box-sizing: border-box;
}
.cta-chat-hover {
  background: #ddf2e8;
}
.cta-chat-emoji {
  font-size: 26rpx;
  line-height: 1;
}
.cta-chat-text {
  letter-spacing: 1rpx;
}
.cta-buy {
  flex: 1 1 0;
  min-width: 0;
  height: 92rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient, linear-gradient(135deg, #1E5FA8 0%, #5B97D1 100%));
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx -10rpx rgba(232, 98, 90, 0.65);
}
.cta-buy-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cta-buy-hover {
  opacity: 0.88;
}
.cta-buy.off {
  background: #d3dae1;
  box-shadow: none;
  color: #ffffff;
}

/* 卖家管理操作条：状态胶囊 + 右侧操作按钮 */
.owner-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  background: rgba(30, 95, 168, 0.1);
  color: #E8925E;
}
.owner-status.sold {
  background: rgba(249, 115, 22, 0.1);
  color: #ea6a0a;
}
.owner-status.off {
  background: #eef1f5;
  color: #64748b;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}
.owner-acts {
  display: flex;
  gap: 14rpx;
  flex: 1;
  justify-content: flex-end;
  min-width: 0;
}
.act-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0;
  padding: 0 30rpx;
  border: none;
  border-radius: 999rpx;
  background: #f2f4f6;
  color: #191c1e;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-sizing: border-box;
}
.act-btn::after {
  border: none;
}
.act-btn-hover {
  opacity: 0.8;
}
.act-btn.act-edit {
  background: rgba(30, 95, 168, 0.12);
  color: #1E5FA8;
}
.act-btn.act-danger {
  background: rgba(255, 77, 79, 0.08);
  color: #e23a3c;
}
/* 加了「推广」之后是四个按钮，固定宽度会挤出屏幕，改成等分自适应。
   width: auto !important 是为了盖掉历史遗留的 inline style width。 */
.owner-acts.is-4 .act-btn {
  flex: 1 1 0;
  width: auto !important;
  min-width: 0;
  padding: 0 10rpx;
}
.act-btn.act-promote {
  background: rgba(30, 95, 168, 0.92);
  color: #fff;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}

/* 评论入口行：卡片底部的「写评论…」触发条 */
.cc-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  background: #f5f7f9;
  border-radius: 999rpx;
}
.cc-entry-hint {
  font-size: 26rpx;
  color: #94a3b8;
}
.cc-entry-tools {
  display: flex;
  gap: 14rpx;
}
.cc-entry-icon {
  font-size: 26rpx;
  line-height: 1;
}

/* 评论遮罩 + 半屏抽屉 */
.comment-mask {
  z-index: 90;
  background: rgba(15, 23, 42, 0.48);
  transition: opacity 0.2s ease;
}
.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.08);
}
.comment-sheet.on {
  transform: translateY(0);
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 6rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx 10rpx;
}
.sheet-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
.sheet-head-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #94a3b8;
  border-radius: 50%;
  background: var(--surface-2, #F0F3F2);
}

/* 主输入：textarea + 右下角计数 */
.sheet-input-area {
  position: relative;
  margin: 6rpx 24rpx 0;
  padding: 20rpx 24rpx 40rpx;
  background: #f8fafc;
  border-radius: 20rpx;
}
.sheet-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 360rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #0f172a;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.sheet-count {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}

/* 工具行 + 发布按钮 */
.sheet-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}
.sheet-tools {
  display: flex;
  gap: 20rpx;
}
.sheet-tool {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 50%;
  background: var(--surface-2, #F0F3F2);
  color: #64748b;
  transition: background 0.15s, color 0.15s;
}
.sheet-tool.on {
  background: #edf9f3;
  color: var(--like-600, #E11D48);
}
.sheet-send {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
  transition: background 0.15s, color 0.15s, transform 0.15s;
}
.sheet-send.on {
  background: var(--brand-gradient, linear-gradient(135deg, #1E5FA8 0%, #5B97D1 100%));
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(30, 95, 168, 0.3);
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 8rpx;
}
.sheet-goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f7f9fb;
  border: 1rpx solid var(--surface-2, #F0F3F2);
  margin-bottom: 24rpx;
}
.sheet-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}
.sheet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}
.sheet-price {
  margin-top: 8rpx;
  color: #f97316;
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.sheet-price .price-symbol {
  font-size: 22rpx;
  margin-right: 2rpx;
}
.sheet-input {
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f7f9fb;
  border: 1rpx solid #e8edf2;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
.sheet-textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #f7f9fb;
  border: 1rpx solid #e8edf2;
  font-size: 28rpx;
  box-sizing: border-box;
}
.sheet-note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: #94a3b8;
}

/* 加载 / 空态 */
.loading-hero {
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.loading-block {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #eceef0;
  animation: pulse 1.2s ease-in-out infinite;
}
.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
}
@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.retry-btn {
  margin-top: 24rpx;
}

/* ---------- 评论区（含楼中楼回复） ---------- */
.comment-card {
  margin-top: 0;
}
.cc-count {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--surface-2, #F0F3F2);
  color: #64748b;
  font-size: 21rpx;
  font-weight: 600;
  margin-left: 2rpx;
}
.cc-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0;
}
.cc-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: var(--bg-page, #F5F7F6);
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
  color: #0f172a;
}
.cc-tool {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--bg-page, #F5F7F6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  transition: background 0.2s ease;
}
.cc-tool.on {
  background: #e6f7f0;
}
.cc-send {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #eef1f4;
  color: #9aa5b1;
  font-size: 25rpx;
  flex-shrink: 0;
  transition: background 0.2s ease, color 0.2s ease;
}
.cc-send.on {
  background: var(--brand-gradient, linear-gradient(135deg, #1E5FA8 0%, #5B97D1 100%));
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx -10rpx rgba(255, 122, 149, 0.8);
}
.emoji-panel {
  margin-top: 14rpx;
  background: #f8fafb;
  border-radius: 18rpx;
  border: 1rpx solid var(--surface-2, #F0F3F2);
  padding: 16rpx;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.emoji-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.05);
}
/* ---------- @ 好友选择器 ---------- */
.mention-picker {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform .25s ease;
  z-index: 120;
  display: flex; flex-direction: column;
}
.mention-picker.on { transform: translateY(0); }
.mention-list {
  flex: 1; overflow-y: auto;
  padding: 0 24rpx 40rpx;
}
.mention-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--surface-2, #F0F3F2);
}
.mi-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg,#a855f7,#ec4899);
}
.mi-avatar.default { background: #e2e8f0; }
.mi-info { flex: 1; min-width: 0; }
.mi-name { font-size: 28rpx; font-weight: 500; color: #1e293b; display: block; }
.mi-sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; display: block; }
.mi-add {
  font-size: 26rpx; color: #ffffff;
  background: linear-gradient(135deg,#6366f1,#a855f7);
  padding: 6rpx 20rpx; border-radius: 30rpx;
}
.mention-empty { text-align: center; padding: 60rpx 0; color: #94a3b8; font-size: 26rpx; }
.mention-tags {
  padding: 0 24rpx; margin-top: 10rpx;
}
.mention-tag {
  display: inline-block;
  font-size: 22rpx; color: #6366f1;
  background: #eef2ff; padding: 4rpx 16rpx; border-radius: 20rpx;
}
.pending-imgs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0 4rpx;
  flex-wrap: wrap;
}
.p-item {
  position: relative;
}
.p-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.p-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.7);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-tip {
  font-size: 20rpx;
  color: #b6c0cc;
}
.cc-list {
  margin-top: 12rpx;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f4f6f9;
}
.comment-item:last-child {
  border-bottom: none;
}
.ci-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef1f4;
}
.ci-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-name {
  font-size: 23rpx;
  color: #94a3b8;
}
.ci-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #1e293b;
  margin-top: 8rpx;
  word-break: break-all;
}
.ci-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.ci-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.ci-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.ci-time {
  font-size: 21rpx;
  color: #b6c0cc;
}
.ci-del {
  font-size: 21rpx;
  color: #b6c0cc;
  padding-left: 16rpx;
}
.ci-reply-btn {
  font-size: 21rpx;
  color: #64748b;
  padding-left: 16rpx;
}
.ci-replies {
  margin-top: 16rpx;
  background: #f7f9fb;
  border-radius: 16rpx;
  padding: 8rpx 18rpx;
}
.reply-item {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
}
.reply-item + .reply-item {
  border-top: 1rpx solid #edf1f6;
}
.reply-to {
  color: var(--like-600, #E11D48);
  font-weight: 600;
}
.reply-more {
  padding: 14rpx 0 10rpx;
  font-size: 23rpx;
  color: var(--like-600, #E11D48);
  font-weight: 600;
}
.reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: var(--surface-2, #F0F3F2);
  border-radius: 14rpx 14rpx 0 0;
  font-size: 22rpx;
  color: #5b6472;
}
.reply-bar-cancel {
  padding: 4rpx 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
}
.comment-empty {
  padding: 56rpx 0 40rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.comment-empty .empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f4f6f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

/* ===== 反诈与禁止线上交易提示（取代原 .safety 轻提示）===== */
.trade-safety {
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #FFF6F4;
  border: 1rpx solid #FFD2C7;
}
.ts-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.ts-icon {
  font-size: 30rpx;
  line-height: 1;
}
.ts-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #B2311A;
}
.ts-line {
  font-size: 24rpx;
  line-height: 1.72;
  color: #7C4A3C;
  margin-top: 8rpx;
}
.ts-strong {
  font-weight: 700;
  color: #B2311A;
}
.ts-warn {
  color: #C0392B;
  font-weight: 600;
}
.ts-tip {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #F0C9BE;
  color: #6B6259;
}

/* 弹层内的付款风险提醒 */
.order-warn {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE0A3;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8A5A00;
}
.sheet-price-label {
  font-size: 22rpx;
  font-weight: 400;
  color: #8A8F99;
}

/* ===== 互通推荐：有人在找这类东西（需求广场） ===== */
.card-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 20rpx;
}
.wanted {
  width: 100%;
  white-space: nowrap;
}
.wanted-inner {
  display: flex;
  flex-direction: row;
}
.wanted-item {
  flex: none;
  width: 260rpx;
  margin-right: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f6f7f9;
  display: flex;
  flex-direction: column;
}
.wanted-type {
  align-self: flex-start;
  font-size: 22rpx;
  color: #1E5FA8;
  background: rgba(30, 95, 168, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.wanted-title {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
  white-space: normal;
}
.wanted-budget {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #D97706;
}
.wanted-cta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1E5FA8;
}
