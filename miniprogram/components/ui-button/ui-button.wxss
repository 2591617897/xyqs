.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border: 2rpx solid transparent;
  /* 按压回弹 + 浮起过渡 */
  transition: transform 0.18s var(--ease-out, cubic-bezier(0.22, 0.61, 0.36, 1)),
    opacity 0.18s ease, box-shadow 0.18s ease;
}
.ui-btn--hover { opacity: 0.92; transform: scale(0.96); }
.ui-btn--block { display: flex; width: 100%; }

/* 主按钮 */
.ui-btn--primary {
  background: var(--brand-500, #1E5FA8);
  color: var(--text-inverse, #fff);
  box-shadow: 0 6rpx 16rpx rgba(30, 95, 168, 0.26);
}
.ui-btn--primary.ui-btn--hover { box-shadow: 0 3rpx 8rpx rgba(30, 95, 168, 0.22); }
/* 次按钮 */
.ui-btn--secondary { background: var(--brand-50, #E8F0FA); color: var(--brand-500, #1E5FA8); }
/* 文字按钮 */
.ui-btn--text { background: transparent; color: var(--brand-500, #1E5FA8); padding: 0 16rpx; }
/* 危险 */
.ui-btn--danger {
  background: var(--danger-500, #DC2626);
  color: var(--text-inverse, #fff);
  box-shadow: 0 6rpx 16rpx rgba(220, 38, 38, 0.24);
}
.ui-btn--danger.ui-btn--hover { box-shadow: 0 3rpx 8rpx rgba(220, 38, 38, 0.2); }

/* 尺寸 */
.ui-btn--default { height: 80rpx; font-size: 30rpx; }
.ui-btn--mini { height: 56rpx; padding: 0 24rpx; font-size: 24rpx; }

.ui-btn--disabled { opacity: 0.5; }
.ui-btn--disabled.ui-btn--hover { transform: none; opacity: 0.5; }

.ui-btn-spin {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: var(--text-inverse, #fff);
  border-radius: 50%;
  animation: ui-btn-rotate 0.7s linear infinite;
  will-change: transform;
}
@keyframes ui-btn-rotate { to { transform: rotate(360deg); } }
