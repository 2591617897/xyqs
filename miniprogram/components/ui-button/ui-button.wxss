.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border: 2rpx solid transparent;
}
.ui-btn--hover { opacity: 0.85; }
.ui-btn--block { display: flex; width: 100%; }

/* 主按钮 */
.ui-btn--primary { background: var(--brand-500, #006C49); color: var(--text-inverse, #fff); }
/* 次按钮 */
.ui-btn--secondary { background: var(--brand-50, #E8F5EF); color: var(--brand-500, #006C49); }
/* 文字按钮 */
.ui-btn--text { background: transparent; color: var(--brand-500, #006C49); padding: 0 16rpx; }
/* 危险 */
.ui-btn--danger { background: var(--danger-500, #DC2626); color: var(--text-inverse, #fff); }

/* 尺寸 */
.ui-btn--default { height: 80rpx; font-size: 30rpx; }
.ui-btn--mini { height: 56rpx; padding: 0 24rpx; font-size: 24rpx; }

.ui-btn--disabled { opacity: 0.5; }

.ui-btn-spin {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: var(--text-inverse, #fff);
  border-radius: 50%;
  animation: ui-btn-rotate 0.7s linear infinite;
}
@keyframes ui-btn-rotate { to { transform: rotate(360deg); } }
