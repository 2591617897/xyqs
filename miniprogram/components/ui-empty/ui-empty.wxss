.ui-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  animation: ui-fade-in 0.4s ease both;
}
.ui-empty-ico { font-size: 120rpx; color: #CBD5E1; animation: ui-empty-float 3s ease-in-out infinite; }
.ui-empty-text { margin-top: 24rpx; font-size: 28rpx; color: #64748B; }
.ui-empty-desc { margin-top: 8rpx; font-size: 24rpx; color: #94A3B8; }
@keyframes ui-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes ui-empty-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
