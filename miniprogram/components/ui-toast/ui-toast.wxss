.ui-toast {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  pointer-events: none;
}
.ui-toast-box {
  max-width: 70%;
  background: rgba(15, 23, 42, 0.88);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
}
.ui-toast-ico { font-size: 56rpx; color: #fff; margin-bottom: 12rpx; }
.ui-toast-text { text-align: center; line-height: 1.5; }
