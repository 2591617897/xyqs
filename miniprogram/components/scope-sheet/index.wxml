<view class="sheet-mask" wx:if="{{show}}" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">浏览范围</view>
    <view class="sheet-sub">切换后首页与表白墙展示对应范围的内容</view>

    <view class="scope-opt {{current === 'school' ? 'on' : ''}}" bindtap="onPickSchool">
      <view class="scope-icon">🏫</view>
      <view class="scope-main">
        <view class="scope-name">{{schoolName || '本校'}}</view>
        <view class="scope-desc">只看本校同学的动态</view>
      </view>
      <view class="scope-check" wx:if="{{current === 'school'}}">✓</view>
    </view>

    <view class="scope-opt {{current === 'city' && (!geoCity || !geoCity.city || currentCity !== geoCity.city) ? 'on' : ''}}" bindtap="onPickCity">
      <view class="scope-icon">📍</view>
      <view class="scope-main">
        <view class="scope-name">{{schoolCity || '本市'}}</view>
        <view class="scope-desc">浏览全市同学的动态</view>
      </view>
      <view class="scope-check" wx:if="{{current === 'city' && (!geoCity || !geoCity.city || currentCity !== geoCity.city)}}">✓</view>
    </view>

    <view
      class="scope-opt {{current === 'city' && currentCity === geoCity.city ? 'on' : ''}}"
      wx:if="{{geoCity && geoCity.city && geoCity.city !== schoolCity}}"
      bindtap="onPickGeo"
    >
      <view class="scope-icon">📌</view>
      <view class="scope-main">
        <view class="scope-name">{{geoCity.city}}</view>
        <view class="scope-desc">当前定位城市{{geoCity.district ? ' · ' + geoCity.district : ''}}</view>
      </view>
      <view class="scope-check" wx:if="{{current === 'city' && currentCity === geoCity.city}}">✓</view>
    </view>

    <view class="sheet-foot" bindtap="onGoVerify">学籍认证 / 切换学校 ›</view>
    <view class="sheet-cancel" bindtap="onClose">取消</view>
  </view>
</view>
