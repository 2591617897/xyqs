/* ===== 左滑操作单元格 ===== */
.sc {
  position: relative;
  overflow: hidden;
  /* 圆角与投影由使用方（宿主元素 class）负责：
     放在组件内部会裁掉卡片的 box-shadow，聊天页气泡圆角也会被切边 */
}

/* 操作区：贴在右侧，卡片左移后露出 */
.sc-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  overflow: hidden;
  z-index: 0;
}

/* 内容层：默认有过渡动画，手势中关闭以保证跟手 */
.sc-body {
  position: relative;
  z-index: 1;
  transition: transform 0.24s cubic-bezier(0.25, 0.8, 0.35, 1);
}
.sc-body-dragging {
  transition: none;
}
