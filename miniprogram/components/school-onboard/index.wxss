/* 新用户选学校引导：底部抽屉，视觉与 scope-sheet 保持一致 */
.ob-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1100;
}

.ob-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* 必须是「确定高度」而不是 max-height：max-height 是内容驱动，
     里面 flex:1 的 scroll-view 会拿到内容高度，列表再长也不滚动、
     还会盖住底部「暂不选择」。定高 + flex 列 + 子项 min-height:0 才是可靠写法
     （与 pages/user/verify 的学校弹层保持一致）。 */
  height: 78vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ob-head {
  flex-shrink: 0;
  text-align: center;
}

.ob-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.ob-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9b9ba3;
}

.ob-search {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-top: 28rpx;
  height: 76rpx;
  padding: 0 24rpx;
  background: var(--bg-page, #F5F7F6);
  border-radius: 999rpx;
}

.ob-search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.ob-search-input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1a1a1a;
}

.ob-search-ph {
  color: #b3b3b8;
}

.ob-list {
  /* 父容器已定高，这里只需 flex 撑满剩余空间；min-height:0 是关键，
     否则 flex 子项默认 min-height:auto 会被内容撑高 → scroll-view 不滚动 */
  flex: 1;
  min-height: 0;
  overflow: hidden;
  margin-top: 16rpx;
}

.ob-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f4f5f8;
}

/* 分组标题：IP 定位到的同城推荐 / 全部学校 */
.ob-group {
  padding: 18rpx 20rpx 8rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #9b9ba3;
}

.ob-group.near {
  color: var(--brand-500, #006C49);
}

.ob-item.on {
  background: rgba(0, 108, 73, 0.06);
  border-radius: 16rpx;
}

.ob-item-main {
  flex: 1;
  min-width: 0;
}

.ob-item-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.ob-item-city {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9b9ba3;
}

.ob-item-check {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-500, #006C49);
  flex-shrink: 0;
}

.ob-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #9b9ba3;
}

.ob-skip {
  flex-shrink: 0;
  margin-top: 20rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #6b6b73;
  text-align: center;
  border-top: 1rpx solid #eef0f4;
}

.ob-tip {
  flex-shrink: 0;
  padding-bottom: 8rpx;
  font-size: 21rpx;
  color: #b6bbc6;
  text-align: center;
}
