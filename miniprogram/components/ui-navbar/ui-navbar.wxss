.ui-navbar {
  width: 100%;
  box-sizing: border-box;
  color: var(--text-1, #0F1A16);
}
.ui-navbar--fixed {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  z-index: 900;
}
.ui-navbar--transparent {
  background: transparent !important;
}
.ui-navbar-status {
  width: 100%;
}
.ui-navbar-bar {
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 16rpx;
}
.ui-navbar-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 100%;
  padding: 0 12rpx;
  z-index: 2;
}
.ui-navbar-back .ico {
  font-size: 38rpx;
}
.ui-navbar-back-text {
  font-size: 28rpx;
}
.ui-navbar-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0 140rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ui-navbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  padding-right: 8rpx;
  z-index: 2;
}
