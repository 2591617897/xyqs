.ui-avatar {
  position: relative;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-50, #E8F0FA);
}
.ui-avatar-img { width: 100%; height: 100%; display: block; }
.ui-avatar-def {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.ui-avatar-def .ad-head {
  width: 42%;
  height: 42%;
  border-radius: 50%;
  background: var(--brand-200, #93C0E8);
  margin-bottom: 6%;
}
.ui-avatar-def .ad-body {
  width: 84%;
  height: 52%;
  border-radius: 50% 50% 0 0;
  background: var(--brand-200, #93C0E8);
}
