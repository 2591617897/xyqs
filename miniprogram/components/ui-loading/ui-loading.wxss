.ui-spin {
  display: inline-block;
  border: 4rpx solid #E2E8F0;
  border-top-color: #006C49;
  border-radius: 50%;
  animation: ui-spin-rotate 0.7s linear infinite;
}
@keyframes ui-spin-rotate { to { transform: rotate(360deg); } }

.ui-skeleton { padding: 8rpx 0; }
.ui-skeleton-row {
  height: 28rpx;
  margin: 16rpx 0;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEF2F6 25%, #E2E8F0 37%, #EEF2F6 63%);
  background-size: 400% 100%;
  animation: ui-skeleton-shine 1.3s ease infinite;
}
@keyframes ui-skeleton-shine { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
