.ui-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 900;
}
.ui-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 901;
  transform: translateY(100%);
  transition: transform 0.28s ease;
  max-height: 86vh;
  box-sizing: border-box;
}
.ui-sheet.on { transform: translateY(0); }
.ui-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.ui-sheet-title { font-size: 30rpx; font-weight: 600; color: #191C1E; }
.ui-sheet-close { font-size: 36rpx; color: #94A3B8; }
