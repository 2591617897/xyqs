{
  "pages": [
    "pages/index/index",
    "pages/zone/index",
    "pages/goods/list",
    "pages/wall/index",
    "pages/wall/detail",
    "pages/user/index",
    "pages/user/profile",
    "pages/user/space/space",
    "pages/goods/detail",
    "pages/goods/publish",
    "pages/post/list",
    "pages/post/detail",
    "pages/post/publish",
    "pages/user/verify",
    "pages/user/cancel",
    "pages/user/follow/index",
    "pages/messages/index",
    "pages/chat/index",
    "pages/legal/agreement",
    "pages/legal/privacy",
    "pages/legal/disclaimer",
    "pages/legal/rule",
    "pages/report/report",
    "pages/notice/index"
  ],
  "subPackages": [
    {
      "root": "subpackages/me",
      "name": "me",
      "pages": [
        "goods/mine",
        "goods/sold",
        "dynamic/index",
        "favorite/index"
      ]
    },
    {
      "root": "subpackages/msg",
      "name": "msg",
      "pages": [
        "notice/like",
        "notice/fans",
        "notice/comment",
        "notice/system",
        "settings/index",
        "group/chat",
        "group/members",
        "group/setting"
      ]
    },
    {
      "root": "subpackages/demand",
      "name": "demand",
      "pages": [
        "list",
        "detail",
        "publish",
        "mine"
      ]
    }
  ],
  "preloadRule": {
    "pages/user/index": {
      "network": "all",
      "packages": ["subpackages/me", "subpackages/msg", "subpackages/demand"]
    },
    "pages/messages/index": {
      "network": "all",
      "packages": ["subpackages/msg"]
    },
    "pages/zone/index": {
      "network": "all",
      "packages": ["subpackages/demand"]
    }
  },
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTitleText": "校聚一城",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F5F7F6"
  },
  "tabBar": {
    "custom": true,
    "color": "#8A8F99",
    "selectedColor": "#006C49",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "发现"
      },
      {
        "pagePath": "pages/zone/index",
        "text": "功能区"
      },
      {
        "pagePath": "pages/messages/index",
        "text": "消息"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "__usePrivacyCheck__": true,
  "usingComponents": {
    "ui-icon": "components/ui-icon/ui-icon",
    "ui-button": "components/ui-button/ui-button",
    "ui-empty": "components/ui-empty/ui-empty",
    "ui-loading": "components/ui-loading/ui-loading",
    "ui-toast": "components/ui-toast/ui-toast",
    "ui-sheet": "components/ui-sheet/ui-sheet",
    "ui-field": "components/ui-field/ui-field",
    "ui-tag": "components/ui-tag/ui-tag",
    "ui-card": "components/ui-card/ui-card",
    "ui-navbar": "components/ui-navbar/ui-navbar",
    "ui-modal": "components/ui-modal/ui-modal",
    "ui-avatar": "components/ui-avatar/ui-avatar"
  }
}
