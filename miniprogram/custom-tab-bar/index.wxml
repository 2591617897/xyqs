<view class="tabbar {{(hidden || showSheet) ? 'tabbar-hidden' : ''}}">
  <block wx:for="{{list}}" wx:key="key">
    <!-- 中间发布按钮 -->
    <view class="tab-plus" wx:if="{{item.plus}}" bindtap="onPlus" hover-class="plus-hover" hover-stay-time="80">
      <view class="plus-btn">＋</view>
    </view>
    <!-- 普通 tab -->
    <view
      wx:else
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
      hover-class="tab-hover"
      hover-stay-time="80"
    >
      <view class="tab-icon-wrap">
        <text class="tab-icon">{{item.icon}}</text>
        <!-- 私信未读角标（游客未登录时为 0，不展示） -->
        <view class="tab-badge" wx:if="{{item.key === 'message' && unread > 0}}">{{unread > 99 ? '99+' : unread}}</view>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </block>
</view>

<!-- 发布弹层（底部磨砂玻璃面板 + 彩色大卡 + 浅色幽灵关闭键）
     结构：pub-mask（深色遮罩 + backdrop 虚化） > pub-sheet（磨砂面板，圆角顶） > 卡片 / 关闭键 -->
<view class="pub-mask" wx:if="{{showSheet}}" bindtap="closeSheet">
  <view class="pub-sheet" catchtap="stop">
    <!-- 拖拽提示条：告诉用户这是从底部上来的面板 -->
    <view class="pub-grab"></view>

    <view class="pub-big" bindtap="goPage" data-url="/pages/post/publish" hover-class="card-press">
      <view class="pub-big-head">
        <text class="pub-big-title">发布帖子</text>
        <text class="pub-big-arrow">›</text>
      </view>
      <view class="pub-big-sub">吐槽 · 表白 · 求助</view>
      <view class="pub-badge">校园精选</view>
      <view class="pub-deco d1"></view>
      <view class="pub-deco d2"></view>
    </view>

    <view class="pub-row">
      <view class="pub-half pub-amber" bindtap="goPage" data-url="/pages/goods/publish" hover-class="card-press">
        <view class="pub-half-head">
          <text class="pub-half-title">发布闲置</text>
          <text class="pub-half-arrow">›</text>
        </view>
        <view class="pub-half-sub">出闲置 · 求购宝贝</view>
        <view class="pub-deco d3"></view>
      </view>
      <view class="pub-half pub-gray" bindtap="goPage" data-url="/pages/user/verify" hover-class="card-press">
        <view class="pub-half-head">
          <text class="pub-half-title">身份认证</text>
          <text class="pub-half-arrow">›</text>
        </view>
        <view class="pub-half-sub">学号 · 实名 · 学生证</view>
      </view>
    </view>

    <!-- 树洞已不是 tab 页，这里改走 navigateTo（入口仍需匿名可达，不做认证拦截） -->
    <view class="pub-line pub-red" bindtap="goNav" data-url="/pages/wall/index" hover-class="card-press">
      <text class="pub-line-title">写匿名心事</text>
      <text class="pub-line-arrow">›</text>
    </view>

    <view class="pub-line pub-plain" bindtap="goTab" data-url="/pages/user/index" hover-class="card-press">
      <text class="pub-line-title">我的发布与收藏</text>
      <text class="pub-line-arrow">›</text>
    </view>

    <!-- 关闭键放进面板内：面板有圆角与磨砂底，放在外面会像贴在遮罩上的黑块 -->
    <view class="pub-close" bindtap="closeSheet" hover-class="close-hover" hover-stay-time="60">✕</view>
  </view>
</view>
