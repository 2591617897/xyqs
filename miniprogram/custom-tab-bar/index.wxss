/* ==========================================================================
 * 冗余 token 副本（防黑底栏）
 * --------------------------------------------------------------------------
 * custom-tab-bar 不在页面 DOM 树内，page{} 作用域的 CSS 变量对其无效。
 * 批量迁移到 design tokens（var(--brand-500) 等）时，这里必须保留副本，
 * 否则底栏会变黑。新增 token 请同步补到下面选择器。
 * ========================================================================== */
.tabbar,
.pub-mask,
.pub-sheet,
.pub-big,
.pub-half,
.pub-line {
  --brand-50: #E8F0FA;
  --brand-100: #C7DDF3;
  --brand-200: #93C0E8;
  --brand-300: #5B97D1;
  --brand-500: #1E5FA8;
  --brand-600: #17508F;
  --brand-700: #123F70;
  --like-500: #FF4D7D;
  --like-600: #E11D48;
  --danger-500: #DC2626;
  --bg-page: #F5F7F6;
  --surface: #FFFFFF;
  --surface-2: #F0F3F2;
  --border: #E3E8E6;
  --text-1: #0F1A16;
  --text-2: #4B5A54;
  --text-3: #6B7A74;
  --text-inverse: #FFFFFF;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --shadow-2: 0 8rpx 24rpx rgba(15, 26, 22, 0.06);
  --shadow-3: 0 16rpx 48rpx rgba(15, 26, 22, 0.10);
}

/* 自定义底部导航 —— 白底 + 绿色主色 + 中间品牌发光凸起发布按钮（对齐设计稿） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: #ffffff;
  border-top: 1rpx solid var(--border, #E3E8E6);
  padding: 10rpx 8rpx calc(10rpx + env(safe-area-inset-bottom));
}

/* 页面弹层打开时由页面通过 getTabBar().setData({hidden:true}) 隐藏底栏 */
.tabbar-hidden {
  display: none;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 8rpx 0 6rpx;
  border-radius: 22rpx;
}

.tab-hover {
  opacity: 0.7;
}

.tab-icon {
  font-size: 38rpx;
  line-height: 1;
  opacity: 0.55;
  filter: grayscale(0.6);
  transform: scale(0.96);
  transition: opacity 0.18s ease, transform 0.18s ease, filter 0.18s ease;
}

/* 图标容器：给未读角标提供定位基准 */
.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

/* 私信未读角标 */
.tab-badge {
  position: absolute;
  top: -8rpx;
  left: 28rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 15rpx;
  background: var(--danger-500, #DC2626);
  border: 2rpx solid #ffffff;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}

.tab-label {
  font-size: 20rpx;
  color: var(--text-3, #6B7A74);
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
  transition: color 0.18s ease;
}

.tab-item.active .tab-icon {
  opacity: 1;
  filter: grayscale(0);
  transform: scale(1.06);
}

.tab-item.active .tab-label {
  color: var(--brand-500, #1E5FA8);
  font-weight: 700;
}

/* 中间发布按钮：品牌绿发光圆钮 */
.tab-plus {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.plus-btn {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--brand-500, #1E5FA8);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 98rpx;
  text-align: center;
  box-sizing: content-box;
  margin-top: -52rpx;
  box-shadow: 0 16rpx 48rpx -8rpx rgba(30, 95, 168, 0.42), 0 8rpx 20rpx -4rpx rgba(30, 95, 168, 0.25);
  transition: transform 0.12s ease;
}
.plus-hover .plus-btn {
  transform: scale(0.94);
}

/* ===== 发布弹层 =====
 * 视觉结构（2026-10-25 重做）：
 *   1) .pub-mask  —— 深色玻璃遮罩 + backdrop-filter 虚化，让底下的功能区页面「化开」不抢焦点；
 *   2) .pub-sheet —— 一块顶部 44rpx 大圆角的磨砂玻璃面板，把彩色卡片整体托住（之前卡片是直接浮在遮罩上的）；
 *   3) .pub-grab  —— 顶部拖拽提示条，暗示「从底部升起、可关闭」；
 *   4) .pub-close —— 从遮罩上挪进面板内，改成浅色幽灵按钮（原来的纯黑圆块压在磨砂板上很突兀）。
 * ⚠️ backdrop-filter 在 iOS 与新版安卓 XWeb 上生效；不支持时自动退化成纯半透明遮罩/面板，
 *    对比度仍然够（遮罩 0.34→0.58 的径向渐变，面板 0.86 白），不会出现内容看不清。
 */
.pub-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  /* 径向渐变：越靠近底部（面板所在处）越深，把面板「压」出来 */
  background: radial-gradient(130% 90% at 50% 100%, rgba(6, 14, 11, 0.34) 0%, rgba(6, 14, 11, 0.58) 100%);
  -webkit-backdrop-filter: blur(24rpx) saturate(130%);
  backdrop-filter: blur(24rpx) saturate(130%);
  animation: pub-mask-in 0.2s ease-out both;
}
.pub-sheet {
  width: 100%;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 44rpx 44rpx 0 0;
  background: rgba(255, 255, 255, 0.86);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  backdrop-filter: blur(40rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 -16rpx 64rpx rgba(4, 12, 9, 0.26);
  animation: pub-sheet-up 0.3s cubic-bezier(0.22, 0.9, 0.24, 1) both;
}
.pub-grab {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  margin: 0 auto 18rpx;
  background: rgba(15, 26, 22, 0.16);
}

@keyframes pub-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes pub-sheet-up {
  from { transform: translateY(64rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.pub-big {
  position: relative;
  border-radius: 28rpx;
  padding: 34rpx 34rpx 32rpx;
  background: linear-gradient(135deg, #007A50 0%, #005B3E 100%);
  color: #ffffff;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 14rpx 34rpx -12rpx rgba(30, 95, 168, 0.6);
}
.pub-big-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pub-big-title {
  font-size: 38rpx;
  font-weight: 700;
}
.pub-big-arrow {
  font-size: 36rpx;
  opacity: 0.9;
}
.pub-big-sub {
  font-size: 25rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}
.pub-badge {
  position: absolute;
  right: 0;
  top: 0;
  padding: 8rpx 22rpx;
  border-radius: 0 28rpx 0 28rpx;
  background: #ffd54a;
  color: #7a4d00;
  font-size: 22rpx;
  font-weight: 700;
}
.pub-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.pub-deco.d1 { width: 150rpx; height: 150rpx; right: 30rpx; bottom: -50rpx; }
.pub-deco.d2 { width: 70rpx; height: 70rpx; right: 170rpx; top: -20rpx; }
.pub-deco.d3 { width: 100rpx; height: 100rpx; right: -20rpx; bottom: -30rpx; }

.pub-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.pub-half {
  position: relative;
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx -10rpx rgba(15, 26, 22, 0.35);
}
.pub-half-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.pub-half-title {
  font-size: 30rpx;
  font-weight: 700;
}
.pub-half-arrow {
  font-size: 28rpx;
  opacity: 0.85;
}
.pub-half-sub {
  font-size: 23rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}
.pub-amber {
  background: linear-gradient(135deg, #FFDB63 0%, #FFC93C 100%);
  color: #6b4a00;
}
.pub-gray {
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a1a;
  border: 1rpx solid rgba(15, 26, 22, 0.06);
}
.pub-gray .pub-half-sub { color: #6b6b73; opacity: 1; }

/* 发布需求：紫色渐变，与需求卡的分类徽标同色系，一眼能认出是需求广场的入口 */
.pub-purple {
  background: linear-gradient(135deg, #A78BFA 0%, #7C5CE8 100%);
  color: #ffffff;
}
.pub-purple .pub-half-sub { color: #ffffff; opacity: 0.92; }

.pub-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 20rpx;
}
.pub-line-title {
  font-size: 30rpx;
  font-weight: 700;
}
.pub-line-arrow {
  font-size: 32rpx;
  opacity: 0.7;
}
.pub-red {
  background: linear-gradient(135deg, #FF8C77 0%, #F2604B 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx -12rpx rgba(242, 96, 75, 0.7);
}
.pub-plain {
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a1a;
  border: 1rpx solid rgba(15, 26, 22, 0.06);
}

/* 关闭键：面板内的浅色幽灵圆钮（替代原先压在遮罩上的纯黑圆块） */
.pub-close {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin: 2rpx auto 4rpx;
  background: rgba(15, 26, 22, 0.06);
  border: 1rpx solid rgba(15, 26, 22, 0.08);
  color: var(--text-2, #4B5A54);
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}
.close-hover {
  background: rgba(15, 26, 22, 0.12);
}
.card-press {
  opacity: 0.85;
  transform: scale(0.99);
}
