/* 自定义底部导航 —— 酷安风格：白底 + 绿色主色 + 中间凸起发布按钮 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: #ffffff;
  border-top: 1rpx solid #f0f1f3;
  padding: 10rpx 8rpx calc(8rpx + env(safe-area-inset-bottom));
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 8rpx 0 6rpx;
}

.tab-hover {
  opacity: 0.7;
}

.tab-icon {
  font-size: 38rpx;
  line-height: 1;
  opacity: 0.42;
  transform: scale(0.96);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.tab-label {
  font-size: 20rpx;
  color: #9b9ba3;
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
  transition: color 0.18s ease;
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: scale(1.04);
}

.tab-item.active .tab-label {
  color: #11a86b;
  font-weight: 600;
}

/* 中间发布按钮 */
.tab-plus {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.plus-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #11a86b;
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 88rpx;
  text-align: center;
  margin-top: -46rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 168, 107, 0.34);
  transition: transform 0.12s ease;
}
.plus-hover .plus-btn {
  transform: scale(0.94);
}
