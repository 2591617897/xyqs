/* 自定义底部导航栏 —— 与页面珊瑚橙视觉统一 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -10rpx 34rpx rgba(31, 35, 41, 0.09);
  padding: 12rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 10rpx 0 6rpx;
  transition: transform 0.18s ease;
}

.tab-hover {
  opacity: 0.7;
}

/* 选中态顶部指示条 */
.tab-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  margin-left: -18rpx;
  width: 36rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff8a65 0%, #ff5a76 100%);
}

.tab-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease, transform 0.18s ease;
}

.tab-icon {
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.45;
  transform: scale(0.94);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.tab-label {
  font-size: 20rpx;
  color: #9aa0aa;
  margin-top: 2rpx;
  letter-spacing: 0.5rpx;
  transition: color 0.18s ease;
}

/* 选中 */
.tab-item.active .tab-icon-wrap {
  background: rgba(255, 107, 87, 0.1);
  transform: translateY(-2rpx);
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: scale(1.06);
}

.tab-item.active .tab-label {
  color: #ff5a57;
  font-weight: 600;
}
