<view class="page">
  <!-- 概览 -->
  <view class="me-head">
    <view class="me-head-row">
      <text class="me-title">我的动态</text>
      <text class="me-sub">帖子 + 树洞</text>
    </view>
    <view class="me-hint">这里汇总你发布的帖子和树洞内容，按时间倒序；下架或被平台处理的内容不会出现在这里。</view>
  </view>

  <!-- 类型分段 -->
  <view class="seg" wx:if="{{master.length}}">
    <view
      class="seg-item {{tab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text>{{item.label}}</text>
      <text class="seg-num">{{item.count}}</text>
    </view>
  </view>

  <!-- 骨架 -->
  <view class="sk-list" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2]}}" wx:key="*this">
      <view class="sk-lines">
        <view class="sk-line"></view>
        <view class="sk-line"></view>
        <view class="sk-line w60"></view>
      </view>
    </view>
  </view>

  <view class="empty-box" wx:elif="{{needLogin}}">
    <text class="empty-ico">🔐</text>
    <view class="empty-txt">登录后才能看你的动态</view>
    <view class="empty-btn" bindtap="login">一键登录</view>
  </view>

  <view class="empty-box" wx:elif="{{loadError}}">
    <text class="empty-ico">📡</text>
    <view class="empty-txt">加载失败，请检查网络</view>
    <view class="empty-btn" bindtap="retry">重新加载</view>
  </view>

  <view class="empty-box" wx:elif="{{!shown.length}}">
    <text class="empty-ico">📝</text>
    <view class="empty-txt">{{tab === 'all' ? '还没有任何动态' : (tab === 'post' ? '还没有发过帖子' : '还没有发过树洞')}}</view>
    <view class="empty-tip">去首页发一条帖子，或者在树洞匿名说句心里话～</view>
  </view>

  <!-- 时间线 -->
  <view class="d-list" wx:else>
    <view
      class="dcard"
      wx:for="{{shown}}"
      wx:key="_key"
      bindtap="goDetail"
      data-type="{{item._type}}"
      data-id="{{item.id}}"
      hover-class="dcard-hover"
      hover-stay-time="60"
    >
      <view class="dcard-head">
        <text class="dbadge {{item._type}}">{{item._type === 'post' ? '📱 帖子' : item.flair}}</text>
        <text class="dcard-channel" wx:if="{{item._type === 'post' && item.channelName}}">{{item.channelName}}</text>
        <text class="dcard-time">{{item.timeText}}</text>
      </view>

      <view class="dcard-title clamp2" wx:if="{{item.title}}">{{item.title}}</view>
      <view class="dcard-content clamp3">{{item.content}}</view>

      <view class="dcard-imgs" wx:if="{{item.imageList.length}}">
        <image
          class="dcard-img"
          wx:for="{{item.imageList}}"
          wx:for-item="img"
          wx:for-index="ii"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          lazy-load
          catchtap="previewImg"
          data-urls="{{item.imageList}}"
          data-current="{{img}}"
        />
      </view>

      <view class="dcard-foot">
        <text>👍 {{item.likeCount || 0}}</text>
        <text>💬 {{item.commentCount || 0}}</text>
      </view>
    </view>
  </view>

  <view class="foot-tip" wx:if="{{shown.length}}">
    {{loadingMore ? '加载中…' : (hasMore ? '上拉加载更多' : '没有更多啦')}}
  </view>
</view>
