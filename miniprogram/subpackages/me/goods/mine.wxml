<view class="page has-cta">
  <!-- 顶部说明 + 统计 -->
  <view class="me-head">
    <view class="me-head-row">
      <text class="me-title">我发布的</text>
      <text class="me-sub">共 {{list.length}} 件</text>
    </view>
    <view class="me-hint">本站仅展示闲置信息，不支持线上交易与支付；面交请在校内明亮公共区域当面验货、当面结清。</view>
  </view>

  <!-- 状态分段（本地过滤，秒切、不发请求） -->
  <view class="seg" wx:if="{{list.length}}">
    <view
      class="seg-item {{tab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text>{{item.label}}</text>
      <text class="seg-num">{{item.count}}</text>
    </view>
  </view>

  <!-- 首屏骨架：比空白页 + 转圈更稳，也不会让页面高度跳变 -->
  <view class="sk-list" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-thumb"></view>
      <view class="sk-lines">
        <view class="sk-line"></view>
        <view class="sk-line w60"></view>
        <view class="sk-line w40"></view>
      </view>
    </view>
  </view>

  <!-- 未登录 -->
  <view class="empty-box" wx:elif="{{needLogin}}">
    <text class="empty-ico">🔐</text>
    <view class="empty-txt">登录后才能看你发布的闲置</view>
    <view class="empty-tip">发布、下架、卖出记录都绑定在账号上</view>
    <view class="empty-btn" bindtap="login">一键登录</view>
  </view>

  <!-- 加载失败 -->
  <view class="empty-box" wx:elif="{{loadError}}">
    <text class="empty-ico">📡</text>
    <view class="empty-txt">加载失败，请检查网络</view>
    <view class="empty-btn" bindtap="retry">重新加载</view>
  </view>

  <!-- 空态：整体没数据 / 当前 tab 没数据，文案分开 -->
  <view class="empty-box" wx:elif="{{!shown.length}}">
    <text class="empty-ico">📦</text>
    <view class="empty-txt">{{tab === 'all' ? '你还没有发布过闲置' : '这个状态下没有闲置'}}</view>
    <view class="empty-tip">{{tab === 'all' ? '把宿舍里闲置的宝贝挂出来，让它找到新主人' : '试试切到「全部」看看'}}</view>
    <view class="empty-btn" wx:if="{{tab === 'all'}}" bindtap="goPublish">去发布</view>
  </view>

  <!-- 列表 -->
  <view class="g-list" wx:else>
    <view
      class="gcard"
      wx:for="{{shown}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
      hover-class="gcard-hover"
      hover-stay-time="60"
    >
      <view class="gcard-cover">
        <image
          wx:if="{{item.cover && !item.imgFailed}}"
          class="gcard-img"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
          binderror="onImgError"
          data-index="{{index}}"
        />
        <view wx:else class="gcard-img gcard-blank">🛍️</view>
        <view class="gcard-badge {{item.statusKey}}">{{item.statusText}}</view>
      </view>

      <view class="gcard-body">
        <view class="gcard-title clamp2">{{item.title}}</view>
        <view class="gcard-meta">
          <text class="tag">{{item.categoryName || '闲置'}}</text>
          <text>{{item.timeText}}</text>
        </view>
        <view class="gcard-price">
          <text class="sym">¥</text>{{item.priceText}}
        </view>
      </view>
    </view>
  </view>

  <view class="foot-tip" wx:if="{{shown.length}}">共 {{shown.length}} 件 · 点击卡片查看详情与管理</view>

  <!-- 底部固定 CTA：任何状态下都能直接去发布 -->
  <view class="cta-bar">
    <view class="cta-btn" bindtap="goPublish">＋ 发布闲置</view>
  </view>
</view>
