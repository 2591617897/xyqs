<view class="page">
  <!-- 成交概览 -->
  <view class="me-head">
    <view class="me-head-row">
      <text class="me-title">已卖出</text>
      <text class="me-sub">共 {{list.length}} 件</text>
    </view>
    <view class="me-amount" wx:if="{{list.length}}">
      <text class="me-amount-num">{{totalAmount}}</text>
      <text class="me-amount-label">累计成交（按发布价汇总，仅供参考）</text>
    </view>
    <view class="me-hint">卖出后请把商品状态改为「已售出」，记录才会出现在这里；线下成交请当面结清，勿提前转账。</view>
  </view>

  <!-- 骨架 -->
  <view class="sk-list" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-thumb"></view>
      <view class="sk-lines">
        <view class="sk-line"></view>
        <view class="sk-line w60"></view>
        <view class="sk-line w40"></view>
      </view>
    </view>
  </view>

  <view class="empty-box" wx:elif="{{needLogin}}">
    <text class="empty-ico">🔐</text>
    <view class="empty-txt">登录后才能看你的成交记录</view>
    <view class="empty-btn" bindtap="login">一键登录</view>
  </view>

  <view class="empty-box" wx:elif="{{loadError}}">
    <text class="empty-ico">📡</text>
    <view class="empty-txt">加载失败，请检查网络</view>
    <view class="empty-btn" bindtap="retry">重新加载</view>
  </view>

  <view class="empty-box" wx:elif="{{!shown.length}}">
    <text class="empty-ico">🏷️</text>
    <view class="empty-txt">还没有卖出记录</view>
    <view class="empty-tip">有人看中并当面成交后，去「我发布的」把状态改成已售出</view>
    <view class="empty-btn" bindtap="goMine">去我发布的</view>
  </view>

  <view class="g-list" wx:else>
    <view
      class="gcard"
      wx:for="{{shown}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
      hover-class="gcard-hover"
      hover-stay-time="60"
    >
      <view class="gcard-cover">
        <image
          wx:if="{{item.cover && !item.imgFailed}}"
          class="gcard-img"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
          binderror="onImgError"
          data-index="{{index}}"
        />
        <view wx:else class="gcard-img gcard-blank">🛍️</view>
        <view class="gcard-badge sold">已售出</view>
      </view>

      <view class="gcard-body">
        <view class="gcard-title clamp2">{{item.title}}</view>
        <view class="gcard-meta">
          <text class="tag tag-mint">成交</text>
          <text>{{item.timeText}}</text>
        </view>
        <view class="gcard-price">
          <text class="sym">¥</text>{{item.priceText}}
        </view>
      </view>
    </view>
  </view>

  <view class="foot-tip" wx:if="{{shown.length}}">共 {{shown.length}} 件已成交</view>
</view>
