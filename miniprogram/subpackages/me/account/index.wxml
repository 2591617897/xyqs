<view class="page">
  <!-- 概览 -->
  <view class="me-head">
    <view class="me-head-row">
      <text class="me-title">账号与服务</text>
      <text class="me-sub">认证 · 范围 · 隐私 · 帮助</text>
    </view>
    <view class="me-hint">学籍认证、浏览范围、消息提醒与隐私设置都集中在这里，随时管理你的账号。</view>
  </view>

  <!-- 分组一：账号与安全 -->
  <view class="sec-title">账号与安全</view>
  <view class="card menu-list">
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="verify">
      <text class="mi-icon">🎓</text>
      <text class="mi-text">实名学籍认证中心</text>
      <text class="mi-tip" wx:if="{{verifyStatus === 2}}">已认证</text>
      <text class="mi-tip warn" wx:elif="{{verifyStatus === 3}}">已驳回，待重新提交</text>
      <text class="mi-tip warn" wx:elif="{{verifyStatus === 1}}">审核中</text>
      <text class="mi-tip warn" wx:else>未认证</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="scope">
      <text class="mi-icon">📍</text>
      <text class="mi-text">浏览范围</text>
      <text class="mi-tip">{{scopeLabel}}</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="privacy-setting">
      <text class="mi-icon">🔐</text>
      <text class="mi-text">隐私设置</text>
      <text class="mi-tip">授权管理</text>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- 分组二：消息与隐私 -->
  <view class="sec-title">消息与隐私</view>
  <view class="card menu-list">
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="notify">
      <text class="mi-icon">🔔</text>
      <text class="mi-text">消息通知与隐私权限</text>
      <text class="mi-tip">提醒与免打扰</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="privacy">
      <text class="mi-icon">🛡️</text>
      <text class="mi-text">隐私政策</text>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- 分组三：帮助与关于 -->
  <view class="sec-title">帮助与关于</view>
  <view class="card menu-list">
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="feedback">
      <text class="mi-icon">💬</text>
      <text class="mi-text">帮助与反馈</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="agreement">
      <text class="mi-icon">📄</text>
      <text class="mi-text">用户服务协议</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="rule">
      <text class="mi-icon">📋</text>
      <text class="mi-text">社区规范</text>
      <text class="mi-tip">发布必读</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="disclaimer">
      <text class="mi-icon">⚠️</text>
      <text class="mi-text">免责声明与反诈提示</text>
      <text class="mi-tip">交易风险必读</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="tap" bindtap="go" data-key="about">
      <text class="mi-icon">ℹ️</text>
      <text class="mi-text">关于校聚一城</text>
      <text class="mi-tip">v2.4.1</text>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- 浏览范围切换：本校 / 本市（+ 定位城市），与首页共用 -->
  <scope-sheet
    show="{{scopeShow}}"
    school-name="{{(user && user.schoolName) || ''}}"
    school-city="{{schoolCity || ''}}"
    geo-city="{{geoCity}}"
    current="{{scopeMode}}"
    current-city="{{scopeCity || ''}}"
    bind:close="closeScope"
    bind:select="onScopeSelect"
    bind:verify="onScopeVerify"
  />
</view>
