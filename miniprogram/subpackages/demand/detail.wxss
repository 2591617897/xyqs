.page {
  padding: 24rpx 24rpx 0;
}

.state {
  text-align: center;
  padding: 120rpx 0;
  font-size: var(--fs-3);
  color: var(--text-3);
}
.state.err {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-btn {
  color: var(--brand-500);
  margin-top: 12rpx;
}

/* ===== 作者行 ===== */
.author {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface-3);
  flex: none;
}
.author-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}
.author-name {
  font-size: var(--fs-4);
  color: var(--text-1);
}
.author-sub {
  font-size: var(--fs-2);
  color: var(--text-3);
  margin-top: 4rpx;
}
.badge {
  flex: none;
  font-size: var(--fs-2);
  color: var(--text-3);
  background: var(--surface-2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.badge-on {
  color: var(--brand-700);
  background: var(--brand-50);
}

/* ===== 主体卡 ===== */
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}
.card-h {
  font-size: var(--fs-4);
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.title-row {
  display: flex;
  align-items: flex-start;
}
.type-tag {
  flex: none;
  font-size: var(--fs-2);
  color: var(--brand-700);
  background: var(--brand-50);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}
.title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-6);
  font-weight: 600;
  color: var(--text-1);
  line-height: var(--lh-tight);
}

/* 信息区改成两列浅底格子。
   原来是「预算 面议 期望 不限 分类 组队拼车」一串横排文字，
   扫读时分不清哪个值对应哪一项，也看不出预算是这屏最该被看到的数字。
   ⚠️ 用 padding 撑间距而不是 margin：格子宽 50%，再加 margin-right 就会超 100% 被挤到下一行 */
.facts {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 8rpx 4rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.fact {
  width: 50%;
  box-sizing: border-box;
  padding: 0 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}
.fact-k {
  font-size: var(--fs-2);
  color: var(--text-3);
}
.fact-v {
  margin-top: 8rpx;
  font-size: var(--fs-4);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fact-v.budget {
  font-size: var(--fs-6);
  font-weight: 700;
  color: var(--warning-500);
}

/* 具体要求：小标题带左侧竖线，正文落进浅底块 —— 和上方信息区同一套圆角与底色 */
.req-title {
  margin-top: 24rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--brand-500, #1E5FA8);
  font-size: var(--fs-4);
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.2;
}
.req {
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: var(--fs-4);
  color: var(--text-1);
  line-height: var(--lh-normal);
  white-space: pre-wrap;
  word-break: break-all;
}

/* 图片：与全站单图口径一致，aspectFill + 写死高度 */
.imgs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.imgs .img {
  border-radius: 12rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
.imgs.cols-1 .img {
  width: 100%;
  height: 480rpx;
  margin-right: 0;
}
.imgs.cols-2 .img {
  width: 330rpx;
  height: 330rpx;
}
.imgs.cols-3 .img {
  width: 214rpx;
  height: 214rpx;
}

.stat {
  display: flex;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  font-size: var(--fs-2);
  color: var(--text-3);
}
.stat text {
  margin-right: 28rpx;
}

/* ===== 互通推荐 ===== */
.match {
  display: flex;
}
.match-item {
  width: 200rpx;
  margin-right: 16rpx;
}
.match-item:last-child {
  margin-right: 0;
}
.match-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  background: var(--surface-3);
}
.match-title {
  margin-top: 10rpx;
  font-size: var(--fs-2);
  color: var(--text-1);
  line-height: var(--lh-tight);
}
.match-price {
  margin-top: 6rpx;
  font-size: var(--fs-3);
  font-weight: 600;
  color: var(--warning-500);
}
.match-tip {
  margin-top: 16rpx;
  font-size: var(--fs-2);
  color: var(--text-4);
}

/* ===== 回应 ===== */
.reply {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border);
}
.reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.reply-name {
  font-size: var(--fs-4);
  color: var(--text-1);
}
.reply-time {
  font-size: var(--fs-2);
  color: var(--text-3);
}
.reply-msg {
  margin-top: 10rpx;
  font-size: var(--fs-3);
  color: var(--text-2);
  line-height: var(--lh-normal);
  word-break: break-all;
}
.reply-contact {
  margin-top: 12rpx;
  font-size: var(--fs-3);
  color: var(--brand-700);
  background: var(--brand-50);
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}
.reply-none {
  margin-top: 10rpx;
  font-size: var(--fs-2);
  color: var(--text-4);
}
.reply-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: var(--fs-3);
  color: var(--text-3);
}

/* ===== 管理 ===== */
.manage {
  display: flex;
  margin-top: 24rpx;
  padding: 0 8rpx;
}
.manage-btn {
  font-size: var(--fs-3);
  color: var(--text-2);
  margin-right: 40rpx;
}
.manage-btn.danger {
  color: var(--danger-500);
}

.pad {
  height: 40rpx;
}

/* ===== 底部操作栏 ===== */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}
.dock-btn {
  flex: 1;
  text-align: center;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: var(--fs-4);
}
.dock-btn.ghost {
  background: var(--surface-2);
  color: var(--text-1);
  margin-right: 20rpx;
}
.dock-btn.main {
  background: var(--brand-500);
  color: #fff;
}
.dock-btn.main.disabled {
  background: var(--surface-3);
  color: var(--text-4);
}

/* ===== 回应弹层 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx 0;
  padding-bottom: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  transition: transform 0.22s ease;
}
.sheet.on {
  transform: translateY(0);
}
.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-size: var(--fs-5);
  font-weight: 600;
  color: var(--text-1);
}
.sheet-close {
  font-size: var(--fs-3);
  color: var(--text-3);
}
.sheet-area {
  width: 100%;
  height: 200rpx;
  margin-top: 20rpx;
  background: var(--surface-2);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: var(--fs-4);
  color: var(--text-1);
}
.sheet-input {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  background: var(--surface-2);
  border-radius: 14rpx;
  padding: 0 18rpx;
  font-size: var(--fs-4);
  color: var(--text-1);
}
.sheet-ph {
  color: var(--text-4);
}
.sheet-tip {
  margin-top: 16rpx;
  font-size: var(--fs-2);
  color: var(--text-3);
}
.sheet-btn {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--brand-500);
  color: #fff;
  font-size: var(--fs-4);
}
.sheet-btn.disabled {
  background: var(--surface-3);
  color: var(--text-4);
}
.comment-section {
  background: #ffffff;
  margin-top: 20rpx;
  padding: 28rpx 32rpx 12rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.section-count {
  font-size: 23rpx;
  color: #b6bbc6;
}
.ch-sorts {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.ch-sort {
  font-size: 25rpx;
  color: #9b9ba3;
}
.ch-sort.on {
  color: var(--brand-500, #1E5FA8);
  font-weight: 600;
}
.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f6f7fb;
}
.comment-item:last-child {
  border-bottom: none;
}
.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  background: #eef0f4;
}
.c-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
/* 头部：左「昵称 + LV 徽章 + 省份」，右「时间」 */
.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.c-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}
.c-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.c-time {
  font-size: 22rpx;
  color: #b6bbc6;
  flex-shrink: 0;
}
/* LV 等级徽章：分 5 档配色，低调但可辨 */
.c-lv {
  flex-shrink: 0;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  background: #eef0f4;
  color: #8b8f99;
}
.c-lv.lv-1 { background: #F2F3F5; color: #9A9EA6; }
.c-lv.lv-2 { background: #E8F0FA; color: #1F9E6E; }
.c-lv.lv-3 { background: #E3F0FF; color: #2E7CD6; }
.c-lv.lv-4 { background: #F1ECFF; color: #7A5AF8; }
.c-lv.lv-5 { background: #FFF3E0; color: #E08A00; }
/* 省份标签 */
.c-province {
  flex-shrink: 0;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  background: #F4F6F8;
  color: #7A8089;
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.c-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2b303b;
  margin-top: 8rpx;
  word-break: break-all;
}
.c-del {
  font-size: 22rpx;
  color: #b6bbc6;
  padding: 4rpx 8rpx;
}
.c-imgs {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}
.c-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #f4f5f9;
}
/* 底部操作栏：点赞 / 回复 / 删除 */
.c-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 14rpx;
}
.c-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 8rpx;
  margin: -4rpx -8rpx;
  border-radius: 999rpx;
  transition: background var(--dur-fast, 120ms) var(--ease-out, ease);
}
.c-action-hover {
  background: var(--surface-2, #F0F3F2);
}
.c-like-ico {
  font-size: 28rpx;
  color: #9ca3af;
  transition: color var(--dur-fast, 120ms) var(--ease-out, ease);
}
.c-action-num {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1;
}
/* 已点赞：心形与数字一起变粉 */
.c-liked {
  color: var(--like-500, #FF4D7D);
}
.comment-empty {
  padding: 70rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
}


/* ===== 评论入口与输入抽屉 ===== */

/* 评论区底部的「说点什么」入口 */
.cmt-entry {
  margin: 8rpx 0 24rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #f4f4f6;
}
.cmt-entry-ph {
  font-size: 25rpx;
  color: #9ca3af;
}

/* 抽屉层级必须高于底部 .dock：DOM 上它在最后，但显式给 z-index 更稳
   （页面里还有互通推荐等兄弟节点，渲染顺序一变就会盖住） */
.cmt-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}
.cmt-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface, #FFFFFF);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx;
  padding-bottom: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  transition: transform 0.22s ease;
  z-index: 61;
}
.cmt-sheet.on {
  transform: translateY(0);
}
.cmt-area {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f4f4f6;
  font-size: 27rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.cmt-send {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e5e7eb;
  color: #9ca3af;
  font-size: 28rpx;
}
.cmt-send.on {
  background: var(--brand-500, #1E5FA8);
  color: #ffffff;
}
