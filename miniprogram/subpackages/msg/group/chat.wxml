<view class="page">
  <!-- 自绘顶栏：左侧返回 + 群名 + 人数，右侧「⋯」进群设置 -->
  <view class="topbar" style="padding-top: {{statusBarHeight + 6}}px; padding-right: {{capsuleGap}}px">
    <view class="tb-back" bindtap="goBack"><view class="ico ico-back"></view></view>
    <view class="tb-main">
      <text class="tb-title">{{group.name || '校友群'}}</text>
      <text class="tb-sub">{{group.memberCount || 0}} 位校友</text>
    </view>
    <view class="tb-set" bindtap="goSetting"><view class="ico ico-more"></view></view>
  </view>

  <block wx:if="{{loading}}">
    <view class="loading"><text>正在进入群聊…</text></view>
  </block>

  <block wx:else>
    <!-- 离线降级提示：不吓人，说明会自动恢复 -->
    <view class="degrade" wx:if="{{degraded}}">
      <text>当前网络较弱，已切换为定时刷新，消息仍会送达</text>
    </view>

    <!-- 群公告（可折叠，默认收起一行） -->
    <view class="notice {{noticeOpen ? 'open' : ''}}" wx:if="{{group.notice}}" bindtap="toggleNotice">
      <view class="notice-head">
        <text class="notice-label">群公告</text>
        <text class="notice-toggle">{{noticeOpen ? '收起' : '展开'}}</text>
      </view>
      <text class="notice-text {{noticeOpen ? '' : 'ellipsis'}}">{{group.notice}}</text>
    </view>

    <!-- 消息区：scroll-view 在 flex 列里必须 min-height:0，否则撑不出滚动 -->
    <scroll-view
      class="msgs"
      scroll-y="true"
      scroll-into-view="{{scrollInto}}"
      scroll-with-animation="true"
      enhanced="true"
      show-scrollbar="false"
      bindtap="onTapMsgs"
    >
      <view class="msgs-pad"></view>
      <view wx:if="{{!msgs.length}}" class="empty">
        <text class="empty-ico">👋</text>
        <text class="empty-title">还没有人说话</text>
        <text class="empty-sub">打个招呼吧：约自习、拼车回家、问课程都行</text>
      </view>

      <view class="msg {{item.mine ? 'mine' : ''}}" wx:for="{{msgs}}" wx:key="id" wx:for-item="item" wx:for-index="idx" id="m-{{item.id}}">
        <!-- 头像双方都要有：.msg.mine 用 row-reverse 自动排到右侧，
             不能再用 !item.mine 过滤，否则自己发的消息整行只有气泡，
             视觉上和别人的消息对不齐（只剩气泡贴边）。
             长按头像 = @ 这个成员（比先去成员列表里找人快得多）。 -->
        <image
          wx:if="{{item.senderAvatar}}"
          class="msg-avatar"
          src="{{item.senderAvatar}}"
          mode="aspectFill"
          data-uid="{{item.senderId}}"
          data-name="{{item.senderName}}"
          bindtap="onAvatar"
          bindlongpress="onAvatarLong"
        />
        <view wx:else class="msg-avatar msg-avatar-default" data-uid="{{item.senderId}}" data-name="{{item.senderName}}" bindtap="onAvatar" bindlongpress="onAvatarLong">
          <view class="avatar-default"><view class="ad-head"></view><view class="ad-body"></view></view>
        </view>

        <view class="msg-body">
          <text class="msg-name" wx:if="{{!item.mine}}">{{item.senderName || '校友'}}</text>
          <!-- 长按气泡出操作菜单：回复 / 撤回（2 分钟内且是自己发的）/ 复制 / 举报 -->
          <view
            class="bubble {{item.mine ? 'bubble-mine' : ''}} {{item.deleted ? 'bubble-deleted' : ''}}"
            data-idx="{{idx}}"
            bindlongpress="onMsgLong"
          >
            <!-- 引用块：被回复内容用服务端快照，原消息撤回后仍能看懂 -->
            <view
              class="quote"
              wx:if="{{item.replyToName && !item.deleted}}"
              data-id="{{item.replyToId}}"
              catchtap="jumpTo"
            >
              <text class="quote-name">{{item.replyToName}}</text>
              <text class="quote-text">{{item.replyToText || '[消息]'}}</text>
            </view>
            <!-- 正文：有 @ 片段时按片段渲染（@昵称 高亮可点开资料卡），
                 segments 为空（普通消息）走兜底直接显示 content -->
            <text class="msg-text" wx:if="{{!item.deleted && item.segments}}">
              <block wx:for="{{item.segments}}" wx:key="k" wx:for-item="seg" wx:for-index="si">
                <text wx:if="{{seg.t === 'text'}}">{{seg.v}}</text>
                <text wx:elif="{{seg.t === 'at'}}" class="at-link" catchtap="onTapAt" data-uid="{{seg.uid}}">{{seg.v}}</text>
                <text wx:elif="{{seg.t === 'atall'}}" class="at-all-link">{{seg.v}}</text>
              </block>
            </text>
            <text class="msg-text" wx:elif="{{!item.deleted}}">{{item.content}}</text>
            <text class="msg-text" wx:elif="{{item.recalled}}">{{item.mine ? '你撤回了一条消息' : '对方撤回了一条消息'}}</text>
            <text class="msg-text" wx:else>该消息已被删除</text>
          </view>
          <view class="msg-meta">
            <text class="msg-at" wx:if="{{item.atAll}}">@所有人</text>
            <text class="msg-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>
      <!-- 滚动锚点：新消息 / 补拉统一滚到这里（行 id 已改成 m-{{id}}，不能再靠最后一行） -->
      <view class="msgs-end" wx:if="{{msgs.length}}" id="m-last">— 只保留最近的消息，更多请上滑 —</view>
    </scroll-view>

    <!-- 不能发言的原因：常驻在输入框上方，绝不等用户打完字才拒绝 -->
    <view class="block-bar" wx:if="{{!canSend && blockReason}}">
      <text class="block-ico">🌙</text>
      <text class="block-text">{{blockReason}}</text>
    </view>

    <!-- 已 @ 的人 -->
    <view class="at-row" wx:if="{{atUsers.length || atAll}}">
      <view class="at-chip" wx:for="{{atUsers}}" wx:key="id" wx:for-item="u" wx:for-index="i" bindtap="removeAt" data-idx="{{i}}">
        <text>@{{u.nickname}}</text>
        <text class="at-x">×</text>
      </view>
      <view class="at-chip at-chip-all" wx:if="{{atAll}}" bindtap="toggleAtAll">
        <text>@所有人</text>
        <text class="at-x">×</text>
      </view>
    </view>

    <!-- 底部固定区：回复栏 + 面板 + 输入栏必须一起抬，分开定位的话
         键盘弹起时输入栏上移、回复栏留在原地被键盘盖住 -->
    <view class="bottom-dock" style="bottom: {{keyboardHeight}}px">
      <view class="reply-bar" wx:if="{{replyTo}}">
        <view class="rb-line"></view>
        <view class="rb-main">
          <text class="rb-name">回复 {{replyTo.name || '校友'}}</text>
          <text class="rb-text">{{replyTo.text || '[消息]'}}</text>
        </view>
        <view class="rb-close" catchtap="cancelReply">✕</view>
      </view>

      <!-- ==================== @ 成员面板 ====================
           不跳页：原来点 @ 要 navigateTo 到成员列表再回来，输入框焦点和
           已打的字都容易丢，人多的群里还要翻好几页。就地展开最快。 -->
      <view class="panel panel-at" wx:if="{{panel === 'at'}}">
        <view class="at-search">
          <view class="at-search-box">
            <text class="at-search-ico">🔍</text>
            <input
              class="at-kw"
              value="{{atKeyword}}"
              placeholder="搜索群成员"
              placeholder-class="ph"
              confirm-type="search"
              adjust-position="false"
              bindinput="onAtKeyword"
              bindkeyboardheightchange="onKeyboard"
            />
          </view>
          <view class="at-cancel" catchtap="closePanel">取消</view>
        </view>

        <scroll-view class="at-list" scroll-y="true" show-scrollbar="false">
          <!-- @所有人放最前面：管理员才显示，比在输入栏挤一个「全体」按钮好懂 -->
          <view class="at-item at-item-all" wx:if="{{atAllAllowed}}" catchtap="toggleAtAll">
            <view class="at-av at-av-all">@</view>
            <text class="at-nick">所有人</text>
            <text class="at-flag {{atAll ? 'on' : ''}}">{{atAll ? '已选择' : '全群'}}</text>
          </view>

          <view
            class="at-item"
            wx:for="{{atList}}"
            wx:key="userId"
            wx:for-index="i"
            data-idx="{{i}}"
            catchtap="pickAt"
          >
            <image wx:if="{{item.avatar}}" class="at-av" src="{{item.avatar}}" mode="aspectFill" />
            <view wx:else class="at-av at-av-default">
              <view class="avatar-default"><view class="ad-head"></view><view class="ad-body"></view></view>
            </view>
            <text class="at-nick">{{item.nickname || '校友'}}</text>
            <text class="at-flag" wx:if="{{item.role === 1}}">管理员</text>
          </view>

          <view class="at-empty" wx:if="{{atLoading}}">加载中…</view>
          <view class="at-empty" wx:elif="{{atError}}">成员加载失败，请重新打开面板</view>
          <view class="at-empty" wx:elif="{{!atList.length}}">没有找到这位校友</view>
        </scroll-view>
      </view>

      <!-- ==================== 表情面板 ====================
           只用 Unicode 表情，不引图片包：不占体积，也不会出现图片 404 的空格子。 -->
      <view class="panel panel-emoji" wx:if="{{panel === 'emoji'}}">
        <view class="emoji-tabs">
          <view
            class="emoji-tab {{emojiIndex === i ? 'on' : ''}}"
            wx:for="{{emojiGroups}}"
            wx:key="name"
            wx:for-index="i"
            data-idx="{{i}}"
            catchtap="switchEmoji"
          >{{item.name}}</view>
          <!-- 面板打开时键盘是收起的，没有系统删除键，得自带一个 -->
          <view class="emoji-del" catchtap="emojiBackspace">⌫</view>
        </view>

        <scroll-view class="emoji-body" scroll-y="true" show-scrollbar="false">
          <view class="emoji-grid">
            <view
              class="emoji-cell"
              wx:for="{{emojiList}}"
              wx:key="*this"
              data-emoji="{{item}}"
              catchtap="addEmoji"
            >{{item}}</view>
          </view>
        </scroll-view>
      </view>

      <!-- 输入栏：adjust-position=false + keyboardheightchange，避免整页被顶飞。
           @ 没有按钮入口了（只剩「手打 @ 自动弹面板」和「长按头像」两条），
           表情留在右侧做唯一的面板开关。 -->
      <view class="input-bar">
        <input
          class="ib-input {{canSend ? '' : 'disabled'}}"
          value="{{inputText}}"
          focus="{{focusInput}}"
          placeholder="{{replyTo ? '回复 ' + replyTo.name : (canSend ? '说点什么…' : (nightMute ? '夜间静默中' : '暂时不能发言'))}}"
          placeholder-class="ph"
          confirm-type="send"
          adjust-position="false"
          disabled="{{!canSend}}"
          bindinput="onInput"
          bindconfirm="onSend"
          bindfocus="onFocus"
          bindblur="onBlur"
          bindkeyboardheightchange="onKeyboard"
        />
        <view class="ib-tool {{panel === 'emoji' ? 'on' : ''}}" catchtap="toggleEmojiPanel">😊</view>
        <view class="ib-send {{(inputText && canSend) ? 'on' : ''}}" bindtap="onSend">发送</view>
      </view>
    </view>
    <!-- 占位高度必须跟 .bottom-dock 真实高度一致，否则最后几条消息会被面板盖住 -->
    <view
      class="input-hold"
      style="height: {{100 + (replyTo ? 100 : 0) + ((atUsers.length || atAll) ? 70 : 0) + (panel === 'at' ? 520 : 0) + (panel === 'emoji' ? 430 : 0)}}rpx"
    ></view>
  </block>

  <!-- 首次进群：全屏群规 + 安全提醒（不是 toast，也不是半屏弹窗——要用户真的看完） -->
  <view class="rules-mask" wx:if="{{showRules}}" catchtap="noop" catchtouchmove="noop">
    <view class="rules">
      <view class="rules-head">
        <text class="rules-title">{{group.name || '校友群'}}</text>
        <text class="rules-sub">{{group.memberCount || 0}} 位校友在这里</text>
      </view>

      <scroll-view class="rules-body" scroll-y="true">
        <view class="rules-block">
          <text class="rb-title">🛡 安全提醒</text>
          <text class="rb-item">· 不要透露学号、身份证、住址等个人信息</text>
          <text class="rb-item">· 谨防冒充同学的借钱、代付、刷单诈骗</text>
          <text class="rb-item">· 交易请走平台，勿私下转账</text>
        </view>

        <view class="rules-block">
          <text class="rb-title">📋 发言规则</text>
          <text class="rb-item">· 禁止广告、刷屏、人身攻击、违法内容</text>
          <text class="rb-item">· 每 {{group.rateGapSec || 10}} 秒可发 1 条，每天最多 {{group.rateDayMax || 50}} 条</text>
          <text class="rb-item" wx:if="{{group.nightRange}}">· {{group.nightRange}} 为夜间静默，可浏览不可发言</text>
          <text class="rb-item">· 违规内容将被删除，并可能被禁言</text>
        </view>

        <view class="rules-block">
          <text class="rb-title">🙋 遇到违规</text>
          <text class="rb-item">· 长按消息可举报，管理员会尽快处理</text>
          <text class="rb-item">· 群里只聊校园生活，别发与学校无关的推广</text>
        </view>
      </scroll-view>

      <view class="rules-btn" bindtap="agreeRules">我已知晓，进入群聊</view>
      <text class="rules-tip">点击即表示你已阅读并同意以上规则</text>
    </view>
  </view>
</view>
