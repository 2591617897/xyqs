/* ===== 校友群 · 群聊页 · QQ 群聊风格 =====
   设计令牌（Design Tokens）
   微信 WXSS 不识别 :root，全局变量必须挂在真实根节点 .page 上才能被后代继承。
   --brand:        QQ 蓝（自己气泡、强调色）
   --bubble-other: 对方气泡白
   --text-1/2:     主/次文本
   --line:         分隔线
   --page:         页面浅灰背景
*/
.page {
  /* ---- 设计令牌 ---- */
  --brand: #1296ff;
  --brand-deep: #0c7cd6;
  --mine-grad: linear-gradient(135deg, #3aa0ff 0%, #1296ff 100%);
  --bubble-other: #ffffff;
  --bubble-self: #1296ff;
  --page: #ededed;
  --text-1: #1a1a1a;
  --text-2: #9a9a9a;
  --line: #e5e5e5;

  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--page);
  box-sizing: border-box;
  /* 锁死页面级滚动：所有滚动都发生在内部 scroll-view，
     顶栏（群名称）与输入栏固定在视口，不会随消息上下滑动 */
  overflow: hidden;
}

/* ---------- 顶栏（QQ：白底深字，无重阴影） ---------- */
.topbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 22rpx 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid var(--line);
  flex-shrink: 0;
}
.tb-back,
.tb-set {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  transition: background 0.15s;
}
.tb-back:active,
.tb-set:active {
  background: #f0f0f0;
}
/* 返回箭头：用 border 画，避免额外图片资源 */
.ico-back {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--text-1);
  border-bottom: 4rpx solid var(--text-1);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/* 更多：三个点 */
.ico-more {
  width: 34rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--text-1);
  box-shadow: -12rpx 0 0 var(--text-1), 12rpx 0 0 var(--text-1);
}
.tb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.tb-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.5rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tb-sub {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 3rpx;
}

/* ---------- 状态条 ---------- */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
}
.degrade {
  padding: 12rpx 24rpx;
  background: #fff7e6;
  font-size: 22rpx;
  color: #a8730f;
  flex-shrink: 0;
}

/* ---------- 群公告（白卡，蓝标题） ---------- */
.notice {
  margin: 16rpx 20rpx 0;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  flex-shrink: 0;
}
.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.notice-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand);
}
.notice-toggle {
  font-size: 22rpx;
  color: var(--text-2);
}
.notice-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4a4a4a;
  line-height: 1.6;
  white-space: pre-wrap;
}
.notice-text.ellipsis {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------- 消息区 ---------- */
.msgs {
  flex: 1;
  /* scroll-view 在 flex 列里必须 min-height:0，否则高度撑成内容高度、滚不动 */
  min-height: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
}
.msgs-pad {
  height: 14rpx;
}
.empty {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.empty-ico {
  font-size: 64rpx;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-2);
  text-align: center;
}

.msg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.msg.mine {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;          /* QQ 头像偏方角，不是正圆 */
  flex-shrink: 0;
  overflow: hidden;
  background: #d8d8d8;
}
.msg-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 默认头像：浅蓝灰渐变底 + 白色人形剪影，干净不破图 */
.avatar-default {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #cfe6ff, #a9d4ff);
  overflow: hidden;
}
.avatar-default .ad-head {
  width: 32%;
  height: 32%;
  border-radius: 50%;
  background: #ffffff;
  margin-bottom: 6%;
}
.avatar-default .ad-body {
  width: 60%;
  height: 44%;
  border-radius: 60rpx 60rpx 0 0;
  background: #ffffff;
}
.msg-body {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.msg.mine .msg-body {
  align-items: flex-end;
}
/* 对方昵称显示在气泡上方（QQ 习惯：班级+姓名） */
.msg-name {
  font-size: 22rpx;
  color: var(--text-2);
  margin: 0 8rpx 6rpx;
}
/* QQ 气泡：朝向头像那一侧收角（近头像的角更小），其余大圆角 */
.bubble {
  padding: 18rpx 22rpx;
  background: var(--bubble-other);
  border-radius: 6rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 1rpx 1rpx rgba(0, 0, 0, 0.04);
}
.bubble-mine {
  background: var(--bubble-self);
  border-radius: 20rpx 6rpx 20rpx 20rpx;
  box-shadow: 0 1rpx 1rpx rgba(18, 150, 255, 0.25);
}
.bubble-deleted {
  background: #e4e4e4;
  box-shadow: none;
}
.msg-text {
  font-size: 29rpx;
  line-height: 1.5;
  color: var(--text-1);
  word-break: break-all;
  white-space: pre-wrap;
}
.bubble-mine .msg-text {
  color: #ffffff;
}
/* 正文里高亮的 @昵称：QQ 蓝，可点 */
.at-link {
  color: var(--brand);
  font-weight: 500;
}
.bubble-mine .at-link {
  color: #e3f1ff;
}
.at-all-link {
  color: var(--brand);
  font-weight: 600;
}
.bubble-mine .at-all-link {
  color: #e3f1ff;
}
.bubble-deleted .msg-text {
  color: #8a8a8a;
  font-size: 26rpx;
}
.msg-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 8rpx 0;
}
.msg.mine .msg-meta {
  flex-direction: row-reverse;
}
.msg-at {
  font-size: 20rpx;
  color: var(--brand);
  background: #e6f2ff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.msg-time {
  font-size: 20rpx;
  color: #b0b0b0;
}
.msgs-end {
  text-align: center;
  font-size: 20rpx;
  color: #b8b8b8;
  padding: 16rpx 0 24rpx;
}

/* ---------- 回到底部浮层按钮（QQ：右下灰圆 + 下箭头） ---------- */
.to-bottom {
  position: fixed;
  right: 24rpx;
  bottom: 130rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 25;
}
.to-bottom .tb-arrow {
  width: 18rpx;
  height: 18rpx;
  border-right: 4rpx solid #555;
  border-bottom: 4rpx solid #555;
  transform: rotate(45deg);
  margin-top: -6rpx;
}
.to-bottom .tb-unread {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ff5b5b;
  color: #fff;
  font-size: 18rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

/* ---------- 不可发言提示 ---------- */
.block-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 20rpx 8rpx;
  padding: 14rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.block-ico {
  font-size: 24rpx;
}
.block-text {
  font-size: 23rpx;
  color: #4a4a4a;
  line-height: 1.5;
}

/* ---------- @ 已选 ---------- */
.at-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 8rpx;
  flex-shrink: 0;
}
.at-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #e6f2ff;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--brand-deep);
}
.at-chip-all {
  background: #e6f2ff;
  color: var(--brand-deep);
}
.at-x {
  font-size: 24rpx;
  opacity: 0.7;
}

/* ---------- 输入栏（QQ：白底 / 麦克风 + 胶囊输入框 + 表情 + 发送/加号） ---------- */
.bottom-dock {
  position: fixed;
  left: 0;
  right: 0;
  background: #f7f7f7;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
  box-sizing: border-box;
}
.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
}
/* 左侧麦克风（装饰） */
.ib-mic {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #444;
  border-radius: 50%;
}
.ib-mic:active {
  background: #ececec;
}
/* 中间胶囊输入框 */
.ib-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}
.ib-input.disabled {
  color: #b0b0b0;
}
.ph {
  color: #b0b0b0;
}
/* 表情按钮（圆形，选中态填蓝） */
.ib-emoji {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 50%;
}
.ib-emoji.on {
  background: #e6f2ff;
}
/* 有文字时显示蓝色发送按钮（QQ：输入即出现「发送」） */
.ib-send {
  flex-shrink: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  border-radius: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--brand);
}
.ib-send:active {
  background: var(--brand-deep);
}
/* 无文字时显示加号（更多功能） */
.ib-plus {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #555;
  border-radius: 50%;
}
.ib-plus:active {
  background: #ececec;
}
.input-hold {
  height: 100rpx;
  flex-shrink: 0;
}

/* ---------- 首次进群群规层 ---------- */
.rules-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 99;
}
.rules {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.rules-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
  flex-shrink: 0;
}
.rules-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}
.rules-sub {
  font-size: 23rpx;
  color: var(--text-2);
}
.rules-body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 0;
}
.rules-block {
  margin-bottom: 24rpx;
}
.rb-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 10rpx;
}
.rb-item {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #4a4a4a;
}
.rules-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--mine-grad);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(18, 150, 255, 0.28);
}
.rules-tip {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #b0b0b0;
  margin-top: 14rpx;
}

/* ==================== 引用回复块（气泡内） ==================== */
.quote {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.04);
  border-left: 4rpx solid rgba(18, 150, 255, 0.5);
}
.bubble-mine .quote {
  background: rgba(255, 255, 255, 0.22);
  border-left-color: rgba(255, 255, 255, 0.8);
}
.quote-name {
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
}
.quote-text {
  font-size: 24rpx;
  color: #5f5f5f;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.bubble-mine .quote-name,
.bubble-mine .quote-text {
  color: rgba(255, 255, 255, 0.92);
}

/* ==================== 回复栏（输入框上方） ==================== */
.reply-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 12rpx 20rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.rb-line {
  width: 4rpx;
  height: 34rpx;
  flex: none;
  border-radius: 2rpx;
  background: var(--brand);
}
.rb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.rb-name {
  font-size: 21rpx;
  color: var(--brand);
}
.rb-text {
  font-size: 23rpx;
  color: #6b6b6b;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rb-close {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

/* ==================== 底部面板（@ / 表情） ====================
   高度固定成 rpx 常量：chat.wxml 的 .input-hold 占位高度按同样的数字算，
   改这里的高度必须同步改 wxml 里那个表达式，否则最后几条消息会被盖住。 */
.panel {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid var(--line);
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
}
.panel-at {
  height: 520rpx;
}
.panel-emoji {
  height: 430rpx;
}

/* ---------- @ 面板 ---------- */
.at-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx 10rpx;
  flex-shrink: 0;
}
.at-search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 18rpx;
  background: #f2f2f2;
  border-radius: 999rpx;
  box-sizing: border-box;
}
.at-search-ico {
  font-size: 22rpx;
  opacity: 0.5;
}
.at-kw {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--text-1);
}
.at-cancel {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--brand);
  padding: 0 6rpx;
}
.at-list {
  flex: 1;
  /* scroll-view 在 flex 列里必须 min-height:0，否则撑成内容高度、滚不动 */
  min-height: 0;
  padding: 0 12rpx 12rpx;
  box-sizing: border-box;
}
.at-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 92rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
}
.at-item:active {
  background: #f2f2f2;
}
.at-av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #d8d8d8;
  overflow: hidden;
}
.at-av-default {
  display: flex;
  align-items: center;
  justify-content: center;
}
.at-av-all {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6f2ff;
  color: var(--brand);
  font-size: 32rpx;
  font-weight: 700;
}
.at-nick {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.at-flag {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #b0b0b0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.at-flag.on {
  color: var(--brand);
  background: #e6f2ff;
}
.at-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b0;
}

/* ---------- 表情面板 ---------- */
.emoji-tabs {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 18rpx 8rpx;
  flex-shrink: 0;
}
.emoji-tab {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--text-2);
  background: #f2f2f2;
}
.emoji-tab.on {
  color: #ffffff;
  background: var(--brand);
}
.emoji-del {
  margin-left: auto;
  width: 64rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  color: #4a4a4a;
}
.emoji-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}
/* 7 列：12.5%（8 列）在部分机型上会因为小数累加溢出换行，留 0.3% 余量 */
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 10rpx 16rpx;
}
.emoji-cell {
  width: 14.2%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
  border-radius: 12rpx;
}
.emoji-cell:active {
  background: #eef3ff;
}
