/* ===== 校友群 · 群聊页 · 视觉升级 =====
   设计令牌（Design Tokens）
   注意：微信 WXSS 不识别 :root，全局变量必须挂在真实根节点 .page 上，
   才能被所有后代（顶栏 / 气泡 / 面板 / 群规层）继承。
   --brand:        主品牌绿（清新薄荷绿，比旧版 #006c49 更亮更现代）
   --brand-deep:   按下/加深态
   --brand-soft:   浅绿底色（@ 胶囊、激活底）
   --mine-grad:    自己气泡渐变
   --text-1/2:     主/次文本
   --line:         分隔线
*/
.page {
  /* ---- 设计令牌 ---- */
  --brand: #07c160;
  --brand-deep: #06ad57;
  --brand-soft: #e6f7ee;
  --mine-grad: linear-gradient(135deg, #21d389 0%, #07c160 100%);
  --page-top: #eef2f0;
  --page-bottom: #f5f6f5;
  --text-1: #1a1f1d;
  --text-2: #6b7770;
  --line: #edeff0;

  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--page-top) 0%, var(--page-bottom) 36%, var(--page-bottom) 100%);
  box-sizing: border-box;
}

/* ---------- 顶栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 22rpx 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 4rpx 16rpx rgba(20, 35, 28, 0.04);
  flex-shrink: 0;
  backdrop-filter: blur(10px);
}
.tb-back,
.tb-set {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  transition: background 0.15s;
}
.tb-back:active,
.tb-set:active {
  background: #f0f3f1;
}
/* 返回箭头：用 border 画，避免额外图片资源 */
.ico-back {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--text-1);
  border-bottom: 4rpx solid var(--text-1);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/* 更多：三个点 */
.ico-more {
  width: 34rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--text-1);
  box-shadow: -12rpx 0 0 var(--text-1), 12rpx 0 0 var(--text-1);
}
.tb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.tb-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.5rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tb-sub {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 3rpx;
}

/* ---------- 状态条 ---------- */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
}
.degrade {
  padding: 12rpx 24rpx;
  background: #fff7e6;
  font-size: 22rpx;
  color: #a8730f;
  flex-shrink: 0;
}

/* ---------- 群公告 ---------- */
.notice {
  margin: 16rpx 20rpx 0;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 2rpx 10rpx rgba(20, 35, 28, 0.03);
  flex-shrink: 0;
}
.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.notice-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand);
}
.notice-toggle {
  font-size: 22rpx;
  color: var(--text-2);
}
.notice-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4a5a54;
  line-height: 1.6;
  white-space: pre-wrap;
}
.notice-text.ellipsis {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------- 消息区 ---------- */
.msgs {
  flex: 1;
  /* scroll-view 在 flex 列里必须 min-height:0，否则高度撑成内容高度、滚不动 */
  min-height: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.msgs-pad {
  height: 14rpx;
}
.empty {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.empty-ico {
  font-size: 64rpx;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-2);
  text-align: center;
}

.msg {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.msg.mine {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  background: #e8eeeb;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(20, 35, 28, 0.08);
}
.msg-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 默认头像：浅绿渐变底 + 白色人形剪影，干净不破图 */
.avatar-default {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #d9f2e6, #bfe6d2);
  overflow: hidden;
}
.avatar-default .ad-head {
  width: 32%;
  height: 32%;
  border-radius: 50%;
  background: #ffffff;
  margin-bottom: 6%;
}
.avatar-default .ad-body {
  width: 60%;
  height: 44%;
  border-radius: 60rpx 60rpx 0 0;
  background: #ffffff;
}
.msg-body {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.msg.mine .msg-body {
  align-items: flex-end;
}
.msg-name {
  font-size: 22rpx;
  color: var(--text-2);
  margin: 0 8rpx 6rpx;
}
.bubble {
  padding: 18rpx 22rpx;
  background: #ffffff;
  border-radius: 6rpx 20rpx 20rpx 20rpx;
  border: 1rpx solid rgba(20, 35, 28, 0.03);
  box-shadow: 0 2rpx 12rpx rgba(20, 35, 28, 0.06);
}
.bubble-mine {
  background: var(--mine-grad);
  border-radius: 20rpx 6rpx 20rpx 20rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.28);
}
.bubble-deleted {
  background: #eef1f0;
  box-shadow: none;
}
.msg-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-1);
  word-break: break-all;
  white-space: pre-wrap;
}
.bubble-mine .msg-text {
  color: #ffffff;
}
/* 正文里高亮的 @昵称：像微信一样成蓝色可点 */
.at-link {
  color: #1a6fe0;
  font-weight: 500;
}
/* 自己发的消息（绿底白字）里，蓝色链接看不清，换成浅蓝 */
.bubble-mine .at-link {
  color: #bfe3ff;
}
/* @所有人：只高亮不可点，用橙色和「@全群」角标呼应 */
.at-all-link {
  color: #c2410c;
  font-weight: 600;
}
.bubble-mine .at-all-link {
  color: #ffd2a8;
}
.bubble-deleted .msg-text {
  color: #9aa8a2;
  font-size: 26rpx;
}
.msg-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 8rpx 0;
}
.msg.mine .msg-meta {
  flex-direction: row-reverse;
}
.msg-at {
  font-size: 20rpx;
  color: #c2410c;
  background: #fff1e6;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.msg-time {
  font-size: 20rpx;
  color: #9aa39e;
}
.msgs-end {
  text-align: center;
  font-size: 20rpx;
  color: #b9c4bf;
  padding: 16rpx 0 24rpx;
}

/* ---------- 不可发言提示 ---------- */
.block-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 20rpx 8rpx;
  padding: 14rpx 20rpx;
  background: #eef3f1;
  border-radius: 14rpx;
  flex-shrink: 0;
}
.block-ico {
  font-size: 24rpx;
}
.block-text {
  font-size: 23rpx;
  color: #4a5a54;
  line-height: 1.5;
}

/* ---------- @ 已选 ---------- */
.at-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 8rpx;
  flex-shrink: 0;
}
.at-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: var(--brand-soft);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--brand-deep);
}
.at-chip-all {
  background: #fff1e6;
  color: #c2410c;
}
.at-x {
  font-size: 24rpx;
  opacity: 0.7;
}

/* ---------- 输入栏 ---------- */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(20, 35, 28, 0.05);
  box-sizing: border-box;
  z-index: 20;
}
/* 表情按钮：圆形，选中态用品牌绿填充 */
.ib-tool {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f2f5f4;
  color: #4a5a54;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.15s, color 0.15s;
}
.ib-tool.on {
  background: var(--brand);
  color: #ffffff;
}
.ib-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 26rpx;
  background: #f1f3f2;
  border: 1rpx solid #e7eae9;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}
.ib-input.disabled {
  color: #9aa8a2;
}
.ph {
  color: #a3b0aa;
}
.ib-send {
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #ffffff;
  background: #cfd9d5;
  flex-shrink: 0;
  transition: background 0.15s, box-shadow 0.15s;
}
.ib-send.on {
  background: var(--mine-grad);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}
.input-hold {
  height: 100rpx;
  flex-shrink: 0;
}

/* ---------- 首次进群群规层 ---------- */
.rules-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 20, 16, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 99;
}
.rules {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.rules-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
  flex-shrink: 0;
}
.rules-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}
.rules-sub {
  font-size: 23rpx;
  color: var(--text-2);
}
.rules-body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 0;
}
.rules-block {
  margin-bottom: 24rpx;
}
.rb-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 10rpx;
}
.rb-item {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #4a5a54;
}
.rules-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--mine-grad);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.28);
}
.rules-tip {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #a3b0aa;
  margin-top: 14rpx;
}

/* ==================== 引用回复块（气泡内） ==================== */
.quote {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(20, 35, 28, 0.05);
  border-left: 4rpx solid rgba(7, 193, 96, 0.5);
}
/* 自己的绿色气泡里用半透明白，不能用深色底 */
.bubble-mine .quote {
  background: rgba(255, 255, 255, 0.22);
  border-left-color: rgba(255, 255, 255, 0.8);
}
.quote-name {
  font-size: 21rpx;
  color: #4d6158;
  font-weight: 600;
}
.quote-text {
  font-size: 23rpx;
  color: #677a71;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.bubble-mine .quote-name,
.bubble-mine .quote-text {
  color: rgba(255, 255, 255, 0.9);
}

/* ==================== 回复栏（输入框上方） ==================== */
.reply-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 20rpx 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f1f5f2;
}
.rb-line {
  width: 4rpx;
  height: 34rpx;
  flex: none;
  border-radius: 2rpx;
  background: var(--brand);
}
.rb-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.rb-name {
  font-size: 21rpx;
  color: var(--brand);
}
.rb-text {
  font-size: 23rpx;
  color: #6b7c74;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rb-close {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  color: #8a9a90;
}

/* ==================== 底部固定区（回复栏 + 输入栏） ====================
   原来 .input-bar 自己 position:fixed / bottom:0，回复栏没法跟着键盘走。
   现在由 .bottom-dock 统一承担固定定位与键盘偏移，.input-bar 回到普通流。 */
.bottom-dock {
  position: fixed;
  left: 0;
  right: 0;
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(20, 35, 28, 0.05);
  z-index: 20;
  box-sizing: border-box;
}
.bottom-dock .input-bar {
  position: static;
  box-shadow: none;
  background: transparent;
  z-index: auto;
}
/* 回复栏在固定区内：左右内缩，靠一条竖线表明「引用」 */
.bottom-dock .reply-bar {
  margin: 12rpx 20rpx 0;
  border-radius: 12rpx;
}

/* ==================== 底部面板（@ / 表情） ====================
   高度固定成 rpx 常量：chat.wxml 的 .input-hold 占位高度按同样的数字算，
   改这里的高度必须同步改 wxml 里那个表达式，否则最后几条消息会被盖住。 */
.panel {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid var(--line);
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
}
.panel-at {
  height: 520rpx;
}
.panel-emoji {
  height: 430rpx;
}

/* ---------- @ 面板 ---------- */
.at-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx 10rpx;
  flex-shrink: 0;
}
.at-search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 18rpx;
  background: #f2f5f4;
  border-radius: 999rpx;
  box-sizing: border-box;
}
.at-search-ico {
  font-size: 22rpx;
  opacity: 0.5;
}
.at-kw {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--text-1);
}
.at-cancel {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--brand);
  padding: 0 6rpx;
}
.at-list {
  flex: 1;
  /* scroll-view 在 flex 列里必须 min-height:0，否则撑成内容高度、滚不动 */
  min-height: 0;
  padding: 0 12rpx 12rpx;
  box-sizing: border-box;
}
.at-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 92rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
}
.at-item:active {
  background: #f2f5f4;
}
.at-av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e8eeeb;
  overflow: hidden;
}
.at-av-default {
  display: flex;
  align-items: center;
  justify-content: center;
}
.at-av-all {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff1e6;
  color: #c2410c;
  font-size: 32rpx;
  font-weight: 700;
}
.at-nick {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.at-flag {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #a3b0aa;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.at-flag.on {
  color: #c2410c;
  background: #fff1e6;
}
.at-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #a3b0aa;
}

/* ---------- 表情面板 ---------- */
.emoji-tabs {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 18rpx 8rpx;
  flex-shrink: 0;
}
.emoji-tab {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--text-2);
  background: #f2f5f4;
}
.emoji-tab.on {
  color: #ffffff;
  background: var(--brand);
}
.emoji-del {
  margin-left: auto;
  width: 64rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f2f5f4;
  font-size: 26rpx;
  color: #4a5a54;
}
.emoji-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}
/* 7 列：12.5%（8 列）在部分机型上会因为小数累加溢出换行，留 0.3% 余量 */
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 10rpx 16rpx;
}
.emoji-cell {
  width: 14.2%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
  border-radius: 12rpx;
}
.emoji-cell:active {
  background: #eef3f1;
}
