# ============================================================================
# 「校园趣事」生产环境变量模板
#
# 用法：复制为 .env（不要提交），或用容器/系统的环境变量注入。
# 原则：能生成随机值的密钥一律随机生成，绝不使用文档里的示例值。
#
#   # 生成一个 32 字节密钥（Linux/macOS）
#   openssl rand -base64 32
#
#   # Windows PowerShell
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 令牌与数据加密密钥（必填，且所有服务/网关必须是同一份）
# ---------------------------------------------------------------------------
# 小程序登录令牌（HS256，>= 32 字节）
JWT_SECRET=
# 后台管理员令牌（与 C 端完全隔离，>= 32 字节）
ADMIN_JWT_SECRET=
# 敏感字段加密（手机号 / 学号 / 真实姓名 / 联系方式）+ 盲索引的根密钥
# ★ 此值丢失 = 库里的密文永久解不开，请与数据库备份分开保管
CAMPUS_DATA_KEY=
# 强制「密钥必须来自环境变量」，缺失则启动失败（生产建议 true）
CAMPUS_SECRET_STRICT=true

# ---------------------------------------------------------------------------
# 2. 数据库（生产必须用最小权限账号，见 migration-20261026-security-hardening.sql）
# ---------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_USER=campus_app
MYSQL_PWD=
# 数据库与网络不在同一可信内网时开启 TLS
MYSQL_SSL=true
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# ---------------------------------------------------------------------------
# 3. 微信小程序
# ---------------------------------------------------------------------------
WX_APPID=
WX_APPSECRET=
# 内容安全：生产必须开启（文本同步拦、图片异步审）
WX_SEC_CHECK=true
WX_MEDIA_CHECK=true
# 消息推送 Token（图片审核结果回调验签），未配置时回调一律拒绝
WX_CALLBACK_TOKEN=
# 微信学生身份快速验证：能力开通后再置 true，未开通时小程序自动走学生证通道
WX_STUDENT_VERIFY=false
# 学生认证 mock：跳过微信调用直接放行，**生产必须 false**（基线自检会拦 true）
WX_STUDENT_VERIFY_MOCK=false
# QQ 小程序（可选）
QQ_APPID=
QQ_APPSECRET=

# ---------------------------------------------------------------------------
# 4. 第三方服务（key/SK 属凭据，禁止写进仓库）
# ---------------------------------------------------------------------------
QQMAP_KEY=
QQMAP_SK=

# ---------------------------------------------------------------------------
# 5. 网关与上传
# ---------------------------------------------------------------------------
# 管理台来源白名单，逗号分隔。线上务必换成真实域名
CORS_ALLOWED_ORIGINS=https://campus-admin.example.com
# 绝对路径，且与 Nginx 的 /uploads/ alias 指向同一目录
UPLOAD_DIR=/mnt/ssd/web/campus-api.example.com/uploads/
UPLOAD_BASE_URL=https://campus-api.example.com
# 每人每天上传配额（数量 / 总字节）。磁盘的最后一道闸：没有它，一个登录账号
# 就能无限次传 50MB 视频把磁盘写满。200MB ≈ 4 条视频或 200 张压过的图。
UPLOAD_DAILY_MAX_COUNT=60
UPLOAD_DAILY_MAX_BYTES=209715200

# ---------------------------------------------------------------------------
# 5.1 异常信息与写入频控（安全开关，生产保持默认）
# ---------------------------------------------------------------------------
# 是否把异常根因写进响应体。**生产必须 false**：true 会把 SQL 表名/列名、
# 唯一键里的手机号、服务器绝对路径直接吐给公网（第三轮审计 P0-3）。
CAMPUS_ERROR_EXPOSE_DETAIL=false
# UGC 写入频控总开关（发帖/树洞/闲置/需求/评论/回应/下单的间隔与日上限）。
# 只在压测或演示时可临时置 false，生产保持 true（第三轮审计 P1-2）。
CAMPUS_WRITE_RATE_ENABLED=true

# ---------------------------------------------------------------------------
# 6. 后台登录与令牌（第二轮加固）
# ---------------------------------------------------------------------------
# 管理员初始密码未修改前，除改密接口外一律 403。默认 true，生产不要关。
CAMPUS_ADMIN_FORCE_PWD_CHANGE=true
# 管理员令牌有效期（小时）。改密/重置/禁用会立即让旧令牌失效，无需等它过期
CAMPUS_ADMIN_JWT_EXPIRE_HOURS=8

# ---------------------------------------------------------------------------
# 7. C 端登录频控（滑动窗口，超限返回 429）
# ---------------------------------------------------------------------------
# 单个 IP 每分钟允许的登录次数；单 openid 每分钟允许的次数
CAMPUS_AUTH_LOGIN_MAX_PER_IP=30
CAMPUS_AUTH_LOGIN_MAX_PER_OPENID=10
CAMPUS_AUTH_LOGIN_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# 8. 备份加密口令（scripts/backup-db.sh 用，务必与数据库分开保管）
# ---------------------------------------------------------------------------
# 生成：openssl rand -base64 32
CAMPUS_BACKUP_PASSPHRASE=
CAMPUS_BACKUP_DIR=/mnt/ssd/backups/campus

# ---------------------------------------------------------------------------
# 9. 一次性任务开关（用完立刻删掉）
# ---------------------------------------------------------------------------
# 把历史明文敏感字段加密；迁移完成后必须置 false 或删除
CAMPUS_SECURITY_MIGRATE_PLAINTEXT=false
# 本地联调可以放开「提交即认证」，生产必须 false（否则学籍认证形同虚设）
VERIFY_AUTO_APPROVE=false
